<UserControl xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:ShopHoa.ViewModels"
  xmlns:models="using:ShopHoa.Models"
  xmlns:controls="using:ShopHoa.Controls"
  x:Class="ShopHoa.Views.ThemPhieuNhapHangView"
  x:Name="RootView"
  x:DataType="vm:MainWindowViewModel">

  <UserControl.Styles>
    <Style Selector="TextBox.formInput">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#CBD5E1" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="FontSize" Value="12.5" />
    </Style>

    <Style Selector="Button.btnPrimary">
      <Setter Property="Background" Value="#1976D2" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.btnPrimary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#1565C0" />
      <Setter Property="TextElement.Foreground" Value="White" />
    </Style>

    <Style Selector="Button.btnOutline">
      <Setter Property="Background" Value="#EFF6FF" />
      <Setter Property="Foreground" Value="#1D4ED8" />
      <Setter Property="BorderBrush" Value="#BFDBFE" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.btnOutline:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#DBEAFE" />
      <Setter Property="BorderBrush" Value="#93C5FD" />
      <Setter Property="TextElement.Foreground" Value="#1E40AF" />
    </Style>

    <Style Selector="Button.btnSubtle">
      <Setter Property="Background" Value="#F1F5F9" />
      <Setter Property="Foreground" Value="#475569" />
      <Setter Property="BorderBrush" Value="#E2E8F0" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.btnSubtle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#E2E8F0" />
      <Setter Property="TextElement.Foreground" Value="#1E293B" />
    </Style>

    <Style Selector="Button.btnDanger">
      <Setter Property="Background" Value="#FEE2E2" />
      <Setter Property="Foreground" Value="#B91C1C" />
      <Setter Property="BorderBrush" Value="#FECACA" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
  </UserControl.Styles>

  <!-- MÀN HÌNH: THÊM PHIẾU NHẬP HÀNG (BLUE ACCENT THEME) -->
  <Grid RowDefinitions="Auto,*" RowSpacing="14">

    <!-- ============================================================ -->
    <!-- HEADER BAR: Tiêu đề, Mã phiếu, Trạng thái, và Nút thao tác nhanh -->
    <!-- ============================================================ -->
    <Border Grid.Row="0"
      Background="White"
      BorderBrush="#E2E8F0"
      BorderThickness="1"
      CornerRadius="12"
      Padding="16,12"
      BoxShadow="0 1 3 #0A000000">
      <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">

        <!-- Nút Quay lại -->
        <Button Classes="btnSubtle"
          Command="{Binding HuyPhieuNhapCommand}"
          Margin="0,0,16,0"
          Padding="10,6"
          VerticalAlignment="Center"
          ToolTip.Tip="Quay lại danh sách phiếu nhập (Hủy bỏ)">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <TextBlock Text="←" FontWeight="Bold" FontSize="15" Foreground="#475569" />
            <TextBlock Text="Quay lại" FontSize="13" FontWeight="SemiBold" Foreground="#475569" />
          </StackPanel>
        </Button>

        <!-- Tiêu đề + Badges -->
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <TextBlock Text="Thêm phiếu nhập hàng"
              FontSize="20"
              FontWeight="Bold"
              Foreground="#0F172A" />

            <!-- Badge Mã phiếu -->
            <Border Background="#E0F2FE"
              BorderBrush="#BAE6FD"
              BorderThickness="1"
              CornerRadius="6"
              Padding="8,2"
              VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="Mã:" FontSize="11.5" Foreground="#0284C7" />
                <TextBlock Text="{Binding PhieuNhapMa}"
                  Foreground="#0369A1"
                  FontWeight="Bold"
                  FontSize="12" />
              </StackPanel>
            </Border>

            <!-- Badge Trạng thái -->
            <Border Background="#F1F5F9"
              BorderBrush="#CBD5E1"
              BorderThickness="1"
              CornerRadius="6"
              Padding="8,2"
              VerticalAlignment="Center">
              <TextBlock Text="Phiếu tạm"
                Foreground="#475569"
                FontWeight="SemiBold"
                FontSize="11.5" />
            </Border>
          </StackPanel>

          <TextBlock
            Text="Nghiệp vụ → Nhập hàng → Thêm phiếu nhập hàng (quản lý tồn kho, giá vốn và công nợ NCC)"
            Foreground="#64748B"
            FontSize="12" />
        </StackPanel>

        <!-- Nút thao tác nhanh trên Header -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <!-- Nút Hủy -->
          <Button Classes="btnSubtle"
            Command="{Binding HuyPhieuNhapCommand}"
            Padding="12,7"
            FontSize="12.5"
            FontWeight="SemiBold"
            VerticalAlignment="Center">
            <TextBlock Text="Hủy bỏ" />
          </Button>

          <!-- Nút Lưu và in -->
          <Button Classes="btnOutline"
            Command="{Binding LuuVaInPhieuNhapCommand}"
            IsEnabled="{Binding CanSavePhieuNhap}"
            IsVisible="{Binding CanCreatePurchase}"
            Padding="12,7"
            FontSize="12.5"
            VerticalAlignment="Center"
            ToolTip.Tip="Lưu phiếu và tự động in hóa đơn nhập hàng">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <TextBlock Text="🖨" FontSize="13" />
              <TextBlock Text="Lưu và in" />
            </StackPanel>
          </Button>

          <!-- Nút Lưu phiếu nhập -->
          <Button Classes="btnPrimary"
            Command="{Binding HoanThanhPhieuNhapCommand}"
            IsEnabled="{Binding CanSavePhieuNhap}"
            IsVisible="{Binding CanCreatePurchase}"
            Padding="16,7"
            FontSize="13"
            VerticalAlignment="Center"
            ToolTip.Tip="Xác thực và lưu phiếu nhập vào cơ sở dữ liệu">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <TextBlock Text="✔" FontSize="13" FontWeight="Bold" />
              <TextBlock Text="Lưu phiếu nhập" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ============================================================ -->
    <!-- MAIN CONTENT: 2 Cột (Trái: Bảng hàng hóa; Phải: Thông tin & Thanh toán) -->
    <!-- ============================================================ -->
    <Grid Grid.Row="1"
      ColumnDefinitions="*,380"
      ColumnSpacing="14">

      <!-- CỘT TRÁI: TÌM KIẾM HÀNG HÓA + BẢNG CHI TIẾT -->
      <Grid RowDefinitions="Auto,*" RowSpacing="12">

        <!-- THANH TÌM KIẾM HÀNG HÓA + THÊM HÀNG MỚI -->
        <Grid Grid.Row="0" RowDefinitions="Auto,Auto">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">

            <!-- Ô TÌM KIẾM -->
            <Border Background="White"
              BorderBrush="#CBD5E1"
              BorderThickness="1"
              CornerRadius="8"
              Padding="0">
              <TextBox
                Watermark="🔍 Tìm theo mã hàng hoặc tên hàng hóa (gõ để tìm)..."
                Text="{Binding ImportProductSearch, Mode=TwoWay}"
                TextChanged="OnImportProductSearchTextChanged"
                Padding="12,9"
                FontSize="13"
                BorderThickness="0"
                Background="Transparent"
                Margin="0" />
            </Border>

            <!-- NÚT THÊM HÀNG MỚI -->
            <Button Grid.Column="1"
              Classes="btnOutline"
              Command="{Binding ThemSanPhamCommand}"
              CommandParameter="{Binding ImportProductSearch}"
              IsVisible="{Binding CanCreateProduct}"
              Padding="14,9"
              FontSize="13"
              VerticalAlignment="Stretch">
              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock Text="＋" FontWeight="Bold" FontSize="14" />
                <TextBlock Text="Thêm hàng hóa mới" />
              </StackPanel>
            </Button>
          </Grid>

          <!-- KẾT QUẢ TÌM KIẾM GỢI Ý (DROPDOWN) -->
          <Border Grid.Row="1"
            IsVisible="{Binding HasPhieuNhapSuggestions}"
            Background="White"
            BorderBrush="#93C5FD"
            BorderThickness="1"
            CornerRadius="8"
            MaxHeight="220"
            Margin="0,4,0,0"
            ClipToBounds="True"
            ZIndex="100"
            BoxShadow="0 4 12 #1E293B1F">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding PhieuNhapProductSuggestions}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:SanPham">
                    <Button HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Left"
                      Background="Transparent"
                      BorderBrush="#F1F5F9"
                      BorderThickness="0,0,0,1"
                      Padding="12,8"
                      Cursor="Hand"
                      Command="{Binding ElementName=RootView, Path=DataContext.ThemSanPhamVaoPhieuNhapCommand}"
                      CommandParameter="{Binding}">
                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">

                        <!-- Icon / Avatar -->
                        <Border Width="34"
                          Height="34"
                          CornerRadius="8"
                          Background="#E0F2FE"
                          VerticalAlignment="Center">
                          <TextBlock Text="🌸"
                            FontSize="16"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                        </Border>

                        <!-- Tên hàng + Mã hàng + Tồn kho -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                          <TextBlock Text="{Binding TenSanPham}"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="#0F172A"
                            TextTrimming="CharacterEllipsis" />

                          <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="{Binding MaSanPham}"
                              FontSize="11.5"
                              Foreground="#64748B" />

                            <StackPanel Orientation="Horizontal" Spacing="4">
                              <TextBlock Text="Tồn:" FontSize="11.5" Foreground="#64748B" />
                              <TextBlock Text="{Binding TonKho, StringFormat='{}{0:N0}'}"
                                IsVisible="{Binding !HetHang}"
                                FontSize="11.5"
                                Foreground="#0284C7"
                                FontWeight="SemiBold" />
                              <Border Background="#FEE2E2" CornerRadius="4" Padding="5,1"
                                IsVisible="{Binding HetHang}">
                                <TextBlock Text="Hết hàng"
                                  Foreground="#DC2626"
                                  FontWeight="Bold"
                                  FontSize="10.5" />
                              </Border>
                            </StackPanel>
                          </StackPanel>
                        </StackPanel>

                        <!-- Giá vốn -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                          <TextBlock Text="{Binding GiaVon, StringFormat={}{0:N0} đ}"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="#1976D2"
                            HorizontalAlignment="Right" />
                          <TextBlock Text="Giá vốn"
                            FontSize="11"
                            Foreground="#94A3B8"
                            HorizontalAlignment="Right" />
                        </StackPanel>
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>
        </Grid>

        <!-- BẢNG CHI TIẾT HÀNG NHẬP -->
        <Border Grid.Row="1"
          Background="White"
          BorderBrush="#E2E8F0"
          BorderThickness="1"
          CornerRadius="12"
          ClipToBounds="True">
          <Grid RowDefinitions="Auto,*,Auto">

            <!-- HEADER BẢNG: 9 CỘT THEO YÊU CẦU -->
            <!-- STT(45), Mã hàng(115), Tên hàng(*), ĐVT(135), Số lượng(110), Giá nhập(135), Chiết khấu(120), Thành tiền(130), Xóa(45) -->
            <Border Grid.Row="0"
              Background="#F8FAFC"
              BorderBrush="#E2E8F0"
              BorderThickness="0,0,0,1"
              Padding="12,0">
              <Grid ColumnDefinitions="45,115,*,135,110,135,120,130,45"
                Height="42">

                <TextBlock Text="STT"
                  FontWeight="Bold"
                  Foreground="#475569"
                  FontSize="12"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Center" />

                <TextBlock Grid.Column="1"
                  Text="MÃ HÀNG"
                  FontWeight="Bold"
                  Foreground="#475569"
                  FontSize="12"
                  VerticalAlignment="Center" />

                <TextBlock Grid.Column="2"
                  Text="TÊN HÀNG HÓA"
                  FontWeight="Bold"
                  Foreground="#475569"
                  FontSize="12"
                  VerticalAlignment="Center" />

                <TextBlock Grid.Column="3"
                  Text="ĐƠN VỊ TÍNH"
                  FontWeight="Bold"
                  Foreground="#475569"
                  FontSize="12"
                  VerticalAlignment="Center" />

                <TextBlock Grid.Column="4"
                  Text="SỐ LƯỢNG"
                  FontWeight="Bold"
                  Foreground="#475569"
                  FontSize="12"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Center" />

                <TextBlock Grid.Column="5"
                  Text="GIÁ NHẬP"
                  FontWeight="Bold"
                  Foreground="#475569"
                  FontSize="12"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Right"
                  Margin="0,0,6,0" />

                <TextBlock Grid.Column="6"
                  Text="CHIẾT KHẤU"
                  FontWeight="Bold"
                  Foreground="#475569"
                  FontSize="12"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Right"
                  Margin="0,0,6,0" />

                <TextBlock Grid.Column="7"
                  Text="THÀNH TIỀN"
                  FontWeight="Bold"
                  Foreground="#475569"
                  FontSize="12"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Right"
                  Margin="0,0,6,0" />

                <TextBlock Grid.Column="8"
                  Text=""
                  VerticalAlignment="Center" />
              </Grid>
            </Border>

            <!-- DANH SÁCH HÀNG HÓA ĐÃ THÊM -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
              <Grid>
                <ItemsControl ItemsSource="{Binding PhieuNhapItems}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:ChiTietPhieuNhapHang">
                      <Border Background="White"
                        BorderBrush="#F1F5F9"
                        BorderThickness="0,0,0,1"
                        Padding="12,0">
                        <Grid ColumnDefinitions="45,115,*,135,110,135,120,130,45"
                          Height="54">

                          <!-- STT -->
                          <TextBlock Text="{Binding Index}"
                            Foreground="#94A3B8"
                            FontSize="13"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center" />

                          <!-- MÃ HÀNG -->
                          <TextBlock Grid.Column="1"
                            Text="{Binding MaSanPham}"
                            Foreground="#334155"
                            FontSize="13"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center"
                            TextTrimming="CharacterEllipsis" />

                          <!-- TÊN HÀNG -->
                          <TextBlock Grid.Column="2"
                            Text="{Binding TenSanPham}"
                            Foreground="#0F172A"
                            FontSize="13"
                            FontWeight="Medium"
                            VerticalAlignment="Center"
                            TextTrimming="CharacterEllipsis"
                            Margin="0,0,8,0" />

                          <!-- ĐVT -->
                          <Grid Grid.Column="3"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0">
                            <TextBlock Text="{Binding DonViTinh}"
                              IsVisible="{Binding CoDonViTinhCoSan}"
                              Foreground="#475569"
                              FontSize="13"
                              VerticalAlignment="Center"
                              TextTrimming="CharacterEllipsis" />

                            <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="4"
                              IsVisible="{Binding ChoPhepChonDonViTinh}"
                              VerticalAlignment="Center">
                              <ComboBox Grid.Column="0"
                                ItemsSource="{Binding DonViTinhOptions}"
                                SelectedItem="{Binding SelectedDonViTinh, Mode=TwoWay}"
                                PlaceholderText="Chọn ĐVT"
                                Height="30"
                                MinHeight="30"
                                Padding="6,3"
                                FontSize="12"
                                CornerRadius="6"
                                Background="#F8FAFC"
                                BorderBrush="#94A3B8"
                                BorderThickness="1"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center">
                                <ComboBox.ItemTemplate>
                                  <DataTemplate x:DataType="models:ProductOption">
                                    <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center" />
                                  </DataTemplate>
                                </ComboBox.ItemTemplate>
                              </ComboBox>

                              <Button Grid.Column="1"
                                Width="26"
                                Height="30"
                                MinWidth="26"
                                MaxWidth="26"
                                Margin="0"
                                Padding="0"
                                CornerRadius="6"
                                Background="#EFF6FF"
                                Foreground="#1D4ED8"
                                BorderBrush="#BFDBFE"
                                BorderThickness="1"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                ToolTip.Tip="Thêm đơn vị tính mới"
                                Command="{Binding ElementName=RootView, Path=DataContext.ThemDonViTinhPhieuNhapCommand}"
                                CommandParameter="{Binding}">
                                <TextBlock Text="+" FontSize="14" FontWeight="Bold" />
                              </Button>
                            </Grid>
                          </Grid>

                          <!-- SỐ LƯỢNG (Stepper) -->
                          <Grid Grid.Column="4"
                            ColumnDefinitions="28,*,28"
                            ColumnSpacing="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                            <Button Width="28"
                              Height="30"
                              MinWidth="28"
                              MaxWidth="28"
                              Margin="0"
                              Padding="0"
                              HorizontalContentAlignment="Center"
                              VerticalContentAlignment="Center"
                              CornerRadius="6,0,0,6"
                              Background="#F1F5F9"
                              Foreground="#475569"
                              BorderBrush="#CBD5E1"
                              BorderThickness="1,1,0,1"
                              Cursor="Hand"
                              Command="{Binding ElementName=RootView, Path=DataContext.GiamSoLuongNhapCommand}"
                              CommandParameter="{Binding}">
                              <TextBlock Text="−" FontSize="13" FontWeight="Bold" />
                            </Button>

                            <TextBox Grid.Column="1"
                              MinWidth="46"
                              Height="30"
                              Margin="0"
                              Padding="2"
                              TextAlignment="Center"
                              HorizontalContentAlignment="Center"
                              VerticalContentAlignment="Center"
                              Background="#FFFFFF"
                              BorderBrush="#CBD5E1"
                              BorderThickness="1"
                              FontSize="13"
                              FontWeight="SemiBold"
                              Foreground="#0F172A"
                              Text="{Binding SoLuong, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <Button Grid.Column="2"
                              Width="28"
                              Height="30"
                              MinWidth="28"
                              MaxWidth="28"
                              Margin="0"
                              Padding="0"
                              HorizontalContentAlignment="Center"
                              VerticalContentAlignment="Center"
                              CornerRadius="0,6,6,0"
                              Background="#F1F5F9"
                              Foreground="#475569"
                              BorderBrush="#CBD5E1"
                              BorderThickness="0,1,1,1"
                              Cursor="Hand"
                              Command="{Binding ElementName=RootView, Path=DataContext.TangSoLuongNhapCommand}"
                              CommandParameter="{Binding}">
                              <TextBlock Text="+" FontSize="13" FontWeight="Bold" />
                            </Button>
                          </Grid>

                          <!-- ĐƠN GIÁ NHẬP -->
                          <controls:MoneyTextBox Grid.Column="5"
                            Margin="0,0,6,0"
                            Height="30"
                            FontSize="13"
                            Value="{Binding DonGiaNhap, Mode=TwoWay}" />

                          <!-- CHIẾT KHẤU DÒNG HÀNG -->
                          <controls:MoneyTextBox Grid.Column="6"
                            Margin="0,0,6,0"
                            Height="30"
                            FontSize="13"
                            Value="{Binding GiamGia, Mode=TwoWay}" />

                          <!-- THÀNH TIỀN -->
                          <TextBlock Grid.Column="7"
                            Text="{Binding ThanhTien, StringFormat={}{0:N0} đ}"
                            Foreground="#1976D2"
                            FontSize="13.5"
                            FontWeight="Bold"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right"
                            Margin="0,0,6,0" />

                          <!-- THAO TÁC (NÚT XÓA) -->
                          <Button Grid.Column="8"
                            Width="28"
                            Height="28"
                            Margin="0"
                            Padding="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            CornerRadius="14"
                            Background="#FEE2E2"
                            Foreground="#DC2626"
                            BorderBrush="#FCA5A5"
                            BorderThickness="1"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Cursor="Hand"
                            ToolTip.Tip="Xóa mặt hàng này khỏi phiếu"
                            Command="{Binding ElementName=RootView, Path=DataContext.XoaDongPhieuNhapCommand}"
                            CommandParameter="{Binding}">
                            <Path Width="10"
                              Height="10"
                              Stretch="Uniform"
                              Fill="#DC2626"
                              Data="M 0.8,0 L 5,4.2 L 9.2,0 L 10,0.8 L 5.8,5 L 10,9.2 L 9.2,10 L 5,5.8 L 0.8,10 L 0,9.2 L 4.2,5 L 0,0.8 Z"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                          </Button>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- EMPTY STATE (KHI CHƯA CÓ HÀNG HÓA) -->
                <StackPanel IsVisible="{Binding IsPhieuNhapEmpty}"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Center"
                  Margin="0,40">
                  <Border Width="64"
                    Height="64"
                    CornerRadius="32"
                    Background="#F0F9FF"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="0,0,0,12">
                    <TextBlock Text="📦"
                      FontSize="30"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
                  </Border>

                  <TextBlock Text="Phiếu nhập chưa có mặt hàng nào"
                    FontSize="15"
                    FontWeight="Bold"
                    Foreground="#334155"
                    HorizontalAlignment="Center" />

                  <TextBlock
                    Text="Tìm mã hàng hoặc tên hàng ở thanh tìm kiếm phía trên để thêm vào phiếu"
                    FontSize="12.5"
                    Foreground="#64748B"
                    HorizontalAlignment="Center"
                    Margin="0,4,0,0" />
                </StackPanel>
              </Grid>
            </ScrollViewer>

            <!-- BẢNG FOOTER: TỔNG SỐ HÀNG + NÚT XÓA TẤT CẢ -->
            <Border Grid.Row="2"
              Background="#F8FAFC"
              BorderBrush="#E2E8F0"
              BorderThickness="0,1,0,0"
              Padding="14,10">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <TextBlock Text="Tổng số mặt hàng:"
                    FontSize="12.5"
                    Foreground="#64748B"
                    VerticalAlignment="Center" />
                  <TextBlock Text="{Binding PhieuNhapItems.Count}"
                    FontSize="13"
                    FontWeight="Bold"
                    Foreground="#0F172A"
                    VerticalAlignment="Center" />
                </StackPanel>

                <Button Grid.Column="2"
                  Classes="btnDanger"
                  Command="{Binding XoaTatPhieuNhapCommand}"
                  IsEnabled="{Binding HasPhieuNhapItems}"
                  Padding="12,5"
                  FontSize="12"
                  FontWeight="SemiBold"
                  VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                    <TextBlock Text="🗑" FontSize="12" />
                    <TextBlock Text="Xóa tất cả mặt hàng" />
                  </StackPanel>
                </Button>
              </Grid>
            </Border>
          </Grid>
        </Border>
      </Grid>

      <!-- ============================================================ -->
      <!-- CỘT PHẢI: THÔNG TIN PHIẾU & TỔNG KẾT THANH TOÁN (Width 380) -->
      <!-- ============================================================ -->
      <Border Grid.Column="1"
        Background="White"
        BorderBrush="#E2E8F0"
        BorderThickness="1"
        CornerRadius="12"
        Padding="16"
        BoxShadow="0 2 8 #0A000000">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="14">

            <!-- PHẦN 1: THÔNG TIN PHIẾU NHẬP -->
            <Border Background="#F8FAFC"
              BorderBrush="#E2E8F0"
              BorderThickness="1"
              CornerRadius="8"
              Padding="12,10">
              <StackPanel Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <TextBlock Text="📋" FontSize="14" />
                  <TextBlock Text="THÔNG TIN PHIẾU NHẬP"
                    FontSize="12"
                    FontWeight="Bold"
                    Foreground="#1E40AF"
                    LetterSpacing="0.5" />
                </StackPanel>

                <!-- MÃ PHIẾU & NGÀY NHẬP -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                  <!-- Mã phiếu -->
                  <StackPanel Spacing="4">
                    <TextBlock Text="Mã phiếu" FontSize="11.5" Foreground="#64748B" FontWeight="Medium" />
                    <Border Background="#E0F2FE"
                      BorderBrush="#BAE6FD"
                      BorderThickness="1"
                      CornerRadius="6"
                      Padding="8,6">
                      <TextBlock Text="{Binding PhieuNhapMa}"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="#0369A1"
                        TextTrimming="CharacterEllipsis" />
                    </Border>
                  </StackPanel>

                  <!-- Ngày nhập -->
                  <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="Ngày nhập" FontSize="11.5" Foreground="#64748B" FontWeight="Medium" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="2">
                      <TextBox Name="PhieuNhapNgayNhapBox"
                        IsReadOnly="True"
                        Text="{Binding PhieuNhapNgayNhapText, Mode=OneWay}"
                        Watermark="dd/MM/yyyy"
                        PointerPressed="OnPhieuNhapNgayNhapBoxPointerPressed"
                        Padding="6,6"
                        FontSize="12"
                        Margin="0"
                        CornerRadius="6,0,0,6"
                        BorderBrush="#CBD5E1"
                        VerticalContentAlignment="Center" />

                      <Button Grid.Column="1"
                        Content="📅"
                        Width="30"
                        Padding="0"
                        FontSize="13"
                        Background="#F1F5F9"
                        Foreground="#334155"
                        BorderBrush="#CBD5E1"
                        BorderThickness="0,1,1,1"
                        CornerRadius="0,6,6,0"
                        VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        ToolTip.Tip="Chọn ngày nhập"
                        Command="{Binding MoLichPhieuNhapCommand}" />

                      <Popup Grid.Column="0"
                        Grid.ColumnSpan="2"
                        PlacementTarget="{Binding #PhieuNhapNgayNhapBox}"
                        Placement="Bottom"
                        IsLightDismissEnabled="True"
                        IsOpen="{Binding IsPhieuNhapCalendarOpen, Mode=TwoWay}">
                        <Border Background="White"
                          BorderBrush="#94A3B8"
                          BorderThickness="1"
                          CornerRadius="8"
                          Padding="4"
                          BoxShadow="0 4 12 #1E293B26">
                          <Calendar Name="PhieuNhapCalendar"
                            SelectedDate="{Binding PhieuNhapNgayNhap, Mode=TwoWay}"
                            Background="Transparent"
                            BorderThickness="0" />
                        </Border>
                      </Popup>
                    </Grid>
                  </StackPanel>
                </Grid>

                <!-- KHO NHẬN HÀNG & NHÂN VIÊN LẬP PHIẾU -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                  <!-- Kho nhận hàng -->
                  <StackPanel Spacing="4">
                    <TextBlock Text="Kho nhận" FontSize="11.5" Foreground="#64748B" FontWeight="Medium" />
                    <Border Background="White"
                      BorderBrush="#CBD5E1"
                      BorderThickness="1"
                      CornerRadius="6"
                      Padding="8,6">
                      <TextBlock Text="{Binding PhieuNhapKhoNhan}"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="#334155"
                        TextTrimming="CharacterEllipsis"
                        ToolTip.Tip="{Binding PhieuNhapKhoNhan}" />
                    </Border>
                  </StackPanel>

                  <!-- Nhân viên -->
                  <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="Nhân viên" FontSize="11.5" Foreground="#64748B" FontWeight="Medium" />
                    <Border Background="White"
                      BorderBrush="#CBD5E1"
                      BorderThickness="1"
                      CornerRadius="6"
                      Padding="8,6">
                      <TextBlock Text="{Binding PhieuNhapNhanVien}"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="#334155"
                        TextTrimming="CharacterEllipsis"
                        ToolTip.Tip="{Binding PhieuNhapNhanVien}" />
                    </Border>
                  </StackPanel>
                </Grid>

                <!-- NHÀ CUNG CẤP -->
                <StackPanel Spacing="4">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Nhà cung cấp *"
                      FontSize="11.5"
                      Foreground="#1E293B"
                      FontWeight="Bold" />
                    <Button Grid.Column="1"
                      Command="{Binding XoaChonNhaCungCapNhapCommand}"
                      IsVisible="{Binding HasSelectedPhieuNhapNcc}"
                      Background="Transparent"
                      BorderThickness="0"
                      Padding="0"
                      Margin="0"
                      Cursor="Hand">
                      <TextBlock Text="[✕ Đổi NCC]" FontSize="11" Foreground="#EF4444" FontWeight="SemiBold" />
                    </Button>
                  </Grid>

                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <TextBox Name="PhieuNhapNccSearchBox"
                      Text="{Binding ImportSupplierSearch, Mode=TwoWay}"
                      Watermark="Tìm tên hoặc SĐT nhà cung cấp..."
                      TextChanged="OnImportSupplierSearchTextChanged"
                      Padding="10,7"
                      FontSize="12.5"
                      CornerRadius="6"
                      BorderBrush="#CBD5E1"
                      Margin="0" />

                    <Button Grid.Column="1"
                      Classes="btnPrimary"
                      Content="＋"
                      Width="34"
                      Padding="0"
                      FontSize="15"
                      CornerRadius="6"
                      VerticalAlignment="Stretch"
                      HorizontalContentAlignment="Center"
                      VerticalContentAlignment="Center"
                      ToolTip.Tip="Thêm nhà cung cấp mới"
                      Command="{Binding ThemNhaCungCapNhapNhanhCommand}"
                      IsVisible="{Binding CanCreateSupplier}" />
                  </Grid>

                  <!-- DROPDOWN GỢI Ý NHÀ CUNG CẤP -->
                  <Border Background="White"
                    BorderBrush="#93C5FD"
                    BorderThickness="1"
                    CornerRadius="6"
                    MaxHeight="140"
                    ClipToBounds="True"
                    IsVisible="{Binding HasPhieuNhapSupplierSuggestions}"
                    BoxShadow="0 4 10 #1E293B1F">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                      <ItemsControl ItemsSource="{Binding PhieuNhapSupplierSuggestions}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="models:NhaCungCap">
                            <Button HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Left"
                              Background="Transparent"
                              BorderBrush="#F1F5F9"
                              BorderThickness="0,0,0,1"
                              Padding="10,6"
                              Cursor="Hand"
                              Command="{Binding ElementName=RootView, Path=DataContext.ChonNhaCungCapNhapCommand}"
                              CommandParameter="{Binding}">
                              <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="1">
                                  <TextBlock Text="{Binding TenNhaCungCap}"
                                    FontSize="12.5"
                                    FontWeight="SemiBold"
                                    Foreground="#0F172A"
                                    TextTrimming="CharacterEllipsis" />
                                  <TextBlock Text="{Binding SoDienThoai}"
                                    FontSize="11"
                                    Foreground="#64748B" />
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                  Text="{Binding MaNhaCungCap}"
                                  FontSize="11"
                                  Foreground="#94A3B8"
                                  VerticalAlignment="Center" />
                              </Grid>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                  </Border>
                </StackPanel>

                <!-- SỐ HÓA ĐƠN ĐẦU VÀO -->
                <StackPanel Spacing="4">
                  <TextBlock Text="Số hóa đơn đầu vào" FontSize="11.5" Foreground="#64748B" FontWeight="Medium" />
                  <TextBox Text="{Binding PhieuNhapSoHoaDonDauVao, Mode=TwoWay}"
                    Watermark="Số hóa đơn đỏ / chứng từ đầu vào NCC cấp (nếu có)"
                    Padding="10,7"
                    FontSize="12.5"
                    CornerRadius="6"
                    BorderBrush="#CBD5E1"
                    Margin="0" />
                </StackPanel>

                <!-- GHI CHÚ -->
                <StackPanel Spacing="4">
                  <TextBlock Text="Ghi chú phiếu nhập" FontSize="11.5" Foreground="#64748B" FontWeight="Medium" />
                  <TextBox Text="{Binding PhieuNhapGhiChu, Mode=TwoWay}"
                    Watermark="Ghi chú thêm thông tin cho đợt nhập hàng này..."
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    Height="56"
                    Padding="10,6"
                    FontSize="12.5"
                    CornerRadius="6"
                    BorderBrush="#CBD5E1"
                    Margin="0" />
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- PHẦN 2: TỔNG KẾT & THANH TOÁN -->
            <Border Background="#F8FAFC"
              BorderBrush="#E2E8F0"
              BorderThickness="1"
              CornerRadius="8"
              Padding="12,10">
              <StackPanel Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <TextBlock Text="💳" FontSize="14" />
                  <TextBlock Text="THANH TOÁN &amp; CÔNG NỢ"
                    FontSize="12"
                    FontWeight="Bold"
                    Foreground="#1E40AF"
                    LetterSpacing="0.5" />
                </StackPanel>

                <!-- TỔNG TIỀN HÀNG -->
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="Tổng tiền hàng"
                    FontSize="12.5"
                    Foreground="#64748B"
                    VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1"
                    Text="{Binding PhieuNhapTongTienHangText, StringFormat={}{0} đ}"
                    FontSize="14"
                    FontWeight="Bold"
                    Foreground="#1E293B" />
                </Grid>

                <!-- TỔNG CHIẾT KHẤU HÀNG (Hiển thị khi > 0) -->
                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasPhieuNhapTongChietKhau}">
                  <TextBlock Text="Tổng chiết khấu hàng"
                    FontSize="12.5"
                    Foreground="#DC2626"
                    VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1"
                    Text="{Binding PhieuNhapTongChietKhauText, StringFormat='-{0} đ'}"
                    FontSize="13.5"
                    FontWeight="Bold"
                    Foreground="#DC2626" />
                </Grid>

                <!-- CHI PHÍ KHÁC (VẬN CHUYỂN, BỐC XẾP...) -->
                <Grid ColumnDefinitions="*,135" ColumnSpacing="6">
                  <TextBlock Text="Chi phí khác (vận chuyển...)"
                    FontSize="12.5"
                    Foreground="#64748B"
                    VerticalAlignment="Center" />
                  <controls:MoneyTextBox Grid.Column="1"
                    Value="{Binding PhieuNhapChiPhiKhac, Mode=TwoWay}"
                    Height="30"
                    FontSize="12.5"
                    Margin="0" />
                </Grid>

                <!-- THẺ TỔNG TIỀN NHẬP (BLUE HIGHLIGHT CARD) -->
                <Border Background="#1976D2"
                  CornerRadius="8"
                  Padding="12,10">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="TỔNG THANH TOÁN"
                        FontSize="11.5"
                        FontWeight="Bold"
                        Foreground="#E0F2FE" />
                      <TextBlock Text="(Đã gồm chi phí khác)"
                        FontSize="10.5"
                        Foreground="#BAE6FD" />
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                      Text="{Binding PhieuNhapTongTienNhapText, StringFormat={}{0} đ}"
                      FontSize="18"
                      FontWeight="Bold"
                      Foreground="White"
                      VerticalAlignment="Center" />
                  </Grid>
                </Border>

                <!-- TIỀN ĐÃ TRẢ NCC -->
                <Grid ColumnDefinitions="*,135" ColumnSpacing="6">
                  <TextBlock Text="Tiền đã trả NCC"
                    FontSize="12.5"
                    FontWeight="SemiBold"
                    Foreground="#1E293B"
                    VerticalAlignment="Center" />
                  <controls:MoneyTextBox Grid.Column="1"
                    Value="{Binding PhieuNhapDaThanhToan, Mode=TwoWay}"
                    Height="32"
                    FontSize="13"
                    FontWeight="Bold"
                    Margin="0" />
                </Grid>

                <!-- HÌNH THỨC THANH TOÁN & NGUỒN QUỸ -->
                <StackPanel Spacing="4">
                  <Grid ColumnDefinitions="*,135" ColumnSpacing="6">
                    <TextBlock Text="Phương thức trả"
                      FontSize="12.5"
                      Foreground="#64748B"
                      VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1"
                      ItemsSource="{Binding PhieuNhapPhuongThucOptions}"
                      SelectedItem="{Binding PhieuNhapPhuongThuc, Mode=TwoWay}"
                      HorizontalAlignment="Stretch"
                      Height="30"
                      FontSize="12"
                      CornerRadius="6" />
                  </Grid>

                  <TextBlock Text="{Binding PhieuNhapNguonQuyText}"
                    FontSize="11"
                    Foreground="#0284C7"
                    Margin="2,1,0,0"
                    TextWrapping="Wrap" />
                </StackPanel>

                <!-- THẺ CÒN NỢ NHÀ CUNG CẤP (AMBER WARNING CARD) -->
                <Border Background="#FFFBEB"
                  BorderBrush="#FDE68A"
                  BorderThickness="1"
                  CornerRadius="8"
                  Padding="12,9">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Còn nợ nhà cung cấp"
                      FontSize="12.5"
                      FontWeight="SemiBold"
                      Foreground="#92400E"
                      VerticalAlignment="Center" />

                    <TextBlock Grid.Column="1"
                      Text="{Binding PhieuNhapConNoText, StringFormat={}{0} đ}"
                      FontSize="15"
                      FontWeight="Bold"
                      Foreground="#B45309"
                      VerticalAlignment="Center" />
                  </Grid>
                </Border>
              </StackPanel>
            </Border>

            <!-- PHẦN 3: NÚT THAO TÁC LƯU / HỦY PHIẾU -->
            <StackPanel Spacing="8">
              <!-- NÚT LƯU PHIẾU NHẬP -->
              <Button Classes="btnPrimary"
                Command="{Binding HoanThanhPhieuNhapCommand}"
                IsEnabled="{Binding CanSavePhieuNhap}"
                IsVisible="{Binding CanCreatePurchase}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Padding="0,11"
                FontSize="14">
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                  <TextBlock Text="✔" FontSize="14" FontWeight="Bold" />
                  <TextBlock Text="Lưu phiếu nhập" />
                </StackPanel>
              </Button>

              <!-- NÚT LƯU VÀ IN -->
              <Button Classes="btnOutline"
                Command="{Binding LuuVaInPhieuNhapCommand}"
                IsEnabled="{Binding CanSavePhieuNhap}"
                IsVisible="{Binding CanCreatePurchase}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Padding="0,9"
                FontSize="13">
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                  <TextBlock Text="🖨" FontSize="13" />
                  <TextBlock Text="Lưu và in phiếu" />
                </StackPanel>
              </Button>

              <!-- NÚT HỦY BỎ -->
              <Button Classes="btnSubtle"
                Command="{Binding HuyPhieuNhapCommand}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Padding="0,8"
                FontSize="13">
                <TextBlock Text="Hủy bỏ" />
              </Button>
            </StackPanel>

          </StackPanel>
        </ScrollViewer>
      </Border>

    </Grid>
  </Grid>
</UserControl>

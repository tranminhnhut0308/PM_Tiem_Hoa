<UserControl xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:ShopHoa.ViewModels"
  xmlns:models="using:ShopHoa.Models"
  xmlns:controls="using:ShopHoa.Controls"
  x:Class="ShopHoa.Views.ThemPhieuNhapKhacView"
  x:Name="RootView"
  x:DataType="vm:MainWindowViewModel">

  <UserControl.Styles>
    <Style Selector="TextBox.formInput">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#CBD5E1" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="FontSize" Value="12.5" />
    </Style>

    <Style Selector="Button.btnPrimary">
      <Setter Property="Background" Value="#7E22CE" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.btnPrimary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#6B21A8" />
      <Setter Property="TextElement.Foreground" Value="White" />
    </Style>

    <Style Selector="Button.btnOutline">
      <Setter Property="Background" Value="#FAF5FF" />
      <Setter Property="Foreground" Value="#7E22CE" />
      <Setter Property="BorderBrush" Value="#E9D5FF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.btnOutline:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#F3E8FF" />
      <Setter Property="BorderBrush" Value="#D8B4FE" />
      <Setter Property="TextElement.Foreground" Value="#6B21A8" />
    </Style>

    <Style Selector="Button.btnSubtle">
      <Setter Property="Background" Value="#F1F5F9" />
      <Setter Property="Foreground" Value="#475569" />
      <Setter Property="BorderBrush" Value="#E2E8F0" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.btnSubtle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#E2E8F0" />
      <Setter Property="TextElement.Foreground" Value="#1E293B" />
    </Style>

    <Style Selector="Button.btnDanger">
      <Setter Property="Background" Value="#FEE2E2" />
      <Setter Property="Foreground" Value="#B91C1C" />
      <Setter Property="BorderBrush" Value="#FECACA" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.btnSuccess">
      <Setter Property="Background" Value="#059669" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.btnSuccess:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#047857" />
      <Setter Property="TextElement.Foreground" Value="White" />
    </Style>
  </UserControl.Styles>

  <!-- MÀN HÌNH: THÊM PHIẾU NHẬP KHÁC -->
  <Grid RowDefinitions="Auto,*" RowSpacing="14">

    <!-- ============================================================ -->
    <!-- HEADER BAR: Tiêu đề, Mã phiếu, Trạng thái, và Nút thao tác nhanh -->
    <!-- ============================================================ -->
    <Border Grid.Row="0"
      Background="White"
      BorderBrush="#E2E8F0"
      BorderThickness="1"
      CornerRadius="12"
      Padding="16,12"
      BoxShadow="0 1 3 #0A000000">
      <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">

        <!-- Nút Quay lại -->
        <Button Classes="btnSubtle"
          Command="{Binding DongFormThemPhieuNhapKhacCommand}"
          Margin="0,0,16,0"
          Padding="10,6"
          VerticalAlignment="Center"
          ToolTip.Tip="Quay lại danh sách phiếu nhập khác">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <TextBlock Text="←" FontWeight="Bold" FontSize="15" Foreground="#475569" />
            <TextBlock Text="Quay lại" FontSize="13" FontWeight="SemiBold" Foreground="#475569" />
          </StackPanel>
        </Button>

        <!-- Tiêu đề + Badges -->
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <TextBlock Text="Thêm phiếu nhập khác"
              FontSize="20"
              FontWeight="Bold"
              Foreground="#0F172A" />

            <!-- Badge Mã phiếu -->
            <Border Background="#F3E8FF"
              BorderBrush="#E9D5FF"
              BorderThickness="1"
              CornerRadius="6"
              Padding="8,2"
              VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="Mã:" FontSize="11.5" Foreground="#7E22CE" />
                <TextBlock Text="{Binding PhieuNhapKhacMa}"
                  Foreground="#6B21A8"
                  FontWeight="Bold"
                  FontSize="12" />
              </StackPanel>
            </Border>

            <!-- Badge Trạng thái -->
            <Border Background="#FEF3C7"
              BorderBrush="#FDE68A"
              BorderThickness="1"
              CornerRadius="6"
              Padding="8,2"
              VerticalAlignment="Center">
              <TextBlock Text="Chờ lưu"
                Foreground="#B45309"
                FontWeight="SemiBold"
                FontSize="11.5" />
            </Border>
          </StackPanel>
          <TextBlock Text="Lập phiếu nhập nội bộ, điều chỉnh kiểm kê, nhập khuyến mãi hoặc nhập thu hồi sự kiện"
            FontSize="12"
            Foreground="#64748B" />
        </StackPanel>

        <!-- Nút thao tác nhanh trên Header -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Button Classes="btnOutline"
            Command="{Binding LamMoiFormThemPhieuNhapKhacCommand}"
            Padding="12,7"
            ToolTip.Tip="Khởi tạo lại dữ liệu form">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <TextBlock Text="↻" FontSize="13" FontWeight="Bold" />
              <TextBlock Text="Làm mới" FontSize="12.5" FontWeight="SemiBold" />
            </StackPanel>
          </Button>

          <Button Classes="btnSuccess"
            Command="{Binding LuuPhieuNhapKhacCommand}"
            IsEnabled="{Binding !IsSavingPhieuNhapKhac}"
            Padding="16,8"
            ToolTip.Tip="Lưu phiếu nhập khác vào hệ thống">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <TextBlock Text="💾" FontSize="13" />
              <TextBlock Text="Lưu phiếu nhập khác" FontSize="13" FontWeight="Bold" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ============================================================ -->
    <!-- NỘI DUNG CHÍNH: 2 KHỐI (THÔNG TIN PHIẾU & CHỌN MẶT HÀNG)     -->
    <!-- ============================================================ -->
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="14" Margin="0,0,0,16">

        <!-- ========================================================== -->
        <!-- KHỐI 1: THÔNG TIN PHIẾU NHẬP KHÁC                          -->
        <!-- ========================================================== -->
        <Border Background="White"
          BorderBrush="#E2E8F0"
          BorderThickness="1"
          CornerRadius="12"
          Padding="18"
          BoxShadow="0 1 3 #0A000000">
          <StackPanel Spacing="14">
            <TextBlock Text="THÔNG TIN PHIẾU NHẬP KHÁC"
              FontSize="13.5"
              FontWeight="Bold"
              Foreground="#475569" />

            <!-- Hàng 1: Mã phiếu, Thời gian nhập, Kho nhận -->
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
              <!-- Mã phiếu -->
              <StackPanel Grid.Column="0" Spacing="6">
                <TextBlock Text="Mã phiếu nhập khác" FontSize="12" FontWeight="SemiBold" Foreground="#334155" />
                <TextBox Classes="formInput"
                  Text="{Binding PhieuNhapKhacMa}"
                  IsReadOnly="True"
                  Background="#F8FAFC"
                  Foreground="#64748B"
                  FontWeight="SemiBold" />
              </StackPanel>

              <!-- Thời gian nhập -->
              <StackPanel Grid.Column="1" Spacing="6">
                <TextBlock Text="Thời gian lập phiếu" FontSize="12" FontWeight="SemiBold" Foreground="#334155" />
                <TextBox Classes="formInput"
                  Text="{Binding PhieuNhapKhacNgayNhapText}"
                  IsReadOnly="True"
                  Background="#F8FAFC"
                  Foreground="#334155" />
              </StackPanel>

              <!-- Kho nhận -->
              <StackPanel Grid.Column="2" Spacing="6">
                <TextBlock Text="Kho nhận hàng *" FontSize="12" FontWeight="SemiBold" Foreground="#334155" />
                <TextBox Classes="formInput"
                  Text="{Binding PhieuNhapKhacKhoNhan, Mode=TwoWay}"
                  Foreground="#334155" />
              </StackPanel>
            </Grid>

            <!-- Hàng 2: Loại phiếu nhập khác & Thẻ giải thích nghiệp vụ -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
              <!-- Loại phiếu nhập khác -->
              <StackPanel Grid.Column="0" Spacing="6">
                <TextBlock Text="Loại phiếu nhập khác *" FontSize="12" FontWeight="SemiBold" Foreground="#334155" />
                <ComboBox ItemsSource="{Binding PhieuNhapKhacLoaiFormOptions}"
                  SelectedItem="{Binding SelectedPhieuNhapKhacLoaiFormHienThi, Mode=TwoWay}"
                  HorizontalAlignment="Stretch"
                  Height="38"
                  FontSize="12.5"
                  Background="White"
                  BorderBrush="#CBD5E1"
                  CornerRadius="6" />
              </StackPanel>

              <!-- Thẻ giải thích loại phiếu -->
              <StackPanel Grid.Column="1" Spacing="6">
                <TextBlock Text="Mục đích nghiệp vụ" FontSize="12" FontWeight="SemiBold" Foreground="#334155" />
                <Border Background="#F3E8FF"
                  BorderBrush="#E9D5FF"
                  BorderThickness="1"
                  CornerRadius="8"
                  Padding="12,9"
                  VerticalAlignment="Center">
                  <TextBlock Text="{Binding PhieuNhapKhacLoaiGiaiThich}"
                    FontSize="12"
                    FontWeight="Medium"
                    Foreground="#6B21A8"
                    TextWrapping="Wrap" />
                </Border>
              </StackPanel>
            </Grid>

            <!-- Hàng 3: Đối tượng / Bộ phận liên quan & Người lập phiếu -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
              <!-- Đối tượng liên quan -->
              <StackPanel Grid.Column="0" Spacing="6">
                <TextBlock Text="Đối tượng / Bộ phận liên quan" FontSize="12" FontWeight="SemiBold" Foreground="#334155" />
                <TextBox Classes="formInput"
                  Text="{Binding PhieuNhapKhacDoiTuong, Mode=TwoWay}"
                  Watermark="Ví dụ: Chi nhánh 2 - Cầu Giấy, Bộ phận kiểm kê, Đối tác Hasfarm..." />
              </StackPanel>

              <!-- Người lập phiếu -->
              <StackPanel Grid.Column="1" Spacing="6">
                <TextBlock Text="Nhân viên lập phiếu" FontSize="12" FontWeight="SemiBold" Foreground="#334155" />
                <TextBox Classes="formInput"
                  Text="{Binding PhieuNhapKhacNhanVien}"
                  IsReadOnly="True"
                  Background="#F8FAFC"
                  Foreground="#334155" />
              </StackPanel>
            </Grid>

            <!-- Hàng 4: Lý do nhập / Ghi chú chung -->
            <StackPanel Spacing="6">
              <TextBlock Text="Lý do nhập / Ghi chú chung" FontSize="12" FontWeight="SemiBold" Foreground="#334155" />
              <TextBox Classes="formInput"
                Text="{Binding PhieuNhapKhacGhiChu, Mode=TwoWay}"
                Watermark="Nhập chi tiết lý do lập phiếu nhập khác (hàng tặng kèm đại lý, thu hồi giỏ hoa sự kiện, cân đối kho sau kiểm kê...)" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- ========================================================== -->
        <!-- KHỐI 2: CHỌN HÀNG HÓA VÀ BẢNG CHI TIẾT MẶT HÀNG NHẬP        -->
        <!-- ========================================================== -->
        <Border Background="White"
          BorderBrush="#E2E8F0"
          BorderThickness="1"
          CornerRadius="12"
          Padding="18"
          BoxShadow="0 1 3 #0A000000">
          <StackPanel Spacing="14">

            <!-- Tiêu đề khối + Ô tìm kiếm hàng hóa -->
            <Grid ColumnDefinitions="*,340" ColumnSpacing="16" VerticalAlignment="Center">
              <StackPanel Spacing="2">
                <TextBlock Text="DANH SÁCH MẶT HÀNG NHẬP KHÁC"
                  FontSize="13.5"
                  FontWeight="Bold"
                  Foreground="#475569" />
                <TextBlock Text="Chọn hoa tươi, phụ kiện hoặc vật tư cần nhập vào kho"
                  FontSize="12"
                  Foreground="#64748B" />
              </StackPanel>

              <!-- Thanh tìm kiếm hoa & phụ kiện có gợi ý -->
              <Grid Grid.Column="1" RowDefinitions="Auto,Auto">
                <TextBox Classes="formInput"
                  Text="{Binding PhieuNhapKhacProductSearch, Mode=TwoWay}"
                  Watermark="🔍 Tìm kiếm hoa, bình gốm, phụ kiện...">
                  <TextBox.InnerRightContent>
                    <Button Classes="btnSubtle"
                      Command="{Binding TimKiemSanPhamChoNhapKhacCommand}"
                      CommandParameter="{Binding PhieuNhapKhacProductSearch}"
                      Margin="2"
                      Padding="6,4">
                      <TextBlock Text="🔍" FontSize="12" />
                    </Button>
                  </TextBox.InnerRightContent>
                </TextBox>

                <!-- Dropdown danh sách gợi ý sản phẩm -->
                <Border Grid.Row="1"
                  Background="White"
                  BorderBrush="#CBD5E1"
                  BorderThickness="1"
                  CornerRadius="8"
                  Margin="0,4,0,0"
                  MaxHeight="220"
                  ZIndex="999"
                  IsVisible="{Binding HasPhieuNhapKhacSuggestions}"
                  BoxShadow="0 4 8 #15000000">
                  <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding PhieuNhapKhacProductSuggestions}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="models:SanPham">
                          <Button HorizontalAlignment="Stretch"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="10,6"
                            Cursor="Hand"
                            Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).ChonSanPhamNhapKhacCommand}"
                            CommandParameter="{Binding}">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                              <TextBlock Text="{Binding MaSanPham}" FontWeight="Bold" Foreground="#7E22CE" FontSize="12" Margin="0,0,8,0" />
                              <TextBlock Grid.Column="1" Text="{Binding TenSanPham}" Foreground="#0F172A" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding DonViTinh}" Foreground="#64748B" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding TonKhoExcel, StringFormat='Tồn: {0:N0}'}" Foreground="#D97706" FontSize="11" VerticalAlignment="Center" />
                              </StackPanel>
                            </Grid>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </Border>
              </Grid>
            </Grid>

            <!-- ======================================================== -->
            <!-- BẢNG CHI TIẾT MẶT HÀNG NHẬP KHÁC                         -->
            <!-- ======================================================== -->
            <Border Background="White"
              BorderBrush="#E2E8F0"
              BorderThickness="1"
              CornerRadius="8"
              ClipToBounds="True">
              <Grid RowDefinitions="Auto,*">

                <!-- Header Bảng (10 Cột chuẩn) -->
                <Border Grid.Row="0"
                  Background="#F8FAFC"
                  BorderBrush="#E2E8F0"
                  BorderThickness="0,0,0,1"
                  Padding="16,10">
                  <Grid ColumnDefinitions="45,95,*,65,65,130,110,120,130,45">
                    <TextBlock Grid.Column="0" Text="STT" FontWeight="Bold" FontSize="12" Foreground="#475569" HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="Mã hàng" FontWeight="Bold" FontSize="12" Foreground="#475569" />
                    <TextBlock Grid.Column="2" Text="Tên hàng hóa" FontWeight="Bold" FontSize="12" Foreground="#475569" Margin="6,0,0,0" />
                    <TextBlock Grid.Column="3" Text="ĐVT" FontWeight="Bold" FontSize="12" Foreground="#475569" HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="4" Text="Tồn kho" FontWeight="Bold" FontSize="12" Foreground="#475569" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="5" Text="Số lượng nhập" FontWeight="Bold" FontSize="12" Foreground="#475569" HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="6" Text="Đơn giá" FontWeight="Bold" FontSize="12" Foreground="#475569" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="7" Text="Thành tiền" FontWeight="Bold" FontSize="12" Foreground="#475569" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="8" Text="Ghi chú dòng" FontWeight="Bold" FontSize="12" Foreground="#475569" Margin="8,0,0,0" />
                    <TextBlock Grid.Column="9" Text="Xóa" FontWeight="Bold" FontSize="12" Foreground="#475569" HorizontalAlignment="Center" />
                  </Grid>
                </Border>

                <!-- Dòng dữ liệu hoặc Trạng thái trống -->
                <Grid Grid.Row="1" MinHeight="180">
                  <!-- Trạng thái trống -->
                  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" IsVisible="{Binding IsPhieuNhapKhacEmpty}" Margin="20">
                    <TextBlock Text="📦" FontSize="36" HorizontalAlignment="Center" Foreground="#94A3B8" />
                    <TextBlock Text="Chưa có mặt hàng nào trong phiếu nhập khác." FontSize="14" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Center" />
                    <TextBlock Text="Hãy tìm kiếm hoa, bình gốm hoặc phụ kiện ở ô tìm kiếm trên để thêm vào phiếu." FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" />
                  </StackPanel>

                  <!-- Danh sách các dòng hàng -->
                  <ItemsControl ItemsSource="{Binding PhieuNhapKhacChiTietItems}" IsVisible="{Binding HasPhieuNhapKhacItems}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="models:ChiTietPhieuNhapKhac">
                        <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="16,8">
                          <Grid ColumnDefinitions="45,95,*,65,65,130,110,120,130,45" VerticalAlignment="Center">

                            <!-- 1. STT -->
                            <TextBlock Grid.Column="0" Text="{Binding SoThuTu}" FontWeight="SemiBold" FontSize="12" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center" />

                            <!-- 2. Mã hàng -->
                            <TextBlock Grid.Column="1" Text="{Binding MaSanPham}" FontWeight="Bold" FontSize="12" Foreground="#7E22CE" VerticalAlignment="Center" />

                            <!-- 3. Tên hàng -->
                            <TextBlock Grid.Column="2" Text="{Binding TenSanPham}" FontWeight="SemiBold" FontSize="13" Foreground="#0F172A" Margin="6,0,8,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />

                            <!-- 4. ĐVT -->
                            <TextBlock Grid.Column="3" Text="{Binding DonViTinh}" FontSize="12" Foreground="#475569" HorizontalAlignment="Center" VerticalAlignment="Center" />

                            <!-- 5. Tồn kho -->
                            <TextBlock Grid.Column="4" Text="{Binding TonKhoText}" FontSize="12" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />

                            <!-- 6. Số lượng nhập: Stepper -->
                            <Border Grid.Column="5"
                              Background="#F8FAFC"
                              BorderBrush="#CBD5E1"
                              BorderThickness="1"
                              CornerRadius="6"
                              Padding="2"
                              Margin="8,0"
                              VerticalAlignment="Center">
                              <Grid ColumnDefinitions="26,*,26">
                                <Button Grid.Column="0"
                                  Classes="btnSubtle"
                                  Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).GiamSoLuongNhapKhacCommand}"
                                  CommandParameter="{Binding}"
                                  Padding="0"
                                  Width="26"
                                  Height="26"
                                  HorizontalContentAlignment="Center"
                                  VerticalContentAlignment="Center">
                                  <TextBlock Text="-" FontSize="14" FontWeight="Bold" Foreground="#475569" />
                                </Button>

                                <NumericUpDown Grid.Column="1"
                                  Value="{Binding SoLuong, Mode=TwoWay}"
                                  Minimum="1"
                                  Maximum="999999"
                                  FormatString="N0"
                                  ShowButtonSpinner="False"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  HorizontalContentAlignment="Center"
                                  VerticalContentAlignment="Center"
                                  FontSize="13"
                                  FontWeight="Bold" />

                                <Button Grid.Column="2"
                                  Classes="btnSubtle"
                                  Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).TangSoLuongNhapKhacCommand}"
                                  CommandParameter="{Binding}"
                                  Padding="0"
                                  Width="26"
                                  Height="26"
                                  HorizontalContentAlignment="Center"
                                  VerticalContentAlignment="Center">
                                  <TextBlock Text="+" FontSize="14" FontWeight="Bold" Foreground="#475569" />
                                </Button>
                              </Grid>
                            </Border>

                            <!-- 7. Đơn giá nhập -->
                            <NumericUpDown Grid.Column="6"
                              Value="{Binding DonGia, Mode=TwoWay}"
                              Minimum="0"
                              Maximum="999999999"
                              FormatString="N0"
                              ShowButtonSpinner="False"
                              BorderThickness="1"
                              BorderBrush="#CBD5E1"
                              CornerRadius="6"
                              Background="White"
                              HorizontalContentAlignment="Right"
                              VerticalContentAlignment="Center"
                              FontSize="12"
                              Padding="6,4"
                              Margin="4,0" />

                            <!-- 8. Thành tiền -->
                            <TextBlock Grid.Column="7"
                              Text="{Binding ThanhTienText}"
                              FontWeight="Bold"
                              FontSize="13"
                              Foreground="#059669"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center" />

                            <!-- 9. Ghi chú dòng -->
                            <TextBox Grid.Column="8"
                              Classes="formInput"
                              Text="{Binding GhiChu, Mode=TwoWay}"
                              Watermark="Ghi chú dòng..."
                              FontSize="12"
                              Padding="6,4"
                              Margin="6,0" />

                            <!-- 10. Xóa dòng -->
                            <Button Grid.Column="9"
                              Classes="btnDanger"
                              Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).XoaDongPhieuNhapKhacCommand}"
                              CommandParameter="{Binding}"
                              Padding="6,4"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              ToolTip.Tip="Xóa dòng mặt hàng này">
                              <TextBlock Text="✕" FontSize="11" FontWeight="Bold" />
                            </Button>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Grid>
              </Grid>
            </Border>

            <!-- ======================================================== -->
            <!-- THANH TỔNG KẾT & LƯU PHIẾU Ở CUỐI FORM                    -->
            <!-- ======================================================== -->
            <Border Background="#F8FAFC"
              BorderBrush="#E2E8F0"
              BorderThickness="1"
              CornerRadius="10"
              Padding="16,12">
              <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">

                <!-- Nút xóa tất cả -->
                <Button Grid.Column="0"
                  Classes="btnSubtle"
                  Command="{Binding XoaTatCaDongPhieuNhapKhacCommand}"
                  IsEnabled="{Binding HasPhieuNhapKhacItems}"
                  Padding="10,6"
                  ToolTip.Tip="Xóa toàn bộ các mặt hàng đang chọn">
                  <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="🗑" FontSize="13" Foreground="#B91C1C" />
                    <TextBlock Text="Xóa tất cả" FontSize="12.5" Foreground="#B91C1C" FontWeight="SemiBold" />
                  </StackPanel>
                </Button>

                <!-- Các thẻ tóm tắt tổng số -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <!-- Tổng số dòng mặt hàng -->
                  <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="Số mặt hàng:" FontSize="13" Foreground="#64748B" />
                    <TextBlock Text="{Binding PhieuNhapKhacTongDongText}" FontWeight="Bold" FontSize="14" Foreground="#0F172A" />
                  </StackPanel>

                  <!-- Tổng số lượng nhập -->
                  <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="Tổng SL nhập:" FontSize="13" Foreground="#64748B" />
                    <TextBlock Text="{Binding PhieuNhapKhacTongSoLuongText}" FontWeight="Bold" FontSize="14" Foreground="#0284C7" />
                  </StackPanel>

                  <!-- Tổng giá trị nhập khác -->
                  <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="Tổng giá trị:" FontSize="13" Foreground="#64748B" />
                    <TextBlock Text="{Binding PhieuNhapKhacTongGiaTriText}" FontWeight="Bold" FontSize="17" Foreground="#059669" />
                  </StackPanel>
                </StackPanel>

                <!-- Nút thao tác chính -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                  <Button Classes="btnSubtle"
                    Command="{Binding DongFormThemPhieuNhapKhacCommand}"
                    Content="✕ Hủy bỏ"
                    Padding="14,8"
                    FontSize="12.5"
                    FontWeight="SemiBold" />

                  <Button Classes="btnSuccess"
                    Command="{Binding LuuPhieuNhapKhacCommand}"
                    IsEnabled="{Binding !IsSavingPhieuNhapKhac}"
                    Padding="18,8">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                      <TextBlock Text="💾" FontSize="13" />
                      <TextBlock Text="Lưu phiếu nhập khác" FontSize="13" FontWeight="Bold" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Grid>
            </Border>

          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>

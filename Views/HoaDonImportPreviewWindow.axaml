<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:ShopHoa.Models"
        x:Class="ShopHoa.Views.HoaDonImportPreviewWindow"
        Width="1120"
        SizeToContent="Height"
        MinHeight="620"
        MaxHeight="820"
        Title="Xem trước trước khi nhập hóa đơn"
        WindowStartupLocation="CenterOwner"
        Background="#F5F8F7"
        CanResize="True">
  <Window.Styles>
    <Style Selector="Button">
      <Setter Property="Padding" Value="18,10"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#087F6E"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#087F6E"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style Selector="Button.primary:pointerover">
      <Setter Property="Background" Value="#056B5D"/>
    </Style>

    <Style Selector="Button.secondary">
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="Foreground" Value="#263B35"/>
      <Setter Property="BorderBrush" Value="#C9DCD6"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style Selector="Button.secondary:pointerover">
      <Setter Property="Background" Value="#E8F5F1"/>
      <Setter Property="BorderBrush" Value="#8CCFC0"/>
    </Style>

    <Style Selector="Button.warn">
      <Setter Property="Background" Value="#B4690E"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#B4690E"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style Selector="Button.warn:pointerover">
      <Setter Property="Background" Value="#9A5A0B"/>
    </Style>

    <Style Selector="Button.radio">
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#C9DCD6"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="#263B35"/>
    </Style>

    <Style Selector="Button.radio:pointerover">
      <Setter Property="Background" Value="#F2FAF7"/>
    </Style>

    <Style Selector="Button.radio:checked">
      <Setter Property="Background" Value="#E3F5F0"/>
      <Setter Property="BorderBrush" Value="#087F6E"/>
      <Setter Property="Foreground" Value="#163F38"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style Selector="TextBlock.headerCell">
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="#163F38"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="TextBlock.cell">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="#263B35"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="TextBlock.cellCu">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="#8A8A8A"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="TextBlock.soLi">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="#A32020"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
  </Window.Styles>

  <Border Margin="16"
          Background="#FFFFFF"
          BorderBrush="#D7E7E2"
          BorderThickness="1"
          CornerRadius="14">
    <DockPanel Margin="24">

      <!-- ======== NÚT XUỐNG ======== -->
      <StackPanel DockPanel.Dock="Bottom"
                  Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Spacing="10"
                  Margin="0,16,0,0">
        <Button Classes="secondary"
                Content="Hủy"
                Click="HuyButton_OnClick"/>
        <Button x:Name="BoQuaButton"
                Classes="warn"
                Content="Nhập, bỏ qua hóa đơn trùng"
                Click="BoQuaButton_OnClick"/>
        <Button x:Name="CapNhatButton"
                Classes="primary"
                Content="Nhập, cập nhật hóa đơn trùng"
                Click="CapNhatButton_OnClick"/>
      </StackPanel>

      <StackPanel DockPanel.Dock="Bottom"
                  Margin="0,14,0,0"
                  Spacing="8">
        <CheckBox x:Name="TaoKhachHangMoiCheckBox"
                  FontSize="13"
                  Foreground="#263B35"
                  Content="Tạo khách hàng mới cho các mã khách hàng chưa có trong hệ thống" />
        <TextBlock x:Name="TaoKhachHangMoiGhiChuTextBlock"
                   FontSize="12"
                   Foreground="#61736E"
                   TextWrapping="Wrap" />
      </StackPanel>

      <!-- ======== TIÊU ĐỀ + TÓM TẮT ======== -->
      <StackPanel DockPanel.Dock="Top" Spacing="10">
        <TextBlock Text="Xem trước dữ liệu hóa đơn"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="#163F38"/>

        <TextBlock x:Name="TieudeFileTextBlock"
                   TextWrapping="Wrap"
                   FontSize="13"
                   Foreground="#5A7B72"/>

        <Border Background="#F0F8F5"
                BorderBrush="#CFE3DD"
                BorderThickness="1"
                CornerRadius="10"
                Padding="16,14">
          <TextBlock x:Name="TomTatTextBlock"
                     FontSize="14"
                     Foreground="#163F38"
                     LineHeight="22"/>
        </Border>
      </StackPanel>

      <!-- ======== CẢNH BÁO ======== -->
      <Border x:Name="CanhBaoBorder"
              DockPanel.Dock="Top"
              Margin="0,12,0,0"
              Background="#FFF7E8"
              BorderBrush="#F0D9AE"
              BorderThickness="1"
              CornerRadius="8"
              Padding="12,10"
              IsVisible="False">
        <StackPanel Spacing="6">
          <TextBlock Text="Cảnh báo"
                     FontWeight="Bold"
                     FontSize="13"
                     Foreground="#7A5210"/>
          <ItemsControl x:Name="CanhBaoItems">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}"
                           TextWrapping="Wrap"
                           FontSize="12"
                           Foreground="#7A5210"
                           Margin="0,2"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- ======== LỖI ======== -->
      <Border x:Name="LoiBorder"
              DockPanel.Dock="Top"
              Margin="0,12,0,0"
              Background="#FEF2F2"
              BorderBrush="#F3C6C6"
              BorderThickness="1"
              CornerRadius="8"
              Padding="12,10"
              IsVisible="False">
        <DockPanel>
          <TextBlock x:Name="LoiTieudeTextBlock"
                     DockPanel.Dock="Top"
                     FontWeight="Bold"
                     FontSize="13"
                     Foreground="#A32020"
                     Margin="0,0,0,8"/>

          <ScrollViewer MaxHeight="130" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="LoiItems" x:DataType="models:HoaDonImportError">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:HoaDonImportError">
                  <Grid ColumnDefinitions="80,150,*" Margin="0,2">
                    <TextBlock Grid.Column="0"
                               Classes="soLi"
                               Text="{Binding SoDongExcel}" />
                    <TextBlock Grid.Column="1"
                               Classes="soLi"
                               Text="{Binding MaHoaDon}"
                               Margin="6,0" />
                    <TextBlock Grid.Column="2"
                               Classes="soLi"
                               Text="{Binding LyDo}"
                               TextWrapping="Wrap" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- ======== DANH SÁCH HÓA ĐƠN ĐỌC ĐƯỢC ======== -->
      <Grid Margin="0,14,0,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#EAF4F1"
                CornerRadius="8"
                Padding="10,10">
          <Grid ColumnDefinitions="60,170,150,180,140,140,120,120">
            <TextBlock Grid.Column="0" Classes="headerCell" Text="Dòng" />
            <TextBlock Grid.Column="1" Classes="headerCell" Text="Mã hóa đơn" />
            <TextBlock Grid.Column="2" Classes="headerCell" Text="Thời gian" />
            <TextBlock Grid.Column="3" Classes="headerCell" Text="Khách hàng" />
            <TextBlock Grid.Column="4" Classes="headerCell" Text="Tổng tiền" />
            <TextBlock Grid.Column="5" Classes="headerCell" Text="Còn nợ" />
            <TextBlock Grid.Column="6" Classes="headerCell" Text="Số dòng hàng" />
            <TextBlock Grid.Column="7" Classes="headerCell" Text="Trạng thái" />
          </Grid>
        </Border>

        <Border Grid.Row="1"
                BorderBrush="#D7E7E2"
                BorderThickness="1"
                CornerRadius="8"
                ClipToBounds="True">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="HoaDonItems" x:DataType="models:HoaDonImportRow">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:HoaDonImportRow">
                  <Border BorderBrush="#EEF3F1" BorderThickness="0,0,0,1" Padding="10,8">
                    <Grid ColumnDefinitions="60,170,150,180,140,140,120,120">
                      <TextBlock Grid.Column="0"
                                 Classes="cellCu"
                                 Text="{Binding SoDongExcel}" />
                      <TextBlock Grid.Column="1"
                                 Classes="cell"
                                 FontWeight="SemiBold"
                                 Text="{Binding MaHoaDon}" />
                      <TextBlock Grid.Column="2"
                                 Classes="cellCu"
                                 Text="{Binding ThoiGianBan, StringFormat={}{0:dd/MM/yyyy HH:mm}}" />
                      <TextBlock Grid.Column="3"
                                 Classes="cell"
                                 Text="{Binding TenKhachHangHienThi}"
                                 TextWrapping="Wrap" />
                      <TextBlock Grid.Column="4"
                                 Classes="cell"
                                 HorizontalAlignment="Right"
                                 Text="{Binding KhachCanTra, StringFormat={}{0:N0} đ}" />
                      <TextBlock Grid.Column="5"
                                 Classes="cell"
                                 HorizontalAlignment="Right"
                                 Text="{Binding ConNoChuan, StringFormat={}{0:N0} đ}" />
                      <TextBlock Grid.Column="6"
                                 Classes="cellCu"
                                 Text="{Binding ChiTiet.Count}" />
                      <TextBlock Grid.Column="7"
                                 Classes="cellCu"
                                 Text="{Binding TrangThaiKhachHangHienThi}"
                                 TextWrapping="Wrap" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>
      </Grid>
    </DockPanel>
  </Border>
</Window>

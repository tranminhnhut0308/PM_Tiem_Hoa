<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:ShopHoa.Models"
        x:Class="ShopHoa.Views.DanhSachKhuyenMaiWindow"
        Width="1260"
        Height="780"
        MinWidth="1050"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        Title="Danh mục chương trình khuyến mãi - WINWON"
        Background="#F4F7F6"
        RequestedThemeVariant="Light">

    <Window.Styles>
        <!-- TextBox Style -->
        <Style Selector="TextBox.searchInput">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style Selector="TextBox.searchInput:focus">
            <Setter Property="BorderBrush" Value="#0B4B82"/>
            <Setter Property="BorderThickness" Value="1.5"/>
        </Style>

        <!-- ComboBox Filter -->
        <Style Selector="ComboBox.filterCombo">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- CalendarDatePicker -->
        <Style Selector="CalendarDatePicker.datePicker">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Button Primary (Thêm) -->
        <Style Selector="Button.btnPrimary">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="#0B4B82"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.btnPrimary:pointerover">
            <Setter Property="Background" Value="#083863"/>
        </Style>

        <!-- Button Action / Default -->
        <Style Selector="Button.btnAction">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.btnAction:pointerover">
            <Setter Property="Background" Value="#F1F5F9"/>
        </Style>

        <!-- DataGrid Row Action Button -->
        <Style Selector="Button.rowBtn">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <!-- Paging Navigation Button -->
        <Style Selector="Button.pageBtn">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="34"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.pageBtn:pointerover">
            <Setter Property="Background" Value="#EFF6FF"/>
            <Setter Property="BorderBrush" Value="#93C5FD"/>
            <Setter Property="Foreground" Value="#1D4ED8"/>
        </Style>
        <Style Selector="Button.pageBtn:disabled">
            <Setter Property="Opacity" Value="0.4"/>
            <Setter Property="Cursor" Value="Arrow"/>
        </Style>

        <!-- DataGrid Styles -->
        <Style Selector="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#F1F5F9"/>
            <Setter Property="RowHeight" Value="48"/>
        </Style>
        <Style Selector="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="12,12"/>
            <Setter Property="SeparatorBrush" Value="#E2E8F0"/>
        </Style>
        <Style Selector="DataGridRow:pointerover">
            <Setter Property="Background" Value="#F8FAFC"/>
        </Style>
        <Style Selector="DataGridRow:selected">
            <Setter Property="Background" Value="#EFF6FF"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="18,14,18,14" RowSpacing="12">

        <!-- 1. HEADER & BREADCRUMB & STATS CARDS -->
        <Border Grid.Row="0" Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="18,14">
            <Grid ColumnDefinitions="*,Auto">
                <!-- Tiêu đề & Breadcrumb -->
                <StackPanel Spacing="4" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Danh mục" Foreground="#64748B" FontSize="12" />
                        <TextBlock Text="›" Foreground="#94A3B8" FontSize="12" />
                        <TextBlock Text="Khuyến mãi" Foreground="#0B4B82" FontWeight="SemiBold" FontSize="12" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,2,0,0">
                        <Border Width="38" Height="38" CornerRadius="10" Background="#EFF6FF" VerticalAlignment="Center">
                            <TextBlock Text="🎁" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Danh sách chương trình khuyến mãi" FontSize="19" FontWeight="Bold" Foreground="#0F172A"/>
                                <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="12" Padding="8,2" VerticalAlignment="Center">
                                    <TextBlock Name="TongSoTopText" Text="0 chương trình" FontSize="11.5" FontWeight="Bold" Foreground="#1D4ED8"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Quản lý chính sách ưu đãi, giảm giá và quà tặng khách hàng" FontSize="12.5" Foreground="#64748B"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Status Summary Cards & Actions -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <!-- Thẻ Đang diễn ra -->
                    <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="8" Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="🟢" FontSize="11" VerticalAlignment="Center"/>
                            <StackPanel Spacing="1" VerticalAlignment="Center">
                                <TextBlock Text="Đang diễn ra" FontSize="11" Foreground="#15803D" FontWeight="Medium"/>
                                <TextBlock Name="DangDienRaCountText" Text="0" FontSize="14" FontWeight="Bold" Foreground="#166534"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Thẻ Sắp áp dụng -->
                    <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="🔵" FontSize="11" VerticalAlignment="Center"/>
                            <StackPanel Spacing="1" VerticalAlignment="Center">
                                <TextBlock Text="Sắp áp dụng" FontSize="11" Foreground="#1D4ED8" FontWeight="Medium"/>
                                <TextBlock Name="SapApDungCountText" Text="0" FontSize="14" FontWeight="Bold" Foreground="#1E40AF"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Thẻ Đã kết thúc / Tạm ngưng -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="⚪" FontSize="11" VerticalAlignment="Center"/>
                            <StackPanel Spacing="1" VerticalAlignment="Center">
                                <TextBlock Text="Kết thúc / Ngưng" FontSize="11" Foreground="#64748B" FontWeight="Medium"/>
                                <TextBlock Name="KetThucNgungCountText" Text="0" FontSize="14" FontWeight="Bold" Foreground="#334155"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Nút Làm mới -->
                    <Button Classes="btnAction" Click="LamMoiButton_OnClick" ToolTip.Tip="Tải lại danh sách">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="🔄" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Text="Làm mới" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Nút Thêm chương trình -->
                    <Button Name="ThemButton" Classes="btnPrimary" Click="ThemButton_OnClick" ToolTip.Tip="Thêm chương trình khuyến mãi mới">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="➕" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Text="Thêm chương trình" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. SEARCH & FILTER TOOLBAR -->
        <Border Grid.Row="1" Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14,12">
            <Grid ColumnDefinitions="320,190,160,160,Auto,*,Auto" ColumnSpacing="10">
                <!-- Tìm kiếm theo mã hoặc tên -->
                <TextBox Grid.Column="0" Name="SearchTextBox" Classes="searchInput"
                         Watermark="🔍 Tìm theo mã hoặc tên chương trình..."
                         TextChanged="SearchTextBox_OnTextChanged"/>

                <!-- Lọc theo trạng thái -->
                <ComboBox Grid.Column="1" Name="TrangThaiComboBox" Classes="filterCombo"
                          HorizontalAlignment="Stretch" SelectionChanged="FilterComboBox_OnSelectionChanged">
                    <ComboBoxItem Tag="TAT_CA" IsSelected="True">-- Tất cả trạng thái --</ComboBoxItem>
                    <ComboBoxItem Tag="DANG_HOAT_DONG">🟢 Đang diễn ra</ComboBoxItem>
                    <ComboBoxItem Tag="CHUA_BAT_DAU">🔵 Chưa bắt đầu</ComboBoxItem>
                    <ComboBoxItem Tag="TAM_NGUNG">🟡 Tạm ngưng</ComboBoxItem>
                    <ComboBoxItem Tag="DA_KET_THUC">⚪ Đã kết thúc</ComboBoxItem>
                </ComboBox>

                <!-- Từ ngày -->
                <CalendarDatePicker Grid.Column="2" Name="TuNgayPicker" Classes="datePicker"
                                    HorizontalAlignment="Stretch" SelectedDateFormat="Short"
                                    Watermark="Từ ngày áp dụng"
                                    SelectedDateChanged="DateFilter_OnDateChanged"/>

                <!-- Đến ngày -->
                <CalendarDatePicker Grid.Column="3" Name="DenNgayPicker" Classes="datePicker"
                                    HorizontalAlignment="Stretch" SelectedDateFormat="Short"
                                    Watermark="Đến ngày áp dụng"
                                    SelectedDateChanged="DateFilter_OnDateChanged"/>

                <!-- Nút Xóa bộ lọc -->
                <Button Grid.Column="4" Classes="btnAction" Click="XoaBoLocButton_OnClick" ToolTip.Tip="Đặt lại toàn bộ bộ lọc">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="✕" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Text="Xóa bộ lọc" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Info summary -->
                <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="Kết quả lọc:" FontSize="12.5" Foreground="#64748B" VerticalAlignment="Center"/>
                    <TextBlock Name="KetQuaLocText" Text="0" FontSize="13" FontWeight="Bold" Foreground="#0B4B82" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. MAIN DATA GRID & STATES -->
        <Border Grid.Row="2" Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" ClipToBounds="True">
            <Grid>
                <!-- DataGrid -->
                <DataGrid Name="DanhSachGrid"
                          x:DataType="models:ChuongTrinhKhuyenMai"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserResizeColumns="True"
                          CanUserReorderColumns="False"
                          CanUserSortColumns="True"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <!-- STT -->
                        <DataGridTextColumn Header="STT" Binding="{Binding Stt}" Width="60"/>

                        <!-- MÃ CHƯƠNG TRÌNH -->
                        <DataGridTemplateColumn Header="MÃ CHƯƠNG TRÌNH" Width="150" SortMemberPath="MaChuongTrinh">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:ChuongTrinhKhuyenMai">
                                    <TextBlock Text="{Binding MaChuongTrinh}" FontWeight="SemiBold"
                                               Foreground="#0B4B82" VerticalAlignment="Center" Margin="12,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- TÊN CHƯƠNG TRÌNH -->
                        <DataGridTemplateColumn Header="TÊN CHƯƠNG TRÌNH" Width="2*" SortMemberPath="TenChuongTrinh">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:ChuongTrinhKhuyenMai">
                                    <StackPanel VerticalAlignment="Center" Margin="12,0" Spacing="2">
                                        <TextBlock Text="{Binding TenChuongTrinh}" FontWeight="Medium" Foreground="#0F172A"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding GhiChu}" FontSize="11.5" Foreground="#94A3B8"
                                                   TextTrimming="CharacterEllipsis" IsVisible="{Binding GhiChu, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- HÌNH THỨC -->
                        <DataGridTemplateColumn Header="HÌNH THỨC" Width="135">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:ChuongTrinhKhuyenMai">
                                    <TextBlock Text="{Binding LoaiKhuyenMaiHienThi}" Foreground="#475569"
                                               VerticalAlignment="Center" Margin="12,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- ƯU ĐÃI / GIÁ TRỊ -->
                        <DataGridTemplateColumn Header="ƯU ĐÃI / GIÁ TRỊ" Width="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:ChuongTrinhKhuyenMai">
                                    <Border Background="#F0FDF4" BorderBrush="#DCFCE7" BorderThickness="1"
                                            CornerRadius="6" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0">
                                        <TextBlock Text="{Binding UuDaiHienThi}" Foreground="#15803D"
                                                   FontWeight="SemiBold" FontSize="12.5"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- THỜI GIAN ÁP DỤNG -->
                        <DataGridTemplateColumn Header="THỜI GIAN ÁP DỤNG" Width="185">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:ChuongTrinhKhuyenMai">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="12,0">
                                        <TextBlock Text="📅" FontSize="11" VerticalAlignment="Center" Foreground="#64748B"/>
                                        <TextBlock Text="{Binding ThoiGianHienThi}" Foreground="#334155" FontSize="12.5" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- ĐỐI TƯỢNG ÁP DỤNG -->
                        <DataGridTemplateColumn Header="ĐỐI TƯỢNG" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:ChuongTrinhKhuyenMai">
                                    <TextBlock Text="{Binding DoiTuongHienThi}" Foreground="#64748B"
                                               VerticalAlignment="Center" Margin="12,0" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- TRẠNG THÁI (BADGE ĐẸP) -->
                        <DataGridTemplateColumn Header="TRẠNG THÁI" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:ChuongTrinhKhuyenMai">
                                    <Border Background="{Binding TrangThaiBadgeBrush}"
                                            BorderBrush="{Binding TrangThaiBadgeBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="10,3"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TrangThaiHienThi}"
                                                   Foreground="{Binding TrangThaiBadgeFgBrush}"
                                                   FontSize="11.5"
                                                   FontWeight="SemiBold"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- THAO TÁC -->
                        <DataGridTemplateColumn Header="THAO TÁC" Width="145">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:ChuongTrinhKhuyenMai">
                                    <StackPanel Orientation="Horizontal" Spacing="6"
                                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Button Classes="rowBtn" Background="#EFF6FF" Foreground="#1D4ED8"
                                                BorderBrush="#BFDBFE" BorderThickness="1"
                                                Content="✏ Sửa" Click="SuaRow_OnClick" Tag="{Binding}"
                                                ToolTip.Tip="Xem và chỉnh sửa chương trình"/>
                                        <Button Classes="rowBtn" Background="#FEF2F2" Foreground="#DC2626"
                                                BorderBrush="#FECACA" BorderThickness="1"
                                                Content="🗑 Xóa" Click="XoaRow_OnClick" Tag="{Binding}"
                                                IsEnabled="{Binding CanDelete}"
                                                ToolTip.Tip="Xóa chương trình khuyến mãi"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Trạng thái trống (Empty state) -->
                <Border Name="EmptyStateBorder" Background="White" IsVisible="False" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                        <Border Width="64" Height="64" CornerRadius="32" Background="#F1F5F9" HorizontalAlignment="Center">
                            <TextBlock Text="🎁" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Không tìm thấy chương trình khuyến mãi nào" FontSize="15" FontWeight="Bold" Foreground="#334155" HorizontalAlignment="Center"/>
                        <TextBlock Text="Thử tìm kiếm với từ khóa khác hoặc bấm nút 'Thêm chương trình' để tạo chương trình mới."
                                   FontSize="12.5" Foreground="#64748B" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="420"/>
                        <Button Classes="btnPrimary" HorizontalAlignment="Center" Margin="0,6,0,0"
                                Click="ThemButton_OnClick" Content="➕  Thêm chương trình mới"/>
                    </StackPanel>
                </Border>

                <!-- Trạng thái đang tải (Loading state) -->
                <Border Name="LoadingBorder" Background="#99FFFFFF" IsVisible="False" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                        <TextBlock Text="⏳" FontSize="26" HorizontalAlignment="Center"/>
                        <TextBlock Text="Đang tải danh sách chương trình khuyến mãi..." FontSize="13" FontWeight="SemiBold" Foreground="#0B4B82"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 4. PAGING TOOLBAR & FOOTER -->
        <Border Grid.Row="3" Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14,10">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <!-- Page size selection -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="Hiển thị:" FontSize="12.5" Foreground="#64748B" VerticalAlignment="Center"/>
                    <ComboBox Name="PageSizeComboBox" Classes="filterCombo" Height="32" Width="130"
                              SelectionChanged="PageSizeComboBox_OnSelectionChanged">
                        <ComboBoxItem Tag="15" IsSelected="True">15 dòng/trang</ComboBoxItem>
                        <ComboBoxItem Tag="25">25 dòng/trang</ComboBoxItem>
                        <ComboBoxItem Tag="50">50 dòng/trang</ComboBoxItem>
                    </ComboBox>
                </StackPanel>

                <!-- Navigation Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Name="FirstPageButton" Classes="pageBtn" Content="⏮" Click="FirstPageButton_OnClick" ToolTip.Tip="Trang đầu"/>
                    <Button Name="PrevPageButton" Classes="pageBtn" Content="◀" Click="PrevPageButton_OnClick" ToolTip.Tip="Trang trước"/>

                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                        <TextBlock Name="PagingInfoText" Text="Trang 1 / 1 (Tổng 0)" FontSize="12.5" FontWeight="SemiBold" Foreground="#1E293B"/>
                    </Border>

                    <Button Name="NextPageButton" Classes="pageBtn" Content="▶" Click="NextPageButton_OnClick" ToolTip.Tip="Trang sau"/>
                    <Button Name="LastPageButton" Classes="pageBtn" Content="⏭" Click="LastPageButton_OnClick" ToolTip.Tip="Trang cuối"/>
                </StackPanel>

                <!-- Close button -->
                <Button Grid.Column="3" Classes="btnAction" Margin="14,0,0,0" Height="34" Click="CloseButton_OnClick" Content="Đóng" ToolTip.Tip="Đóng cửa sổ"/>
            </Grid>
        </Border>

    </Grid>
</Window>

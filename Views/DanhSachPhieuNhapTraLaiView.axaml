<UserControl xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:ShopHoa.ViewModels"
  xmlns:models="using:ShopHoa.Models"
  x:Class="ShopHoa.Views.DanhSachPhieuNhapTraLaiView"
  x:Name="RootView"
  x:DataType="vm:MainWindowViewModel">

  <UserControl.Styles>
    <Style Selector="TextBox.filterInput">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#CBD5E1" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="FontSize" Value="12.5" />
    </Style>

    <Style Selector="Button.btnPrimary">
      <Setter Property="Background" Value="#1976D2" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.btnPrimary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#1565C0" />
      <Setter Property="TextElement.Foreground" Value="White" />
    </Style>

    <Style Selector="Button.btnOutline">
      <Setter Property="Background" Value="#EFF6FF" />
      <Setter Property="Foreground" Value="#1D4ED8" />
      <Setter Property="BorderBrush" Value="#BFDBFE" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.btnOutline:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#DBEAFE" />
      <Setter Property="BorderBrush" Value="#93C5FD" />
      <Setter Property="TextElement.Foreground" Value="#1E40AF" />
    </Style>

    <Style Selector="Button.btnSubtle">
      <Setter Property="Background" Value="#F1F5F9" />
      <Setter Property="Foreground" Value="#475569" />
      <Setter Property="BorderBrush" Value="#E2E8F0" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.btnSubtle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#E2E8F0" />
      <Setter Property="TextElement.Foreground" Value="#1E293B" />
    </Style>

    <Style Selector="Button.btnTableAction">
      <Setter Property="Background" Value="#F8FAFC" />
      <Setter Property="Foreground" Value="#334155" />
      <Setter Property="BorderBrush" Value="#CBD5E1" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.btnTableAction:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#EFF6FF" />
      <Setter Property="BorderBrush" Value="#93C5FD" />
      <Setter Property="TextElement.Foreground" Value="#1D4ED8" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="12" Margin="0">

    <!-- ============================================================ -->
    <!-- SECTION A: HEADER & CÁC NÚT THAO TÁC                         -->
    <!-- ============================================================ -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="16" VerticalAlignment="Center">
      <StackPanel Spacing="3">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Border Background="#EFF6FF" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
            <TextBlock Text="↩ NHẬP TRẢ LẠI" FontSize="11" FontWeight="Bold" Foreground="#1D4ED8" />
          </Border>
          <TextBlock Text="Danh sách phiếu nhập trả lại" FontSize="20" FontWeight="Bold" Foreground="#0F172A" />
        </StackPanel>
        <TextBlock Text="Theo dõi và quản lý hàng hóa khách hàng trả lại, hoàn tiền và nhập lại tồn kho"
                   FontSize="12.5" Foreground="#64748B" />
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button Classes="btnPrimary"
                Content="＋ Tạo phiếu trả lại"
                Height="36"
                Padding="14,0"
                Command="{Binding TaoPhieuTraHangMoiCommand}" />

        <Button Classes="btnOutline"
                Content="↻ Làm mới"
                Height="36"
                Padding="12,0"
                Command="{Binding LamMoiDsPhieuTraCommand}" />

        <Button Classes="btnSubtle"
                Content="📤 Xuất Excel"
                Height="36"
                Padding="12,0"
                Command="{Binding XuatExcelDsPhieuTraCommand}" />
      </StackPanel>
    </Grid>

    <!-- ============================================================ -->
    <!-- SECTION B: THỐNG KÊ TỔNG QUAN (3 THẺ TỔNG HỢP)                -->
    <!-- ============================================================ -->
    <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="12">
      <!-- Thẻ 1: Tổng số phiếu trả -->
      <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1"
              CornerRadius="12" Padding="14,12" BoxShadow="0 1 3 #0A000000">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalAlignment="Center">
          <Border Width="42" Height="42" CornerRadius="10" Background="#EFF6FF" VerticalAlignment="Center">
            <TextBlock Text="↩" FontSize="20" Foreground="#1D4ED8" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
            <TextBlock Text="Tổng phiếu trả lại" FontSize="12" Foreground="#64748B" FontWeight="Medium" />
            <TextBlock Text="{Binding ThongKeTongPhieuTraText}" FontSize="18" FontWeight="Bold" Foreground="#0F172A" />
            <TextBlock Text="Số lượt khách hoàn trả hàng" FontSize="11" Foreground="#94A3B8" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- Thẻ 2: Tổng tiền hoàn trả -->
      <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1"
              CornerRadius="12" Padding="14,12" BoxShadow="0 1 3 #0A000000">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalAlignment="Center">
          <Border Width="42" Height="42" CornerRadius="10" Background="#FEF2F2" VerticalAlignment="Center">
            <TextBlock Text="💰" FontSize="20" Foreground="#DC2626" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
            <TextBlock Text="Tổng tiền hoàn trả" FontSize="12" Foreground="#64748B" FontWeight="Medium" />
            <TextBlock Text="{Binding ThongKeTongTienTraText}" FontSize="18" FontWeight="Bold" Foreground="#DC2626" />
            <TextBlock Text="Tiền đã chi trả lại cho khách" FontSize="11" Foreground="#94A3B8" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- Thẻ 3: Tổng sản phẩm trả lại -->
      <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1"
              CornerRadius="12" Padding="14,12" BoxShadow="0 1 3 #0A000000">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalAlignment="Center">
          <Border Width="42" Height="42" CornerRadius="10" Background="#F0FDF4" VerticalAlignment="Center">
            <TextBlock Text="📦" FontSize="20" Foreground="#15803D" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
            <TextBlock Text="Tổng sản phẩm trả lại" FontSize="12" Foreground="#64748B" FontWeight="Medium" />
            <TextBlock Text="{Binding ThongKeTongSoLuongTraText}" FontSize="18" FontWeight="Bold" Foreground="#15803D" />
            <TextBlock Text="Số lượng hoa &amp; phụ kiện nhập lại" FontSize="11" Foreground="#94A3B8" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <!-- ============================================================ -->
    <!-- SECTION C: THANH TÌM KIẾM & BỘ LỌC                            -->
    <!-- ============================================================ -->
    <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1"
            CornerRadius="10" Padding="12" BoxShadow="0 1 2 #05000000">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10" VerticalAlignment="Center">

        <!-- Ô tìm kiếm từ khóa -->
        <TextBox Grid.Column="0"
                 Classes="filterInput"
                 Watermark="🔍 Tìm theo mã phiếu trả, tên khách hàng, số điện thoại, mã hóa đơn gốc..."
                 Text="{Binding DsPhieuTraSearch, Mode=TwoWay}"
                 Height="36" />

        <!-- ComboBox lọc trạng thái -->
        <ComboBox Grid.Column="1"
                  ItemsSource="{Binding DsPhieuTraTrangThaiOptions}"
                  SelectedItem="{Binding SelectedPhieuTraTrangThaiHienThi, Mode=TwoWay}"
                  Height="36"
                  Width="170"
                  VerticalAlignment="Center" />

        <!-- Nút Tìm kiếm -->
        <Button Grid.Column="2"
                Classes="btnPrimary"
                Content="Tìm kiếm"
                Height="36"
                Padding="16,0"
                Command="{Binding TimKiemDsPhieuTraCommand}" />

        <!-- Nút Xóa lọc -->
        <Button Grid.Column="3"
                Classes="btnSubtle"
                Content="✕ Xóa lọc"
                Height="36"
                Padding="12,0"
                Command="{Binding LamMoiDsPhieuTraCommand}" />
      </Grid>
    </Border>

    <!-- ============================================================ -->
    <!-- SECTION D: BẢNG DỮ LIỆU DANH SÁCH PHIẾU NHẬP TRẢ LẠI         -->
    <!-- ============================================================ -->
    <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1"
            CornerRadius="10" Padding="0" ClipToBounds="True">
      <Grid RowDefinitions="Auto,*">

        <!-- Tiêu đề các cột trong bảng -->
        <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="12,10">
          <Grid ColumnDefinitions="45,120,130,*,110,140,85,125,115,100" ColumnSpacing="8">
            <TextBlock Grid.Column="0" Text="STT" FontWeight="Bold" Foreground="#475569" FontSize="12" HorizontalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="Mã phiếu trả" FontWeight="Bold" Foreground="#475569" FontSize="12" />
            <TextBlock Grid.Column="2" Text="Ngày lập" FontWeight="Bold" Foreground="#475569" FontSize="12" />
            <TextBlock Grid.Column="3" Text="Khách hàng" FontWeight="Bold" Foreground="#475569" FontSize="12" />
            <TextBlock Grid.Column="4" Text="Mã HĐ gốc" FontWeight="Bold" Foreground="#475569" FontSize="12" />
            <TextBlock Grid.Column="5" Text="Kho nhận" FontWeight="Bold" Foreground="#475569" FontSize="12" />
            <TextBlock Grid.Column="6" Text="Tổng SL" FontWeight="Bold" Foreground="#475569" FontSize="12" HorizontalAlignment="Center" />
            <TextBlock Grid.Column="7" Text="Tổng tiền trả" FontWeight="Bold" Foreground="#475569" FontSize="12" HorizontalAlignment="Right" />
            <TextBlock Grid.Column="8" Text="Trạng thái" FontWeight="Bold" Foreground="#475569" FontSize="12" HorizontalAlignment="Center" />
            <TextBlock Grid.Column="9" Text="Thao tác" FontWeight="Bold" Foreground="#475569" FontSize="12" HorizontalAlignment="Center" />
          </Grid>
        </Border>

        <!-- Danh sách các dòng dữ liệu -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding DsPhieuTraHangItems}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:PhieuTraHang">
                <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="12,9" Background="Transparent">
                  <Grid ColumnDefinitions="45,120,130,*,110,140,85,125,115,100" ColumnSpacing="8" VerticalAlignment="Center">

                    <!-- Cột 1: STT -->
                    <TextBlock Grid.Column="0" Text="{Binding SoThuTu}" Foreground="#64748B" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />

                    <!-- Cột 2: Mã phiếu trả -->
                    <TextBlock Grid.Column="1" Text="{Binding MaPhieuTra}" FontWeight="Bold" Foreground="#1D4ED8" FontSize="12.5" VerticalAlignment="Center" />

                    <!-- Cột 3: Ngày lập -->
                    <TextBlock Grid.Column="2" Text="{Binding ThoiGianTraText}" Foreground="#475569" FontSize="12" VerticalAlignment="Center" />

                    <!-- Cột 4: Khách hàng -->
                    <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="1">
                      <TextBlock Text="{Binding KhachHangHienThi}" FontWeight="SemiBold" Foreground="#0F172A" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding SoDienThoaiKhach, StringFormat='SĐT: {0}'}" Foreground="#64748B" FontSize="11"
                                 IsVisible="{Binding SoDienThoaiKhach, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>

                    <!-- Cột 5: Mã HĐ gốc -->
                    <Border Grid.Column="4" Background="#F1F5F9" CornerRadius="4" Padding="5,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                      <TextBlock Text="{Binding HoaDonGocHienThi}" Foreground="#475569" FontSize="11.5" FontWeight="Medium" />
                    </Border>

                    <!-- Cột 6: Kho nhận -->
                    <TextBlock Grid.Column="5" Text="{Binding KhoNhan}" Foreground="#475569" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                    <!-- Cột 7: Tổng SL -->
                    <TextBlock Grid.Column="6" Text="{Binding TongSoLuongText}" FontWeight="Bold" Foreground="#0F172A" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />

                    <!-- Cột 8: Tổng tiền trả -->
                    <TextBlock Grid.Column="7" Text="{Binding TongTienTraText}" FontWeight="Bold" Foreground="#15803D" FontSize="12.5" HorizontalAlignment="Right" VerticalAlignment="Center" />

                    <!-- Cột 9: Trạng thái badge -->
                    <Border Grid.Column="8" Background="{Binding MauNenTrangThai}" BorderBrush="{Binding MauBorderTrangThai}"
                            BorderThickness="1" CornerRadius="6" Padding="6,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                      <TextBlock Text="{Binding TrangThaiText}" Foreground="{Binding MauChuTrangThai}" FontSize="11" FontWeight="Bold" />
                    </Border>

                    <!-- Cột 10: Thao tác -->
                    <StackPanel Grid.Column="9" Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center" VerticalAlignment="Center">
                      <Button Classes="btnTableAction" Content="👁 Xem"
                              Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).XemChiTietPhieuTraCommand}"
                              CommandParameter="{Binding}"
                              ToolTip.Tip="Xem chi tiết các mặt hàng trả lại" />

                      <Button Classes="btnTableAction" Content="🖨"
                              Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).InPhieuTraHangCommand}"
                              CommandParameter="{Binding}"
                              ToolTip.Tip="In phiếu trả hàng" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <!-- Empty state when no return items found -->
        <Border Grid.Row="1" IsVisible="{Binding !DsPhieuTraHangItems.Count}" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="30">
          <StackPanel Spacing="6" HorizontalAlignment="Center">
            <TextBlock Text="↩" FontSize="36" Foreground="#CBD5E1" HorizontalAlignment="Center" />
            <TextBlock Text="Chưa có phiếu nhập trả lại nào phù hợp với bộ lọc" FontWeight="Bold" Foreground="#64748B" FontSize="14" HorizontalAlignment="Center" />
            <TextBlock Text="Thử xóa điều kiện tìm kiếm hoặc bấm '＋ Tạo phiếu trả lại' để thêm mới." Foreground="#94A3B8" FontSize="12" HorizontalAlignment="Center" />
          </StackPanel>
        </Border>

      </Grid>
    </Border>

    <!-- ============================================================ -->
    <!-- SECTION E: THANH PHÂN TRANG                                   -->
    <!-- ============================================================ -->
    <Border Grid.Row="4" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1"
            CornerRadius="8" Padding="12,8">
      <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
        <!-- Thông tin số bản ghi hiển thị -->
        <TextBlock Grid.Column="0" Text="{Binding DsPhieuTraRangeText}" Foreground="#64748B" FontSize="12" VerticalAlignment="Center" />

        <!-- Nút chuyển trang -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Button Classes="btnSubtle"
                  Content="◀ Trước"
                  Height="30"
                  Padding="10,0"
                  FontSize="11.5"
                  IsEnabled="{Binding CanDsPhieuTraTrangTruoc}"
                  Command="{Binding DsPhieuTraTrangTruocCommand}" />

          <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6"
                  Padding="8,4" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="3">
              <TextBlock Text="Trang" FontSize="11" Foreground="#64748B" />
              <TextBlock Text="{Binding DsPhieuTraPage}" FontWeight="Bold" Foreground="#1D4ED8" FontSize="11.5" />
              <TextBlock Text="/" FontSize="11" Foreground="#64748B" />
              <TextBlock Text="{Binding DsPhieuTraTotalPages}" FontWeight="Bold" Foreground="#1D4ED8" FontSize="11.5" />
            </StackPanel>
          </Border>

          <Button Classes="btnSubtle"
                  Content="Sau ▶"
                  Height="30"
                  Padding="10,0"
                  FontSize="11.5"
                  IsEnabled="{Binding CanDsPhieuTraTrangSau}"
                  Command="{Binding DsPhieuTraTrangSauCommand}" />
        </StackPanel>
      </Grid>
    </Border>

  </Grid>
</UserControl>

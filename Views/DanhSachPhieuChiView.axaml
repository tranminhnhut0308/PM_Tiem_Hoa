<UserControl xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:ShopHoa.ViewModels"
  xmlns:models="using:ShopHoa.Models"
  x:Class="ShopHoa.Views.DanhSachPhieuChiView"
  x:Name="RootView"
  x:DataType="vm:MainWindowViewModel">

  <UserControl.Styles>
    <Style Selector="TextBox.filterInput">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#CBD5E1" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="FontSize" Value="12.5" />
    </Style>

    <Style Selector="Button.btnPrimary">
      <Setter Property="Background" Value="#D92D20" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.btnPrimary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#B42318" />
      <Setter Property="TextElement.Foreground" Value="White" />
    </Style>

    <Style Selector="Button.btnOutline">
      <Setter Property="Background" Value="#EFF6FF" />
      <Setter Property="Foreground" Value="#1D4ED8" />
      <Setter Property="BorderBrush" Value="#BFDBFE" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.btnOutline:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#DBEAFE" />
      <Setter Property="BorderBrush" Value="#93C5FD" />
      <Setter Property="TextElement.Foreground" Value="#1E40AF" />
    </Style>

    <Style Selector="Button.btnSubtle">
      <Setter Property="Background" Value="#F1F5F9" />
      <Setter Property="Foreground" Value="#475569" />
      <Setter Property="BorderBrush" Value="#E2E8F0" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.btnSubtle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#E2E8F0" />
      <Setter Property="TextElement.Foreground" Value="#1E293B" />
    </Style>

    <Style Selector="Button.btnTableAction">
      <Setter Property="Background" Value="#F8FAFC" />
      <Setter Property="Foreground" Value="#334155" />
      <Setter Property="BorderBrush" Value="#CBD5E1" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.btnTableAction:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#FEF3F2" />
      <Setter Property="BorderBrush" Value="#FDA29B" />
      <Setter Property="TextElement.Foreground" Value="#B42318" />
    </Style>

    <Style Selector="CalendarDatePicker.filterInput">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#CBD5E1" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="FontSize" Value="12.5" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="12" Margin="0">

    <!-- ============================================================ -->
    <!-- SECTION A: HEADER & CÁC NÚT THAO TÁC                         -->
    <!-- ============================================================ -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="16" VerticalAlignment="Center">
      <StackPanel Spacing="3">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Border Background="#FEF3F2" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
            <TextBlock Text="💸 PHIẾU CHI" FontSize="11" FontWeight="Bold" Foreground="#B42318" />
          </Border>
          <TextBlock Text="Danh sách phiếu chi" FontSize="20" FontWeight="Bold" Foreground="#0F172A" />
        </StackPanel>
        <TextBlock Text="Quản lý các khoản chi tiền mặt, chuyển khoản và các khoản chi khác của cửa hàng"
                   FontSize="12.5" Foreground="#64748B" />
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button Classes="btnPrimary"
                Content="＋ Thêm phiếu chi"
                Height="36"
                Padding="14,0"
                IsVisible="{Binding CanCreatePayment}"
                Command="{Binding MoFormThemPhieuChiCommand}" />

        <Button Classes="btnOutline"
                Content="↻ Làm mới"
                Height="36"
                Padding="12,0"
                Command="{Binding LamMoiDsPhieuChiCommand}" />

        <Button Classes="btnSubtle"
                Content="📤 Xuất Excel"
                Height="36"
                Padding="12,0"
                IsVisible="{Binding CanExportCashBook}"
                Command="{Binding XuatExcelDsPhieuChiCommand}" />
      </StackPanel>
    </Grid>

    <!-- ============================================================ -->
    <!-- SECTION B: 3 THẺ THỐNG KÊ                                    -->
    <!-- ============================================================ -->
    <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="12">

      <!-- Thẻ 1: Tổng số phiếu chi -->
      <Border Grid.Column="0"
              Background="White"
              BorderBrush="#E2E8F0"
              BorderThickness="1"
              CornerRadius="10"
              Padding="14,10"
              BoxShadow="0 1 3 #0A000000">
        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
          <StackPanel Spacing="2">
            <TextBlock Text="TỔNG SỐ PHIẾU CHI" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" />
            <TextBlock Text="{Binding ThongKeTongSoPhieuChiText}"
                       FontSize="18" FontWeight="Bold" Foreground="#1E293B" />
          </StackPanel>
          <Border Grid.Column="1" Background="#F1F5F9" CornerRadius="8" Width="36" Height="36">
            <TextBlock Text="📋" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </Grid>
      </Border>

      <!-- Thẻ 2: Tổng tiền chi -->
      <Border Grid.Column="1"
              Background="White"
              BorderBrush="#E2E8F0"
              BorderThickness="1"
              CornerRadius="10"
              Padding="14,10"
              BoxShadow="0 1 3 #0A000000">
        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
          <StackPanel Spacing="2">
            <TextBlock Text="TỔNG TIỀN CHI" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" />
            <TextBlock Text="{Binding ThongKeTongTienChiText}"
                       FontSize="18" FontWeight="Bold" Foreground="#D92D20" />
          </StackPanel>
          <Border Grid.Column="1" Background="#FEF3F2" CornerRadius="8" Width="36" Height="36">
            <TextBlock Text="💸" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </Grid>
      </Border>

      <!-- Thẻ 3: Số phiếu đã hủy -->
      <Border Grid.Column="2"
              Background="White"
              BorderBrush="#E2E8F0"
              BorderThickness="1"
              CornerRadius="10"
              Padding="14,10"
              BoxShadow="0 1 3 #0A000000">
        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
          <StackPanel Spacing="2">
            <TextBlock Text="PHIẾU ĐÃ HỦY" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" />
            <TextBlock Text="{Binding ThongKeSoPhieuDaHuyText}"
                       FontSize="18" FontWeight="Bold" Foreground="#B54708" />
          </StackPanel>
          <Border Grid.Column="1" Background="#FFFAEB" CornerRadius="8" Width="36" Height="36">
            <TextBlock Text="🚫" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </Grid>
      </Border>
    </Grid>

    <!-- ============================================================ -->
    <!-- SECTION C: BỘ LỌC TÌM KIẾM                                   -->
    <!-- ============================================================ -->
    <Border Grid.Row="2"
            Background="White"
            BorderBrush="#E2E8F0"
            BorderThickness="1"
            CornerRadius="10"
            Padding="12"
            BoxShadow="0 1 3 #0A000000">
      <Grid ColumnDefinitions="2.6*,1.2*,1.2*,Auto,Auto" ColumnSpacing="10" VerticalAlignment="Center">

        <!-- 1. Ô tìm kiếm -->
        <TextBox Grid.Column="0"
                 Classes="filterInput"
                 Text="{Binding DsPhieuChiSearch, Mode=TwoWay}"
                 Watermark="🔍 Tìm theo mã phiếu, nội dung, người tạo, loại chi..." />

        <!-- 2. Từ ngày -->
        <CalendarDatePicker Grid.Column="1"
                            Classes="filterInput"
                            SelectedDate="{Binding DsPhieuChiTuNgay, Mode=TwoWay}"
                            Watermark="Từ ngày"
                            HorizontalAlignment="Stretch"
                            Height="36"
                            FontSize="12" />

        <!-- 3. Đến ngày -->
        <CalendarDatePicker Grid.Column="2"
                            Classes="filterInput"
                            SelectedDate="{Binding DsPhieuChiDenNgay, Mode=TwoWay}"
                            Watermark="Đến ngày"
                            HorizontalAlignment="Stretch"
                            Height="36"
                            FontSize="12" />

        <!-- 4. Nút Tìm kiếm (bấm mới áp bộ lọc) -->
        <Button Grid.Column="3"
                Classes="btnPrimary"
                Content="Tìm kiếm"
                Height="36"
                Padding="14,0"
                Command="{Binding TimKiemDsPhieuChiCommand}" />

        <!-- 5. Nút Xóa lọc -->
        <Button Grid.Column="4"
                Classes="btnSubtle"
                Content="Xóa lọc"
                Height="36"
                Padding="12,0"
                Command="{Binding XoaBoLocDsPhieuChiCommand}" />
      </Grid>
    </Border>

    <!-- ============================================================ -->
    <!-- SECTION D: BẢNG DỮ LIỆU PHIẾU CHI (9 CỘT)                    -->
    <!-- ============================================================ -->
    <Border Grid.Row="3"
            Background="White"
            BorderBrush="#E2E8F0"
            BorderThickness="1"
            CornerRadius="10"
            BoxShadow="0 1 3 #0A000000"
            ClipToBounds="True">
      <Grid RowDefinitions="Auto,*">

        <!-- Header Bảng -->
        <Border Grid.Row="0"
                Background="#F8FAFC"
                BorderBrush="#E2E8F0"
                BorderThickness="0,0,0,1"
                Padding="12,10">
          <Grid ColumnDefinitions="130,128,140,145,110,115,100,*,240">
            <TextBlock Grid.Column="0" Text="Mã phiếu" FontWeight="Bold" FontSize="11.5" Foreground="#475569" />
            <TextBlock Grid.Column="1" Text="Thời gian" FontWeight="Bold" FontSize="11.5" Foreground="#475569" />
            <TextBlock Grid.Column="2" Text="Loại chi" FontWeight="Bold" FontSize="11.5" Foreground="#475569" />
            <TextBlock Grid.Column="3" Text="Người nhận" FontWeight="Bold" FontSize="11.5" Foreground="#475569" Margin="6,0,0,0" />
            <TextBlock Grid.Column="4" Text="Quỹ" FontWeight="Bold" FontSize="11.5" Foreground="#475569" />
            <TextBlock Grid.Column="5" Text="Số tiền" FontWeight="Bold" FontSize="11.5" Foreground="#475569" HorizontalAlignment="Right" />
            <TextBlock Grid.Column="6" Text="Trạng thái" FontWeight="Bold" FontSize="11.5" Foreground="#475569" HorizontalAlignment="Center" />
            <TextBlock Grid.Column="7" Text="Nội dung" FontWeight="Bold" FontSize="11.5" Foreground="#475569" Margin="6,0,0,0" />
            <TextBlock Grid.Column="8" Text="Thao tác" FontWeight="Bold" FontSize="11.5" Foreground="#475569" HorizontalAlignment="Center" />
          </Grid>
        </Border>

        <!-- Loading indicator -->
        <ProgressBar Grid.Row="0"
                     IsIndeterminate="True"
                     IsVisible="{Binding IsLoadingDsPhieuChi}"
                     Height="2"
                     VerticalAlignment="Bottom"
                     Background="Transparent"
                     Foreground="#D92D20" />

        <!-- Danh sách dòng dữ liệu -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <Grid>
            <!-- Khi danh sách rỗng -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6" Margin="0,40"
                        IsVisible="{Binding !DsPhieuChiItems.Count}">
              <TextBlock Text="🧾" FontSize="36" HorizontalAlignment="Center" Foreground="#94A3B8" />
              <TextBlock Text="{Binding DsPhieuChiEmptyStateText}"
                         FontSize="13.5" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Center" />
              <TextBlock Text="Thử thay đổi từ khóa tìm kiếm hoặc bấm 'Làm mới'."
                         FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Có dữ liệu -->
            <ItemsControl ItemsSource="{Binding DsPhieuChiItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="models:SoQuyGiaoDich">
                  <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="12,9">
                    <Grid ColumnDefinitions="130,128,140,145,110,115,100,*,240" VerticalAlignment="Center">

                      <!-- 1. Mã phiếu -->
                      <TextBlock Grid.Column="0"
                                 Text="{Binding MaPhieu}"
                                 FontWeight="Bold"
                                 FontSize="12.5"
                                 Foreground="#B42318"
                                 VerticalAlignment="Center" />

                      <!-- 2. Thời gian -->
                      <TextBlock Grid.Column="1"
                                 Text="{Binding ThoiGianHienThi}"
                                 FontSize="12"
                                 Foreground="#334155"
                                 VerticalAlignment="Center" />

                      <!-- 3. Loại chi -->
                      <TextBlock Grid.Column="2"
                                 Text="{Binding TenLoai}"
                                 FontSize="12"
                                 Foreground="#334155"
                                 VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis" />

                      <!-- 4. Người nhận -->
                      <TextBlock Grid.Column="3"
                                 Text="{Binding NguoiNopNhan}"
                                 FontSize="12"
                                 Foreground="#334155"
                                 Margin="6,0,0,0"
                                 VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis" />

                      <!-- 5. Quỹ -->
                      <TextBlock Grid.Column="4"
                                 Text="{Binding PhuongThucHienThi}"
                                 FontSize="12"
                                 Foreground="#334155"
                                 VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis" />

                      <!-- 6. Số tiền -->
                      <TextBlock Grid.Column="5"
                                 Text="{Binding GiaTriHienThi}"
                                 FontWeight="Bold"
                                 FontSize="12.5"
                                 Foreground="{Binding MauGiaTri}"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Center" />

                      <!-- 7. Trạng thái (Badge) -->
                      <Border Grid.Column="6"
                              Background="{Binding MauNenTrangThai}"
                              CornerRadius="4"
                              Padding="6,2"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center">
                        <TextBlock Text="{Binding TrangThaiHienThi}"
                                   FontWeight="SemiBold"
                                   FontSize="11"
                                   Foreground="{Binding MauTrangThai}" />
                      </Border>

                      <!-- 8. Nội dung + ghi chú -->
                      <StackPanel Grid.Column="7" Margin="6,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding NoiDung}"
                                   FontWeight="SemiBold"
                                   FontSize="12.5"
                                   Foreground="#0F172A"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding GhiChu}"
                                   FontSize="11"
                                   Foreground="#64748B"
                                   TextTrimming="CharacterEllipsis"
                                   IsVisible="{Binding GhiChu, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      </StackPanel>

                      <!-- 9. Thao tác -->
                      <StackPanel Grid.Column="8" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button Classes="btnTableAction"
                                Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).MoChiTietPhieuCommand}"
                                CommandParameter="{Binding}"
                                ToolTip.Tip="Xem chi tiết phiếu">
                          <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="👁" FontSize="11" />
                            <TextBlock Text="Xem" FontSize="11" />
                          </StackPanel>
                        </Button>

                        <Button Classes="btnTableAction"
                                Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).SuaPhieuChiCommand}"
                                CommandParameter="{Binding}"
                                IsEnabled="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).CanEditCashBook}"
                                ToolTip.Tip="Sửa phiếu chi">
                          <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="✏" FontSize="11" />
                            <TextBlock Text="Sửa" FontSize="11" />
                          </StackPanel>
                        </Button>

                        <Button Classes="btnTableAction"
                                Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).XoaPhieuChiCommand}"
                                CommandParameter="{Binding}"
                                IsEnabled="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).CanCancelCashBook}"
                                ToolTip.Tip="Hủy phiếu chi">
                          <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="🗑" FontSize="11" />
                            <TextBlock Text="Xóa" FontSize="11" />
                          </StackPanel>
                        </Button>

                        <Button Classes="btnTableAction"
                                Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).InPhieuChiCommand}"
                                CommandParameter="{Binding}"
                                ToolTip.Tip="In phiếu chi">
                          <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="🖨" FontSize="11" />
                            <TextBlock Text="In" FontSize="11" />
                          </StackPanel>
                        </Button>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
        </ScrollViewer>
      </Grid>
    </Border>

    <!-- ============================================================ -->
    <!-- SECTION E: THANH PHÂN TRANG                                  -->
    <!-- ============================================================ -->
    <Grid Grid.Row="4" ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center" Margin="2,0">
      <TextBlock Grid.Column="0"
                 Text="{Binding DsPhieuChiRangeText}"
                 FontSize="12.5"
                 Foreground="#64748B"
                 VerticalAlignment="Center" />

      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <Button Classes="btnSubtle"
                Command="{Binding DsPhieuChiTrangTruocCommand}"
                IsEnabled="{Binding CanDsPhieuChiTrangTruoc}"
                Height="32"
                Padding="10,0">
          <TextBlock Text="‹ Trang trước" FontSize="12" />
        </Button>

        <Border Background="#FEF3F2" CornerRadius="6" Padding="10,6" VerticalAlignment="Center">
          <TextBlock Text="{Binding DsPhieuChiPage, StringFormat='Trang {0}'}"
                     FontSize="12"
                     FontWeight="Bold"
                     Foreground="#B42318" />
        </Border>

        <Button Classes="btnSubtle"
                Command="{Binding DsPhieuChiTrangSauCommand}"
                IsEnabled="{Binding CanDsPhieuChiTrangSau}"
                Height="32"
                Padding="10,0">
          <TextBlock Text="Trang sau ›" FontSize="12" />
        </Button>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>

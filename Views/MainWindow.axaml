<Window xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:ShopHoa.ViewModels"
  xmlns:models="using:ShopHoa.Models"
  xmlns:converters="using:ShopHoa.Converters"
  xmlns:controls="using:ShopHoa.Controls"
  xmlns:views="using:ShopHoa.Views"
  x:Class="ShopHoa.Views.MainWindow"
  x:Name="RootWindow"
  x:DataType="vm:MainWindowViewModel"
  Title="VỰA HOA NHÀ HUY"
  Icon="/Assets/logo.ico"
  Width="1500"
  Height="900"
  WindowState="Maximized"
  MinWidth="1100"
  MinHeight="700">

  <Window.Resources>
    <x:Double x:Key="DatePickerThemeMinWidth">0</x:Double>
    <converters:ThousandsSeparatorConverter x:Key="ThousandsSeparatorConverter" />
    <converters:LuaChonRadioConverter x:Key="LuaChonRadioConverter" />
    <converters:ConNoForegroundConverter x:Key="ConNoForegroundConverter" />
  </Window.Resources>

  <Window.Styles>
    <!-- ===== STYLE DÙNG CHUNG (Dashboard dùng trong Views/TongQuanDashboardView.axaml) ===== -->
    <Style Selector="TextBox">
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="#263B35" />
      <Setter Property="BorderBrush" Value="#D8E5E0" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="TextBox:pointerover">
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="#263B35" />
      <Setter Property="BorderBrush" Value="#D8E5E0" />
    </Style>

    <Style Selector="TextBox:focus">
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="#263B35" />
      <Setter Property="BorderBrush" Value="#087F6E" />
    </Style>

    <Style Selector="TextBox:pointerover:focus">
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="#263B35" />
      <Setter Property="BorderBrush" Value="#D8E5E0" />
    </Style>

    <Style Selector="TextBox /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#D8E5E0" />
    </Style>

    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#D8E5E0" />
    </Style>

    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#D8E5E0" />
    </Style>

    <Style Selector="TextBox /template/ ScrollViewer#PART_ContentHost">
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="#263B35" />
    </Style>

    <Style Selector="TextBox:pointerover /template/ ScrollViewer#PART_ContentHost">
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="#263B35" />
    </Style>

    <Style Selector="TextBox:focus /template/ ScrollViewer#PART_ContentHost">
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="#263B35" />
    </Style>

    <!-- MENU CHÍNH BÊN TRÁI -->
    <Style Selector="Button.menu">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#D6EDE4" />
      <Setter Property="BorderThickness" Value="3.5,0,0,0" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Padding" Value="14,9" />
      <Setter Property="Margin" Value="0,2" />
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.menu /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="3.5,0,0,0" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="TextElement.Foreground" Value="#D6EDE4" />
    </Style>

    <!-- Hover Menu chính -->
    <Style Selector="Button.menu:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#1FFFFFFF" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="TextElement.Foreground" Value="#FFFFFF" />
    </Style>

    <!-- Active Menu chính (Đang được chọn) -->
    <Style Selector="Button.menu.active /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#2BFFFFFF" />
      <Setter Property="BorderThickness" Value="3.5,0,0,0" />
      <Setter Property="BorderBrush" Value="#D9B66F" />
      <Setter Property="TextElement.Foreground" Value="#FFFFFF" />
      <Setter Property="TextElement.FontWeight" Value="Bold" />
    </Style>

    <Style Selector="Button.menu:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#38FFFFFF" />
      <Setter Property="BorderBrush" Value="#D9B66F" />
      <Setter Property="TextElement.Foreground" Value="#FFFFFF" />
    </Style>

    <!-- SUB-MENU (BÁO CÁO CON) -->
    <Style Selector="Button.subMenu">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#B2DDD0" />
      <Setter Property="BorderThickness" Value="2.5,0,0,0" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.subMenu /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="2.5,0,0,0" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="TextElement.Foreground" Value="#B2DDD0" />
    </Style>

    <!-- Hover SubMenu -->
    <Style Selector="Button.subMenu:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#18FFFFFF" />
      <Setter Property="TextElement.Foreground" Value="#FFFFFF" />
    </Style>

    <!-- Active SubMenu -->
    <Style Selector="Button.subMenu.active /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#25FFFFFF" />
      <Setter Property="BorderThickness" Value="2.5,0,0,0" />
      <Setter Property="BorderBrush" Value="#D9B66F" />
      <Setter Property="TextElement.Foreground" Value="#FFFFFF" />
      <Setter Property="TextElement.FontWeight" Value="SemiBold" />
    </Style>

    <!-- NÚT BÁN HÀNG NỔI BẬT -->
    <Style Selector="Button.salesButton">
      <Setter Property="Background" Value="#0A8C78" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#62E8D3" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="16,12" />
      <Setter Property="Margin" Value="0,10,0,0" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.salesButton /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#0A8C78" />
      <Setter Property="BorderBrush" Value="#62E8D3" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="TextElement.Foreground" Value="#FFFFFF" />
    </Style>

    <Style Selector="Button.salesButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#0E9F89" />
      <Setter Property="BorderBrush" Value="#95F5E5" />
      <Setter Property="TextElement.Foreground" Value="#FFFFFF" />
    </Style>

    <Style Selector="Button.salesButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#076E5E" />
    </Style>

    <!-- THẺ TÀI KHOẢN ADMIN KÍNH MỜ -->
    <Style Selector="Button.accountCard">
      <Setter Property="Background" Value="#1C000000" />
      <Setter Property="BorderBrush" Value="#25FFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Margin" Value="0,10,0,0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.accountCard /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#1C000000" />
      <Setter Property="BorderBrush" Value="#25FFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
    </Style>

    <Style Selector="Button.accountCard:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#2D000000" />
      <Setter Property="BorderBrush" Value="#45FFFFFF" />
    </Style>


    <Style Selector="Border.card">
      <Setter Property="Background" Value="White" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="22" />
      <Setter Property="Margin" Value="0,0,16,16" />
      <Setter Property="BoxShadow" Value="0 4 16 #120A352E" />
    </Style>

    <Style Selector="DataGrid">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#E2ECE8" />
      <Setter Property="GridLinesVisibility" Value="Horizontal" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- DÒNG KHÁCH HÀNG: DI CHUỘT CÓ MÀU, TÁCH DÒNG MỎNG -->
    <Style Selector="Border.customerRow">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Border.customerRow:pointerover">
      <Setter Property="Background" Value="#F2F9F6" />
    </Style>

    <!--
      BẢNG CUỘN (KHÁCH HÀNG / NHÀ CUNG CẤP)
      Thanh cuộn luôn chiếm đúng 13px nên vùng danh sách có chiều rộng ổn định,
      không nhảy cột khi dữ liệu nhiều/ít. Tiêu đề bảng chừa sẵn 13px Padding phải
      tương ứng để cột tiêu đề thẳng hàng với cột dữ liệu.
    -->
    <Style Selector="ScrollViewer.listScroll">
      <Setter Property="VerticalScrollBarVisibility" Value="Visible" />
      <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>

    <Style Selector="ScrollViewer.listScroll ScrollBar:vertical">
      <Setter Property="Width" Value="13" />
      <Setter Property="MinWidth" Value="13" />
      <Setter Property="MaxWidth" Value="13" />
    </Style>

    <Style Selector="CheckBox.rowCheckBox">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="CheckBox.rowCheckBox /template/ Border#PART_ControlRoot">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#A8BDB6" />
      <Setter Property="BorderThickness" Value="1.2" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>

    <Style Selector="CheckBox.rowCheckBox:pointerover /template/ Border#PART_ControlRoot">
      <Setter Property="BorderBrush" Value="#087F6E" />
    </Style>

    <Style Selector="CheckBox.rowCheckBox:checked /template/ Border#PART_ControlRoot">
      <Setter Property="Background" Value="#087F6E" />
      <Setter Property="BorderBrush" Value="#087F6E" />
    </Style>

    <Style Selector="DataGridColumnHeader">
      <Setter Property="Background" Value="#E5F2EE" />
      <Setter Property="Foreground" Value="#164B40" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="10,8" />
    </Style>

    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#61736E" />
      <Setter Property="Padding" Value="14,10" />
    </Style>

    <Style Selector="TabItem:selected">
      <Setter Property="Foreground" Value="#087F6E" />
    </Style>

    <Style Selector="TabControl /template/ ItemsPresenter#PART_ItemsPresenter">
      <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="Button.filter">
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="#344B45" />
      <Setter Property="BorderBrush" Value="#D8E5E0" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="Padding" Value="15,8" />
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>

    <Style Selector="Button.filter:selected">
      <Setter Property="Background" Value="#087F6E" />
      <Setter Property="Foreground" Value="White" />
    </Style>

    <Style Selector="Button.filter:pointerover">
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="#344B45" />
      <Setter Property="BorderBrush" Value="#D8E5E0" />
    </Style>

    <Style Selector="Button.filter:pressed">
      <Setter Property="Background" Value="#A9DED2" />
      <Setter Property="Foreground" Value="#06483E" />
      <Setter Property="BorderBrush" Value="#087F6E" />
    </Style>

    <Style Selector="Button.filter:selected:pointerover">
      <Setter Property="Background" Value="#087F6E" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="#D8E5E0" />
    </Style>

    <Style Selector="Button.filter /template/ Border#PART_ButtonRoot">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#D8E5E0" />
    </Style>

    <Style Selector="Button.filter:pointerover /template/ Border#PART_ButtonRoot">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#D8E5E0" />
    </Style>

    <Style Selector="Button.filter:selected /template/ Border#PART_ButtonRoot">
      <Setter Property="Background" Value="#087F6E" />
      <Setter Property="BorderBrush" Value="#D8E5E0" />
    </Style>

    <Style Selector="Button.filter:selected:pointerover /template/ Border#PART_ButtonRoot">
      <Setter Property="Background" Value="#087F6E" />
      <Setter Property="BorderBrush" Value="#D8E5E0" />
    </Style>

    <Style Selector="Button.filter /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="TextElement.Foreground" Value="#344B45" />
    </Style>

    <Style Selector="Button.filter:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="TextElement.Foreground" Value="#344B45" />
    </Style>

    <Style Selector="Button.filter:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="TextElement.Foreground" Value="White" />
    </Style>

    <Style
      Selector="Button.filter:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="TextElement.Foreground" Value="White" />
    </Style>

    <Style Selector="Border.product-card">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#E1EAE6" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Margin" Value="0,0,14,14" />
      <Setter Property="Padding" Value="8" />
    </Style>

    <Style Selector="Button.card-action">
      <Setter Property="Background" Value="#E8F5F1" />
      <Setter Property="Foreground" Value="#087F6E" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="Margin" Value="0,8,6,0" />
    </Style>

    <Style Selector="Button.card-action /template/ Border#PART_ButtonRoot">
      <Setter Property="Background" Value="#E8F5F1" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style Selector="Button.card-action /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="TextElement.Foreground" Value="#087F6E" />
    </Style>

    <Style Selector="Button.card-action:pointerover">
      <Setter Property="Background" Value="#E8F5F1" />
      <Setter Property="Foreground" Value="#087F6E" />
    </Style>

    <Style Selector="Button.card-action:pointerover /template/ Border#PART_ButtonRoot">
      <Setter Property="Background" Value="#E8F5F1" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style
      Selector="Button.card-action:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="TextElement.Foreground" Value="#087F6E" />
    </Style>

    <Style Selector="Button.card-action.danger">
      <Setter Property="Background" Value="#FFF0F0" />
      <Setter Property="Foreground" Value="#D64545" />
    </Style>

    <Style Selector="Button.card-action.danger /template/ Border#PART_ButtonRoot">
      <Setter Property="Background" Value="#FFF0F0" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style Selector="Button.card-action.danger /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="TextElement.Foreground" Value="#D64545" />
    </Style>

    <Style Selector="Button.card-action.danger:pointerover">
      <Setter Property="Background" Value="#FFF0F0" />
      <Setter Property="Foreground" Value="#D64545" />
    </Style>

    <Style Selector="Button.card-action.danger:pointerover /template/ Border#PART_ButtonRoot">
      <Setter Property="Background" Value="#FFF0F0" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style
      Selector="Button.card-action.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="TextElement.Foreground" Value="#D64545" />
    </Style>

    <Style Selector="Button.toolbar-action">
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="#344B45" />
      <Setter Property="BorderBrush" Value="#D8E5E0" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14,9" />
      <Setter Property="Margin" Value="8,0,0,10" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="White"
            BorderBrush="#D8E5E0"
            BorderThickness="1"
            CornerRadius="8"
            Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}"
              ContentTemplate="{TemplateBinding ContentTemplate}"
              HorizontalContentAlignment="Center"
              VerticalContentAlignment="Center"
              TextElement.Foreground="#344B45" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>

    <Style Selector="Button.toolbar-action:pointerover">
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="#344B45" />
      <Setter Property="BorderBrush" Value="#D8E5E0" />
    </Style>

    <Style Selector="Button.toolbar-action:pressed">
      <Setter Property="Background" Value="#BDE5DA" />
      <Setter Property="Foreground" Value="#06483E" />
      <Setter Property="BorderBrush" Value="#087F6E" />
    </Style>

    <Style Selector="Button.toolbar-action:focus">
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="#344B45" />
      <Setter Property="BorderBrush" Value="#087F6E" />
    </Style>

    <Style Selector="Button.toolbar-action:pointerover:focus">
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="#344B45" />
      <Setter Property="BorderBrush" Value="#087F6E" />
    </Style>

    <Style Selector="Button.toolbar-action /template/ Border#PART_ButtonRoot">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#D8E5E0" />
    </Style>

    <Style Selector="Button.toolbar-action:pointerover /template/ Border#PART_ButtonRoot">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#D8E5E0" />
    </Style>

    <Style Selector="Button.toolbar-action:pressed /template/ Border#PART_ButtonRoot">
      <Setter Property="Background" Value="#BDE5DA" />
      <Setter Property="BorderBrush" Value="#087F6E" />
    </Style>

    <Style Selector="Button.toolbar-action /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="TextElement.Foreground" Value="#344B45" />
    </Style>

    <Style
      Selector="Button.toolbar-action:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="TextElement.Foreground" Value="#344B45" />
    </Style>


    <Style Selector="Button.toolbar-action:focus /template/ Border">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#087F6E" />
    </Style>

    <!-- ============ NÚT THANH TOÁN CÔNG NỢ PHIẾU NHẬP (TRÊN BÁO CÁO) ============ -->
    <!-- Nút xanh có cả icon + chữ "Thanh toán", kích thước đồng đều, có hiệu ứng hover -->
    <Style Selector="Button.payRowButton">
      <Setter Property="Background" Value="#087F6E" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="Height" Value="32" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border x:Name="PART_Root"
            Background="#087F6E"
            CornerRadius="8"
            Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}"
              ContentTemplate="{TemplateBinding ContentTemplate}"
              HorizontalContentAlignment="Center"
              VerticalContentAlignment="Center"
              TextElement.Foreground="White" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>

    <Style Selector="Button.payRowButton /template/ Border#PART_Root">
      <Setter Property="Background" Value="#087F6E" />
    </Style>

    <Style Selector="Button.payRowButton:pointerover /template/ Border#PART_Root">
      <Setter Property="Background" Value="#06695A" />
    </Style>

    <Style Selector="Button.payRowButton:pressed /template/ Border#PART_Root">
      <Setter Property="Background" Value="#055C4F" />
    </Style>

    <Style Selector="Button.payRowButton:disabled /template/ Border#PART_Root">
      <Setter Property="Background" Value="#9DBFB7" />
    </Style>

    <Style Selector="Button.payRowButton /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="TextElement.Foreground" Value="White" />
    </Style>

    <Style Selector="Button.payRowButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="TextElement.Foreground" Value="White" />
    </Style>

    <!-- ============ CHỈNH GIÁ NHANH NGAY TRÊN DANH SÁCH HÀNG HÓA ============ -->

    <!-- Nút ✏ mở ô nhập giá: ẩn cho tới khi rê chuột vào dòng -->
    <Style Selector="Button.priceEditTrigger">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Border:pointerover Button.priceEditTrigger">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="Button.priceEditTrigger:pointerover">
      <Setter Property="Background" Value="#E7F2EE" />
    </Style>

    <Style Selector="Button.priceEditTrigger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="TextElement.Foreground" Value="#087F6E" />
    </Style>

    <Style Selector="Button.priceEditSave">
      <Setter Property="Background" Value="#087F6E" />
      <Setter Property="Foreground" Value="White" />

  <Grid ColumnDefinitions="225,*" Background="#F4F7F6">
    <Border Grid.Column="0" Padding="14,0">
      <Border.Background>
        <ImageBrush Source="avares://ShopHoa/Assets/anh_menu.png" Stretch="UniformToFill" />
      </Border.Background>
      <Grid RowDefinitions="Auto,*,Auto">
        <!-- LOGO VỰA HOA NHÀ HUY -->
        <StackPanel Margin="0,20,0,18" HorizontalAlignment="Center" VerticalAlignment="Center">
          <!-- Biểu tượng hoa cách điệu -->
          <Path Data="M12,2 C12,2 9,7 9,11 C9,15 12,20 12,20 C12,20 15,15 15,11 C15,7 12,2 12,2 Z M12,20 C12,20 6,18 4,13 C2,8 5,6 5,6 C5,6 8,9 10,14 C11,16 12,20 12,20 Z M12,20 C12,20 18,18 20,13 C22,8 19,6 19,6 C19,6 16,9 14,14 C13,16 12,20 12,20 Z"
                Fill="#D9B66F" 
                Stretch="Uniform" 
                Width="38" 
                Height="38" 
                HorizontalAlignment="Center"
                Margin="0,0,0,6"/>
          
          <!-- Chữ VỰA HOA -->
          <TextBlock Text="VỰA HOA"
                     Foreground="#FFFDF5"
                     FontSize="13"
                     FontWeight="SemiBold"
                     LetterSpacing="1.2"
                     HorizontalAlignment="Center" />
                      
          <!-- Đường kẻ vàng champagne -->
          <Rectangle Width="44" Height="1.5" Fill="#D9B66F" Margin="0,5,0,5" HorizontalAlignment="Center" />
          
          <!-- Chữ NHÀ HUY -->
          <TextBlock Text="NHÀ HUY"
                     Foreground="#D9B66F"
                     FontSize="18"
                     FontWeight="Bold"
                     LetterSpacing="1.8"
                     HorizontalAlignment="Center" />
        </StackPanel>

        <!-- DANH SÁCH MENU ĐIỀU HƯỚNG CÓ CUỘN TỰ ĐỘNG -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Orientation="Vertical" Margin="0,0,2,0">
            <!-- Nhãn phân nhóm chức năng -->
            <TextBlock Text="CHỨC NĂNG" FontSize="10" FontWeight="Bold" Foreground="#85C7B7"
                       Margin="10,0,0,6" LetterSpacing="0.8" />

            <!-- TỔNG QUAN -->
            <Button Classes="menu" Classes.active="{Binding IsTongQuanSelected}"
              Command="{Binding ChonMenuCommand}" CommandParameter="Tổng quan"
              IsVisible="{Binding CanViewDashboard}">
              <Grid ColumnDefinitions="24,*">
                <TextBlock Text="📊" FontSize="14" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="Tổng quan" VerticalAlignment="Center" Margin="6,0,0,0" />
              </Grid>
            </Button>

            <!-- HÀNG HÓA -->
            <Button Classes="menu" Classes.active="{Binding IsHangHoaSelected}"
              Command="{Binding ChonMenuCommand}" CommandParameter="Hàng hóa"
              IsVisible="{Binding CanViewProducts}">
              <Grid ColumnDefinitions="24,*">
                <TextBlock Text="🌸" FontSize="14" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="Hàng hóa" VerticalAlignment="Center" Margin="6,0,0,0" />
              </Grid>
            </Button>

            <!-- HÓA ĐƠN -->
            <Button Classes="menu" Classes.active="{Binding IsHoaDonSelected}"
              Command="{Binding ChonMenuCommand}" CommandParameter="Hóa đơn"
              IsVisible="{Binding CanViewInvoices}">
              <Grid ColumnDefinitions="24,*">
                <TextBlock Text="🧾" FontSize="14" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="Hóa đơn" VerticalAlignment="Center" Margin="6,0,0,0" />
              </Grid>
            </Button>

            <!-- KHÁCH HÀNG -->
            <Button Classes="menu" Classes.active="{Binding IsKhachHangSelected}"
              Command="{Binding ChonMenuCommand}" CommandParameter="Khách hàng"
              IsVisible="{Binding CanViewCustomers}">
              <Grid ColumnDefinitions="24,*">
                <TextBlock Text="👥" FontSize="14" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="Khách hàng" VerticalAlignment="Center" Margin="6,0,0,0" />
              </Grid>
            </Button>

            <!-- NHÀ CUNG CẤP -->
            <Button Classes="menu" Classes.active="{Binding IsNhaCungCapSelected}"
              Command="{Binding ChonMenuCommand}" CommandParameter="Nhà cung cấp"
              IsVisible="{Binding CanViewSuppliers}">
              <Grid ColumnDefinitions="24,*">
                <TextBlock Text="🚚" FontSize="14" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="Nhà cung cấp" VerticalAlignment="Center" Margin="6,0,0,0" />
              </Grid>
            </Button>

            <!-- SỔ QUỸ -->
            <Button Classes="menu" Classes.active="{Binding IsSoQuySelected}"
              Command="{Binding ChonMenuCommand}" CommandParameter="Sổ quỹ"
              IsVisible="{Binding CanViewCashBook}">
              <Grid ColumnDefinitions="24,*">
                <TextBlock Text="💰" FontSize="14" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="Sổ quỹ" VerticalAlignment="Center" Margin="6,0,0,0" />
              </Grid>
            </Button>

            <!-- BÁO CÁO (ACCORDION CÓ GẬP MỞ) -->
            <Button Classes="menu" Classes.active="{Binding IsBaoCaoSectionSelected}"
              Command="{Binding ChonMenuCommand}" CommandParameter="Báo cáo"
              IsVisible="{Binding CanViewReports}">
              <Grid ColumnDefinitions="24,*,Auto">
                <TextBlock Text="📈" FontSize="14" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="Báo cáo" VerticalAlignment="Center" Margin="6,0,0,0" />
                <TextBlock Grid.Column="2" Text="{Binding BaoCaoArrowText}" FontSize="12" Foreground="#85C7B7" VerticalAlignment="Center" Margin="0,0,4,0" />
              </Grid>
            </Button>

            <!-- CÁC BÁO CÁO CON DẠNG NHÁNH CÂY -->
            <Border IsVisible="{Binding IsBaoCaoExpanded}"
                    Margin="16,2,0,4"
                    Padding="6,2,0,2"
                    BorderBrush="#2FFFFFFF"
                    BorderThickness="1.5,0,0,0">
              <ItemsControl ItemsSource="{Binding BaoCaoMenuItems}" IsVisible="{Binding CanViewReports}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:BaoCaoMenuItem">
                    <Button Classes="subMenu" Classes.active="{Binding IsSelected}"
                      IsVisible="{Binding IsVisible}"
                      Command="{Binding ElementName=RootWindow, Path=DataContext.ChonBaoCaoCommand}"
                      CommandParameter="{Binding}">
                      <StackPanel Orientation="Horizontal" Spacing="7">
                        <TextBlock Text="{Binding BieuTuong}" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding TieuDe}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- KHU VỰC CUỐI THANH MENU -->
        <StackPanel Grid.Row="2" Margin="0,6,0,12">
          <!-- NÚT BÁN HÀNG -->
          <Button Classes="salesButton" Content="🛒  Bán hàng" VerticalAlignment="Center"
            Command="{Binding MoGiaoDienBanHangCommand}" IsVisible="{Binding CanViewSales}" />

          <!-- NÚT CHUÔNG THÔNG BÁO BẢN CẬP NHẬT MỚI -->
          <Button Background="#FEF3C7"
            BorderBrush="#F59E0B"
            BorderThickness="1"
            CornerRadius="10"
            Padding="12,10"
            Margin="0,10,0,0"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Left"
            Click="OpenUpdateWindow_OnClick"
            IsVisible="{Binding CoBanCapNhatMoi}"
            ToolTip.Tip="Bấm để cập nhật phiên bản mới!">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="🔔" FontSize="16" VerticalAlignment="Center" />
              <TextBlock Text="{Binding PhienBanMoiText, StringFormat='Có bản mới: {0}'}"
                Foreground="#B45309"
                FontWeight="Bold"
                FontSize="13"
                VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <!-- THẺ TÀI KHOẢN ADMIN TÍCH HỢP POPUP MENU (FLYOUT) - KÍNH MỜ -->
          <Button x:Name="AccountButton"
            Classes="accountCard">

            <!-- Giao diện hiển thị Avatar + Tên người đang đăng nhập -->
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border Width="34" Height="34" Background="#147B6B" BorderBrush="#D9B66F" BorderThickness="1.2" CornerRadius="17">
                <TextBlock Text="{Binding ChuiChuCaiHienThi}" Foreground="#FFFDF5" FontWeight="Bold"
                  HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding HoTenHienThi}" Foreground="White" FontWeight="SemiBold" FontSize="12.5" />
                <TextBlock Text="{Binding VaiTroHienThi}" Foreground="#A3DFCE" FontSize="11" />
              </StackPanel>
              <!-- Ký hiệu mũi tên gợi ý có menu -->
              <TextBlock Grid.Column="2" Text="▲" FontSize="9" Foreground="#A3DFCE"
                VerticalAlignment="Center" Margin="0,0,4,0" />
            </Grid>

            <!-- MENU POPUP KHI BẤM VÀO ADMIN -->
            <Button.Flyout>
              <Flyout Placement="TopEdgeAlignedLeft">
                <Border Background="White" CornerRadius="8" Padding="6" Width="200"
                  BoxShadow="0 4 12 #20000000">
                  <StackPanel Spacing="3">

                    <!-- Mục Quản lý tài khoản -->
                    <Button Background="Transparent"
                      BorderThickness="0"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Left"
                      Padding="10,8"
                      Click="OpenUsersButton_OnClick"
                      IsVisible="{Binding CanManageUsers}">
                      <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="👤" FontSize="14" Foreground="#087F6E"
                          VerticalAlignment="Center" />
                        <TextBlock Text="Quản lý tài khoản" FontSize="13" Foreground="#263B35"
                          VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                    <!-- Mục Thông tin tiệm: cùng kiểu với Cài đặt danh mục,
                         chỉ khác là chuyển sang màn hình thay vì mở hộp thoại. -->
                    <Button Background="Transparent"
                      BorderThickness="0"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Left"
                      Padding="10,8"
                      IsVisible="{Binding CanViewStoreInfo}"
                      Click="OpenStoreInfoButton_OnClick">
                      <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="🏪" FontSize="14" Foreground="#087F6E"
                          VerticalAlignment="Center" />
                        <TextBlock Text="Thông tin tiệm" FontSize="13" Foreground="#263B35"
                          VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>

                    <!-- Mục Cài đặt danh mục -->
                    <Button Background="Transparent"
                      BorderThickness="0"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Left"
                      Padding="10,8"
                      IsVisible="{Binding CanViewSettings}"
                      Click="OpenSettingsButton_OnClick">
                      <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="⚙" FontSize="14" Foreground="#087F6E"
                          VerticalAlignment="Center" />
                        <TextBlock Text="Cài đặt danh mục" FontSize="13" Foreground="#263B35"
                          VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>

                    <!-- Mục Cập nhật phần mềm -->
                    <Button Background="Transparent"
                      BorderThickness="0"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Left"
                      Padding="10,8"
                      Click="OpenUpdateWindow_OnClick">
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                          <TextBlock Text="🔄" FontSize="14" Foreground="#087F6E"
                            VerticalAlignment="Center" />
                          <TextBlock Text="Cập nhật phần mềm" FontSize="13" Foreground="#263B35"
                            VerticalAlignment="Center" />
                        </StackPanel>
                        <Border Grid.Column="2" Background="#EF4444" CornerRadius="8" Padding="6,1"
                          IsVisible="{Binding CoBanCapNhatMoi}" VerticalAlignment="Center">
                          <TextBlock Text="MỚI" FontSize="10" Foreground="White" FontWeight="Bold" />
                        </Border>
                      </Grid>
                    </Button>

                    <!-- Mục Đăng xuất -->
                    <Button Background="Transparent"
                      BorderThickness="0"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Left"
                      Padding="10,8"
                      Click="LogoutButton_OnClick">
                      <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="⏻" FontSize="14" Foreground="#C94A3D"
                          VerticalAlignment="Center" />
                        <TextBlock Text="Đăng xuất" FontSize="13" Foreground="#263B35"
                          VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>

                  </StackPanel>
                </Border>
              </Flyout>
            </Button.Flyout>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Column="1" Margin="34,28">
  <Grid IsVisible="{Binding IsSalesPanelVisible}" ZIndex="10" Background="#F4F7F6">
    <Border Background="#FFFFFF" CornerRadius="20" Padding="20" BorderBrush="#D8E5E0"
            BorderThickness="1" Margin="20" BoxShadow="0 10 30 #0A1F1B22">
      <Grid RowDefinitions="Auto,*" ColumnDefinitions="1*,1.1*,1*" ColumnSpacing="16" RowSpacing="16">
        
        <!-- HEADER -->
        <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,4">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Text="Bán hàng" FontSize="24" FontWeight="Bold" Foreground="#163F38" />
              <TextBlock Text="Chọn sản phẩm bên trái, kiểm tra giỏ hàng ở giữa và thanh toán bên phải."
                         Foreground="#61736E" Margin="0,2,0,0" FontSize="13" />

              <TextBlock Text="{Binding StatusMessage}" 
                 Foreground="#D92D20" 
                 FontWeight="SemiBold" 
                 FontSize="13" 
                 Margin="0,4,0,0"
                 IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>

            <Button Grid.Column="1"
                    Classes="toolbar-action"
                    Content="🧾 Đơn mới"
                    VerticalAlignment="Center"
                    Command="{Binding TaoDonMoiCommand}" />
          </Grid>
        </StackPanel>

       <!-- CỘT 1: TÌM KIẾM, LỌC NHÓM & DANH SÁCH SẢN PHẨM -->
        <Grid Grid.Row="1" Grid.Column="0" RowDefinitions="Auto,Auto,*" RowSpacing="8">
          
          <!-- Ô tìm kiếm -->
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="6">
            <Border CornerRadius="8" BorderBrush="#D8E5E0" BorderThickness="1">
              <TextBox Watermark="🔍 Tìm tên, mã hoa..."
                       Text="{Binding SaleSearchText, Mode=TwoWay}"
                       Padding="10,8"
                       TextChanged="OnSaleSearchTextChanged" />
            </Border>
            <Button Grid.Column="1"
                    Classes="toolbar-primary"
                    Content="Tìm"
                    Command="{Binding TimKiemHoaBanCommand}"
                    CommandParameter="{Binding SaleSearchText}" />
          </Grid>

          <!-- ComboBox lọc theo nhóm sản phẩm ở màn hình bán hàng -->
          <ComboBox Grid.Row="1"
                    ItemsSource="{Binding NhomSanPhamOptions}"
                    SelectedItem="{Binding SelectedNhomSanPham, Mode=TwoWay}"
                    PlaceholderText="-- Lọc theo nhóm hàng --"
                    Height="34"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="models:ProductOption">
                <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center"/>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <!-- Danh sách kết quả sản phẩm -->
          <Border Grid.Row="2" Padding="8" CornerRadius="12"
                  BorderBrush="#D8E5E0" BorderThickness="1" Background="#F7FAF9">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding ProductSearchResults}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:SanPham">
                    <Border Margin="0,0,0,8"
                            Padding="8"
                            CornerRadius="8"
                            Background="White"
                            BorderBrush="#D8E5E0"
                            BorderThickness="1">
                      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Border Width="38" Height="38" CornerRadius="6" Background="#DFF5F0" VerticalAlignment="Center">
                          <TextBlock Text="🌼" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <!-- Thông tin sản phẩm: Bấm vào để thêm vào giỏ hàng (nếu hết hàng sẽ tự mở popup sửa tồn kho) -->
                        <Button Grid.Column="1"
                                Classes="productSearchItem"
                                Command="{Binding ElementName=RootWindow, Path=DataContext.ThemVaoGioHangCommand}"
                                CommandParameter="{Binding}">
                          <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{Binding TenSanPham}" FontWeight="SemiBold" Foreground="#163F38" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding GiaBan, StringFormat={}{0:N0} đ}" Foreground="#087F6E" FontWeight="Bold" FontSize="12" />

                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                              <TextBlock Text="Tồn:" Foreground="#666666" FontSize="12" VerticalAlignment="Center"/>

                              <TextBlock Text="{Binding TonKho, StringFormat='{}{0:N0}'}"
                                         IsVisible="{Binding !HetHang}"
                                         FontWeight="Bold" Foreground="#078C7A" FontSize="12" VerticalAlignment="Center"/>

                              <Border Background="#FFEEE2" CornerRadius="4" Padding="6,2"
                                      IsVisible="{Binding HetHang}">
                                <TextBlock Text="Hết hàng"
                                           Foreground="#E53935"
                                           FontWeight="Bold"
                                           FontSize="11"/>
                              </Border>
                            </StackPanel>
                          </StackPanel>
                        </Button>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>
        </Grid>

        <!-- CỘT 2: GIỎ HÀNG (SẢN PHẨM ĐÃ CHỌN) -->
        <Border Grid.Row="1" Grid.Column="1" Padding="12" CornerRadius="12"
                BorderBrush="#D8E5E0" BorderThickness="1" Background="#FFFFFF">
          <Grid RowDefinitions="Auto,*">
            <TextBlock Text="Giỏ hàng đã chọn" FontWeight="Bold" Foreground="#163F38" Margin="0,0,0,8" />
            
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding SaleCart}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:SaleCartItem">
                    <Border BorderBrush="#EAEFE2" BorderThickness="0,0,0,1" Padding="0,6">
                      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="{Binding SanPham.TenSanPham}" FontWeight="SemiBold" Foreground="#163F38" FontSize="13" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding ThanhTien, StringFormat={}{0:N0} đ}" Foreground="#087F6E" FontWeight="Bold" FontSize="12" />
                        </StackPanel>

                        <!-- Tăng/Giảm Số lượng -->
                        <Grid Grid.Column="1" ColumnDefinitions="28,34,28" VerticalAlignment="Center">
                          <Button Content="−" Width="28" Height="28" Padding="0" CornerRadius="4,0,0,4"
                                  Background="#EEF7F4" Foreground="#0C756A" BorderBrush="#CFE6E1" BorderThickness="1,1,0,1"
                                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                  Command="{Binding ElementName=RootWindow, Path=DataContext.GiamSoLuongCommand}"
                                  CommandParameter="{Binding}" />
                          <TextBox Grid.Column="1" Width="34" Height="28" Padding="0" Margin="0" TextAlignment="Center"
                                   HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                   BorderBrush="#CFE6E1" BorderThickness="1" Background="#F8FBFA" FontSize="12"
                                   Text="{Binding SoLuong, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                          <Button Grid.Column="2" Content="+" Width="28" Height="28" Padding="0" CornerRadius="0,4,4,0"
                                  Background="#EEF7F4" Foreground="#0C756A" BorderBrush="#CFE6E1" BorderThickness="0,1,1,1"
                                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                  Command="{Binding ElementName=RootWindow, Path=DataContext.TangSoLuongCommand}"
                                  CommandParameter="{Binding}" />
                        </Grid>

                        <!-- Nút Xóa -->
                        <Button Grid.Column="2" Content="×" Width="24" Height="24" CornerRadius="12"
                                Background="#FDECEC" Foreground="#D92D20" BorderBrush="#F1B7B1" BorderThickness="1"
                                VerticalAlignment="Center" Padding="0"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Command="{Binding ElementName=RootWindow, Path=DataContext.XoaKhoiGioHangCommand}"
                                CommandParameter="{Binding}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </Border>

        <!-- CỘT 3: THÔNG TIN KHÁCH HÀNG & THANH TOÁN -->
        <Border Grid.Row="1" Grid.Column="2" Padding="12" CornerRadius="12"
                BorderBrush="#D8E5E0" BorderThickness="1" Background="#F7FAF9">
          <Grid RowDefinitions="Auto,*,Auto">
            
            <!-- THÔNG TIN KHÁCH HÀNG -->
            <StackPanel Grid.Row="0">
              <TextBlock Text="Khách hàng" Foreground="#61736E" FontSize="12" FontWeight="SemiBold" />
              <TextBox Text="{Binding SaleCustomerName, Mode=TwoWay}"
                       Margin="0,4,0,4"
                       Watermark="Tìm khách hàng..."
                       TextChanged="OnSaleCustomerSearchTextChanged" />
              
              <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,4">
                <Button Content="Khách lẻ" Classes="toolbar-action" Padding="8,4" FontSize="11"
                        Command="{Binding ChonKhachLeCommand}" />
                <Button Content="Danh sách" Classes="toolbar-action" Padding="8,4" FontSize="11"
                        Command="{Binding MoDanhSachKhachBanCommand}" />
              </StackPanel>

              <!-- Thêm khách hàng ngay trong màn Bán hàng -->
              <Button Content="＋ Thêm khách hàng"
                      Classes="toolbar-action"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Center"
                      Padding="8,5"
                      FontSize="11"
                      Margin="0,0,0,4"
                      Command="{Binding ThemKhachHangBanCommand}" />

              <!-- List gợi ý thu gọn -->
              <Border Background="White" BorderBrush="#D8E5E0" BorderThickness="1" CornerRadius="6" MaxHeight="90" Margin="0,0,0,8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <ItemsControl ItemsSource="{Binding SaleCustomerSuggestions}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="models:KhachHang">
                        <Button Content="{Binding TenKhachHang}"
                                Command="{Binding ElementName=RootWindow, Path=DataContext.ChonKhachHangBanCommand}"
                                CommandParameter="{Binding}"
                                HorizontalContentAlignment="Left" Background="Transparent" Foreground="#263B35"
                                BorderThickness="0" Padding="8,4" FontSize="12" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Border>

              <!-- SỐ ĐIỆN THOẠI & ĐỊA CHỈ -->
              <TextBlock Text="Số điện thoại" Foreground="#61736E" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,2" />
              <TextBox Text="{Binding SaleCustomerPhone, Mode=TwoWay}"
                       Watermark="Nhập SĐT khách hàng..."
                       FontSize="12"
                       Margin="0,0,0,4" />

              <TextBlock Text="Địa chỉ" Foreground="#61736E" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,2" />
              <TextBox Text="{Binding SaleCustomerAddress, Mode=TwoWay}"
                       Watermark="Nhập địa chỉ giao hàng / khách..."
                       AcceptsReturn="True"
                       TextWrapping="Wrap"
                       MinHeight="36"
                       MaxHeight="54"
                       FontSize="12"
                       Margin="0,0,0,4" />

              <!-- TÙY CHỌN GIAO HÀNG & IN KÈM SĐT/ĐỊA CHỈ -->
              <CheckBox IsChecked="{Binding SaleCanGiaoHang, Mode=TwoWay}"
                        Content="Giao đến địa chỉ của khách"
                        FontSize="11.5"
                        Margin="0,0,0,2" />

              <CheckBox IsChecked="{Binding SaleInKemSdtDiaChi, Mode=TwoWay}"
                        Content="In kèm SĐT và địa chỉ lên hóa đơn"
                        FontSize="11.5"
                        Margin="0,0,0,4" />

              <!-- GHI CHÚ HÓA ĐƠN -->
              <TextBlock Text="Ghi chú hóa đơn" Foreground="#61736E" FontSize="12"
                FontWeight="SemiBold" Margin="0,0,0,2" />
              <TextBox Text="{Binding SaleGhiChu, Mode=TwoWay}"
                Watermark="Yêu cầu riêng của khách (băng rôn, thiệp chúc...)"
                AcceptsReturn="True"
                TextWrapping="Wrap"
                MinHeight="40"
                MaxHeight="60"
                FontSize="12" />
            </StackPanel>

            <!-- TÍNH TIỀN & THANH TOÁN -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
              <Border Padding="10" CornerRadius="10" Background="#EAF9F5">
                <StackPanel Spacing="6">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Tạm tính" Foreground="#61736E" FontSize="12" />
                    <TextBlock Grid.Column="1" Text="{Binding SaleSubtotal, StringFormat={}{0:N0} đ}" Foreground="#263B35" FontWeight="SemiBold" />
                  </Grid>

                  <Border Height="1" Background="#D5EAE4" />

                  <!-- GIẢM GIÁ -->
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Giảm giá" Foreground="#61736E" FontSize="12" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                      <ComboBox ItemsSource="{Binding DiscountModes}" SelectedItem="{Binding SaleDiscountMode, Mode=TwoWay}" Padding="4,2" FontSize="11" />
                      <TextBox Width="80" Text="{Binding SaleDiscountInput, Mode=TwoWay, Converter={StaticResource ThousandsSeparatorConverter}}"
                               Watermark="0" TextChanged="OnSaleDiscountTextChanged" HorizontalContentAlignment="Right" Padding="4,2" FontSize="12" />
                    </StackPanel>
                  </Grid>

                  

                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Tiền thối" Foreground="#61736E" FontSize="12" />
                    <TextBlock Grid.Column="1" Text="{Binding TienThoi, StringFormat={}{0:N0} đ}" Foreground="#087F6E" FontWeight="Bold" />
                  </Grid>

                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Công nợ" Foreground="#61736E" FontSize="12" />
                    <TextBlock Grid.Column="1" Text="{Binding TienCongNo, StringFormat={}{0:N0} đ}" Foreground="#D64545" FontWeight="Bold" />
                  </Grid>

                  <TextBlock Text="{Binding TrangThaiThanhToan}" Foreground="#087F6E" FontWeight="SemiBold" HorizontalAlignment="Right" FontSize="11" TextWrapping="Wrap" />

                  <Border Height="1" Background="#D5EAE4" />

                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Tổng tiền" Foreground="#163F38" FontWeight="Bold" FontSize="14" />
                    <TextBlock Grid.Column="1" Text="{Binding SaleTotal, StringFormat={}{0:N0} đ}" Foreground="#087F6E" FontWeight="Bold" FontSize="14" />
                  </Grid>

                    <!-- TIỀN KHÁCH ĐƯA -->
                    <Grid ColumnDefinitions="*,Auto"
                      Margin="0,6,0,0">

                      <TextBlock Text="Tiền khách đưa"
                        Foreground="#61736E"
                        VerticalAlignment="Center" />

                      <TextBox Grid.Column="1"
                        Width="160"
                        Text="{Binding TienKhachDua, Mode=OneWay}"
                        TextChanged="OnTienKhachDuaTextChangedUI"
                        HorizontalContentAlignment="Right"
                        Watermark="0" />
                    </Grid>

                    <!-- TIỀN THỐI -->
                    <Grid ColumnDefinitions="*,Auto"
                      Margin="0,6,0,0">

                      <TextBlock Text="Tiền thối"
                        Foreground="#61736E" />

                      <TextBlock Grid.Column="1"
                        Text="{Binding TienThoi, StringFormat={}{0:N0} đ}"
                        Foreground="#087F6E"
                        FontWeight="Bold" />
                    </Grid>

                    <!-- CÔNG NỢ -->
                    <Grid ColumnDefinitions="*,Auto"
                      Margin="0,4,0,0">

                      <TextBlock Text="Công nợ"
                        Foreground="#61736E" />

                      <TextBlock Grid.Column="1"
                        Text="{Binding TienCongNo, StringFormat={}{0:N0} đ}"
                        Foreground="#D64545"
                        FontWeight="Bold" />
                    </Grid>

                    <!-- TRẠNG THÁI -->
                    <TextBlock Text="{Binding TrangThaiThanhToan}"
                      Margin="0,6,0,0"
                      Foreground="#087F6E"
                      FontWeight="SemiBold"
                      HorizontalAlignment="Right"
                      TextWrapping="Wrap" />

                    <!-- ĐƯỜNG PHÂN CÁCH -->
                    <Border Height="1"
                      Background="#D5EAE4"
                      Margin="0,8,0,4" />

                    <!-- TỔNG TIỀN -->
                    <Grid ColumnDefinitions="*,Auto"
                      Margin="0,4,0,0">

                      <TextBlock Text="Tổng tiền"
                        Foreground="#163F38"
                        FontWeight="Bold"
                        FontSize="15" />

                      <TextBlock Grid.Column="1"
                        Text="{Binding SaleTotal, StringFormat={}{0:N0} đ}"
                        Foreground="#087F6E"
                        FontWeight="Bold"
                        FontSize="15" />
                    </Grid>

                  </StackPanel>
                </Border>

            </ScrollViewer>

            <!-- NÚT THAO TÁC -->
            <StackPanel Grid.Row="2" Orientation="Vertical" Spacing="6" Margin="0,8,0,0">
              <Button Classes="toolbar-primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                      Content="{Binding TrangThaiXuLyThanhToan}" IsEnabled="{Binding CanThanhToan}" Command="{Binding ThanhToanCommand}" Height="36" />
              <Button Classes="secondary" Content="Đóng" Command="{Binding DongGiaoDienBanHangCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="36" />
            </StackPanel>

          </Grid>
        </Border>

      </Grid>
    </Border>
  </Grid>

      <Grid IsVisible="{Binding IsTongQuanSelected}" Background="#F4F7F6">
        <views:TongQuanDashboardView DataContext="{Binding Dashboard}" />
      </Grid>

      <TabControl Grid.RowSpan="2" Margin="0"
        SelectedIndex="{Binding SelectedDataTabIndex}"
        IsVisible="{Binding IsDataSectionSelected}">
        <!-- TAB HÀNG HÓA - GIAO DIỆN DẠNG DANH SÁCH GIỐNG ẢNH MẪU -->
        <TabItem Header="Hàng hóa">
          <Grid Margin="0,0,0,0" RowDefinitions="Auto,Auto,*">

            <!-- THANH CÔNG CỤ -->
            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto"
             ColumnSpacing="8"
             Margin="0,0,0,10">

              <TextBox Grid.Column="0" Classes="searchInput"
                Watermark="⌕  Theo mã, tên hàng"
                Text="{Binding ProductSearch, Mode=TwoWay}"
                Height="38"
                VerticalContentAlignment="Center"
                Padding="12,7"
                Margin="0" />

              <!-- COMBOBOX LỌC NHÓM SẢN PHẨM + NÚT THÊM NHANH NHÓM HÀNG -->
              <Grid Grid.Column="1" ColumnDefinitions="Auto,Auto" ColumnSpacing="4">
                <ComboBox ItemsSource="{Binding NhomSanPhamOptions}"
                          SelectedItem="{Binding SelectedNhomSanPham, Mode=TwoWay}"
                          PlaceholderText="Lọc nhóm"
                          Height="38"
                          VerticalAlignment="Center">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="models:ProductOption">
                      <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center"/>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Column="1" Classes="toolbar-action" Content="＋"
                  Height="38" Width="36" Padding="0"
                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                  FontSize="15" FontWeight="Bold"
                  ToolTip.Tip="Thêm nhóm hàng mới"
                  Command="{Binding ThemNhomHangNhanhCommand}"
                  IsVisible="{Binding CanCreateProduct}" />
              </Grid>

              <!-- NÚT SẮP XẾP LINH HOẠT (Tên, Mã, Giá) -->
              <Button Grid.Column="2"
                Classes="toolbar-action"
                Content="⇅ Sắp xếp ▾"
                Margin="0"
                Padding="10,7"
                Height="38">
                <Button.Flyout>
                  <MenuFlyout Placement="BottomEdgeAlignedLeft">
                    <MenuItem Header="Theo Tên sản phẩm" Command="{Binding SapXepTheoTieuChiCommand}" CommandParameter="Tên sản phẩm"/>
                    <MenuItem Header="Theo Mã hàng" Command="{Binding SapXepTheoTieuChiCommand}" CommandParameter="Mã hàng"/>
                    <MenuItem Header="Giá bán tăng dần" Command="{Binding SapXepTheoTieuChiCommand}" CommandParameter="Giá tăng dần"/>
                    <MenuItem Header="Giá bán giảm dần" Command="{Binding SapXepTheoTieuChiCommand}" CommandParameter="Giá giảm dần"/>
                  </MenuFlyout>
                </Button.Flyout>
              </Button>

              <!-- CÁC NÚT CŨ GIỮ NGUYÊN (Đổi lại số thứ tự Grid.Column cho khớp) -->
              <Button Grid.Column="3"
                Classes="toolbar-primary"
                Content="＋  Hàng hóa"
                Command="{Binding ThemSanPhamCommand}"
                Margin="0"
                Height="38"
                IsVisible="{Binding CanCreateProduct}" />

              <Button Grid.Column="4"
                Classes="toolbar-primary"
                Content="＋  Nhập hàng"
                Command="{Binding MoGiaoDienNhapHangCommand}"
                Margin="0"
                Height="38"
                IsVisible="{Binding CanCreatePurchase}" />

              <Button Grid.Column="5"
                Classes="toolbar-action"
                Content="⇩  Import file"
                Command="{Binding ThemSanPhamTuFileCommand}"
                Margin="0"
                Height="38"
                IsVisible="{Binding CanImportProduct}" />

              <Button Grid.Column="6"
                Classes="toolbar-action"
                Content="⇧  Xuất file"
                Margin="0"
                Height="38"
                Padding="14,7"
                IsVisible="{Binding CanExportProduct}"
                Click="OnExportProductsClick" />

            </Grid>

            <!-- DÒNG TRẠNG THÁI -->
            <Grid Grid.Row="1"
              ColumnDefinitions="*,Auto"
              Margin="0,0,0,8">

              <StackPanel Orientation="Horizontal" Spacing="5">
                <TextBlock Text="Danh sách hàng hóa"
                  Foreground="#344054"
                  FontSize="14"
                  FontWeight="SemiBold"
                  VerticalAlignment="Center" />
                <TextBlock Text="•"
                  Foreground="#98A2B3"
                  VerticalAlignment="Center" />
                <TextBlock Text="{Binding SanPhams.Count, StringFormat={}{0} sản phẩm}"
                  Foreground="#667085"
                  FontSize="13"
                  VerticalAlignment="Center" />
              </StackPanel>

              <TextBlock Grid.Column="1"
                Text="{Binding StatusMessage}"
                Foreground="#667085"
                FontSize="12"
                VerticalAlignment="Center"
                TextTrimming="CharacterEllipsis" />
            </Grid>

            <!-- BẢNG HÀNG HÓA -->
            <Border Grid.Row="2"
              Background="White"
              BorderBrush="#D9E2EC"
              BorderThickness="1"
              CornerRadius="8"
              ClipToBounds="True">

              <ScrollViewer HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Auto">

                <Grid MinWidth="1450"
                  RowDefinitions="Auto,*">

                  <!-- HEADER -->
                  <Border Grid.Row="0"
                    Background="#E7F1FB"
                    BorderBrush="#D7E3EF"
                    BorderThickness="0,0,0,1"
                    Padding="8,0">

                    <Grid ColumnDefinitions="42,150,260,120,120,120,120,120,170,130"
                      Height="42">

                      <TextBlock Grid.Column="0"
                        Text=""
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />

                      <TextBlock Grid.Column="1"
                        Text="Mã hàng"
                        FontWeight="SemiBold"
                        Foreground="#344054"
                        VerticalAlignment="Center" />

                      <TextBlock Grid.Column="2"
                        Text="Tên hàng"
                        FontWeight="SemiBold"
                        Foreground="#344054"
                        VerticalAlignment="Center" />

                      <TextBlock Grid.Column="3"
                        Text="Giá bán"
                        FontWeight="SemiBold"
                        Foreground="#344054"
                        HorizontalAlignment="Right"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center" />

                      <TextBlock Grid.Column="4"
                        Text="Giá vốn"
                        FontWeight="SemiBold"
                        Foreground="#344054"
                        HorizontalAlignment="Right"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center" />

                      <TextBlock Grid.Column="5"
                        Text="Tồn kho"
                        FontWeight="SemiBold"
                        Foreground="#344054"
                        HorizontalAlignment="Right"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center" />

                      <TextBlock Grid.Column="6"
                        Text="Khách đặt"
                        FontWeight="SemiBold"
                        Foreground="#344054"
                        HorizontalAlignment="Right"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center" />

                      <TextBlock Grid.Column="7"
                        Text="Đơn vị tính"
                        FontWeight="SemiBold"
                        Foreground="#344054"
                        VerticalAlignment="Center" />

                      <TextBlock Grid.Column="8"
                        Text="Thời gian tạo"
                        FontWeight="SemiBold"
                        Foreground="#344054"
                        VerticalAlignment="Center" />

                      <TextBlock Grid.Column="9"
                        Text="Dự kiến hết hàng"
                        FontWeight="SemiBold"
                        Foreground="#344054"
                        VerticalAlignment="Center" />
                    </Grid>
                  </Border>

                  <!-- DANH SÁCH -->
                  <ItemsControl Grid.Row="1"
                    ItemsSource="{Binding SanPhams}">

                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="models:SanPham">

                        <Border Background="White"
                          BorderBrush="#E4E7EC"
                          BorderThickness="0,0,0,1"
                          Padding="8,0"
                          PointerPressed="OnProductRowPointerPressed">

                          <Grid ColumnDefinitions="42,150,260,120,120,120,120,120,170,130"
                            Height="56">

                            <!-- ẢNH -->
                            <Border Grid.Column="0"
                              Width="30"
                              Height="30"
                              CornerRadius="5"
                              Background="#EAF3FF"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center">

                              <Image Source="{Binding HinhAnhBitmap}"
                                Stretch="Uniform"
                                Width="22"
                                Height="22" />
                            </Border>

                            <!-- MÃ HÀNG -->
                            <TextBlock Grid.Column="1"
                              Text="{Binding MaSanPham}"
                              Foreground="#344054"
                              FontSize="13"
                              VerticalAlignment="Center"
                              TextTrimming="CharacterEllipsis" />

                            <!-- TÊN HÀNG -->
                            <TextBlock Grid.Column="2"
                              Text="{Binding TenSanPham}"
                              Foreground="#344054"
                              FontSize="13"
                              VerticalAlignment="Center"
                              TextWrapping="NoWrap"
                              TextTrimming="CharacterEllipsis" />

                            <!-- GIÁ BÁN: hiển thị + ô sửa nhanh tại chỗ -->
                            <Grid Grid.Column="3"
                              Name="PriceCell">

                              <TextBlock Text="{Binding GiaBan, Converter={StaticResource ThousandsSeparatorConverter}, StringFormat={}{0} đ}"
                                Foreground="#344054"
                                FontSize="13"
                                HorizontalAlignment="Right"
                                Margin="0,0,22,0"
                                VerticalAlignment="Center"
                                IsVisible="{Binding !DangChinhGia}" />

                              <TextBlock Text="✏"
                                FontSize="12"
                                Foreground="#087F6E"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                ToolTip.Tip="Sửa giá bán"
                                IsVisible="{Binding !DangChinhGia}"
                                IsHitTestVisible="False" />

                              <Button Classes="priceEditTrigger"
                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).BatDauChinhGiaBanCommand}"
                                CommandParameter="{Binding}"
                                IsVisible="{Binding !DangChinhGia}"
                                IsEnabled="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DuocSuaGiaBan}"
                                ToolTip.Tip="Sửa giá bán"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Width="22"
                                Height="22"
                                Padding="0" />

                              <StackPanel Name="PriceEditPanel"
                                IsVisible="{Binding DangChinhGia}"
                                Spacing="2">

                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="2">
                                  <TextBox Name="GiaBanInlineTextBox"
                                    Text="{Binding GiaBanDangNhap, Mode=TwoWay}"
                                    Watermark="0"
                                    Padding="6,3"
                                    FontSize="12"
                                    MinWidth="52"
                                    KeyDown="OnInlineGiaBanKeyDown" />
                                  <Button Grid.Column="1"
                                    Classes="priceEditSave"
                                    Content="✓"
                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).LuuGiaBanNhanhCommand}"
                                    CommandParameter="{Binding}"
                                    IsEnabled="{Binding !DangLuGiaBan}" />
                                  <Button Grid.Column="2"
                                    Classes="priceEditCancel"
                                    Content="✕"
                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).HuyChinhGiaBanCommand}"
                                    CommandParameter="{Binding}" />
                                </Grid>

                                <TextBlock Text="{Binding LoiGiaBanNhanh}"
                                  Foreground="#C0392B"
                                  FontSize="10"
                                  TextWrapping="Wrap"
                                  MaxLines="2"
                                  IsVisible="{Binding LoiGiaBanNhanh, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                              </StackPanel>
                            </Grid>

                            <!-- GIÁ VỐN -->
                             
                            <TextBlock Grid.Column="4"
                              Text="{Binding GiaVon, StringFormat={}{0:N0}}"
                              Foreground="#344054"
                              FontSize="13"
                              HorizontalAlignment="Right"
                              Margin="0,0,10,0"
                              VerticalAlignment="Center" />

                            <!-- TỒN KHO -->
                            <TextBlock Grid.Column="5"
                              Text="{Binding TonKhoExcel, Converter={x:Static converters:SoLuongHienThiConverter.Instance}}"
                              Foreground="#344054"
                              FontSize="13"
                              HorizontalAlignment="Right"
                              Margin="0,0,10,0"
                              VerticalAlignment="Center" />

                            <!-- KHÁCH ĐẶT -->
                            <TextBlock Grid.Column="6"
                              Text="{Binding KhachDat, Converter={x:Static converters:SoLuongHienThiConverter.Instance}}"
                              Foreground="#344054"
                              FontSize="13"
                              HorizontalAlignment="Right"
                              Margin="0,0,10,0"
                              VerticalAlignment="Center" />

                            <!-- ĐVT -->
                            <TextBlock Grid.Column="7"
                              Text="{Binding DonViTinh}"
                              Foreground="#667085"
                              FontSize="13"
                              VerticalAlignment="Center"
                              TextTrimming="CharacterEllipsis" />

                            <!-- THỜI GIAN TẠO: lấy đúng ngày giờ trong database (kể cả khi nhập từ Excel).
                                 Ô không có dữ liệu thì để trống, không hiện 01/01/0001. -->
                            <TextBlock Grid.Column="8"
                              Text="{Binding NgayTao, StringFormat={}{0:dd/MM/yyyy HH:mm}, TargetNullValue=''}"
                              Foreground="#667085"
                              FontSize="13"
                              VerticalAlignment="Center" />

                            <!-- DỰ KIẾN HẾT HÀNG -->
                            <TextBlock Grid.Column="9"
                              Text="{Binding DuKienHetHang}"
                              Foreground="#344054"
                              FontSize="13"
                              VerticalAlignment="Center"
                              TextTrimming="CharacterEllipsis" />


                          </Grid>

                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                </Grid>
              </ScrollViewer>
            </Border>

            <!-- DANH SÁCH RỖNG / KHÔNG TÌM THẤY -->
            <StackPanel Grid.Row="2"
              IsVisible="{Binding IsSanPhamListEmpty}"
              Margin="0,90,0,0" Spacing="8"
              VerticalAlignment="Top"
              HorizontalAlignment="Center"
              IsHitTestVisible="False">
              <TextBlock Text="📦" FontSize="34" HorizontalAlignment="Center"
                Foreground="#C3D6D0" />
              <TextBlock Text="{Binding SanPhamEmptyText}" FontSize="16"
                FontWeight="SemiBold" Foreground="#163F38"
                HorizontalAlignment="Center" />
              <TextBlock Text="{Binding SanPhamEmptyHint}" Foreground="#61736E"
                FontSize="13" HorizontalAlignment="Center" />
            </StackPanel>

          </Grid>
        </TabItem>

        <TabItem Header="Khách hàng">
     <TabItem.Styles>
  <!-- Sửa triệt để bằng cách tạo Template mới cho Button.detailTab -->
  <Style Selector="Button.detailTab">
    <Setter Property="Margin" Value="0,0,6,0" />
    <Setter Property="Padding" Value="16,8" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate TargetType="Button">
        <Border x:Name="PART_Border"
                Background="#E2ECE8"
                CornerRadius="8"
                Padding="{TemplateBinding Padding}">
          <TextBlock x:Name="PART_Text"
                     Text="{TemplateBinding Content}"
                     FontSize="13"
                     FontWeight="SemiBold"
                     Foreground="#263B35"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <!-- 1. Trạng thái Hover (Rê chuột) -->
  <Style Selector="Button.detailTab:pointerover /template/ Border#PART_Border">
    <Setter Property="Background" Value="#CBE0D8" />
  </Style>
  <Style Selector="Button.detailTab:pointerover /template/ TextBlock#PART_Text">
    <Setter Property="Foreground" Value="#163F38" />
  </Style>

  <!-- 2. Trạng thái ACTIVE (Khi Classes.active="True") -->
  <Style Selector="Button.detailTab.active /template/ Border#PART_Border">
    <Setter Property="Background" Value="#087F6E" />
  </Style>
  <Style Selector="Button.detailTab.active /template/ TextBlock#PART_Text">
    <Setter Property="Foreground" Value="White" />
  </Style>

  <!-- 3. Trạng thái ACTIVE + HOVER -->
  <Style Selector="Button.detailTab.active:pointerover /template/ Border#PART_Border">
    <Setter Property="Background" Value="#066658" />
  </Style>
  <Style Selector="Button.detailTab.active:pointerover /template/ TextBlock#PART_Text">
    <Setter Property="Foreground" Value="White" />
  </Style>

  <!-- Style cho statBox giữ nguyên -->
  <Style Selector="Border.statBox">
    <Setter Property="Background" Value="White" />
    <Setter Property="BorderBrush" Value="#D9EAE4" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="14,10" />
  </Style>
</TabItem.Styles>

          <Grid RowDefinitions="Auto,Auto,*" Margin="0,14,16,0" RowSpacing="12">

            <!-- 1. THANH CÔNG CỤ -->
            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
              <TextBox Classes="searchInput" Height="38" VerticalAlignment="Top"
                Watermark="🔍 Tìm theo mã, tên, số điện thoại..."
                Text="{Binding CustomerSearch, Mode=TwoWay}"
                TextChanged="OnCustomerSearchTextChanged"
                Margin="0,0,10,0" />
              <Button Grid.Column="1" Classes="toolbar-action" Margin="0,0,10,0"
                x:Name="CustomerFilterButton"
                ToolTip.Tip="Lọc khách hàng theo nhóm và tình trạng công nợ">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="⚙" />
                  <TextBlock Text="{Binding CustomerFilterButtonText}" />
                  <TextBlock Text="{Binding CustomerFilterArrowText}" />
                </StackPanel>

                <Button.Flyout>
                  <Flyout Placement="BottomEdgeAlignedRight"
                    Opened="OnCustomerFilterFlyoutOpened"
                    Closed="OnCustomerFilterFlyoutClosed">
                    <Border Background="#F1F8F5" BorderBrush="#D9EAE4" BorderThickness="1"
                      CornerRadius="10" Padding="14" Width="260"
                      BoxShadow="0 8 20 #30000000">
                      <StackPanel Spacing="10">

                        <TextBlock Text="Nhóm khách hàng" FontSize="12"
                          FontWeight="SemiBold" Foreground="#163F38" />
                        <ComboBox ItemsSource="{Binding CustomerNhomOptions}"
                          SelectedItem="{Binding SelectedCustomerNhom, Mode=TwoWay}"
                          HorizontalAlignment="Stretch"
                          FontSize="13" />

                        <Rectangle Height="1" Fill="#D9EAE4" />

                        <TextBlock Text="Tình trạng công nợ" FontSize="12"
                          FontWeight="SemiBold" Foreground="#163F38" />

                        <StackPanel Spacing="2">
                          <RadioButton GroupName="CustomerCongNo"
                            Content="Tất cả" FontSize="13" Padding="0,6"
                            IsChecked="{Binding CustomerCongNoFilter, Mode=TwoWay, Converter={StaticResource LuaChonRadioConverter}, ConverterParameter=tatca}" />
                          <RadioButton GroupName="CustomerCongNo"
                            Content="Còn nợ" FontSize="13" Padding="0,6"
                            IsChecked="{Binding CustomerCongNoFilter, Mode=TwoWay, Converter={StaticResource LuaChonRadioConverter}, ConverterParameter=conno}" />
                          <RadioButton GroupName="CustomerCongNo"
                            Content="Không còn nợ" FontSize="13" Padding="0,6"
                            IsChecked="{Binding CustomerCongNoFilter, Mode=TwoWay, Converter={StaticResource LuaChonRadioConverter}, ConverterParameter=khongconno}" />
                        </StackPanel>

                        <Rectangle Height="1" Fill="#D9EAE4" />

                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                          <Button Classes="toolbar-action" Content="Xóa" Margin="0"
                            Command="{Binding ClearCustomerFilterCommand}"
                            Click="OnCustomerFilterClearClicked"
                            IsVisible="{Binding CustomerHasFilter}" />
                          <Button Grid.Column="1" Classes="toolbar-primary"
                            Content="🔍 Áp dụng" Margin="0"
                            Command="{Binding ApplyCustomerFilterCommand}"
                            Click="OnCustomerFilterApplyClicked" />
                        </Grid>

                      </StackPanel>
                    </Border>
                  </Flyout>
                </Button.Flyout>
              </Button>
              <Button Grid.Column="2" Classes="toolbar-action" Content="Tìm kiếm"
                Command="{Binding TimKiemKhachHangCommand}"
                Margin="0,0,10,0" />
              <Button Grid.Column="3" Classes="toolbar-action" Content="📁 Nhập file"
                Margin="0,0,10,0"
                Command="{Binding ThemKhachHangTuFileCommand}"
                IsVisible="{Binding CanImportCustomer}" />
              <Button Grid.Column="4" Classes="toolbar-primary" Content="＋ Thêm mới"
                Margin="0"
                Command="{Binding ThemMoiKhachHangCommand}"
                IsVisible="{Binding CanCreateCustomer}" />
            </Grid>

            <!-- 2. THỐNG KÊ THẬT TỪ DATABASE -->
            <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" ColumnSpacing="14">
              <Border Classes="card" Padding="18" Margin="0">
                <StackPanel>
                  <TextBlock Text="Tổng khách hàng" Foreground="#61736E" FontSize="12" />
                  <TextBlock Text="{Binding CustomerAllCount}" FontSize="28" FontWeight="Bold"
                    Foreground="#163F38" Margin="0,6,0,0" />
                  <TextBlock Text="{Binding CustomerRangeText}" FontSize="12" Foreground="#087F6E"
                    Margin="0,2,0,0" />
                </StackPanel>
              </Border>

              <Border Grid.Column="1" Classes="card" Padding="18" Margin="0">
                <StackPanel>
                  <TextBlock Text="Khách hàng mới" Foreground="#61736E" FontSize="12" />
                  <TextBlock Text="{Binding CustomerNewCount}" FontSize="28" FontWeight="Bold"
                    Foreground="#163F38" Margin="0,6,0,0" />
                  <TextBlock Text="{Binding CustomerNewCountCaption}" FontSize="12"
                    Foreground="#087F6E" Margin="0,2,0,0" />
                </StackPanel>
              </Border>

              <Border Grid.Column="2" Classes="card" Padding="18" Margin="0">
                <StackPanel>
                  <TextBlock Text="Nợ hiện tại" Foreground="#61736E" FontSize="12" />
                  <TextBlock Text="{Binding CustomerTotalDebtText}" FontSize="24" FontWeight="Bold"
                    Foreground="#B3261E" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="Tổng công nợ của toàn bộ khách hàng" FontSize="12"
                    Foreground="#087F6E" Margin="0,2,0,0" />
                </StackPanel>
              </Border>

              <Border Grid.Column="3" Classes="card" Padding="18" Margin="0">
                <StackPanel>
                  <TextBlock Text="Tổng bán" Foreground="#61736E" FontSize="12" />
                  <TextBlock Text="{Binding CustomerTotalSalesText}" FontSize="24" FontWeight="Bold"
                    Foreground="#163F38" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="Tổng tiền bán của toàn bộ khách hàng" FontSize="12"
                    Foreground="#087F6E" Margin="0,2,0,0" />
                </StackPanel>
              </Border>
            </Grid>

            <!-- 3. BẢNG KHÁCH HÀNG (DÒNG MỞ RỘNG NGAY DƯỚI DÒNG ĐÃ CHỌN) -->
            <Border Grid.Row="2" Classes="card" Padding="0" Margin="0">
              <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

                <!--
                  TIÊU ĐỀ BẢNG (KHÔNG CUỘN)
                  Padding phải 29px: 16px lề trái + 13px chừa sẵn cho thanh cuộn
                  của vùng danh sách, để cột tiêu đề thẳng hàng với dòng dữ liệu
                  bên dưới khi thanh cuộn xuất hiện.
                -->
                <Border Padding="16,14,29,14" BorderBrush="#E2ECE8" BorderThickness="0,0,0,1"
                  Background="#F1F8F5">
                  <Grid ColumnDefinitions="120,*,150,150,160,190,40" ColumnSpacing="10">

                    <TextBlock Grid.Column="0" Text="MÃ KHÁCH HÀNG" FontWeight="SemiBold"
                      Foreground="#164B40" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="TÊN KHÁCH HÀNG" FontWeight="SemiBold"
                      Foreground="#164B40" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="ĐIỆN THOẠI" FontWeight="SemiBold"
                      Foreground="#164B40" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="NỢ HIỆN TẠI" FontWeight="SemiBold"
                      Foreground="#164B40" FontSize="12" VerticalAlignment="Center"
                      HorizontalAlignment="Right" TextAlignment="Right" />
                    <TextBlock Grid.Column="4" Text="TỔNG BÁN" FontWeight="SemiBold"
                      Foreground="#164B40" FontSize="12" VerticalAlignment="Center"
                      HorizontalAlignment="Right" TextAlignment="Right" />
                    <TextBlock Grid.Column="5" Text="TỔNG BÁN TRỪ TRẢ HÀNG" FontWeight="SemiBold"
                      Foreground="#164B40" FontSize="12" VerticalAlignment="Center"
                      HorizontalAlignment="Right" TextAlignment="Right" />
                  </Grid>
                </Border>

                <!-- ĐANG TẢI -->
                <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="3"
                  Foreground="#087F6E" Background="Transparent"
                  IsVisible="{Binding IsLoadingCustomers}" />

                <!-- DANH SÁCH RỖNG -->
                <StackPanel Grid.Row="2" IsVisible="{Binding IsCustomerListEmpty}"
                  Margin="0,40,0,40" Spacing="8">
                  <TextBlock Text="👤" FontSize="34" HorizontalAlignment="Center"
                    Foreground="#C3D6D0" />
                  <TextBlock Text="{Binding CustomerEmptyText}" FontSize="16" FontWeight="SemiBold"
                    Foreground="#163F38" HorizontalAlignment="Center" />
                  <TextBlock Text="{Binding CustomerEmptyHint}"
                    Foreground="#61736E" FontSize="13" HorizontalAlignment="Center" />
                </StackPanel>

                <!--
                  CÁC DÒNG KHÁCH HÀNG - ĐƯỢC CUỘN DỌC

                  ItemsControl mặc định KHÔNG có thanh cuộn: nó đo các dòng con với
                  chiều cao vô hạn rồi bị hàng lưới cắt, nên chỉ thấy vài dòng đầu và
                  không kéo xuống được. Bọc ScrollViewer quanh ItemsControl là cách
                  đúng trong Avalonia. KHÔNG bọc cả khung bảng để tiêu đề, thanh tìm
                  kiếm, thống kê và phân trang không bị cuộn theo.
                  VerticalScrollBarVisibility="Visible" giữ chiều rộng vùng cuộn luôn
                  cố định 13px nên tiêu đề không bị lệch cột.
                -->
                <ScrollViewer Grid.Row="3" Classes="listScroll"
                  IsVisible="{Binding HasCustomerRows}">

                  <ItemsControl ItemsSource="{Binding CustomerRows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:KhachHangRowViewModel">
                      <Border Classes="customerRow" BorderBrush="#EDF3F1" BorderThickness="0,0,0,1"
                        PointerPressed="OnCustomerRowPointerPressed">

                        <StackPanel>

                          <!-- DÒNG CHÍNH -->
                          <Grid ColumnDefinitions="120,*,150,150,160,190,40" ColumnSpacing="10"
                            Height="54" Margin="16,0,16,0">

                            <TextBlock Grid.Column="0" Text="{Binding MaKhachHang}" FontSize="12"
                              Foreground="#667A74" VerticalAlignment="Center"
                              TextTrimming="CharacterEllipsis" />

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="9"
                              VerticalAlignment="Center">
                              <Border Width="30" Height="30" CornerRadius="15"
                                Background="#E3F2ED" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ChuCaiDau}" FontSize="12" FontWeight="Bold"
                                  Foreground="#087F6E" HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                              </Border>
                              <TextBlock Text="{Binding TenKhachHang}" FontSize="13" FontWeight="SemiBold"
                                Foreground="#163F38" VerticalAlignment="Center"
                                TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <TextBlock Grid.Column="2" Text="{Binding SoDienThoai}" FontSize="12"
                              Foreground="#344B45" VerticalAlignment="Center"
                              TextTrimming="CharacterEllipsis" />

                            <TextBlock Grid.Column="3" Text="{Binding NoHienTaiText}" FontSize="12"
                              Foreground="{Binding NoHienTaiForeground}" VerticalAlignment="Center"
                              HorizontalAlignment="Right" TextAlignment="Right"
                              FontWeight="SemiBold" />

                            <TextBlock Grid.Column="4" Text="{Binding TongBanText}" FontSize="12"
                              Foreground="#344B45" VerticalAlignment="Center"
                              HorizontalAlignment="Right" TextAlignment="Right" />

                            <TextBlock Grid.Column="5" Text="{Binding TongBanTruTraHangText}" FontSize="12"
                              Foreground="#344B45" VerticalAlignment="Center"
                              HorizontalAlignment="Right" TextAlignment="Right" />

                            <TextBlock Grid.Column="6" Text="{Binding KyHieuMoRong}" FontSize="11"
                              Foreground="#087F6E" VerticalAlignment="Center"
                              HorizontalAlignment="Center" />
                          </Grid>

                          <!-- VÙNG CHI TIẾT MỞ RỘNG -->
                          <Border Name="DetailPanel" IsVisible="{Binding IsExpanded}"
                            Background="#F3F8F6" BorderBrush="#D9EAE4"
                            BorderThickness="0,1,0,0" Padding="18,16">

                            <StackPanel Spacing="14">

                              <!-- TÊN + NÚT SỬA / XÓA -->
                              <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="14">
                                <Border Width="42" Height="42" CornerRadius="21" Background="#087F6E">
                                  <TextBlock Text="{Binding Detail.ChuCaiDau}" Foreground="White"
                                    FontSize="16" FontWeight="Bold"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                  <TextBlock Text="{Binding Detail.TenKhachHang}" FontSize="18"
                                    FontWeight="Bold" Foreground="#163F38" />
                                  <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding MaKhachHang}" FontSize="12"
                                      Foreground="#667A74" />
                                    <TextBlock Text="•" FontSize="12" Foreground="#B4C4BF" />
                                    <TextBlock Text="{Binding SoDienThoai}" FontSize="12"
                                      Foreground="#667A74" />
                                    <TextBlock Text="•" FontSize="12" Foreground="#B4C4BF" />
                                    <TextBlock Text="{Binding Detail.NhomKhachHang}" FontSize="12"
                                      Foreground="#087F6E" />
                                  </StackPanel>
                                </StackPanel>

                                <Button Grid.Column="2" Classes="toolbar-action" Content="✏ Sửa"
                                  Margin="0,0,8,0" Command="{Binding SuaCommand}"
                                  IsVisible="{Binding $parent[Window].DataContext.CanEditCustomer}" />
                                <Button Grid.Column="3" Classes="toolbar-action" Content="🗑 Xóa"
                                  Margin="0" Command="{Binding XoaCommand}"
                                  IsVisible="{Binding $parent[Window].DataContext.CanDeleteCustomer}" />
                              </Grid>

                              <!-- ĐANG TẢI CHI TIẾT -->
                              <ProgressBar IsIndeterminate="True" Height="4" Foreground="#087F6E"
                                Background="Transparent" IsVisible="{Binding Detail.IsLoading}" />

                              <!-- Ô THỐNG KÊ NHANH (BẤM ĐỂ MỞ TAB TƯƠNG ỨNG) -->
                              <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">

                                <Border Grid.Column="0" Classes="statBox" Tag="lichsu"
                                  PointerPressed="OnCustomerSummaryPressed">
                                  <StackPanel>
                                    <TextBlock Text="Tổng chi tiêu" FontSize="11" Foreground="#61736E" />
                                    <TextBlock Text="{Binding Detail.TongTienDaMuaText}" FontSize="17"
                                      FontWeight="Bold" Foreground="#163F38" Margin="0,3,0,0" />
                                  </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Classes="statBox" Tag="lichsu"
                                  PointerPressed="OnCustomerSummaryPressed">
                                  <StackPanel>
                                    <TextBlock Text="Đã thanh toán" FontSize="11" Foreground="#61736E" />
                                    <TextBlock Text="{Binding Detail.TongDaThanhToanText}" FontSize="17"
                                      FontWeight="Bold" Foreground="#087F6E" Margin="0,3,0,0" />
                                  </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Classes="statBox" Tag="congno"
                                  PointerPressed="OnCustomerSummaryPressed">
                                  <StackPanel>
                                    <TextBlock Text="Công nợ hiện tại" FontSize="11" Foreground="#61736E" />
                                    <TextBlock Text="{Binding Detail.TongCongNoText}" FontSize="17"
                                      FontWeight="Bold" Foreground="#D64545" Margin="0,3,0,0" />
                                  </StackPanel>
                                </Border>

                                <Border Grid.Column="3" Classes="statBox" Tag="lichsu"
                                  PointerPressed="OnCustomerSummaryPressed">
                                  <StackPanel>
                                    <TextBlock Text="Số hóa đơn" FontSize="11" Foreground="#61736E" />
                                    <TextBlock Text="{Binding Detail.SoHoaDonText}" FontSize="17"
                                      FontWeight="Bold" Foreground="#163F38" Margin="0,3,0,0" />
                                  </StackPanel>
                                </Border>

                              </Grid>

                              <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Tổng bán trừ trả hàng" FontSize="11"
                                  Foreground="#61736E" />
                                <TextBlock Text="{Binding Detail.TongBanTruTraHangText}" FontSize="11"
                                  Foreground="#087F6E" FontWeight="SemiBold" />
                              </StackPanel>

                            <!-- TAB: THÔNG TIN / LỊCH SỬ MUA HÀNG / CÔNG NỢ -->
<StackPanel Orientation="Horizontal">

  <!-- TAB 1: THÔNG TIN -->
  <Button Command="{Binding Detail.ChonTabCommand}"
          CommandParameter="thongtin"
          Classes.active="{Binding Detail.IsTabThongTin}"
          Margin="0,0,6,0" Padding="16,8" CornerRadius="8" Cursor="Hand" BorderThickness="0">
    <Button.Styles>
      <Style Selector="Button">
        <Setter Property="Background" Value="#E2ECE8" />
      </Style>
      <Style Selector="Button.active">
        <Setter Property="Background" Value="#087F6E" />
      </Style>
    </Button.Styles>
    <TextBlock Text="Thông tin" FontSize="13" FontWeight="SemiBold">
      <TextBlock.Styles>
        <Style Selector="TextBlock">
          <Setter Property="Foreground" Value="#163F38" />
        </Style>
        <Style Selector="Button.active TextBlock">
          <Setter Property="Foreground" Value="White" />
        </Style>
      </TextBlock.Styles>
    </TextBlock>
  </Button>

  <!-- TAB 2: LỊCH SỬ MUA HÀNG -->
  <Button Command="{Binding Detail.ChonTabCommand}"
          CommandParameter="lichsu"
          Classes.active="{Binding Detail.IsTabLichSuMuaHang}"
          Margin="0,0,6,0" Padding="16,8" CornerRadius="8" Cursor="Hand" BorderThickness="0">
    <Button.Styles>
      <Style Selector="Button">
        <Setter Property="Background" Value="#E2ECE8" />
      </Style>
      <Style Selector="Button.active">
        <Setter Property="Background" Value="#087F6E" />
      </Style>
    </Button.Styles>
    <TextBlock Text="Lịch sử mua hàng" FontSize="13" FontWeight="SemiBold">
      <TextBlock.Styles>
        <Style Selector="TextBlock">
          <Setter Property="Foreground" Value="#163F38" />
        </Style>
        <Style Selector="Button.active TextBlock">
          <Setter Property="Foreground" Value="White" />
        </Style>
      </TextBlock.Styles>
    </TextBlock>
  </Button>

  <!-- TAB 3: CÔNG NỢ -->
  <Button Command="{Binding Detail.ChonTabCommand}"
          CommandParameter="congno"
          Classes.active="{Binding Detail.IsTabCongNo}"
          Margin="0,0,6,0" Padding="16,8" CornerRadius="8" Cursor="Hand" BorderThickness="0">
    <Button.Styles>
      <Style Selector="Button">
        <Setter Property="Background" Value="#E2ECE8" />
      </Style>
      <Style Selector="Button.active">
        <Setter Property="Background" Value="#087F6E" />
      </Style>
    </Button.Styles>
    <TextBlock Text="Công nợ" FontSize="13" FontWeight="SemiBold">
      <TextBlock.Styles>
        <Style Selector="TextBlock">
          <Setter Property="Foreground" Value="#163F38" />
        </Style>
        <Style Selector="Button.active TextBlock">
          <Setter Property="Foreground" Value="White" />
        </Style>
      </TextBlock.Styles>
    </TextBlock>
  </Button>

</StackPanel>

                              <!-- TAB 1: THÔNG TIN -->
                              <Grid IsVisible="{Binding Detail.IsTabThongTin}"
                                RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                                RowSpacing="10">

                                <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                                  <StackPanel>
                                    <TextBlock Text="Số điện thoại" Foreground="#61736E" FontSize="12" />
                                    <TextBlock Text="{Binding Detail.SoDienThoai}" FontSize="13"
                                      Foreground="#263B35" Margin="0,4,0,0" />
                                  </StackPanel>
                                  <StackPanel Grid.Column="1">
                                    <TextBlock Text="Email" Foreground="#61736E" FontSize="12" />
                                    <TextBlock Text="{Binding Detail.Email}" FontSize="13"
                                      Foreground="#263B35" Margin="0,4,0,0" TextWrapping="Wrap" />
                                  </StackPanel>
                                  
                                </Grid>

                                <StackPanel Grid.Row="1">
                                  <TextBlock Text="Địa chỉ" Foreground="#61736E" FontSize="12" />
                                  <TextBlock Text="{Binding Detail.DiaChiDayDu}" FontSize="13"
                                    Foreground="#263B35" Margin="0,4,0,0" TextWrapping="Wrap" />
                                </StackPanel>

                                <Grid Grid.Row="2" ColumnDefinitions="*,*,*,*" ColumnSpacing="14">
                                  <StackPanel>
                                    <TextBlock Text="Loại khách hàng" Foreground="#61736E" FontSize="12" />
                                    <TextBlock Text="{Binding Detail.LoaiKhachHangHienThi}" FontSize="13"
                                      Foreground="#263B35" Margin="0,4,0,0" />
                                  </StackPanel>
                                  <StackPanel Grid.Column="1">
                                    <TextBlock Text="Giới tính" Foreground="#61736E" FontSize="12" />
                                    <TextBlock Text="{Binding Detail.GioiTinh}" FontSize="13"
                                      Foreground="#263B35" Margin="0,4,0,0" />
                                  </StackPanel>
                                  <StackPanel Grid.Column="2">
                                    <TextBlock Text="Ngày sinh" Foreground="#61736E" FontSize="12" />
                                    <TextBlock Text="{Binding Detail.NgaySinhText}" FontSize="13"
                                      Foreground="#263B35" Margin="0,4,0,0" />
                                  </StackPanel>
                                  <StackPanel Grid.Column="3">
                                    <TextBlock Text="Ngày tạo" Foreground="#61736E" FontSize="12" />
                                    <TextBlock Text="{Binding Detail.NgayTaoText}" FontSize="13"
                                      Foreground="#263B35" Margin="0,4,0,0" />
                                  </StackPanel>
                                </Grid>

                                <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="14">
                                  <StackPanel>
                                    <TextBlock Text="Mã số thuế" Foreground="#61736E" FontSize="12" />
                                    <TextBlock Text="{Binding Detail.MaSoThue}" FontSize="13"
                                      Foreground="#263B35" Margin="0,4,0,0" />
                                  </StackPanel>
                                  <StackPanel Grid.Column="1">
                                    <TextBlock Text="Tên công ty" Foreground="#61736E" FontSize="12" />
                                    <TextBlock Text="{Binding Detail.TenCongTy}" FontSize="13"
                                      Foreground="#263B35" Margin="0,4,0,0" TextWrapping="Wrap" />
                                  </StackPanel>
                                </Grid>

                                <Grid Grid.Row="4" ColumnDefinitions="*,*" ColumnSpacing="14">
                                  <StackPanel>
                                    <TextBlock Text="Người mua hóa đơn" Foreground="#61736E" FontSize="12" />
                                    <TextBlock Text="{Binding Detail.TenNguoiMuaHoaDon}" FontSize="13"
                                      Foreground="#263B35" Margin="0,4,0,0" TextWrapping="Wrap" />
                                  </StackPanel>
                                  <StackPanel Grid.Column="1">
                                    <TextBlock Text="Địa chỉ xuất hóa đơn" Foreground="#61736E" FontSize="12" />
                                    <TextBlock Text="{Binding Detail.DiaChiXuatHoaDon}" FontSize="13"
                                      Foreground="#263B35" Margin="0,4,0,0" TextWrapping="Wrap" />
                                  </StackPanel>
                                </Grid>

                                <StackPanel Grid.Row="5">
                                  <TextBlock Text="Ghi chú" Foreground="#61736E" FontSize="12" />
                                  <TextBlock Text="{Binding Detail.GhiChu}" FontSize="13"
                                    Foreground="#263B35" Margin="0,4,0,0" TextWrapping="Wrap" />
                                </StackPanel>

                              </Grid>

                              <!-- TAB 2: LỊCH SỬ MUA HÀNG -->
                              <StackPanel IsVisible="{Binding Detail.IsTabLichSuMuaHang}" Spacing="10">

                                <TextBlock Text="Danh sách hóa đơn của khách hàng"
                                  Foreground="#61736E" FontSize="12" />

                                <TextBlock Text="{Binding Detail.LichSuMuaHangRongText}"
                                  IsVisible="{Binding !Detail.HasLichSuMuaHang}"
                                  Foreground="#98A2B3" FontSize="13" Margin="0,10,0,0" />

                                <ItemsControl ItemsSource="{Binding Detail.HoaDons}"
                                  IsVisible="{Binding Detail.HasLichSuMuaHang}">
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:HoaDon">
                                      <Border BorderBrush="#E2ECE8" BorderThickness="0,0,0,1"
                                        Padding="0,9">
                                        <Grid ColumnDefinitions="170,150,*,120,120,120" ColumnSpacing="10">
                                          <!-- Mã hóa đơn: bấm để xem chi tiết hóa đơn -->
                                          <Button Classes="customerLink"
                                            Content="{Binding MaHoaDon}"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="#087F6E"
                                            VerticalAlignment="Center"
                                            ToolTip.Tip="Bấm để xem chi tiết hóa đơn"
                                            Command="{Binding ElementName=RootWindow, Path=DataContext.XemHoaDonCommand}"
                                            CommandParameter="{Binding}" />
                                          <TextBlock Grid.Column="1" Text="{Binding ThoiGianBanText}"
                                            FontSize="12" Foreground="#667A74"
                                            VerticalAlignment="Center" />
                                          <TextBlock Grid.Column="2" Text="{Binding TenKhachHang}"
                                            FontSize="12" Foreground="#344B45"
                                            VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                          <TextBlock Grid.Column="3"
                                            Text="{Binding KhachCanTra, StringFormat={}{0:N0} đ}"
                                            FontSize="12" FontWeight="SemiBold" Foreground="#087F6E"
                                            HorizontalAlignment="Right" VerticalAlignment="Center" />
                                          <TextBlock Grid.Column="4"
                                            Text="{Binding KhachDaThanhToan, StringFormat={}{0:N0} đ}"
                                            FontSize="12" Foreground="#344B45"
                                            HorizontalAlignment="Right" VerticalAlignment="Center" />
                                          <TextBlock Grid.Column="5"
                                            Text="{Binding ConNo, StringFormat={}{0:N0} đ}"
                                            FontSize="12" FontWeight="SemiBold" Foreground="#D64545"
                                            HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                      </Border>
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>

                              </StackPanel>

                              <!-- TAB 3: CÔNG NỢ -->
                              <StackPanel IsVisible="{Binding Detail.IsTabCongNo}" Spacing="12">

                                <Border Classes="statBox" Background="White"
                                  IsVisible="{Binding Detail.HasCongNoData}">
                                  <Grid ColumnDefinitions="*,*,*" ColumnSpacing="14">
                                    <StackPanel>
                                      <TextBlock Text="Tổng tiền đã mua" FontSize="11"
                                        Foreground="#61736E" />
                                      <TextBlock Text="{Binding Detail.TongTienDaMuaText}" FontSize="18"
                                        FontWeight="Bold" Foreground="#163F38" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                      <TextBlock Text="Đã thanh toán" FontSize="11"
                                        Foreground="#61736E" />
                                      <TextBlock Text="{Binding Detail.TongDaThanhToanText}" FontSize="18"
                                        FontWeight="Bold" Foreground="#087F6E" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                      <TextBlock Text="Còn nợ" FontSize="11" Foreground="#61736E" />
                                      <TextBlock Text="{Binding Detail.TongCongNoText}" FontSize="18"
                                        FontWeight="Bold" Foreground="#D64545" Margin="0,3,0,0" />
                                    </StackPanel>
                                  </Grid>
                                </Border>

                                <TextBlock Text="{Binding Detail.CongNoRongText}"
                                  IsVisible="{Binding !Detail.HasCongNoData}"
                                  Foreground="#98A2B3" FontSize="13" />

                                <StackPanel IsVisible="{Binding Detail.HasCongNoData}" Spacing="4">
                                  <TextBlock Text="{Binding Detail.NguonCongNoText}" FontSize="12"
                                    Foreground="#61736E" />
                                  <TextBlock Text="{Binding Detail.SoLanGhiCongNoText}" FontSize="12"
                                    Foreground="#667A74" />
                                  <TextBlock FontSize="12" Foreground="#667A74"
                                    Text="{Binding Detail.LanGhiCongNoText, StringFormat='Lần ghi công nợ gần nhất: {0}'}" />
                                </StackPanel>

                                <!-- THANH TOÁN CÔNG NỢ: trừ dần vào các hóa đơn còn nợ -->
                                <Button Content="💵 Thanh toán công nợ"
                                  Padding="16,8"
                                  CornerRadius="8"
                                  Background="#087F6E"
                                  Foreground="White"
                                  FontWeight="SemiBold"
                                  BorderThickness="0"
                                  Cursor="Hand"
                                  HorizontalAlignment="Right"
                                  IsVisible="{Binding Detail.CongNoDuong}"
                                  ToolTip.Tip="Nhập số tiền khách trả, hệ thống tự trừ vào các hóa đơn còn nợ"
                                  Command="{Binding ElementName=RootWindow, Path=DataContext.ThuNoKhachHangCommand}"
                                  CommandParameter="{Binding}" />

                              </StackPanel>

                            </StackPanel>

                          </Border>

                        </StackPanel>

                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                  </ItemsControl>

                </ScrollViewer>

                <!-- PHÂN TRANG -->
                <Border Grid.Row="4" Padding="16,12" BorderBrush="#E2ECE8" BorderThickness="0,1,0,0">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">

                    <TextBlock Grid.Column="0" Text="{Binding CustomerRangeText}" FontSize="12"
                      Foreground="#163F38" FontWeight="SemiBold" VerticalAlignment="Center"
                      HorizontalAlignment="Center" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                      VerticalAlignment="Center">

                      <Button Classes="toolbar-action" Content="⏮" Width="34" Height="30"
                        Padding="0" FontSize="12" ToolTip.Tip="Về trang đầu" Margin="0"
                        Command="{Binding CustomerTrangDauCommand}" />

                      <Button Classes="toolbar-action" Content="◀" Width="34" Height="30"
                        Padding="0" FontSize="11" ToolTip.Tip="Trang trước" Margin="0"
                        IsEnabled="{Binding CanCustomerTrangTruoc}"
                        Command="{Binding CustomerTrangTruocCommand}" />

                      <Border Background="#087F6E" CornerRadius="8" MinWidth="38" Height="30"
                        Padding="10,0">
                        <TextBlock Text="{Binding CustomerPage}" Foreground="White" FontWeight="Bold"
                          FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>

                      <TextBlock Text="trên" FontSize="12" Foreground="#61736E"
                        VerticalAlignment="Center" />

                      <TextBlock Text="{Binding CustomerTotalPages}" FontSize="12" Foreground="#163F38"
                        FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0" />

                      <Button Classes="toolbar-action" Content="▶" Width="34" Height="30"
                        Padding="0" FontSize="11" ToolTip.Tip="Trang sau" Margin="0"
                        IsEnabled="{Binding CanCustomerTrangSau}"
                        Command="{Binding CustomerTrangSauCommand}" />

                      <Button Classes="toolbar-action" Content="⏭" Width="34" Height="30"
                        Padding="0" FontSize="12" ToolTip.Tip="Về trang cuối" Margin="0"
                        Command="{Binding CustomerTrangCuoiCommand}" />

                    </StackPanel>

                  </Grid>
                </Border>

              </Grid>
            </Border>

          </Grid>
        </TabItem>

        <TabItem Header="Hóa đơn">
          <Grid RowDefinitions="Auto,Auto,*" Margin="0,10,0,0" RowSpacing="14">

            <!-- 1. TIÊU ĐỀ & LÀM MỚI -->
            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
              <StackPanel>
                <TextBlock Text="Quản lý hóa đơn"
                  FontSize="24"
                  FontWeight="Bold"
                  Foreground="#163F38" />
                <TextBlock Text="Theo dõi các hóa đơn bán hàng và công nợ khách hàng"
                  Foreground="#61736E"
                  FontSize="13"
                  Margin="0,3,0,0" />
              </StackPanel>

              <StackPanel Grid.Column="1"
                Orientation="Horizontal"
                Spacing="8">
                <Button Classes="toolbar-action"
                  Content="⇩ Nhập từ file"
                  Command="{Binding NhapHoaDonTuFileCommand}"
                  IsVisible="{Binding CanImportInvoice}" />

                <Button Classes="toolbar-action"
                  Content="↻ Làm mới"
                  Command="{Binding ClearInvoiceSearchCommand}" />
              </StackPanel>
            </Grid>

            <!-- 2. THANH TÌM KIẾM (ĐÃ BỎ NÚT XÓA TÌM KIẾM) -->
            <Border Grid.Row="1"
              Background="White"
              BorderBrush="#E2ECE8"
              BorderThickness="1"
              CornerRadius="12"
              Padding="14,10"
              BoxShadow="0 2 8 #080A352E">
              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                <TextBox Classes="searchInput"
                  Watermark="🔍 Tìm theo mã hóa đơn hoặc tên khách hàng..."
                  Text="{Binding InvoiceSearch, Mode=TwoWay}"
                  Height="38"
                  VerticalContentAlignment="Center"
                  Padding="12,0" />

                <Button Grid.Column="1"
                  Classes="toolbar-primary"
                  Content="Tìm kiếm"
                  Height="38"
                  Padding="18,0"
                  Command="{Binding SearchInvoicesCommand}" />

                <!-- LỌC NHANH: TẤT CẢ / ĐÃ THANH TOÁN / CÒN NỢ -->
                <StackPanel Grid.Column="2"
                  Orientation="Horizontal"
                  Spacing="6"
                  VerticalAlignment="Center">
                  <Button Classes="filterChip"
                    Classes.active="{Binding IsInvoiceFilterAll}"
                    Content="Tất cả"
                    Command="{Binding LocHoaDonCommand}"
                    CommandParameter="ALL" />
                  <Button Classes="filterChip"
                    Classes.active="{Binding IsInvoiceFilterPaid}"
                    Content="Đã thanh toán"
                    Command="{Binding LocHoaDonCommand}"
                    CommandParameter="PAID" />
                  <Button Classes="filterChip"
                    Classes.active="{Binding IsInvoiceFilterDebt}"
                    Content="Còn nợ"
                    Command="{Binding LocHoaDonCommand}"
                    CommandParameter="DEBT" />
                </StackPanel>
              </Grid>
            </Border>

            <!-- 3. DANH SÁCH HÓA ĐƠN -->
            <Border Grid.Row="2"
              Background="White"
              BorderBrush="#E2ECE8"
              BorderThickness="1"
              CornerRadius="12"
              ClipToBounds="True"
              BoxShadow="0 4 16 #0A0A352E">
              <Grid RowDefinitions="Auto,*">

                <!-- HEADER BẢNG -->
                <Border Background="#EBF5F1"
                  BorderBrush="#D5EAE3"
                  BorderThickness="0,0,0,1"
                  Padding="16,12">
                  <Grid ColumnDefinitions="200,160,*,140,140,140,140,64,56" ColumnSpacing="12">
                    <TextBlock Text="MÃ HÓA ĐƠN" FontWeight="Bold" Foreground="#164B40"
                      FontSize="12" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="THỜI GIAN" FontWeight="Bold"
                      Foreground="#164B40" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="KHÁCH HÀNG" FontWeight="Bold"
                      Foreground="#164B40" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="TỔNG TIỀN" FontWeight="Bold"
                      Foreground="#164B40" FontSize="12" HorizontalAlignment="Right"
                      VerticalAlignment="Center" />
                    <TextBlock Grid.Column="4" Text="ĐÃ TRẢ" FontWeight="Bold" Foreground="#164B40"
                      FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="5" Text="CÒN NỢ" FontWeight="Bold" Foreground="#164B40"
                      FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="6" Text="TRẠNG THÁI" FontWeight="Bold"
                      Foreground="#164B40" FontSize="12" HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
                    <TextBlock Grid.Column="7" Text="THU NỢ" FontWeight="Bold"
                      Foreground="#164B40" FontSize="12" HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
                    <TextBlock Grid.Column="8" Text="XEM" FontWeight="Bold"
                      Foreground="#164B40" FontSize="12" HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
                  </Grid>
                </Border>

                <!-- NỘI DUNG DỮ LIỆU -->
                <ListBox Grid.Row="1"
                  ItemsSource="{Binding HoaDons}"
                  Background="Transparent"
                  BorderThickness="0">
                  <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                      <Setter Property="Padding" Value="0" />
                      <Setter Property="Margin" Value="0" />
                    </Style>
                    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                      <Setter Property="Background" Value="#F4FAF8" />
                    </Style>
                  </ListBox.Styles>

                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:HoaDon">
                      <Border BorderBrush="#EEF3F1" BorderThickness="0,0,0,1" Padding="16,12"
                        Background="Transparent"
                        DoubleTapped="InvoiceRow_OnDoubleTapped">
                        <Grid ColumnDefinitions="200,160,*,140,140,140,140,64,56" ColumnSpacing="12"
                          VerticalAlignment="Center">

                          <!-- Mã hóa đơn: bấm để xem chi tiết hóa đơn -->
                          <Button Classes="customerLink"
                            Content="{Binding MaHoaDon}"
                            FontWeight="SemiBold"
                            Foreground="#087F6E"
                            VerticalAlignment="Center"
                            ToolTip.Tip="Bấm để xem chi tiết hóa đơn"
                            Command="{Binding ElementName=RootWindow, Path=DataContext.XemHoaDonCommand}"
                            CommandParameter="{Binding}" />

                          <!-- Thời gian -->
                          <TextBlock Grid.Column="1"
                            Text="{Binding ThoiGianBan, StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                            Foreground="#667A74"
                            FontSize="12"
                            VerticalAlignment="Center" />

                          <!-- Khách hàng (kèm ghi chú hóa đơn nếu có) -->
                          <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <TextBlock Text="👤" FontSize="11" Foreground="#8FA39D"
                                VerticalAlignment="Center" />
                              <Button Classes="customerLink"
                                Content="{Binding TenKhachHang, FallbackValue='Khách lẻ'}"
                                VerticalAlignment="Center"
                                ToolTip.Tip="Bấm để xem chi tiết hóa đơn"
                                Command="{Binding ElementName=RootWindow, Path=DataContext.XemHoaDonCommand}"
                                CommandParameter="{Binding}" />
                            </StackPanel>
                            <TextBlock Text="{Binding GhiChu}"
                              IsVisible="{Binding CoGhiChu}"
                              FontSize="11"
                              Foreground="#B07A1E"
                              TextTrimming="CharacterEllipsis"
                              ToolTip.Tip="{Binding GhiChu}"
                              Margin="17,0,0,0" />
                          </StackPanel>

                          <!-- Tổng tiền -->
                          <TextBlock Grid.Column="3"
                            Text="{Binding KhachCanTra, StringFormat={}{0:N0} đ}"
                            FontWeight="Bold"
                            Foreground="#087F6E"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center" />

                          <!-- Đã trả -->
                          <TextBlock Grid.Column="4"
                            Text="{Binding KhachDaThanhToan, StringFormat={}{0:N0} đ}"
                            Foreground="#263B35"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center" />

                          <!-- Còn nợ: màu đỏ khi thực sự còn nợ, xanh khi đã trả đủ -->
                          <TextBlock Grid.Column="5"
                            Text="{Binding ConNo, StringFormat={}{0:N0} đ}"
                            FontWeight="Bold"
                            Foreground="{Binding ConNo, Converter={StaticResource ConNoForegroundConverter}}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center" />

                          <!-- CỘT TRẠNG THÁI: ô riêng, CHỈ chứa badge trạng thái -->
                          <Border Grid.Column="6"
                            CornerRadius="14"
                            Padding="10,4"
                            Margin="0"
                            MaxWidth="130"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="#E4F5EC">
                            <TextBlock Text="{Binding TrangThaiThanhToanHienThi}"
                              FontSize="11"
                              FontWeight="SemiBold"
                              TextAlignment="Center"
                              TextTrimming="CharacterEllipsis"
                              Foreground="#087F6E" />
                          </Border>

                          <!-- CỘT THU NỢ: chỉ hiện khi hóa đơn còn nợ -->
                          <Button Grid.Column="7"
                            IsVisible="{Binding ConNoDuong}"
                            Content="Thu"
                            Width="52" Height="26"
                            Padding="0"
                            CornerRadius="13"
                            Background="#FDF0EE"
                            BorderBrush="#F3C9C2"
                            BorderThickness="1"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="#C0392B"
                            ToolTip.Tip="Thu công nợ cho hóa đơn này"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Command="{Binding ElementName=RootWindow, Path=DataContext.ThuNoHoaDonCommand}"
                            CommandParameter="{Binding}" />

                          <!-- CỘT XEM: ô cố định 56px, nút luôn nằm chính giữa
                               nên mọi dòng thẳng hàng bất kể trạng thái dài/ngắn -->
                          <Button Grid.Column="8"
                            Width="26" Height="26"
                            Padding="0"
                            CornerRadius="13"
                            Background="#EAF9F5"
                            BorderBrush="#CFE6E1"
                            BorderThickness="1"
                            ToolTip.Tip="Xem / in hóa đơn"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Margin="0"
                            Command="{Binding ElementName=RootWindow, Path=DataContext.XemHoaDonCommand}"
                            CommandParameter="{Binding}">

                            <!-- Icon mắt dạng VECTOR (Path) thay cho emoji 👁.
                                 Emoji là glyph text, canh theo baseline của font nên
                                 không nằm đúng tâm hình tròn. Path có tâm hình học
                                 cố định nên luôn khớp chính giữa nút. -->
                            <Grid Width="14" Height="14"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center">

                              <!-- Hốc mắt: nét viền -->
                              <Path Stretch="Uniform"
                                Stroke="#0C756A"
                                StrokeThickness="1.9"
                                StrokeJoin="Round"
                                StrokeLineCap="Round"
                                Data="M 1,12 C 4.5,6.5 8,5 12,5 C 16,5 19.5,6.5 23,12 C 19.5,17.5 16,19 12,19 C 8,19 4.5,17.5 1,12 Z"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch" />

                              <!-- Con ngươi: chính giữa trục X và Y -->
                              <Ellipse Width="5.4" Height="5.4"
                                Fill="#0C756A"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                            </Grid>
                          </Button>

                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>

              </Grid>
            </Border>

          </Grid>
        </TabItem>

        <TabItem Header="Nhà cung cấp">
          <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="0,14,16,0" RowSpacing="12">

            <!-- 1. TIÊU ĐỀ & NÚT THAO TÁC -->
            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">

              <StackPanel>
                <TextBlock Text="Nhà cung cấp" FontSize="26" FontWeight="Bold"
                  Foreground="#163F38" />
                <TextBlock Text="Quản lý danh sách nhà cung cấp, lịch sử nhập hàng và công nợ"
                  Foreground="#61736E" FontSize="13" Margin="0,4,0,0" />
              </StackPanel>

              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                <Button Classes="toolbar-action" Content="↻ Làm mới" Margin="0"
                  Command="{Binding RefreshSuppliersCommand}" />
                <Button Classes="toolbar-action" Content="📁 Nhập file" Margin="0"
                  Command="{Binding ThemNhaCungCapTuFileCommand}"
                  IsVisible="{Binding CanImportSupplier}" />
                <Button Classes="toolbar-action" Content="📤 Xuất file" Margin="0"
                  Command="{Binding XuatFileNhaCungCapCommand}"
                  ToolTip.Tip="Xuất toàn bộ danh sách nhà cung cấp đang xem ra file Excel"
                  IsVisible="{Binding CanExportSupplier}" />
                <Button Classes="toolbar-primary" Content="＋ Thêm nhà cung cấp" Margin="0"
                  Command="{Binding ThemNhaCungCapCommand}"
                  IsVisible="{Binding CanCreateSupplier}" />
              </StackPanel>
            </Grid>

            <!-- 2. THANH TÌM KIẾM + NÚT BỘ LỌC -->
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">

              <TextBox Classes="searchInput" Height="38" VerticalAlignment="Top"
                Watermark="🔍 Tìm theo mã, tên, số điện thoại hoặc email..."
                Text="{Binding SupplierSearch, Mode=TwoWay}"
                TextChanged="OnSupplierSearchTextChanged" />

              <Button Grid.Column="1" Classes="toolbar-action" Content="🔍 Tìm kiếm"
                Margin="0" Command="{Binding SearchSuppliersCommand}"
                ToolTip.Tip="Tìm nhà cung cấp ngay với từ khóa đang gõ" />

              <Button Grid.Column="2" Classes="toolbar-action" Margin="0"
                x:Name="SupplierFilterButton"
                ToolTip.Tip="Lọc nhà cung cấp theo tình trạng công nợ">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="⚙" />
                  <TextBlock Text="{Binding SupplierFilterButtonText}" />
                  <TextBlock Text="{Binding SupplierFilterArrowText}" />
                </StackPanel>

                <!--
                  BỘ LỌC NẰM TRONG FLYOUT CỦA CHÍNH NÚT NÀY
                  Nổi phía trên bảng dữ liệu, không chiếm hàng nào trong layout
                  chính nên đóng lại thì khu vực tìm kiếm giữ nguyên chiều cao.
                  Flyout tự đóng khi bấm ra ngoài. Nội dung nằm trong Popup nên
                  không sinh field trong code-behind.
                -->
                <Button.Flyout>
                  <Flyout Placement="BottomEdgeAlignedRight"
                    Opened="OnSupplierFilterFlyoutOpened"
                    Closed="OnSupplierFilterFlyoutClosed">
                    <Border Background="#F1F8F5" BorderBrush="#D9EAE4" BorderThickness="1"
                      CornerRadius="10" Padding="14" Width="240"
                      BoxShadow="0 8 20 #30000000">
                      <StackPanel Spacing="10">

                        <TextBlock Text="Tình trạng công nợ" FontSize="12"
                          FontWeight="SemiBold" Foreground="#163F38" />

                        <StackPanel Spacing="2">
                          <RadioButton GroupName="SupplierCongNo"
                            Content="Tất cả" FontSize="13" Padding="0,6"
                            IsChecked="{Binding SupplierCongNoFilter, Mode=TwoWay, Converter={StaticResource LuaChonRadioConverter}, ConverterParameter=tatca}" />
                          <RadioButton GroupName="SupplierCongNo"
                            Content="Còn nợ" FontSize="13" Padding="0,6"
                            IsChecked="{Binding SupplierCongNoFilter, Mode=TwoWay, Converter={StaticResource LuaChonRadioConverter}, ConverterParameter=conno}" />
                          <RadioButton GroupName="SupplierCongNo"
                            Content="Không còn nợ" FontSize="13" Padding="0,6"
                            IsChecked="{Binding SupplierCongNoFilter, Mode=TwoWay, Converter={StaticResource LuaChonRadioConverter}, ConverterParameter=khongconno}" />
                        </StackPanel>

                        <Rectangle Height="1" Fill="#D9EAE4" />

                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                          <Button Classes="toolbar-action" Content="Xóa" Margin="0"
                            Command="{Binding ClearSupplierFilterCommand}"
                            Click="OnSupplierFilterClearClicked"
                            IsVisible="{Binding SupplierHasFilter}" />
                          <Button Grid.Column="1" Classes="toolbar-primary"
                            Content="🔍 Áp dụng" Margin="0"
                            Command="{Binding ApplySupplierFilterCommand}"
                            Click="OnSupplierFilterApplyClicked" />
                        </Grid>

                      </StackPanel>
                    </Border>
                  </Flyout>
                </Button.Flyout>
              </Button>
            </Grid>

            <!-- 3. THỐNG KÊ THẬT TỪ DATABASE -->
            <Grid Grid.Row="2" ColumnDefinitions="*,*,*,*" ColumnSpacing="14">

              <Border Classes="card" Padding="18" Margin="0">
                <StackPanel>
                  <TextBlock Text="Tổng nhà cung cấp" Foreground="#61736E" FontSize="12" />
                  <TextBlock Text="{Binding SupplierAllCount}" FontSize="28" FontWeight="Bold"
                    Foreground="#163F38" Margin="0,6,0,0" />
                  <TextBlock Text="{Binding SupplierRangeText}" FontSize="12"
                    Foreground="#087F6E" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Border>

              <Border Grid.Column="1" Classes="card" Padding="18" Margin="0">
                <StackPanel>
                  <TextBlock Text="Còn nợ" Foreground="#61736E" FontSize="12" />
                  <TextBlock Text="{Binding SupplierDebtSupplierCount}" FontSize="28"
                    FontWeight="Bold" Foreground="#163F38" Margin="0,6,0,0" />
                  <TextBlock Text="{Binding SupplierDebtSupplierCaption}" FontSize="12"
                    Foreground="#087F6E" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Border>

              <Border Grid.Column="2" Classes="card" Padding="18" Margin="0">
                <StackPanel>
                  <TextBlock Text="Tổng công nợ" Foreground="#61736E" FontSize="12" />
                  <TextBlock Text="{Binding SupplierTotalDebtText}" FontSize="24"
                    FontWeight="Bold" Foreground="#D64545" Margin="0,6,0,0"
                    TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="Theo sổ cái công nợ nhà cung cấp" FontSize="12"
                    Foreground="#087F6E" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Border>

              <Border Grid.Column="3" Classes="card" Padding="18" Margin="0">
                <StackPanel>
                  <TextBlock Text="Tổng mua" Foreground="#61736E" FontSize="12" />
                  <TextBlock Text="{Binding SupplierTotalPurchaseText}" FontSize="24"
                    FontWeight="Bold" Foreground="#087F6E" Margin="0,6,0,0"
                    TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="Theo file danh sách / phiếu nhập" FontSize="12"
                    Foreground="#087F6E" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Border>
            </Grid>

            <!-- 4. BẢNG NHÀ CUNG CẤP (DÒNG MỞ RỘNG NGAY DƯỚI DÒNG ĐÃ CHỌN) -->
            <Border Grid.Row="3" Classes="card" Padding="0" Margin="0">
              <!--
                Hàng: 0 = tiêu đề bảng, 1 = thanh tải, 2 = vùng danh sách,
                3 = phân trang.
                Empty State nằm CHUNG hàng 2 với danh sách (không phải một hàng
                Auto riêng) để nó nằm giữa đúng khu vực danh sách và khi bị ẩn
                thì không còn chiếm bất kỳ khoảng không nào.
              -->
              <Grid RowDefinitions="Auto,Auto,*,Auto">

                <!--
                  TIÊU ĐỀ BẢNG (KHÔNG CUỘN)
                  Padding phải 29px: 16px lề trái + 13px chừa sẵn cho thanh cuộn
                  của vùng danh sách, để cột tiêu đề thẳng hàng với dòng dữ liệu.
                -->
                <Border Padding="16,14,29,14" BorderBrush="#E2ECE8" BorderThickness="0,0,0,1"
                  Background="#F1F8F5">
                  <Grid ColumnDefinitions="110,*,140,150,*,130,140,40" ColumnSpacing="10">

                    <TextBlock Grid.Column="0" Text="MÃ NCC" FontWeight="SemiBold"
                      Foreground="#164B40" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="TÊN NHÀ CUNG CẤP" FontWeight="SemiBold"
                      Foreground="#164B40" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="ĐIỆN THOẠI" FontWeight="SemiBold"
                      Foreground="#164B40" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="EMAIL" FontWeight="SemiBold"
                      Foreground="#164B40" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="4" Text="ĐỊA CHỈ" FontWeight="SemiBold"
                      Foreground="#164B40" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="5" Text="TỔNG MUA" FontWeight="SemiBold"
                      Foreground="#164B40" FontSize="12" VerticalAlignment="Center"
                      HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="6" Text="CÒN NỢ" FontWeight="SemiBold"
                      Foreground="#164B40" FontSize="12" VerticalAlignment="Center"
                      HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="7" Text="" />
                  </Grid>
                </Border>

                <!-- ĐANG TẢI -->
                <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="3"
                  Foreground="#087F6E" Background="Transparent"
                  IsVisible="{Binding IsLoadingSuppliers}" />

                <!--
                  DANH SÁCH RỖNG: đặt chung hàng 2 với ItemsControl bên dưới.
                  Hai phần loại trừ nhau theo IsSupplierListEmpty, nên khi có dữ liệu
                  vùng này bị ẩn hoàn toàn và danh sách hiện ngay dưới tiêu đề.
                -->
                <StackPanel Grid.Row="2" IsVisible="{Binding IsSupplierListEmpty}"
                  VerticalAlignment="Center" HorizontalAlignment="Center"
                  Margin="24" Spacing="8">
                  <TextBlock Text="🏭" FontSize="34" HorizontalAlignment="Center"
                    Foreground="#C3D6D0" />
                  <TextBlock Text="{Binding SupplierRongText}" FontSize="16"
                    FontWeight="SemiBold" Foreground="#163F38" HorizontalAlignment="Center"
                    TextWrapping="Wrap" TextAlignment="Center" />
                  <TextBlock Text="{Binding SupplierRongHint}" Foreground="#61736E"
                    FontSize="13" HorizontalAlignment="Center" TextWrapping="Wrap"
                    TextAlignment="Center" />
                </StackPanel>

                <!--
                  CÁC DÒNG NHÀ CUNG CẤP - ĐƯỢC CUỘN DỌC
                  Xem giải thích ở tab Khách hàng: ItemsControl không tự cuộn,
                  phải bọc ScrollViewer và không bọc cả khung bảng.
                -->
                <ScrollViewer Grid.Row="2" Classes="listScroll">

                  <ItemsControl ItemsSource="{Binding SupplierRows}"
                  IsVisible="{Binding HasSupplierRows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:NhaCungCapRowViewModel">
                      <Border Classes="customerRow" BorderBrush="#EDF3F1" BorderThickness="0,0,0,1"
                        PointerPressed="OnSupplierRowPointerPressed">

                        <StackPanel>

                          <!-- DÒNG CHÍNH -->
                          <Grid ColumnDefinitions="110,*,140,150,*,130,140,40"
                            ColumnSpacing="10" Height="54" Margin="16,0,16,0">

                            <TextBlock Grid.Column="0" Text="{Binding MaNhaCungCap}"
                              FontSize="12" Foreground="#667A74" VerticalAlignment="Center"
                              TextTrimming="CharacterEllipsis" />

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="9"
                              VerticalAlignment="Center">
                              <Border Width="30" Height="30" CornerRadius="15"
                                Background="#E3F2ED" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ChuCaiDau}" FontSize="12"
                                  FontWeight="Bold" Foreground="#087F6E"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                              </Border>
                              <TextBlock Text="{Binding TenNhaCungCap}" FontSize="13"
                                FontWeight="SemiBold" Foreground="#163F38"
                                VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <TextBlock Grid.Column="2" Text="{Binding SoDienThoai}"
                              FontSize="12" Foreground="#344B45" VerticalAlignment="Center"
                              TextTrimming="CharacterEllipsis" />

                            <TextBlock Grid.Column="3" Text="{Binding Email}" FontSize="12"
                              Foreground="#344B45" VerticalAlignment="Center"
                              TextTrimming="CharacterEllipsis" />

                            <TextBlock Grid.Column="4" Text="{Binding DiaChi}" FontSize="12"
                              Foreground="#52645E" VerticalAlignment="Center"
                              TextTrimming="CharacterEllipsis" />

                            <TextBlock Grid.Column="5" Text="{Binding TongMuaText}"
                              FontSize="12" Foreground="#344B45" VerticalAlignment="Center"
                              HorizontalAlignment="Right"
                              TextTrimming="CharacterEllipsis" />

                            <Border Grid.Column="6" CornerRadius="6" Padding="8,3"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Background="{Binding ConNoBackground}">
                              <TextBlock Text="{Binding ConNoText}" FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{Binding ConNoForeground}" />
                            </Border>

                            <TextBlock Grid.Column="7" Text="{Binding KyHieuMoRong}" FontSize="11"
                              Foreground="#087F6E" VerticalAlignment="Center"
                              HorizontalAlignment="Center" />
                          </Grid>

                          <!-- VÙNG CHI TIẾT MỞ RỘNG -->
                          <Border Name="DetailPanel" IsVisible="{Binding IsExpanded}"
                            Background="#F3F8F6" BorderBrush="#D9EAE4"
                            BorderThickness="0,1,0,0" Padding="18,16">

                            <StackPanel Spacing="14">

                              <!-- TÊN + NÚT SỬA / XÓA -->
                              <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="14">
                                <Border Width="42" Height="42" CornerRadius="21"
                                  Background="#087F6E">
                                  <TextBlock Text="{Binding Detail.ChuCaiDau}"
                                    Foreground="White" FontSize="16" FontWeight="Bold"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                  <TextBlock Text="{Binding Detail.TenNhaCungCap}" FontSize="18"
                                    FontWeight="Bold" Foreground="#163F38" />
                                  <StackPanel Orientation="Horizontal" Spacing="8"
                                    Margin="0,4,0,0">
                                    <TextBlock Text="{Binding MaNhaCungCap}" FontSize="12"
                                      Foreground="#667A74" />
                                    <TextBlock Text="•" FontSize="12" Foreground="#B4C4BF" />
                                    <TextBlock Text="{Binding SoDienThoai}" FontSize="12"
                                      Foreground="#667A74" />
                                    <TextBlock Text="•" FontSize="12" Foreground="#B4C4BF" />
                                    <TextBlock Text="{Binding Detail.TrangThaiHienThi}"
                                      FontSize="12" Foreground="#087F6E" />
                                  </StackPanel>
                                </StackPanel>

                                <Button Grid.Column="2" Classes="toolbar-action"
                                  Content="✏ Sửa" Margin="0,0,8,0"
                                  Command="{Binding SuaCommand}"
                                  IsVisible="{Binding $parent[Window].DataContext.CanEditSupplier}" />
                                <Button Grid.Column="3" Classes="toolbar-action"
                                  Content="🗑 Xóa" Margin="0"
                                  Command="{Binding XoaCommand}"
                                  IsVisible="{Binding $parent[Window].DataContext.CanDeleteSupplier}" />
                              </Grid>

                              <!-- ĐANG TẢI CHI TIẾT -->
                              <ProgressBar IsIndeterminate="True" Height="4"
                                Foreground="#087F6E" Background="Transparent"
                                IsVisible="{Binding Detail.IsLoading}" />

                              <!-- Ô THỐNG KÊ NHANH (BẤM ĐỂ MỞ TAB TƯƠNG ỨNG) -->
                              <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">

                                <Border Grid.Column="0" Classes="statBox" Tag="lichsu"
                                  PointerPressed="OnSupplierSummaryPressed">
                                  <StackPanel>
                                    <TextBlock Text="Tổng tiền đã mua" FontSize="11"
                                      Foreground="#61736E" />
                                    <TextBlock Text="{Binding Detail.TongMuaText}"
                                      FontSize="17" FontWeight="Bold" Foreground="#163F38"
                                      Margin="0,3,0,0" />
                                  </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Classes="statBox" Tag="lichsu"
                                  PointerPressed="OnSupplierSummaryPressed">
                                  <StackPanel>
                                    <TextBlock Text="Đã thanh toán" FontSize="11"
                                      Foreground="#61736E" />
                                    <TextBlock Text="{Binding Detail.TongDaThanhToanText}"
                                      FontSize="17" FontWeight="Bold" Foreground="#087F6E"
                                      Margin="0,3,0,0" />
                                  </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Classes="statBox" Tag="congno"
                                  PointerPressed="OnSupplierSummaryPressed">
                                  <StackPanel>
                                    <TextBlock Text="Công nợ hiện tại" FontSize="11"
                                      Foreground="#61736E" />
                                    <TextBlock Text="{Binding Detail.TongCongNoText}"
                                      FontSize="17" FontWeight="Bold" Foreground="#D64545"
                                      Margin="0,3,0,0" />
                                  </StackPanel>
                                </Border>

                                <Border Grid.Column="3" Classes="statBox" Tag="lichsu"
                                  PointerPressed="OnSupplierSummaryPressed">
                                  <StackPanel>
                                    <TextBlock Text="Số phiếu nhập" FontSize="11"
                                      Foreground="#61736E" />
                                    <TextBlock Text="{Binding Detail.SoPhieuNhapText}"
                                      FontSize="17" FontWeight="Bold" Foreground="#163F38"
                                      Margin="0,3,0,0" />
                                  </StackPanel>
                                </Border>

                              </Grid>

                              <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Nguồn số liệu" FontSize="11"
                                  Foreground="#61736E" />
                                <TextBlock Text="{Binding Detail.NguonCongNoText}" FontSize="11"
                                  Foreground="#087F6E" FontWeight="SemiBold" />
                              </StackPanel>

                              <!-- TAB: THÔNG TIN / LỊCH SỬ NHẬP HÀNG / CÔNG NỢ -->
                              <StackPanel Orientation="Horizontal">

                                <!-- TAB 1: THÔNG TIN -->
                                <Button Command="{Binding Detail.ChonTabCommand}"
                                        CommandParameter="thongtin"
                                        Classes.active="{Binding Detail.IsTabThongTin}"
                                        Margin="0,0,6,0" Padding="16,8" CornerRadius="8" Cursor="Hand" BorderThickness="0">
                                  <Button.Styles>
                                    <Style Selector="Button">
                                      <Setter Property="Background" Value="#E2ECE8" />
                                    </Style>
                                    <Style Selector="Button.active">
                                      <Setter Property="Background" Value="#087F6E" />
                                    </Style>
                                  </Button.Styles>
                                  <TextBlock Text="Thông tin" FontSize="13" FontWeight="SemiBold">
                                    <TextBlock.Styles>
                                      <Style Selector="TextBlock">
                                        <Setter Property="Foreground" Value="#163F38" />
                                      </Style>
                                      <Style Selector="Button.active TextBlock">
                                        <Setter Property="Foreground" Value="White" />
                                      </Style>
                                    </TextBlock.Styles>
                                  </TextBlock>
                                </Button>

                                <!-- TAB 2: LỊCH SỬ NHẬP HÀNG -->
                                <Button Command="{Binding Detail.ChonTabCommand}"
                                        CommandParameter="lichsu"
                                        Classes.active="{Binding Detail.IsTabLichSuNhapHang}"
                                        Margin="0,0,6,0" Padding="16,8" CornerRadius="8" Cursor="Hand" BorderThickness="0">
                                  <Button.Styles>
                                    <Style Selector="Button">
                                      <Setter Property="Background" Value="#E2ECE8" />
                                    </Style>
                                    <Style Selector="Button.active">
                                      <Setter Property="Background" Value="#087F6E" />
                                    </Style>
                                  </Button.Styles>
                                  <TextBlock Text="Lịch sử nhập hàng" FontSize="13" FontWeight="SemiBold">
                                    <TextBlock.Styles>
                                      <Style Selector="TextBlock">
                                        <Setter Property="Foreground" Value="#163F38" />
                                      </Style>
                                      <Style Selector="Button.active TextBlock">
                                        <Setter Property="Foreground" Value="White" />
                                      </Style>
                                    </TextBlock.Styles>
                                  </TextBlock>
                                </Button>

                                <!-- TAB 3: CÔNG NỢ -->
                                <Button Command="{Binding Detail.ChonTabCommand}"
                                        CommandParameter="congno"
                                        Classes.active="{Binding Detail.IsTabCongNo}"
                                        Margin="0,0,6,0" Padding="16,8" CornerRadius="8" Cursor="Hand" BorderThickness="0">
                                  <Button.Styles>
                                    <Style Selector="Button">
                                      <Setter Property="Background" Value="#E2ECE8" />
                                    </Style>
                                    <Style Selector="Button.active">
                                      <Setter Property="Background" Value="#087F6E" />
                                    </Style>
                                  </Button.Styles>
                                  <TextBlock Text="Công nợ" FontSize="13" FontWeight="SemiBold">
                                    <TextBlock.Styles>
                                      <Style Selector="TextBlock">
                                        <Setter Property="Foreground" Value="#163F38" />
                                      </Style>
                                      <Style Selector="Button.active TextBlock">
                                        <Setter Property="Foreground" Value="White" />
                                      </Style>
                                    </TextBlock.Styles>
                                  </TextBlock>
                                </Button>

                              </StackPanel>
                            

                              <!-- TAB 1: THÔNG TIN -->
                              <Grid IsVisible="{Binding Detail.IsTabThongTin}"
                                RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10">

                                <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                                  <StackPanel>
                                    <TextBlock Text="Số điện thoại" Foreground="#61736E"
                                      FontSize="12" />
                                    <TextBlock Text="{Binding Detail.SoDienThoai}"
                                      FontSize="13" Foreground="#263B35" Margin="0,4,0,0" />
                                  </StackPanel>
                                  <StackPanel Grid.Column="1">
                                    <TextBlock Text="Email" Foreground="#61736E" FontSize="12" />
                                    <TextBlock Text="{Binding Detail.Email}" FontSize="13"
                                      Foreground="#263B35" Margin="0,4,0,0" TextWrapping="Wrap" />
                                  </StackPanel>
                                </Grid>

                                <StackPanel Grid.Row="1">
                                  <TextBlock Text="Địa chỉ" Foreground="#61736E" FontSize="12" />
                                  <TextBlock Text="{Binding Detail.DiaChiDayDu}" FontSize="13"
                                    Foreground="#263B35" Margin="0,4,0,0" TextWrapping="Wrap" />
                                </StackPanel>

                                <Grid Grid.Row="2" ColumnDefinitions="*,*,*,*"
                                  ColumnSpacing="14">
                                  <StackPanel>
                                    <TextBlock Text="Mã số thuế" Foreground="#61736E"
                                      FontSize="12" />
                                    <TextBlock Text="{Binding Detail.MaSoThue}" FontSize="13"
                                      Foreground="#263B35" Margin="0,4,0,0" />
                                  </StackPanel>
                                  <StackPanel Grid.Column="1">
                                    <TextBlock Text="Người liên hệ" Foreground="#61736E"
                                      FontSize="12" />
                                    <TextBlock Text="{Binding Detail.NguoiLienHe}" FontSize="13"
                                      Foreground="#263B35" Margin="0,4,0,0" TextWrapping="Wrap" />
                                  </StackPanel>
                                  <StackPanel Grid.Column="2">
                                    <TextBlock Text="Ngày tạo" Foreground="#61736E" FontSize="12" />
                                    <TextBlock Text="{Binding Detail.NgayTaoText}" FontSize="13"
                                      Foreground="#263B35" Margin="0,4,0,0" />
                                  </StackPanel>
                                  <StackPanel Grid.Column="3">
                                    <TextBlock Text="Trạng thái" Foreground="#61736E" FontSize="12" />
                                    <TextBlock Text="{Binding Detail.TrangThaiHienThi}"
                                      FontSize="13" Foreground="#263B35" Margin="0,4,0,0" />
                                  </StackPanel>
                                </Grid>

                                <StackPanel Grid.Row="3">
                                  <TextBlock Text="Ghi chú" Foreground="#61736E" FontSize="12" />
                                  <TextBlock Text="{Binding Detail.GhiChu}" FontSize="13"
                                    Foreground="#263B35" Margin="0,4,0,0" TextWrapping="Wrap" />
                                </StackPanel>

                              </Grid>

                              <!-- TAB 2: LỊCH SỬ NHẬP HÀNG -->
                              <StackPanel IsVisible="{Binding Detail.IsTabLichSuNhapHang}"
                                Spacing="10">

                                <TextBlock Text="Các phiếu nhập hàng gần nhất từ nhà cung cấp này"
                                  Foreground="#61736E" FontSize="12" />

                                <TextBlock Text="{Binding Detail.LichSuNhapHangRongText}"
                                  IsVisible="{Binding !Detail.HasLichSuNhapHang}"
                                  Foreground="#98A2B3" FontSize="13" Margin="0,10,0,0" />

                                <ItemsControl ItemsSource="{Binding Detail.PhieuNhapHangs}"
                                  IsVisible="{Binding Detail.HasLichSuNhapHang}">
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:PhieuNhapHang">
                                      <Border BorderBrush="#E2ECE8" BorderThickness="0,0,0,1"
                                        Padding="0,9">
                                        <Grid ColumnDefinitions="150,150,140,140,140,130"
                                          ColumnSpacing="10">
                                          <TextBlock Text="{Binding MaPhieuNhap}" FontSize="12"
                                            FontWeight="SemiBold" Foreground="#163F38"
                                            VerticalAlignment="Center" />
                                          <TextBlock Grid.Column="1"
                                            Text="{Binding ThoiGianNhapText}" FontSize="12"
                                            Foreground="#667A74" VerticalAlignment="Center" />
                                          <TextBlock Grid.Column="2" Text="{Binding TenNhanVien}"
                                            FontSize="12" Foreground="#344B45"
                                            VerticalAlignment="Center"
                                            TextTrimming="CharacterEllipsis" />
                                          <TextBlock Grid.Column="3"
                                            Text="{Binding TongTienNhap, StringFormat={}{0:N0} đ}"
                                            FontSize="12" FontWeight="SemiBold"
                                            Foreground="#163F38" HorizontalAlignment="Right"
                                            VerticalAlignment="Center" />
                                          <StackPanel Grid.Column="4"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DaThanhToan, StringFormat={}{0:N0} đ}"
                                              FontSize="12" Foreground="#087F6E"
                                              HorizontalAlignment="Right" />
                                            <TextBlock Text="{Binding NguonQuyHienThi}"
                                              FontSize="10" Foreground="#61736E"
                                              HorizontalAlignment="Right" />
                                          </StackPanel>
                                          <TextBlock Grid.Column="5"
                                            Text="{Binding ConNo, StringFormat={}{0:N0} đ}"
                                            FontSize="12" FontWeight="SemiBold"
                                            Foreground="#D64545" HorizontalAlignment="Right"
                                            VerticalAlignment="Center" />
                                        </Grid>
                                      </Border>
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>

                              </StackPanel>

                              <!-- TAB 3: CÔNG NỢ -->
                              <StackPanel IsVisible="{Binding Detail.IsTabCongNo}" Spacing="12">

                                <Border Classes="statBox" Background="White"
                                  IsVisible="{Binding Detail.HasCongNoData}">
                                  <Grid ColumnDefinitions="*,*,*" ColumnSpacing="14">
<StackPanel>
                                       <TextBlock Text="Tổng tiền đã mua" FontSize="11"
                                         Foreground="#61736E" />
                                       <TextBlock Text="{Binding Detail.TongMuaText}"
                                         FontSize="18" FontWeight="Bold" Foreground="#163F38"
                                         Margin="0,3,0,0" />
                                     </StackPanel>
                                     <StackPanel Grid.Column="1">
                                       <TextBlock Text="Đã thanh toán" FontSize="11"
                                         Foreground="#61736E" />
                                       <TextBlock Text="{Binding Detail.TongDaThanhToanText}"
                                         FontSize="18" FontWeight="Bold" Foreground="#087F6E"
                                         Margin="0,3,0,0" />
                                     </StackPanel>
                                    <StackPanel Grid.Column="2">
                                      <TextBlock Text="Còn nợ" FontSize="11"
                                        Foreground="#61736E" />
                                      <TextBlock Text="{Binding Detail.TongCongNoText}"
                                        FontSize="18" FontWeight="Bold" Foreground="#D64545"
                                        Margin="0,3,0,0" />
                                    </StackPanel>
                                  </Grid>
                                </Border>

                                <TextBlock Text="{Binding Detail.CongNoRongText}"
                                  IsVisible="{Binding !Detail.HasCongNoData}"
                                  Foreground="#98A2B3" FontSize="13" />

                                <StackPanel IsVisible="{Binding Detail.HasCongNoData}" Spacing="4">
                                  <TextBlock Text="{Binding Detail.NguonCongNoText}"
                                    FontSize="12" Foreground="#61736E" />
                                  <TextBlock Text="{Binding Detail.SoLanGhiCongNoText}"
                                    FontSize="12" Foreground="#667A74" />
                                  <TextBlock FontSize="12" Foreground="#667A74"
                                    Text="{Binding Detail.LanGhiCongNoText, StringFormat='Lần ghi công nợ gần nhất: {0}'}" />
                                </StackPanel>

                                <TextBlock Text="Sổ cái công nợ" Foreground="#61736E"
                                  FontSize="12" Margin="0,4,0,0" />

                                <TextBlock Text="{Binding Detail.LichSuCongNoRongText}"
                                  IsVisible="{Binding !Detail.HasLichSuCongNo}"
                                  Foreground="#98A2B3" FontSize="13" Margin="0,4,0,0" />

                                <ItemsControl ItemsSource="{Binding Detail.LichSuCongNos}"
                                  IsVisible="{Binding Detail.HasLichSuCongNo}">
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:LichSuCongNoNhaCungCap">
                                      <Border BorderBrush="#E2ECE8" BorderThickness="0,0,0,1"
                                        Padding="0,9">
                                        <Grid ColumnDefinitions="150,150,130,130,130,*"
                                          ColumnSpacing="10">
                                          <TextBlock Text="{Binding ThoiGianText}" FontSize="12"
                                            Foreground="#667A74" VerticalAlignment="Center" />
                                          <TextBlock Grid.Column="1"
                                            Text="{Binding LoaiGiaoDichHienThi}" FontSize="12"
                                            FontWeight="SemiBold" Foreground="#163F38"
                                            VerticalAlignment="Center" />
                                          <TextBlock Grid.Column="2"
                                            Text="{Binding MaChungTuHienThi}" FontSize="12"
                                            Foreground="#344B45" VerticalAlignment="Center"
                                            TextTrimming="CharacterEllipsis" />
                                          <TextBlock Grid.Column="3"
                                            Text="{Binding PhatSinhNoText}" FontSize="12"
                                            FontWeight="SemiBold" Foreground="#D64545"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center" />
                                          <TextBlock Grid.Column="4" Text="{Binding SoDuText}"
                                            FontSize="12" FontWeight="SemiBold"
                                            Foreground="#163F38" HorizontalAlignment="Right"
                                            VerticalAlignment="Center" />
                                          <TextBlock Grid.Column="5"
                                            Text="{Binding GhiChuHienThi}" FontSize="12"
                                            Foreground="#667A74" VerticalAlignment="Center"
                                            TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                      </Border>
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>

                              </StackPanel>

                            </StackPanel>

                          </Border>

                        </StackPanel>

                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                  </ItemsControl>

                </ScrollViewer>

                <!-- PHÂN TRANG -->
                <Border Grid.Row="3" Padding="16,12" BorderBrush="#E2ECE8"
                  BorderThickness="0,1,0,0">
                  <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="16">

                    <StackPanel Orientation="Horizontal" Spacing="8"
                      VerticalAlignment="Center">
                      <TextBlock Text="Số dòng mỗi trang:" FontSize="12" Foreground="#61736E"
                        VerticalAlignment="Center" />
                      <ComboBox Name="SupplierPageSizeBox" Width="72" Height="30" FontSize="12"
                        SelectedIndex="0" HorizontalAlignment="Left"
                        SelectionChanged="OnSupplierPageSizeChanged">
                        <ComboBoxItem Content="20" />
                        <ComboBoxItem Content="50" />
                        <ComboBoxItem Content="100" />
                      </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                      VerticalAlignment="Center"
                      IsVisible="{Binding HasSelectedSupplierRows}">
                      <TextBlock Text="{Binding SupplierSelectedCountText}" FontSize="12"
                        Foreground="#087F6E" FontWeight="SemiBold"
                        VerticalAlignment="Center" />
                      <Button Classes="toolbar-action" Content="Bỏ chọn" Padding="10,4"
                        FontSize="11" Margin="0" VerticalAlignment="Center"
                        Command="{Binding BoChonTatCaSupplierRowsCommand}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                      VerticalAlignment="Center" HorizontalAlignment="Center">

                      <TextBlock Text="{Binding SupplierRangeText}" FontSize="12"
                        Foreground="#163F38" FontWeight="SemiBold"
                        VerticalAlignment="Center" Margin="0,0,10,0" />

                      <Button Classes="toolbar-action" Content="⏮" Width="34" Height="30"
                        Padding="0" FontSize="12" ToolTip.Tip="Về trang đầu" Margin="0"
                        IsEnabled="{Binding CanSupplierTrangDau}"
                        Command="{Binding SupplierTrangDauCommand}" />

                      <Button Classes="toolbar-action" Content="◀" Width="34" Height="30"
                        Padding="0" FontSize="11" ToolTip.Tip="Trang trước" Margin="0"
                        IsEnabled="{Binding CanSupplierTrangTruoc}"
                        Command="{Binding SupplierTrangTruocCommand}" />

                      <Border Background="#087F6E" CornerRadius="8" MinWidth="38" Height="30"
                        Padding="10,0">
                        <TextBlock Text="{Binding SupplierPage}" Foreground="White"
                          FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                      </Border>

                      <TextBlock Text="trên" FontSize="12" Foreground="#61736E"
                        VerticalAlignment="Center" />

                      <TextBlock Text="{Binding SupplierTotalPages}" FontSize="12"
                        Foreground="#163F38" FontWeight="SemiBold" VerticalAlignment="Center"
                        Margin="0,0,6,0" />

                      <Button Classes="toolbar-action" Content="▶" Width="34" Height="30"
                        Padding="0" FontSize="11" ToolTip.Tip="Trang sau" Margin="0"
                        IsEnabled="{Binding CanSupplierTrangSau}"
                        Command="{Binding SupplierTrangSauCommand}" />

                      <Button Classes="toolbar-action" Content="⏭" Width="34" Height="30"
                        Padding="0" FontSize="12" ToolTip.Tip="Về trang cuối" Margin="0"
                        IsEnabled="{Binding CanSupplierTrangCuoi}"
                        Command="{Binding SupplierDenTrangCommand}" />

                    </StackPanel>

                  </Grid>
                </Border>

              </Grid>
            </Border>

          </Grid>
        </TabItem>
        <!-- TAB NHẬP HÀNG / MUA HÀNG -->
        <TabItem Header="Nhập hàng">
          <Grid Margin="0,14,0,0">

            <!-- MÀN 1: DANH SÁCH PHIẾU NHẬP (giữ nguyên giao diện cũ) -->
            <Grid IsVisible="{Binding IsNhapHangListVisible}"
              RowDefinitions="Auto,Auto,*"
              RowSpacing="14">

              <!-- TIÊU ĐỀ -->
              <Grid ColumnDefinitions="*,Auto">

                <StackPanel>
                  <TextBlock Text="Nhập hàng"
                    FontSize="26"
                    FontWeight="Bold"
                    Foreground="#163F38" />

                  <TextBlock Text="Quản lý mua hàng và nhập hàng từ nhà cung cấp"
                    Foreground="#61736E"
                    FontSize="13"
                    Margin="0,4,0,0" />
                </StackPanel>

                <Button Grid.Column="1"
                  Classes="toolbar-primary"
                  Content="＋  Hàng hóa mới"
                  Command="{Binding MoPhieuNhapHangCommand}"
                  Margin="0"
                  IsVisible="{Binding CanCreatePurchase}" />
              </Grid>

              <!-- THANH TÌM KIẾM -->
              <Border Grid.Row="1"
                Background="White"
                BorderBrush="#E2ECE8"
                BorderThickness="1"
                CornerRadius="12"
                Padding="12">

                <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="10">

                  <TextBox Classes="searchInput"
                    Watermark="🔍 Tìm mã phiếu hoặc nhà cung cấp..."
                    Padding="12,9"
                    Margin="0" />

                  <Button Grid.Column="1"
                    Classes="toolbar-action"
                    Content="🔍 Tìm kiếm"
                    Margin="0" />
                </Grid>
              </Border>

              <!-- DANH SÁCH PHIẾU NHẬP -->
              <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E2ECE8"
                BorderThickness="1"
                CornerRadius="12"
                ClipToBounds="True">

                <Grid RowDefinitions="Auto,*">

                  <!-- HEADER -->
                  <Border Background="#F7FAF9"
                    BorderBrush="#E2ECE8"
                    BorderThickness="0,0,0,1"
                    Padding="16,13">

                    <Grid ColumnDefinitions="150,*,180,160,150"
                      ColumnSpacing="10">

                      <TextBlock Text="MÃ PHIẾU"
                        FontWeight="SemiBold"
                        Foreground="#164B40"
                        FontSize="12" />

                      <TextBlock Grid.Column="1"
                        Text="NHÀ CUNG CẤP"
                        FontWeight="SemiBold"
                        Foreground="#164B40"
                        FontSize="12" />

                      <TextBlock Grid.Column="2"
                        Text="NGÀY NHẬP"
                        FontWeight="SemiBold"
                        Foreground="#164B40"
                        FontSize="12" />

                      <TextBlock Grid.Column="3"
                        Text="TỔNG TIỀN"
                        FontWeight="SemiBold"
                        Foreground="#164B40"
                        FontSize="12" />

                      <TextBlock Grid.Column="4"
                        Text="TRẠNG THÁI"
                        FontWeight="SemiBold"
                        Foreground="#164B40"
                        FontSize="12" />
                    </Grid>
                  </Border>

                  <!-- DỮ LIỆU -->
                  <ScrollViewer Grid.Row="1"
                    VerticalScrollBarVisibility="Auto">

                    <StackPanel>

                      <TextBlock Text="Chưa có phiếu nhập"
                        FontSize="15"
                        Foreground="#61736E"
                        HorizontalAlignment="Center"
                        Margin="0,40" />

                    </StackPanel>

                  </ScrollViewer>

                </Grid>
              </Border>

            </Grid>

            <!-- MÀN 2: LẬP PHIẾU NHẬP HÀNG (75% bảng / 25% panel) -->
            <Grid IsVisible="{Binding IsNhapHangFormVisible}"
              ColumnDefinitions="3*,*"
              ColumnSpacing="16"
              RowDefinitions="Auto,Auto,*"
              RowSpacing="12">

              <!-- TIÊU ĐỀ -->
              <StackPanel Grid.Row="0" Grid.ColumnSpan="2">
                <TextBlock Text="Lập phiếu nhập hàng"
                  FontSize="26"
                  FontWeight="Bold"
                  Foreground="#163F38" />

                <TextBlock
                  Text="Chọn hàng hóa, nhập số lượng và giá nhập để tạo phiếu nhập từ nhà cung cấp"
                  Foreground="#61736E"
                  FontSize="13"
                  Margin="0,4,0,0" />
              </StackPanel>

              <!-- CỘT TRÁI - BẢNG HÀNG HÓA NHẬP                          -->
              <Grid Grid.Row="1" Grid.RowSpan="2" Grid.Column="0"
                RowDefinitions="Auto,Auto,*"
                RowSpacing="12">

                <!-- Ô TÌM KIẾM + NÚT THÊM HÀNG HÓA -->
                <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="10">

                  <Border Background="White"
                    BorderBrush="#E2ECE8"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="0">

                    <TextBox Classes="searchInput"
                      Watermark="🔍 Tìm theo mã hàng hoặc tên hàng..."
                      Text="{Binding ImportProductSearch, Mode=TwoWay}"
                      TextChanged="OnImportProductSearchTextChanged"
                      Padding="12,9"
                      Margin="0" />
                  </Border>

                  <Button Grid.Column="1"
                    Classes="toolbar-primary"
                    Content="＋  Thêm hàng hóa"
                    Command="{Binding ThemSanPhamCommand}"
                    CommandParameter="{Binding ImportProductSearch}"
                    VerticalAlignment="Stretch"
                    IsVisible="{Binding CanCreateProduct}" />
                </Grid>

                <!-- KẾT QUẢ TÌM HÀNG HÓA -->
                <Border Grid.Row="1"
                  IsVisible="{Binding HasPhieuNhapSuggestions}"
                  Background="White"
                  BorderBrush="#CFE6E1"
                  BorderThickness="1"
                  CornerRadius="10"
                  MaxHeight="170"
                  ClipToBounds="True">

                  <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding PhieuNhapProductSuggestions}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:SanPham">
                          <Button HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="10,7"
                            Command="{Binding ElementName=RootWindow, Path=DataContext.ThemSanPhamVaoPhieuNhapCommand}"
                            CommandParameter="{Binding}">
                            <Grid ColumnDefinitions="Auto,*,Auto"
                              ColumnSpacing="10">

                              <Border Width="34"
                                Height="34"
                                CornerRadius="8"
                                Background="#DFF5F0"
                                VerticalAlignment="Center">
                                <TextBlock Text="🌼"
                                  FontSize="16"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                              </Border>

                              <StackPanel Grid.Column="1"
                                VerticalAlignment="Center">
                                <TextBlock Text="{Binding TenSanPham}"
                                  FontSize="13"
                                  FontWeight="SemiBold"
                                  Foreground="#163F38"
                                  TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding MaSanPham}"
                                  FontSize="11"
                                  Foreground="#98A2B3" />
                                <!-- Hiển thị Số lượng tồn / Hết hàng -->
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <TextBlock Text="Tồn:" FontSize="11" Foreground="#98A2B3"/>
                                    
                                    <!-- Hiện số lượng khi còn hàng -->
                                    <TextBlock Text="{Binding TonKho, StringFormat='{}{0:N0}'}"
                                              IsVisible="{Binding !HetHang}"
                                              FontSize="11"
                                              Foreground="#98A2B3"/>

                                    <!-- Hiện nhãn HẾT HÀNG màu đỏ khi TonKho <= 0 -->
                                    <Border Background="#FFEEE2" CornerRadius="4" Padding="6,2"
                                            IsVisible="{Binding HetHang}">
                                        <TextBlock Text="Hết hàng" 
                                                  Foreground="#E53935" 
                                                  FontWeight="Bold" 
                                                  FontSize="12"/>
                                    </Border>
                                </StackPanel>
                              </StackPanel>

                              <TextBlock Grid.Column="2"
                                Text="{Binding GiaVon, StringFormat={}{0:N0} đ}"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="#087F6E"
                                VerticalAlignment="Center" />

            
                            </Grid>
                            
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </Border>

                <!-- BẢNG -->
                <Border Grid.Row="2"
                  Background="White"
                  BorderBrush="#E2ECE8"
                  BorderThickness="1"
                  CornerRadius="12"
                  ClipToBounds="True">

                  <Grid RowDefinitions="Auto,*">

                    <!-- HEADER BẢNG -->
                    <Border Background="#F7FAF9"
                      BorderBrush="#E2ECE8"
                      BorderThickness="0,0,0,1"
                      Padding="10,0">

                      <Grid ColumnDefinitions="50,140,*,160,108,150,130,60"
                        Height="42">

                        <TextBlock Text="STT"
                          FontWeight="SemiBold"
                          Foreground="#164B40"
                          FontSize="12"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Center" />

                        <TextBlock Grid.Column="1"
                          Text="MÃ HÀNG"
                          FontWeight="SemiBold"
                          Foreground="#164B40"
                          FontSize="12"
                          VerticalAlignment="Center" />

                        <TextBlock Grid.Column="2"
                          Text="TÊN HÀNG"
                          FontWeight="SemiBold"
                          Foreground="#164B40"
                          FontSize="12"
                          VerticalAlignment="Center" />

                        <TextBlock Grid.Column="3"
                          Text="ĐVT"
                          FontWeight="SemiBold"
                          Foreground="#164B40"
                          FontSize="12"
                          VerticalAlignment="Center" />

                        <TextBlock Grid.Column="4"
                          Text="SỐ LƯỢNG"
                          FontWeight="SemiBold"
                          Foreground="#164B40"
                          FontSize="12"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Center" />

                        <TextBlock Grid.Column="5"
                          Text="GIÁ NHẬP"
                          FontWeight="SemiBold"
                          Foreground="#164B40"
                          FontSize="12"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Right"
                          Margin="0,0,8,0" />

                        <TextBlock Grid.Column="6"
                          Text="THÀNH TIỀN"
                          FontWeight="SemiBold"
                          Foreground="#164B40"
                          FontSize="12"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Right"
                          Margin="0,0,8,0" />

                        <TextBlock Grid.Column="7"
                          Text=""
                          VerticalAlignment="Center" />
                      </Grid>
                    </Border>

                    <!-- DANH SÁCH -->
                    <Grid Grid.Row="1">

                      <ItemsControl ItemsSource="{Binding PhieuNhapItems}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="models:ChiTietPhieuNhapHang">

                            <Border Background="White"
                              BorderBrush="#EDF2F0"
                              BorderThickness="0,0,0,1"
                              Padding="10,0">

                              <Grid ColumnDefinitions="50,140,*,160,108,150,130,60"
                                Height="52">

                                <!-- STT -->
                                <TextBlock Text="{Binding Index}"
                                  Foreground="#98A2B3"
                                  FontSize="13"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Center" />

                                <!-- MÃ HÀNG -->
                                <TextBlock Grid.Column="1"
                                  Text="{Binding MaSanPham}"
                                  Foreground="#344054"
                                  FontSize="13"
                                  VerticalAlignment="Center"
                                  TextTrimming="CharacterEllipsis" />

                                <!-- TÊN HÀNG -->
                                <TextBlock Grid.Column="2"
                                  Text="{Binding TenSanPham}"
                                  Foreground="#344054"
                                  FontSize="13"
                                  VerticalAlignment="Center"
                                  TextTrimming="CharacterEllipsis" />

                                <!-- ĐVT: hiển thị sẵn nếu hàng đã có ĐVT, hoặc cho chọn/thêm trực tiếp nếu hàng chưa có ĐVT -->
                                <Grid Grid.Column="3"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0">

                                  <TextBlock Text="{Binding DonViTinh}"
                                    IsVisible="{Binding CoDonViTinhCoSan}"
                                    Foreground="#667085"
                                    FontSize="13"
                                    VerticalAlignment="Center"
                                    TextTrimming="CharacterEllipsis" />

                                  <Grid ColumnDefinitions="*,Auto"
                                    ColumnSpacing="4"
                                    IsVisible="{Binding ChoPhepChonDonViTinh}"
                                    VerticalAlignment="Center">

                                    <ComboBox Grid.Column="0"
                                      ItemsSource="{Binding DonViTinhOptions}"
                                      SelectedItem="{Binding SelectedDonViTinh, Mode=TwoWay}"
                                      PlaceholderText="Chọn ĐVT"
                                      Height="30"
                                      MinHeight="30"
                                      Padding="8,3"
                                      FontSize="12.5"
                                      CornerRadius="6"
                                      Background="#F8FBFA"
                                      BorderBrush="#087F6E"
                                      BorderThickness="1"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Center"
                                      ToolTip.Tip="Hàng hóa này chưa có ĐVT — chọn ĐVT tại đây để tự động cập nhật vào danh sách hàng hóa sau khi hoàn thành phiếu nhập">
                                      <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:ProductOption">
                                          <TextBlock Text="{Binding Name}" FontSize="12.5" VerticalAlignment="Center" />
                                        </DataTemplate>
                                      </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <Button Grid.Column="1"
                                      Width="26"
                                      Height="30"
                                      MinWidth="26"
                                      MaxWidth="26"
                                      Margin="0"
                                      Padding="0"
                                      CornerRadius="6"
                                      Background="#EEF7F4"
                                      Foreground="#0C756A"
                                      BorderBrush="#CFE6E1"
                                      BorderThickness="1"
                                      HorizontalContentAlignment="Center"
                                      VerticalContentAlignment="Center"
                                      ToolTip.Tip="Thêm đơn vị tính mới"
                                      Command="{Binding ElementName=RootWindow, Path=DataContext.ThemDonViTinhPhieuNhapCommand}"
                                      CommandParameter="{Binding}">
                                      <Path Width="10"
                                        Height="10"
                                        Stretch="Uniform"
                                        Fill="#0C756A"
                                        Data="M 4.6,0 H 6.4 V 4.6 H 11 V 6.4 H 6.4 V 11 H 4.6 V 6.4 H 0 V 4.6 H 4.6 Z"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                                    </Button>
                                  </Grid>
                                </Grid>

                                <!-- SỐ LƯỢNG (sửa trực tiếp) -->
                                <!-- Icon của 3 nút dùng hình học (Rectangle/Path) thay cho chữ "+", "−", "×":
                                     chữ của font luôn nằm trên trục toán học nên lệch ~1px xuống dưới tâm,
                                     còn hình học do layout căn giữa nên luôn đúng tâm ở mọi độ phân giải. -->
                                <Grid Grid.Column="4"
                                  ColumnDefinitions="26,*,26"
                                  ColumnSpacing="0"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center">

                                  <Button Width="26"
                                    Height="28"
                                    MinWidth="26"
                                    MaxWidth="26"
                                    Margin="0"
                                    Padding="0"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    CornerRadius="6,0,0,6"
                                    Background="#EEF7F4"
                                    Foreground="#0C756A"
                                    BorderBrush="#CFE6E1"
                                    BorderThickness="1,1,0,1"
                                    Command="{Binding ElementName=RootWindow, Path=DataContext.GiamSoLuongNhapCommand}"
                                    CommandParameter="{Binding}">

                                    <Rectangle Width="11"
                                      Height="1.8"
                                      Fill="#0C756A"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                                  </Button>

                                  <TextBox Grid.Column="1"
                                    MinWidth="52"
                                    Height="28"
                                    Margin="0"
                                    Padding="2"
                                    TextAlignment="Center"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Background="#F8FBFA"
                                    BorderBrush="#CFE6E1"
                                    BorderThickness="1"
                                    Text="{Binding SoLuong, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                  <Button Grid.Column="2"
                                    Width="26"
                                    Height="28"
                                    MinWidth="26"
                                    MaxWidth="26"
                                    Margin="0"
                                    Padding="0"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    CornerRadius="0,6,6,0"
                                    Background="#EEF7F4"
                                    Foreground="#0C756A"
                                    BorderBrush="#CFE6E1"
                                    BorderThickness="0,1,1,1"
                                    Command="{Binding ElementName=RootWindow, Path=DataContext.TangSoLuongNhapCommand}"
                                    CommandParameter="{Binding}">

                                    <Path Width="11"
                                      Height="11"
                                      Stretch="Uniform"
                                      Fill="#0C756A"
                                      Data="M 4.6,0 H 6.4 V 4.6 H 11 V 6.4 H 6.4 V 11 H 4.6 V 6.4 H 0 V 4.6 H 4.6 Z"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                                  </Button>
                                </Grid>

                                <!-- GIÁ NHẬP (sửa trực tiếp, có định dạng tiền VN) -->
                                <controls:MoneyTextBox Grid.Column="5"
                                  Margin="0,0,8,0"
                                  Height="28"
                                  Value="{Binding DonGiaNhap, Mode=TwoWay}" />

                                <!-- THÀNH TIỀN -->
                                <TextBlock Grid.Column="6"
                                  Text="{Binding ThanhTien, StringFormat={}{0:N0} đ}"
                                  Foreground="#087F6E"
                                  FontSize="13"
                                  FontWeight="SemiBold"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Right"
                                  Margin="0,0,8,0" />

                                <!-- XÓA DÒNG: nút tròn vuông 28x28, CornerRadius = 14 = nửa kích thước,
                                     icon "×" vẽ bằng Path nên nằm đúng tâm hình tròn. -->
                                <Button Grid.Column="7"
                                  Width="28"
                                  Height="28"
                                  Margin="0"
                                  Padding="0"
                                  HorizontalContentAlignment="Center"
                                  VerticalContentAlignment="Center"
                                  CornerRadius="14"
                                  Background="#FDECEC"
                                  Foreground="#D92D20"
                                  BorderBrush="#F1B7B1"
                                  BorderThickness="1"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Center"
                                  ToolTip.Tip="Xóa dòng này"
                                  Command="{Binding ElementName=RootWindow, Path=DataContext.XoaDongPhieuNhapCommand}"
                                  CommandParameter="{Binding}">

                                  <Path Width="10"
                                    Height="10"
                                    Stretch="Uniform"
                                    Fill="#D92D20"
                                    Data="M 0.8,0 L 5,4.2 L 9.2,0 L 10,0.8 L 5.8,5 L 10,9.2 L 9.2,10 L 5,5.8 L 0.8,10 L 0,9.2 L 4.2,5 L 0,0.8 Z"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                                </Button>
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>

                      <!-- RỖNG -->
                      <StackPanel IsVisible="{Binding IsPhieuNhapEmpty}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">

                        <TextBlock Text="🌼"
                          FontSize="38"
                          HorizontalAlignment="Center"
                          Foreground="#CDE7E0" />

                        <TextBlock Text="Chưa có hàng hóa nào trong phiếu"
                          FontSize="15"
                          FontWeight="SemiBold"
                          Foreground="#61736E"
                          HorizontalAlignment="Center"
                          Margin="0,10,0,0" />

                        <TextBlock
                          Text="Tìm hàng hóa ở ô trên rồi bấm vào kết quả để thêm vào phiếu"
                          FontSize="12"
                          Foreground="#98A2B3"
                          HorizontalAlignment="Center"
                          Margin="0,4,0,0" />
                      </StackPanel>
                    </Grid>

                  </Grid>
                </Border>
              </Grid>

              <!-- CỘT PHẢI - PANEL THÔNG TIN PHIẾU                        -->
              <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="1"
                Background="White"
                BorderBrush="#E2ECE8"
                BorderThickness="1"
                CornerRadius="14"
                Padding="18"
                BoxShadow="0 4 16 #120A352E">

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <StackPanel Spacing="14">

                    <!-- TIÊU ĐỀ PANEL -->
                    <TextBlock Text="THÔNG TIN PHIẾU"
                      FontSize="12"
                      FontWeight="Bold"
                      Foreground="#164B40"
                      LetterSpacing="1" />

                    <!-- NHÂN VIÊN -->
                    <StackPanel Spacing="5">
                      <TextBlock Text="Nhân viên"
                        FontSize="12"
                        Foreground="#61736E" />

                      <Border Background="#F7FAF9"
                        BorderBrush="#E2ECE8"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10,8">
                        <TextBlock Text="{Binding PhieuNhapNhanVien}"
                          FontSize="13"
                          FontWeight="SemiBold"
                          Foreground="#163F38"
                          TextTrimming="CharacterEllipsis" />
                      </Border>
                    </StackPanel>

                    <!-- NGÀY NHẬP -->
                    <StackPanel Spacing="5">
                      <TextBlock Text="Ngày nhập"
                        FontSize="12"
                        Foreground="#61736E" />

                      <Grid ColumnDefinitions="*,Auto"
                        ColumnSpacing="6">

                        <TextBox Name="PhieuNhapNgayNhapBox"
                          IsReadOnly="True"
                          Text="{Binding PhieuNhapNgayNhapText, Mode=OneWay}"
                          Watermark="dd/MM/yyyy HH:mm"
                          PointerPressed="OnPhieuNhapNgayNhapBoxPointerPressed"
                          Padding="10,8"
                          FontSize="13"
                          Margin="0" />

                        <Button Grid.Column="1"
                          Content="📅"
                          Width="38"
                          Padding="0"
                          FontSize="15"
                          Background="#F7FAF9"
                          Foreground="#164B40"
                          BorderBrush="#D8E5E0"
                          BorderThickness="1"
                          CornerRadius="8"
                          VerticalAlignment="Stretch"
                          HorizontalAlignment="Stretch"
                          ToolTip.Tip="Mở lịch chọn ngày nhập"
                          Command="{Binding MoLichPhieuNhapCommand}" />

                        <Popup Grid.Column="0"
                          Grid.ColumnSpan="2"
                          PlacementTarget="PhieuNhapNgayNhapBox"
                          Placement="Bottom"
                          IsLightDismissEnabled="True"
                          IsOpen="{Binding IsPhieuNhapCalendarOpen, Mode=TwoWay}">
                          <Border Background="White"
                            BorderBrush="#D8E5E0"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="4">
                            <Calendar Name="PhieuNhapCalendar"
                              SelectedDate="{Binding PhieuNhapNgayNhap, Mode=TwoWay}"
                              Background="Transparent"
                              BorderThickness="0" />
                          </Border>
                        </Popup>
                      </Grid>
                    </StackPanel>

                    <!-- NHÀ CUNG CẤP -->
                    <StackPanel Spacing="5">
                      <TextBlock Text="Nhà cung cấp"
                        FontSize="12"
                        Foreground="#61736E" />

                      <Grid ColumnDefinitions="*,Auto"
                        ColumnSpacing="6">

                        <TextBox Name="PhieuNhapNccSearchBox"
                          Text="{Binding ImportSupplierSearch, Mode=TwoWay}"
                          Watermark="Tìm nhà cung cấp..."
                          TextChanged="OnImportSupplierSearchTextChanged"
                          Padding="10,8"
                          FontSize="13"
                          Margin="0" />

                        <Button Grid.Column="1"
                          Content="+"
                          Width="38"
                          Padding="0"
                          FontSize="17"
                          FontWeight="Bold"
                          Background="#087F6E"
                          Foreground="White"
                          BorderBrush="Transparent"
                          BorderThickness="0"
                          CornerRadius="8"
                          VerticalAlignment="Stretch"
                          HorizontalAlignment="Stretch"
                          ToolTip.Tip="Thêm nhà cung cấp mới"
                          Command="{Binding ThemNhaCungCapNhapNhanhCommand}"
                          IsVisible="{Binding CanCreateSupplier}" />
                      </Grid>

                      <!-- KẾT QUẢ TÌM NHÀ CUNG CẤP -->
                      <Border Background="#F7FAF9"
                        BorderBrush="#E2ECE8"
                        BorderThickness="1"
                        CornerRadius="8"
                        MaxHeight="140"
                        IsVisible="{Binding HasPhieuNhapSupplierSuggestions}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                          <ItemsControl ItemsSource="{Binding PhieuNhapSupplierSuggestions}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="models:NhaCungCap">
                                <Button HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Left"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  Foreground="#344054"
                                  Padding="10,7"
                                  Command="{Binding ElementName=RootWindow, Path=DataContext.ChonNhaCungCapNhapCommand}"
                                  CommandParameter="{Binding}">
                                  <StackPanel>
                                    <TextBlock Text="{Binding TenNhaCungCap}"
                                      FontSize="13"
                                      TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding MaNhaCungCap}"
                                      FontSize="11"
                                      Foreground="#98A2B3" />
                                  </StackPanel>
                                </Button>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </ScrollViewer>
                      </Border>
                    </StackPanel>

                    <!-- MÃ PHIẾU NHẬP -->
                    <StackPanel Spacing="5">
                      <TextBlock Text="Mã phiếu nhập"
                        FontSize="12"
                        Foreground="#61736E" />

                      <Border Background="#EAF9F5"
                        BorderBrush="#BFE5DC"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10,8">
                        <TextBlock Text="{Binding PhieuNhapMa}"
                          FontSize="14"
                          FontWeight="Bold"
                          Foreground="#087F6E" />
                      </Border>
                    </StackPanel>

                    <!-- SỐ HÓA ĐƠN ĐẦU VÀO -->
                    <StackPanel Spacing="5">
                      <TextBlock Text="Số hóa đơn đầu vào"
                        FontSize="12"
                        Foreground="#61736E" />

                      <TextBox Text="{Binding PhieuNhapSoHoaDonDauVao, Mode=TwoWay}"
                        Watermark="Số hóa đơn của nhà cung cấp"
                        Padding="10,8"
                        FontSize="13"
                        Margin="0" />
                    </StackPanel>

                    <!-- TỔNG TIỀN HÀNG -->
                    <Border Background="#F7FAF9"
                      CornerRadius="10"
                      Padding="12"
                      BorderBrush="#E2ECE8"
                      BorderThickness="1">
                      <Grid ColumnDefinitions="*,Auto">

                        <TextBlock Text="Tổng tiền hàng"
                          FontSize="13"
                          Foreground="#61736E"
                          VerticalAlignment="Center" />

                        <TextBlock Grid.Column="1"
                          Text="{Binding PhieuNhapTongTienHangText}"
                          FontSize="15"
                          FontWeight="Bold"
                          Foreground="#163F38" />
                      </Grid>
                    </Border>

                    <!-- CHI PHÍ KHÁC -->
                    <StackPanel Spacing="5">
                      <TextBlock Text="Chi phí khác (vận chuyển, thuế...)"
                        FontSize="12"
                        Foreground="#61736E" />

                      <controls:MoneyTextBox Value="{Binding PhieuNhapChiPhiKhac, Mode=TwoWay}"
                        Height="34"
                        Margin="0" />
                    </StackPanel>

                    <!-- ĐÃ THANH TOÁN -->
                    <StackPanel Spacing="5">
                      <TextBlock Text="Đã thanh toán"
                        FontSize="12"
                        Foreground="#61736E" />

                      <controls:MoneyTextBox Value="{Binding PhieuNhapDaThanhToan, Mode=TwoWay}"
                        Height="34"
                        Margin="0" />
                    </StackPanel>

                    <!-- PHƯƠNG THỨC / NGUỒN QUỸ THANH TOÁN -->
                    <StackPanel Spacing="5">
                      <TextBlock Text="Phương thức thanh toán / Nguồn quỹ"
                        FontSize="12"
                        Foreground="#61736E" />

                      <ComboBox ItemsSource="{Binding PhieuNhapPhuongThucOptions}"
                        SelectedItem="{Binding PhieuNhapPhuongThuc, Mode=TwoWay}"
                        HorizontalAlignment="Stretch"
                        Height="34" />

                      <TextBlock Text="{Binding PhieuNhapNguonQuyText}"
                        FontSize="11"
                        Foreground="#087F6E"
                        Margin="2,1,0,0"
                        TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- TỔNG TIỀN NHẬP -->
                    <Border Background="#0A8C78"
                      CornerRadius="10"
                      Padding="14">
                      <Grid ColumnDefinitions="*,Auto">

                        <TextBlock Text="Tổng tiền nhập"
                          FontSize="14"
                          FontWeight="SemiBold"
                          Foreground="#EAF9F5"
                          VerticalAlignment="Center" />

                        <TextBlock Grid.Column="1"
                          Text="{Binding PhieuNhapTongTienNhapText}"
                          FontSize="19"
                          FontWeight="Bold"
                          Foreground="White" />
                      </Grid>
                    </Border>

                    <!-- CÒN PHẢI TRẢ (công nợ) -->
                    <Border Background="#FFF7E8"
                      CornerRadius="10"
                      Padding="12"
                      BorderBrush="#F5DDB4"
                      BorderThickness="1">
                      <Grid ColumnDefinitions="*,Auto">

                        <TextBlock Text="Còn phải trả"
                          FontSize="13"
                          Foreground="#B06A00"
                          VerticalAlignment="Center" />

                        <TextBlock Grid.Column="1"
                          Text="{Binding PhieuNhapConNoText}"
                          FontSize="15"
                          FontWeight="Bold"
                          Foreground="#B06A00" />
                      </Grid>
                    </Border>

                    <!-- GHI CHÚ -->
                    <StackPanel Spacing="5">
                      <TextBlock Text="Ghi chú"
                        FontSize="12"
                        Foreground="#61736E" />

                      <TextBox Text="{Binding PhieuNhapGhiChu, Mode=TwoWay}"
                        Watermark="Ghi chú phiếu nhập..."
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        Height="72"
                        Padding="10,8"
                        FontSize="13"
                        Margin="0" />
                    </StackPanel>

                    <!-- NÚT HOÀN THÀNH -->
                    <Button Classes="toolbar-primary"
                      Content="✔  Hoàn thành"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Center"
                      Padding="0,12"
                      Command="{Binding HoanThanhPhieuNhapCommand}"
                      IsEnabled="{Binding CanSavePhieuNhap}"
                      IsVisible="{Binding CanCreatePurchase}" />

                    <!-- XÓA TẤT CẢ -->
                    <Button Classes="toolbar-action"
                      Content="🗑  Xóa tất cả dòng hàng"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Center"
                      Padding="0,10"
                      Command="{Binding XoaTatPhieuNhapCommand}" />

                  </StackPanel>
                </ScrollViewer>
              </Border>

            </Grid>
          </Grid>
        </TabItem>

        <!-- TAB SỔ QUỸ - PHIẾU THU / PHIẾU CHI CÓ BỘ LỌC                    -->
        <!-- Bố cục: bộ lọc bên trái, danh sách + thống kê bên phải.          -->
        <!-- Mọi điều kiện lọc và cả 4 thẻ thống kê đều do MySQL tính.        -->
        <TabItem Header="Sổ quỹ">
          <Grid ColumnDefinitions="272,*" ColumnSpacing="12">

            <!-- BÊN TRÁI: BỘ LỌC                                            -->
            <Border Grid.Column="0"
              Background="White"
              BorderBrush="#E2ECE8"
              BorderThickness="1"
              CornerRadius="12"
              ClipToBounds="True">

              <Grid RowDefinitions="Auto,*,Auto">

                <Border Grid.Row="0"
                  Background="#F7FAF9"
                  BorderBrush="#E2ECE8"
                  BorderThickness="0,0,0,1"
                  CornerRadius="12,12,0,0"
                  Padding="14,11">

                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <StackPanel Grid.Column="0" Spacing="1">
                      <TextBlock Text="BỘ LỌC"
                        FontSize="12"
                        FontWeight="Bold"
                        Foreground="#164B40" />
                      <TextBlock Text="{Binding SoQuyLocDangChonQuy}"
                        FontSize="11"
                        Foreground="#98A2B3"
                        TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <Button Grid.Column="1"
                      Classes="sq-icon"
                      Content="↺"
                      Width="26"
                      Height="26"
                      FontSize="12"
                      ToolTip.Tip="Xóa toàn bộ bộ lọc"
                      Command="{Binding XoaBoLocSoQuyCommand}" />
                  </Grid>
                </Border>

                <ScrollViewer Grid.Row="1"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="14,12">

                  <!-- Thêm khoảng trống margin đáy ở đây để không bị nút footer che khuất -->
                  <StackPanel Spacing="15" Margin="0,0,0,40">


                    <!-- 1. QUỸ -->
                    <StackPanel Spacing="6">
                      <TextBlock Classes="sq-label" Text="QUỸ" />

                      <ComboBox x:Name="SoQuyQuyBox"
                        Classes="sq-input"
                        FontSize="12"
                        HorizontalAlignment="Stretch"
                        ItemsSource="{Binding SoQuyQuyOptions}"
                        SelectedItem="{Binding SoQuyLocQuy, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                          <DataTemplate x:DataType="models:SoQuyLuaChon">
                            <TextBlock Text="{Binding HienThi}" FontSize="12" />
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                        <ComboBox.SelectionBoxItemTemplate>
                          <DataTemplate x:DataType="models:SoQuyLuaChon">
                            <TextBlock Text="{Binding HienThi}" FontSize="12" />
                          </DataTemplate>
                        </ComboBox.SelectionBoxItemTemplate>
                      </ComboBox>
                    </StackPanel>

                    <!-- 2. THỜI GIAN -->
                    <StackPanel Spacing="6">
                      <TextBlock Classes="sq-label" Text="THỜI GIAN" />

                      <ComboBox x:Name="SoQuyKhoangThoiGianBox"
                        Classes="sq-input"
                        FontSize="12"
                        HorizontalAlignment="Stretch"
                        ItemsSource="{Binding SoQuyKhoangThoiGianOptions}"
                        SelectedItem="{Binding SoQuyLocKhoangThoiGian, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                          <DataTemplate x:DataType="models:SoQuyLuaChon">
                            <TextBlock Text="{Binding HienThi}" FontSize="12" />
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                                              <ComboBox.SelectionBoxItemTemplate>
                          <DataTemplate x:DataType="models:SoQuyLuaChon">
                            <TextBlock Text="{Binding HienThi}" FontSize="12" />
                          </DataTemplate>
                        </ComboBox.SelectionBoxItemTemplate>
                      </ComboBox>

                      <!-- Ô tùy chỉnh chỉ hiện khi chọn "Tùy chỉnh" -->
                      <StackPanel Spacing="6"
                        Margin="0,2,0,0"
                        IsVisible="{Binding SoQuyLocTuyChinh}">
                        <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="6">
                          <StackPanel Grid.Column="0" Spacing="3">
                            <TextBlock Text="Từ ngày"
                              FontSize="10"
                              Foreground="#98A2B3" />
                            <DatePicker Classes="sq-date"
                              FontSize="12"
                              SelectedDate="{Binding SoQuyLocTuNgay, Mode=TwoWay}" />
                          </StackPanel>

                          <StackPanel Grid.Column="2" Spacing="3">
                            <TextBlock Text="Đến ngày"
                              FontSize="10"
                              Foreground="#98A2B3" />
                            <DatePicker Classes="sq-date"
                              FontSize="12"
                              SelectedDate="{Binding SoQuyLocDenNgay, Mode=TwoWay}" />
                          </StackPanel>
                        </Grid>
                      </StackPanel>
                    </StackPanel>

                    <!-- 3. LOẠI CHỨNG TỪ -->
                    <StackPanel Spacing="6">
                      <TextBlock Classes="sq-label" Text="LOẠI CHỨNG TỪ" />

                      <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                        <ToggleButton Grid.Column="0"
                          Classes="locChip"
                          Content="Tất cả"
                          FontSize="11"
                          IsChecked="{Binding SoQuyLocChonTatCa, Mode=TwoWay}" />
                        <ToggleButton Grid.Column="1"
                          Classes="locChip"
                          Content="Phiếu thu"
                          FontSize="11"
                          IsChecked="{Binding SoQuyLocChonThu, Mode=TwoWay}" />
                        <ToggleButton Grid.Column="2"
                          Classes="locChip"
                          Content="Phiếu chi"
                          FontSize="11"
                          IsChecked="{Binding SoQuyLocChonChi, Mode=TwoWay}" />
                      </Grid>
                    </StackPanel>

                    <!-- 4. LOẠI THU CHI (lấy từ bảng nhom_chi_phi) -->
                    <StackPanel Spacing="6"
                      IsVisible="{Binding SoQuyCoLoaiThuChi}">
                      <TextBlock Classes="sq-label" Text="LOẠI THU CHI" />

                      <ItemsControl ItemsSource="{Binding SoQuyLoaiThuChiOptions}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="models:SoQuyLuaChonItem">
                            <CheckBox Content="{Binding HienThi}"
                              IsChecked="{Binding IsChecked, Mode=TwoWay}"
                              FontSize="12"
                              Foreground="#344054"
                              Margin="0,0,0,4" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>

                    <!-- 5. NGƯỜI TẠO (lấy từ bảng nguoi_dung) -->
                    <StackPanel Spacing="6"
                      IsVisible="{Binding SoQuyCoNguoiTao}">
                      <TextBlock Classes="sq-label" Text="NGƯỜI TẠO" />

                      <ItemsControl ItemsSource="{Binding SoQuyNguoiTaoOptions}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="models:SoQuyLuaChonItem">
                            <CheckBox Content="{Binding HienThi}"
                              IsChecked="{Binding IsChecked, Mode=TwoWay}"
                              FontSize="12"
                              Foreground="#344054"
                              Margin="0,0,0,4" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>

                    <!-- 6. KHOẢNG TIỀN -->
                    <StackPanel Spacing="6">
                      <TextBlock Classes="sq-label" Text="KHOẢNG TIỀN" />

                      <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="6">
                        <TextBox Grid.Column="0"
                          Classes="sq-input"
                          FontSize="12"
                          Watermark="Từ số tiền"
                          Text="{Binding SoQuyLocTienTuText, Mode=TwoWay}" />

                        <TextBlock Grid.Column="1"
                          Text="–"
                          FontSize="12"
                          Foreground="#98A2B3"
                          VerticalAlignment="Center" />

                        <TextBox Grid.Column="2"
                          Classes="sq-input"
                          FontSize="12"
                          Watermark="Đến số tiền"
                          Text="{Binding SoQuyLocTienDenText, Mode=TwoWay}" />
                      </Grid>
                    </StackPanel>

                  </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2"
                  Background="#F7FAF9"
                  BorderBrush="#E2ECE8"
                  BorderThickness="0,1,0,0"
                  CornerRadius="0,0,12,12"
                  Padding="14,10">
                  <Button Classes="toolbar-action"
                    Content="✕  Xóa bộ lọc"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Padding="0,10"
                    Margin="0"
                    FontSize="12"
                    IsEnabled="{Binding CoSoQuyBoLoc}"
                    Command="{Binding XoaBoLocSoQuyCommand}" />
                </Border>
              </Grid>
            </Border>

            <!-- BÊN PHẢI: THANH TÌM KIẾM + DANH SÁCH + THỐNG KÊ            -->
            <Grid Grid.Column="1"
              RowDefinitions="Auto,Auto,*"
              RowSpacing="12">

              <Grid Grid.Row="0"
                ColumnDefinitions="Auto,*,Auto"
                ColumnSpacing="10">

                <Grid Grid.Column="0"
                  ColumnDefinitions="*,Auto"
                  ColumnSpacing="8"
                  Width="440"
                  VerticalAlignment="Center">

                  <TextBox Grid.Column="0"
                    Classes="searchInput"
                    Watermark="🔍  Mã phiếu, người nộp / nhận, nội dung"
                    Text="{Binding SoQuySearchText, Mode=TwoWay}"
                    Height="38"
                    Padding="12,7"
                    FontSize="13"
                    VerticalContentAlignment="Center" />

                  <Button Grid.Column="1"
                    Classes="toolbar-action"
                    Content="✕"
                    ToolTip.Tip="Xóa ô tìm kiếm"
                    Width="38"
                    Height="38"
                    Padding="0"
                    FontSize="13"
                    IsVisible="{Binding IsSoQuyDangTimKiem}"
                    Command="{Binding XoaTimKiemSoQuyCommand}" />
                </Grid>

                <StackPanel Grid.Column="2"
                  Orientation="Horizontal"
                  Spacing="8"
                  VerticalAlignment="Center">

                  <Button Classes="toolbar-primary"
                    Content="＋  Phiếu thu"
                    Command="{Binding MoSoQuyPhieuThuCommand}"
                    Height="38"
                    Padding="16,0"
                    FontSize="13"
                    IsVisible="{Binding CanCreateReceipt}" />

                  <Button Classes="toolbar-action"
                    Content="－  Phiếu chi"
                    Command="{Binding MoSoQuyPhieuChiCommand}"
                    Height="38"
                    Padding="16,0"
                    FontSize="13"
                    IsVisible="{Binding CanCreatePayment}" />

                  <Border Width="1"
                    Height="26"
                    Background="#E2ECE8"
                    Margin="4,0"
                    VerticalAlignment="Center" />

                  <Button Classes="toolbar-action"
                    Content="⇩  Xuất file"
                    ToolTip.Tip="Xuất danh sách phiếu đang lọc ra file Excel"
                    Command="{Binding XuatFileSoQuyCommand}"
                    Height="38"
                    Padding="14,0"
                    FontSize="13"
                    IsVisible="{Binding CanExportCashBook}" />

                  <Button Classes="toolbar-action"
                    Content="⇧  Nhập file"
                    ToolTip.Tip="Nhập sổ quỹ từ file Excel hoặc CSV, có xem trước trước khi ghi"
                    Command="{Binding NhapFileSoQuyCommand}"
                    IsEnabled="{Binding !IsSoQuyDangNhap}"
                    Height="38"
                    Padding="14,0"
                    FontSize="13"
                    IsVisible="{Binding CanImportCashBook}" />
                </StackPanel>
              </Grid>

              <!-- 1. KHI CHỌN "TẤT CẢ": Hiển thị đầy đủ 3 thẻ (Tổng thu, Tổng chi, Tồn quỹ) chia đều 3 cột -->
              <Grid Grid.Row="1"
                IsVisible="{Binding SoQuyLocChonTatCa}"
                ColumnDefinitions="*,*,*"
                ColumnSpacing="12">

                <!-- Tổng thu - màu xanh dương -->
                <Border Grid.Column="0"
                  Background="White"
                  BorderBrush="#D6E4FF"
                  BorderThickness="1"
                  CornerRadius="12"
                  Padding="16,14"
                  VerticalAlignment="Stretch">

                  <StackPanel Spacing="8">

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                      <Border Grid.Column="0"
                        Width="28"
                        Height="28"
                        CornerRadius="7"
                        Background="#EAF1FF"
                        VerticalAlignment="Center">
                        <TextBlock Text="↑"
                          FontSize="13"
                          FontWeight="Bold"
                          Foreground="#1877F2"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                      </Border>

                      <TextBlock Grid.Column="1"
                        Text="TỔNG THU"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="#667085"
                        VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock Text="{Binding SoQuyTongThuText}"
                      FontSize="25"
                      FontWeight="Bold"
                      Foreground="#1877F2"
                      VerticalAlignment="Center" />
                  </StackPanel>
                </Border>

                <!-- Tổng chi - màu đỏ -->
                <Border Grid.Column="1"
                  Background="White"
                  BorderBrush="#FBD3D0"
                  BorderThickness="1"
                  CornerRadius="12"
                  Padding="16,14"
                  VerticalAlignment="Stretch">

                  <StackPanel Spacing="8">

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                      <Border Grid.Column="0"
                        Width="28"
                        Height="28"
                        CornerRadius="7"
                        Background="#FEF3F2"
                        VerticalAlignment="Center">
                        <TextBlock Text="↓"
                          FontSize="13"
                          FontWeight="Bold"
                          Foreground="#D92D20"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                      </Border>

                      <TextBlock Grid.Column="1"
                        Text="TỔNG CHI"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="#667085"
                        VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock Text="{Binding SoQuyTongChiText}"
                      FontSize="25"
                      FontWeight="Bold"
                      Foreground="#D92D20"
                      VerticalAlignment="Center" />
                  </StackPanel>
                </Border>

                <!-- Tồn quỹ - màu xanh lá -->
                <Border Grid.Column="2"
                  Background="White"
                  BorderBrush="#C3EBD8"
                  BorderThickness="1"
                  CornerRadius="12"
                  Padding="16,14"
                  VerticalAlignment="Stretch">

                  <StackPanel Spacing="8">

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                      <Border Grid.Column="0"
                        Width="28"
                        Height="28"
                        CornerRadius="7"
                        Background="#E7F8F0"
                        VerticalAlignment="Center">
                        <TextBlock Text="▣"
                          FontSize="13"
                          Foreground="#12B76A"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                      </Border>

                      <TextBlock Grid.Column="1"
                        Text="TỒN QUỸ"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="#667085"
                        VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock Text="{Binding SoQuyTonQuyText}"
                      FontSize="25"
                      FontWeight="Bold"
                      Foreground="#12B76A"
                      VerticalAlignment="Center" />
                  </StackPanel>
                </Border>
              </Grid>

              <!-- 2. KHI CHỌN "PHIẾU THU": Chỉ hiển thị Tổng thu, ẩn Tổng chi và Tồn quỹ, cân đối hài hòa -->
              <Border Grid.Row="1"
                IsVisible="{Binding SoQuyLocChonThu}"
                Background="White"
                BorderBrush="#D6E4FF"
                BorderThickness="1"
                CornerRadius="12"
                MinHeight="84"
                Padding="24,14">

                <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                  <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Width="38"
                      Height="38"
                      CornerRadius="9"
                      Background="#EAF1FF"
                      VerticalAlignment="Center">
                      <TextBlock Text="↑"
                        FontSize="17"
                        FontWeight="Bold"
                        Foreground="#1877F2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                    </Border>

                    <StackPanel VerticalAlignment="Center" Spacing="2">
                      <TextBlock Text="TỔNG THU"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="#667085" />
                      <TextBlock Text="Tổng các khoản tiền thu theo bộ lọc"
                        FontSize="11"
                        Foreground="#98A2B3" />
                    </StackPanel>
                  </StackPanel>

                  <TextBlock Grid.Column="2"
                    Text="{Binding SoQuyTongThuText}"
                    FontSize="28"
                    FontWeight="Bold"
                    Foreground="#1877F2"
                    VerticalAlignment="Center" />
                </Grid>
              </Border>

              <!-- 3. KHI CHỌN "PHIẾU CHI": Chỉ hiển thị Tổng chi, ẩn Tổng thu và Tồn quỹ, cân đối hài hòa -->
              <Border Grid.Row="1"
                IsVisible="{Binding SoQuyLocChonChi}"
                Background="White"
                BorderBrush="#FBD3D0"
                BorderThickness="1"
                CornerRadius="12"
                MinHeight="84"
                Padding="24,14">

                <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                  <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Width="38"
                      Height="38"
                      CornerRadius="9"
                      Background="#FEF3F2"
                      VerticalAlignment="Center">
                      <TextBlock Text="↓"
                        FontSize="17"
                        FontWeight="Bold"
                        Foreground="#D92D20"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                    </Border>

                    <StackPanel VerticalAlignment="Center" Spacing="2">
                      <TextBlock Text="TỔNG CHI"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="#667085" />
                      <TextBlock Text="Tổng các khoản tiền chi theo bộ lọc"
                        FontSize="11"
                        Foreground="#98A2B3" />
                    </StackPanel>
                  </StackPanel>

                  <TextBlock Grid.Column="2"
                    Text="{Binding SoQuyTongChiText}"
                    FontSize="28"
                    FontWeight="Bold"
                    Foreground="#D92D20"
                    VerticalAlignment="Center" />
                </Grid>
              </Border>

              <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E2ECE8"
                BorderThickness="1"
                CornerRadius="12"
                ClipToBounds="True">

                <Grid RowDefinitions="*,Auto">

                  <!-- HEADER -->
                  <Grid Grid.Row="0" RowDefinitions="Auto,*">

                    <Border Grid.Row="0"
                      Background="#F7FAF9"
                      BorderBrush="#E2ECE8"
                      BorderThickness="0,0,0,1"
                      Padding="16,0">

                      <Grid ColumnDefinitions="150,175,140,120,240,175,110"
                        Height="46">
                        <TextBlock Grid.Column="0"
                          Text="MÃ PHIẾU"
                          FontSize="12"
                          FontWeight="SemiBold"
                          Foreground="#164B40"
                          VerticalAlignment="Center" />

                        <TextBlock Grid.Column="1"
                          Text="THỜI GIAN"
                          FontSize="12"
                          FontWeight="SemiBold"
                          Foreground="#164B40"
                          VerticalAlignment="Center" />

                        <TextBlock Grid.Column="2"
                          Text="LOẠI"
                          FontSize="12"
                          FontWeight="SemiBold"
                          Foreground="#164B40"
                          VerticalAlignment="Center" />

                        <TextBlock Grid.Column="3"
                          Text="TRẠNG THÁI"
                          FontSize="12"
                          FontWeight="SemiBold"
                          Foreground="#164B40"
                          VerticalAlignment="Center" />

                        <TextBlock Grid.Column="4"
                          Text="NGƯỜI NỘP / NHẬN"
                          FontSize="12"
                          FontWeight="SemiBold"
                          Foreground="#164B40"
                          VerticalAlignment="Center" />

                        <TextBlock Grid.Column="5"
                          Text="GIÁ TRỊ"
                          FontSize="12"
                          FontWeight="SemiBold"
                          Foreground="#164B40"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center"
                          Margin="0,0,4,0" />

                        <TextBlock Grid.Column="6"
                          Text="THAO TÁC"
                          FontSize="12"
                          FontWeight="SemiBold"
                          Foreground="#164B40"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                      </Grid>
                    </Border>

                    <Grid Grid.RowSpan="2"
                      IsVisible="{Binding IsSoQuyDangNhap}"
                      VerticalAlignment="Top"
                      HorizontalAlignment="Center"
                      Margin="0,10,0,0"
                      ZIndex="21">
                      <Border Background="#F2F9F7"
                        BorderBrush="#D7E7E2"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="18,12"
                        MinWidth="380">
                        <StackPanel Spacing="6">
                          <TextBlock Text="{Binding SoQuyTienDoNhap}"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="#163F38"
                            HorizontalAlignment="Center" />
                          <ProgressBar Height="6"
                            Minimum="0"
                            Maximum="100"
                            Value="{Binding SoQuyPhanTramNhap}"
                            Foreground="#087F6E"
                            Background="#D7E7E2" />
                        </StackPanel>
                      </Border>
                    </Grid>

                    <!-- DANH SÁCH -->
                    <Grid Grid.Row="1">

                      <ScrollViewer HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Auto">

                        <Grid MinWidth="1104">

                          <ItemsControl ItemsSource="{Binding SoQuyGiaoDichs}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="models:SoQuyGiaoDich">

                                <Border Background="White"
                                  BorderBrush="#EDF2F0"
                                  BorderThickness="0,0,0,1"
                                  Padding="16,0">

                                  <Grid ColumnDefinitions="150,175,140,120,240,175,110"
                                    MinHeight="56">

                                    <!-- MÃ PHIẾU -->
                                    <StackPanel Grid.Column="0"
                                      Orientation="Vertical"
                                      VerticalAlignment="Center">
                                      <TextBlock Text="{Binding MaPhieu}"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="#263B35"
                                        TextTrimming="CharacterEllipsis" />
                                      <TextBlock Text="{Binding TenLoai}"
                                        FontSize="11"
                                        Foreground="#98A2B3"
                                        TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <!-- THỜI GIAN -->
                                    <TextBlock Grid.Column="1"
                                      Text="{Binding ThoiGianHienThi}"
                                      FontSize="13"
                                      Foreground="#475467"
                                      VerticalAlignment="Center"
                                      TextTrimming="CharacterEllipsis" />

                                    <!-- LOẠI THU/CHI -->
                                    <Border Grid.Column="2"
                                      Background="{Binding MauNenLoai}"
                                      CornerRadius="12"
                                      Padding="10,4"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center">
                                      <TextBlock Text="{Binding LoaiHienThi}"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="{Binding MauLoai}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                                    </Border>

                                    <!-- TRẠNG THÁI -->
                                    <Border Grid.Column="3"
                                      Background="{Binding MauNenTrangThai}"
                                      CornerRadius="12"
                                      Padding="10,4"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center">
                                      <TextBlock Text="{Binding TrangThaiHienThi}"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="{Binding MauTrangThai}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                                    </Border>

                                    <!-- NGƯỜI NỘP / NHẬN -->
                                    <TextBlock Grid.Column="4"
                                      Text="{Binding NguoiNopNhan}"
                                      FontSize="13"
                                      Foreground="#344054"
                                      VerticalAlignment="Center"
                                      Margin="0,8"
                                      TextWrapping="Wrap"
                                      MaxLines="2"
                                      TextTrimming="CharacterEllipsis" />

                                    <!-- GIÁ TRỊ -->
                                    <TextBlock Grid.Column="5"
                                      Text="{Binding GiaTri, StringFormat={}{0:N0} đ}"
                                      FontSize="14"
                                      FontWeight="Bold"
                                      Foreground="{Binding MauLoai}"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      Margin="0,0,4,0" />

                                    <!-- THAO TÁC: mở modal chi tiết, từ đó mới hủy -->
                                    <Button Grid.Column="6"
                                      Classes="toolbar-action"
                                      Content="Xem"
                                      Padding="10,0"
                                      Height="28"
                                      FontSize="12"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Command="{Binding ElementName=RootWindow,
                                                Path=DataContext.MoChiTietPhieuCommand}"
                                      CommandParameter="{Binding}"
                                      ToolTip.Tip="Xem chi tiết phiếu" />
                                  </Grid>
                                </Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>

                          <!-- TRẠNG THÁI RỖNG -->
                          <StackPanel IsVisible="{Binding !HasSoQuyData}"
                            Spacing="10"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="0,36,0,0">

                            <TextBlock Text="🔍"
                              FontSize="26"
                              Foreground="#C4D2CC"
                              HorizontalAlignment="Center" />

                            <TextBlock Text="{Binding SoQuyEmptyStateText}"
                              FontSize="14"
                              FontWeight="SemiBold"
                              Foreground="#667085"
                              HorizontalAlignment="Center"
                              TextAlignment="Center" />

                            <TextBlock Text="Thử bỏ bớt điều kiện lọc hoặc nhấn &quot;Xóa bộ lọc&quot; để xem toàn bộ phiếu."
                              FontSize="12"
                              Foreground="#98A2B3"
                              HorizontalAlignment="Center"
                              TextAlignment="Center" />

                            <Button Classes="toolbar-action"
                              Content="✕  Xóa bộ lọc"
                              Command="{Binding XoaBoLocSoQuyCommand}"
                              IsVisible="{Binding CoSoQuyBoLoc}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Padding="16,8"
                              Margin="0" />
                          </StackPanel>
                        </Grid>
                      </ScrollViewer>
                    </Grid>
                  </Grid>

                  <!-- PHÂN TRANG -->
                  <Border Grid.Row="1"
                    Background="#F7FAF9"
                    BorderBrush="#E2ECE8"
                    BorderThickness="0,1,0,0"
                    Padding="16,10">

                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">

                      <StackPanel Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">

                        <TextBlock Text="Số dòng mỗi trang:"
                          FontSize="12"
                          Foreground="#61736E"
                          VerticalAlignment="Center" />

                        <ComboBox Name="SoQuyPageSizeBox"
                          Width="76"
                          Height="32"
                          FontSize="12"
                          ItemsSource="{Binding SoQuyPageSizeOptions}"
                          SelectedItem="{Binding SoQuyPageSize, Mode=TwoWay}"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center" />

                        <TextBlock Text="{Binding SoQuyRangeText}"
                          FontSize="12"
                          FontWeight="SemiBold"
                          Foreground="#163F38"
                          VerticalAlignment="Center"
                          Margin="10,0,0,0" />
                      </StackPanel>

                      <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="6"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                        <Button Classes="toolbar-action"
                          Content="⏮"
                          Width="34"
                          Height="30"
                          Padding="0"
                          FontSize="12"
                          Command="{Binding SoQuyTrangDauCommand}"
                          ToolTip.Tip="Về trang đầu" />

                        <Button Classes="toolbar-action"
                          Content="◀"
                          Width="34"
                          Height="30"
                          Padding="0"
                          FontSize="11"
                          IsEnabled="{Binding CanSoQuyTrangTruoc}"
                          Command="{Binding SoQuyTrangTruocCommand}"
                          ToolTip.Tip="Trang trước" />

                        <Border Background="#087F6E"
                          CornerRadius="8"
                          MinWidth="38"
                          Height="30"
                          Padding="10,0"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                          <TextBlock Text="{Binding SoQuyPage}"
                            Foreground="White"
                            FontWeight="Bold"
                            FontSize="12"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                        </Border>

                        <TextBlock Text="trên"
                          FontSize="12"
                          Foreground="#61736E"
                          VerticalAlignment="Center" />

                        <TextBlock Text="{Binding SoQuyTotalPages}"
                          FontSize="12"
                          FontWeight="SemiBold"
                          Foreground="#163F38"
                          VerticalAlignment="Center" />

                        <Button Classes="toolbar-action"
                          Content="▶"
                          Width="34"
                          Height="30"
                          Padding="0"
                          FontSize="11"
                          IsEnabled="{Binding CanSoQuyTrangSau}"
                          Command="{Binding SoQuyTrangSauCommand}"
                          ToolTip.Tip="Trang sau" />

                        <Button Classes="toolbar-action"
                          Content="⏭"
                          Width="34"
                          Height="30"
                          Padding="0"
                          FontSize="12"
                          Command="{Binding SoQuyTrangCuoiCommand}"
                          ToolTip.Tip="Về trang cuối" />
                      </StackPanel>

                      <TextBlock Grid.Column="2"
                        Text="{Binding SoQuyTotalCount, StringFormat='Tổng: {0} phiếu'}"
                        FontSize="11"
                        Foreground="#98A2B3"
                        VerticalAlignment="Center" />
                    </Grid>
                  </Border>
                </Grid>
              </Border>
            </Grid>
          </Grid>
        </TabItem>
      </TabControl>

      <!-- BÁO CÁO CUỐI NGÀY                                           -->
      <!-- Grid ngoài bind vào MainWindowViewModel để đọc được           -->
      <!-- IsBaoCaoCuoiNgaySelected; UserControl bên trong nhận        -->
      <!-- DataContext là ViewModel báo cáo.                            -->
      <Grid IsVisible="{Binding IsBaoCaoCuoiNgaySelected}">
        <views:BaoCaoCuoiNgayView DataContext="{Binding BaoCaoCuoiNgay}" />
      </Grid>

      <!-- ============================================================ -->
      <!-- THÔNG TIN TIỆM                                              -->
      <!-- Nội dung thông tin tiệm mà hóa đơn sử dụng, nằm ngoài       -->
      <!-- TabControl dữ liệu như các màn báo cáo.                    -->
      <!-- ============================================================ -->
      <Grid IsVisible="{Binding IsThongTinTiemSelected}">
        <views:ThongTinTiemView DataContext="{Binding ThongTinTiem}" />
      </Grid>

      <!-- ============================================================ -->
      <!-- BÁO CÁO BÁN HÀNG                                            -->
      <Grid IsVisible="{Binding IsBaoCaoBanHangSelected}">
        <views:BaoCaoBanHangView DataContext="{Binding BaoCaoBanHang}" />
      </Grid>

      <!-- ============================================================ -->
      <!-- BÁO CÁO HÀNG HÓA                                            -->
      <Grid IsVisible="{Binding IsBaoCaoHangHoaSelected}">
        <views:BaoCaoHangHoaView DataContext="{Binding BaoCaoHangHoa}" />
      </Grid>

      <!-- ============================================================ -->
      <!-- BÁO CÁO KHÁCH HÀNG                                           -->
      <Grid IsVisible="{Binding IsBaoCaoKhachHangSelected}">
        <views:BaoCaoKhachHangView DataContext="{Binding BaoCaoKhachHang}" />
      </Grid>

      <!-- ============================================================ -->
      <!-- BÁO CÁO NHÀ CUNG CẤP                                         -->
      <Grid IsVisible="{Binding IsBaoCaoNhaCungCapSelected}">
        <views:BaoCaoNhaCungCapView DataContext="{Binding BaoCaoNhaCungCap}" />
      </Grid>

      <!-- ============================================================ -->
      <!-- BÁO CÁO PHIẾU NHẬP HÀNG                                       -->
      <!-- (khác với Mua hàng → Nhập hàng: đây là màn đọc dữ liệu)      -->
      <Grid IsVisible="{Binding IsBaoCaoPhieuNhapSelected}"
        RowDefinitions="Auto,Auto,*"
        RowSpacing="14">

        <!-- 1. TIÊU ĐỀ + NÚT + NHẬP HÀNG -->
        <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto"
          ColumnSpacing="10">

          <StackPanel>
            <TextBlock Text="Báo cáo phiếu nhập hàng"
              FontSize="26"
              FontWeight="Bold"
              Foreground="#163F38" />

            <TextBlock Text="Theo dõi toàn bộ phiếu nhập đã tạo, có phân trang và tìm kiếm theo mã"
              Foreground="#61736E"
              FontSize="13"
              Margin="0,4,0,0" />
          </StackPanel>

          <!-- NÚT "+ NHẬP HÀNG" -> chuyển sang màn lập phiếu nhập hàng -->
          <Button Grid.Column="1"
            Classes="toolbar-primary"
            Content="＋  Nhập hàng"
            Command="{Binding MoGiaoDienNhapHangTuBaoCaoCommand}"
            VerticalAlignment="Center"
            Margin="0"
            IsVisible="{Binding CanViewPurchases}" />

          <Button Grid.Column="2"
            Classes="toolbar-action"
            Content="📤  Xuất Excel"
            Command="{Binding XuatExcelBaoCaoPhieuNhapCommand}"
            VerticalAlignment="Center"
            Margin="0" />

          <Button Grid.Column="3"
            Classes="toolbar-action"
            Content="⚙  Tuỳ chọn"
            Command="{Binding TimKiemBaoCaoPhieuNhapCommand}"
            VerticalAlignment="Center"
            Margin="0" />

          <Button Grid.Column="4"
            Classes="toolbar-action"
            Content="↻  Làm mới"
            Command="{Binding LoadBaoCaoPhieuNhapCommand}"
            VerticalAlignment="Center"
            Margin="0" />
        </Grid>

        <!-- 2. THANH TÌM KIẾM & BỘ LỌC THANH TOÁN -->
        <Border Grid.Row="1"
          Background="White"
          BorderBrush="#E2ECE8"
          BorderThickness="1"
          CornerRadius="12"
          Padding="12"
          BoxShadow="0 2 8 #080A352E">

          <Grid ColumnDefinitions="*,Auto,Auto"
            ColumnSpacing="10">

            <TextBox Name="BaoCaoPhieuNhapSearchBox"
              Classes="searchInput"
              Watermark="🔍 Tìm theo mã phiếu, mã NCC, tên NCC..."
              Text="{Binding BaoCaoPhieuNhapSearch, Mode=TwoWay}"
              TextChanged="OnBaoCaoPhieuNhapSearchTextChanged"
              Padding="12,9"
              Margin="0" />

            <Button Grid.Column="1"
              Classes="toolbar-primary"
              Content="🔍  Tìm kiếm"
              Command="{Binding TimKiemBaoCaoPhieuNhapCommand}"
              Margin="0" />

            <!-- BỘ LỌC TÌNH TRẠNG THANH TOÁN -->
            <StackPanel Grid.Column="2"
              Orientation="Horizontal"
              Spacing="6"
              VerticalAlignment="Center">
              <Button Classes="filterChip"
                Classes.active="{Binding IsBaoCaoPhieuNhapLocTatCa}"
                Content="Tất cả"
                Command="{Binding LocBaoCaoPhieuNhapThanhToanCommand}"
                CommandParameter="TAT_CA" />
              <Button Classes="filterChip"
                Classes.active="{Binding IsBaoCaoPhieuNhapLocDaThanhToan}"
                Content="Đã thanh toán"
                Command="{Binding LocBaoCaoPhieuNhapThanhToanCommand}"
                CommandParameter="DA_THANH_TOAN" />
              <Button Classes="filterChip"
                Classes.active="{Binding IsBaoCaoPhieuNhapLocChuaThanhToan}"
                Content="Chưa thanh toán"
                Command="{Binding LocBaoCaoPhieuNhapThanhToanCommand}"
                CommandParameter="CHUA_THANH_TOAN" />
              <Button Classes="filterChip"
                Classes.active="{Binding IsBaoCaoPhieuNhapLocThanhToanMotPhan}"
                Content="Thanh toán 1 phần"
                Command="{Binding LocBaoCaoPhieuNhapThanhToanCommand}"
                CommandParameter="MOT_PHAN" />
            </StackPanel>
          </Grid>
        </Border>

        <!-- 3. BẢNG BÁO CÁO + PHÂN TRANG -->
        <Border Grid.Row="2"
          Background="White"
          BorderBrush="#E2ECE8"
          BorderThickness="1"
          CornerRadius="12"
          ClipToBounds="True"
          BoxShadow="0 4 16 #0A0A352E">

          <Grid RowDefinitions="Auto,*,Auto">

            <!-- HEADER BẢNG -->
            <Border Background="#EBF5F1"
              BorderBrush="#D5EAE3"
              BorderThickness="0,0,0,1"
              Padding="16,12">

              <Grid ColumnDefinitions="106,108,76,*,138,100,104,136,150"
                ColumnSpacing="10">

                <TextBlock Grid.Column="0"
                  Text="MÃ NHẬP HÀNG"
                  FontWeight="Bold"
                  Foreground="#164B40"
                  FontSize="12"
                  VerticalAlignment="Center" />

                <TextBlock Grid.Column="1"
                  Text="THỜI GIAN"
                  FontWeight="Bold"
                  Foreground="#164B40"
                  FontSize="12"
                  VerticalAlignment="Center" />

                <TextBlock Grid.Column="2"
                  Text="MÃ NCC"
                  FontWeight="Bold"
                  Foreground="#164B40"
                  FontSize="12"
                  VerticalAlignment="Center" />

                <TextBlock Grid.Column="3"
                  Text="NHÀ CUNG CẤP"
                  FontWeight="Bold"
                  Foreground="#164B40"
                  FontSize="12"
                  VerticalAlignment="Center" />

                <TextBlock Grid.Column="4"
                  Text="PHƯƠNG THỨC / QUỸ"
                  FontWeight="Bold"
                  Foreground="#164B40"
                  FontSize="12"
                  VerticalAlignment="Center" />

                <TextBlock Grid.Column="5"
                  Text="CÒN NỢ"
                  FontWeight="Bold"
                  Foreground="#164B40"
                  FontSize="12"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Center" />

                <TextBlock Grid.Column="6"
                  Text="TRẠNG THÁI"
                  FontWeight="Bold"
                  Foreground="#164B40"
                  FontSize="12"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center" />

                <TextBlock Grid.Column="7"
                  Text="THANH TOÁN"
                  FontWeight="Bold"
                  Foreground="#164B40"
                  FontSize="12"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center" />

                <TextBlock Grid.Column="8"
                  Text="THAO TÁC"
                  FontWeight="Bold"
                  Foreground="#164B40"
                  FontSize="12"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center" />
              </Grid>
            </Border>

            <!-- NỘI DUNG -->
            <Panel Grid.Row="1">

              <ListBox ItemsSource="{Binding BaoCaoPhieuNhaps}"
                Background="Transparent"
                BorderThickness="0"
                DoubleTapped="OnBaoCaoPhieuNhapRowDoubleTapped"
                IsVisible="{Binding HasBaoCaoPhieuNhapData}">

                <ListBox.Styles>
                  <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                  </Style>
                  <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                    <Setter Property="Background" Value="#F4FAF8" />
                  </Style>
                  <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                    <Setter Property="Background" Value="Transparent" />
                  </Style>
                  <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter">
                    <Setter Property="Background" Value="#F4FAF8" />
                  </Style>
                </ListBox.Styles>

                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="models:PhieuNhapHang">
                    <Border BorderBrush="#EEF3F1"
                      BorderThickness="0,0,0,1"
                      Background="Transparent"
                      Cursor="Hand"
                      PointerPressed="OnBaoCaoPhieuNhapRowPointerPressed"
                      ToolTip.Tip="Nhấn vào dòng để xem chi tiết phiếu nhập"
                      Padding="16,11">

                      <Grid ColumnDefinitions="106,108,76,*,138,100,104,136,150"
                        ColumnSpacing="10"
                        VerticalAlignment="Center">

                        <Button Grid.Column="0"
                          Background="Transparent"
                          BorderThickness="0"
                          Padding="0"
                          Margin="0"
                          Cursor="Hand"
                          HorizontalContentAlignment="Left"
                          VerticalContentAlignment="Center"
                          ToolTip.Tip="Xem chi tiết phiếu nhập"
                          Command="{Binding ElementName=RootWindow, Path=DataContext.XemChiTietPhieuNhapCommand}"
                          CommandParameter="{Binding}">
                          <TextBlock Text="{Binding MaPhieuNhap}"
                            FontWeight="SemiBold"
                            Foreground="#087F6E"
                            VerticalAlignment="Center" />
                        </Button>

                        <TextBlock Grid.Column="1"
                          Text="{Binding ThoiGianNhapText}"
                          Foreground="#667A74"
                          FontSize="12"
                          VerticalAlignment="Center" />

                        <TextBlock Grid.Column="2"
                          Text="{Binding MaNhaCungCap}"
                          Foreground="#667A74"
                          FontSize="12"
                          VerticalAlignment="Center" />

                        <TextBlock Grid.Column="3"
                          Text="{Binding TenNhaCungCap}"
                          Foreground="#263B35"
                          FontWeight="Medium"
                          TextTrimming="CharacterEllipsis"
                          VerticalAlignment="Center" />

                        <!-- PHƯƠNG THỨC / QUỸ CHI TRẢ -->
                        <StackPanel Grid.Column="4"
                          VerticalAlignment="Center"
                          Spacing="2">
                          <TextBlock Text="{Binding PhuongThucThanhToanHienThi}"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="#263B35" />
                          <TextBlock Text="{Binding NguonQuyHienThi}"
                            FontSize="11"
                            Foreground="#087F6E" />
                        </StackPanel>

                        <!-- SỐ CÒN NỢ -->
                        <TextBlock Grid.Column="5"
                          Text="{Binding ConNoText}"
                          FontSize="12"
                          FontWeight="SemiBold"
                          Foreground="#D64545"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center" />

                        <!-- BADGE TRẠNG THÁI PHIẾU -->
                        <Border Grid.Column="6"
                          CornerRadius="14"
                          Padding="12,4"
                          MinWidth="96"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Background="{Binding TrangThaiBadgeBrush}">
                          <TextBlock Text="{Binding TrangThaiHienThi}"
                            FontSize="11"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{Binding TrangThaiBadgeForeground}" />
                        </Border>

                        <!-- BADGE TRẠNG THÁI THANH TOÁN -->
                        <Border Grid.Column="7"
                          CornerRadius="14"
                          Padding="10,4"
                          MinWidth="132"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Background="{Binding TrangThaiThanhToanBadgeBrush}">
                          <TextBlock Text="{Binding TrangThaiThanhToanHienThi}"
                            FontSize="11"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{Binding TrangThaiThanhToanBadgeForeground}" />
                        </Border>

                        <!-- NÚT THANH TOÁN + IN PHIẾU NHẬP -->
                        <StackPanel Grid.Column="8"
                          Orientation="Horizontal"
                          Spacing="6"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                          <Button
                            Classes="payRowButton"
                            Width="114"
                            Height="32"
                            Padding="10,0"
                            Margin="0"
                            IsVisible="{Binding CoTheThanhToan}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            ToolTip.Tip="Thanh toán công nợ phiếu nhập"
                            Command="{Binding ElementName=RootWindow, Path=DataContext.ThanhToanPhieuNhapCommand}"
                            CommandParameter="{Binding}">
                            <StackPanel Orientation="Horizontal"
                              Spacing="6"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center">
                              <TextBlock Text="💳"
                                FontSize="14"
                                VerticalAlignment="Center" />
                              <TextBlock Text="Thanh toán"
                                FontSize="12"
                                FontWeight="SemiBold"
                                VerticalAlignment="Center" />
                            </StackPanel>
                          </Button>
                          <Button
                            Classes="toolbar-action"
                            Content="🖨"
                            FontSize="13"
                            Width="30"
                            Height="32"
                            Padding="0"
                            Margin="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            ToolTip.Tip="In phiếu nhập"
                            Command="{Binding ElementName=RootWindow, Path=DataContext.InPhieuNhapCommand}"
                            CommandParameter="{Binding}" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <!-- TRẠNG THÁI KHÔNG CÓ DỮ LIỆU -->
              <StackPanel IsVisible="{Binding IsBaoCaoPhieuNhapEmpty}"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Spacing="6">

                <TextBlock Text="🗂"
                  FontSize="34"
                  HorizontalAlignment="Center"
                  Foreground="#B7C9C3" />

                <TextBlock Text="Không có dữ liệu"
                  FontSize="16"
                  FontWeight="SemiBold"
                  Foreground="#61736E"
                  HorizontalAlignment="Center" />

                <TextBlock Text="Thử tìm theo mã phiếu nhập khác hoặc bấm ↻ Làm mới"
                  FontSize="12"
                  Foreground="#98A2B3"
                  HorizontalAlignment="Center" />
              </StackPanel>
            </Panel>

            <!-- PHÂN TRANG -->
            <Border Grid.Row="2"
              Background="#F7FAF9"
              BorderBrush="#E2ECE8"
              BorderThickness="0,1,0,0"
              Padding="16,10">

              <Grid ColumnDefinitions="Auto,*"
                ColumnSpacing="12">

                <!-- TỔNG SỐ GIAO DỊCH -->
                <StackPanel Orientation="Horizontal"
                  Spacing="8"
                  VerticalAlignment="Center">

                  <TextBlock Text="{Binding BaoCaoPhieuNhapRangeText}"
                    FontSize="12"
                    Foreground="#163F38"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center" />
                </StackPanel>

                <!-- CÁC NÚT TRANG -->
                <StackPanel Grid.Column="1"
                  Orientation="Horizontal"
                  Spacing="6"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">

                  <Button Classes="toolbar-action"
                    Content="⏮"
                    Width="34"
                    Height="30"
                    Padding="0"
                    FontSize="12"
                    ToolTip.Tip="Về trang đầu"
                    Command="{Binding BaoCaoPhieuNhapTrangDauCommand}" />

                  <Button Classes="toolbar-action"
                    Content="◀"
                    Width="34"
                    Height="30"
                    Padding="0"
                    FontSize="11"
                    ToolTip.Tip="Trang trước"
                    IsEnabled="{Binding CanBaoCaoPhieuNhapTrangTruoc}"
                    Command="{Binding BaoCaoPhieuNhapTrangTruocCommand}" />

                  <Border Background="#087F6E"
                    CornerRadius="8"
                    MinWidth="38"
                    Height="30"
                    Padding="10,0">
                    <TextBlock Text="{Binding BaoCaoPhieuNhapPage}"
                      Foreground="White"
                      FontWeight="Bold"
                      FontSize="12"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
                  </Border>

                  <TextBlock Text="trên"
                    FontSize="12"
                    Foreground="#61736E"
                    VerticalAlignment="Center" />

                  <TextBlock Text="{Binding BaoCaoPhieuNhapTotalPages}"
                    FontSize="12"
                    Foreground="#163F38"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center" />

                  <Button Classes="toolbar-action"
                    Content="▶"
                    Width="34"
                    Height="30"
                    Padding="0"
                    FontSize="11"
                    ToolTip.Tip="Trang sau"
                    IsEnabled="{Binding CanBaoCaoPhieuNhapTrangSau}"
                    Command="{Binding BaoCaoPhieuNhapTrangSauCommand}" />

                  <Button Classes="toolbar-action"
                    Content="⏭"
                    Width="34"
                    Height="30"
                    Padding="0"
                    FontSize="12"
                    ToolTip.Tip="Về trang cuối"
                    Command="{Binding BaoCaoPhieuNhapTrangCuoiCommand}" />
                </StackPanel>
              </Grid>
            </Border>
          </Grid>
        </Border>
      </Grid>


      <!-- OVERLAY LOADING IMPORT -->
      <Grid IsVisible="{Binding IsImporting}"
        ZIndex="9999"
        Background="#99000000">

        <Border Width="480"
          Padding="30"
          Background="White"
          CornerRadius="18"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          BoxShadow="0 10 35 #40000000">

          <StackPanel Spacing="16">

            <!-- ICON -->
            <Border Width="60"
              Height="60"
              CornerRadius="30"
              Background="#EAF9F5"
              HorizontalAlignment="Center">

              <TextBlock Text="⇩"
                FontSize="30"
                FontWeight="Bold"
                Foreground="#087F6E"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
            </Border>

            <!-- TIÊU ĐỀ -->
            <TextBlock Text="Đang nhập dữ liệu"
              FontSize="22"
              FontWeight="Bold"
              Foreground="#163F38"
              HorizontalAlignment="Center" />

            <!-- LOADING -->
            <ProgressBar Height="9"
              Width="360"
              IsIndeterminate="{Binding !ImportHasProgress}"
              Minimum="0"
              Maximum="100"
              Value="{Binding ImportProgress}" />

            <!-- PHẦN TRĂM -->
            <TextBlock Text="{Binding ImportProgress, StringFormat={}{0:N0}%}"
              IsVisible="{Binding ImportHasProgress}"
              FontSize="13"
              FontWeight="SemiBold"
              Foreground="#087F6E"
              HorizontalAlignment="Center" />

            <!-- TRẠNG THÁI -->
            <TextBlock Text="{Binding ImportStatus}"
              FontSize="14"
              Foreground="#52645E"
              TextWrapping="Wrap"
              HorizontalAlignment="Center"
              TextAlignment="Center" />

            <!-- CẢNH BÁO -->
            <Border Background="#F7FAF9"
              CornerRadius="10"
              Padding="12"
              Margin="0,4,0,0">

              <TextBlock Text="⏳ Vui lòng chờ trong khi hệ thống đang xử lý. Không đóng phần mềm."
                FontSize="12"
                Foreground="#667085"
                TextWrapping="Wrap"
                HorizontalAlignment="Center"
                TextAlignment="Center" />
            </Border>

          </StackPanel>
        </Border>

      </Grid>

      <!-- MODAL TẠO PHIẾU THU TIỀN MẶT (chỉ giao diện)                    -->
      <Grid IsVisible="{Binding IsSoQuyPhieuThuVisible}"
        ZIndex="900"
        Background="#66101A2B">

        <Border Width="920"
          MaxHeight="780"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Background="White"
          BorderBrush="#E2ECE8"
          BorderThickness="1"
          CornerRadius="16"
          BoxShadow="0 18 50 #40000000">

          <Grid RowDefinitions="Auto,*,Auto">

            <!-- TIÊU ĐỀ -->
            <Border Grid.Row="0"
              Background="#F7FAF9"
              BorderBrush="#E2ECE8"
              BorderThickness="0,0,0,1"
              CornerRadius="16,16,0,0"
              Padding="22,16">

              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock Text="Tạo phiếu thu tiền mặt"
                  FontSize="19"
                  FontWeight="Bold"
                  Foreground="#163F38"
                  VerticalAlignment="Center" />

                <Button Grid.Column="1"
                  Classes="sq-icon"
                  Content="✕"
                  Width="32"
                  Height="32"
                  FontSize="13"
                  ToolTip.Tip="Đóng"
                  Command="{Binding DongSoQuyPhieuCommand}" />
              </Grid>
            </Border>

            <!-- FORM 2 CỘT -->
            <ScrollViewer Grid.Row="1"
              Padding="22,18"
              HorizontalScrollBarVisibility="Disabled">

              <Grid ColumnDefinitions="*,*" ColumnSpacing="22" RowSpacing="0">

                <StackPanel Grid.Column="0" Spacing="14" Margin="0,0,0,0">

                  <!-- Mã phiếu (tự sinh) -->
                  <StackPanel Spacing="0">
                    <TextBlock Classes="sq-label" Text="Mã phiếu" />
                    <TextBox Classes="sq-input"
                      Text="{Binding SoQuyPhieuMa, Mode=OneWay}"
                      IsReadOnly="True"
                      Focusable="False"
                      BorderBrush="{Binding SoQuyVienMaPhieu}"
                      Foreground="#087F6E"
                      FontWeight="Bold"
                      Watermark="Đang tạo mã..."
                      HorizontalAlignment="Stretch" />
                    <TextBlock Classes="sq-error-text"
                      Text="{Binding SoQuyLoiMaPhieuText}"
                      IsVisible="{Binding SoQuyHienLoiMaPhieu}" />
                  </StackPanel>

                  <!-- Loại thu -->
                  <StackPanel Spacing="0">
                    <TextBlock Classes="sq-label" Text="Loại thu" />
                    <ComboBox Classes="sq-input"
                      ItemsSource="{Binding SoQuyLoaiThuOptions}"
                      SelectedItem="{Binding SoQuyPhieuThuLoai, Mode=TwoWay}"
                      BorderBrush="{Binding SoQuyVienLoai}"
                      HorizontalAlignment="Stretch">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:SoQuyLuaChonItem">
                          <TextBlock Text="{Binding HienThi}" FontSize="13" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                      <ComboBox.SelectionBoxItemTemplate>
                        <DataTemplate x:DataType="models:SoQuyLuaChonItem">
                          <TextBlock Text="{Binding HienThi}" FontSize="13" />
                        </DataTemplate>
                      </ComboBox.SelectionBoxItemTemplate>
                    </ComboBox>
                    <TextBlock Classes="sq-error-text"
                      Text="{Binding SoQuyLoiLoaiText}"
                      IsVisible="{Binding SoQuyHienLoiLoai}" />
                  </StackPanel>

                  <!-- Quỹ: danh sách lấy từ phuong_thuc có trong phiếu -->
                  <StackPanel Spacing="0"
                    IsVisible="{Binding SoQuyPhieuCoQuy}">
                    <TextBlock Classes="sq-label" Text="Quỹ" />
                    <ComboBox Classes="sq-input"
                      ItemsSource="{Binding SoQuyPhieuQuyOptions}"
                      SelectedItem="{Binding SoQuyPhieuQuy, Mode=TwoWay}"
                      HorizontalAlignment="Stretch">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:SoQuyLuaChon">
                          <TextBlock Text="{Binding HienThi}" FontSize="13" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                      <ComboBox.SelectionBoxItemTemplate>
                        <DataTemplate x:DataType="models:SoQuyLuaChon">
                          <TextBlock Text="{Binding HienThi}" FontSize="13" />
                        </DataTemplate>
                      </ComboBox.SelectionBoxItemTemplate>
                    </ComboBox>
                  </StackPanel>

                  <!-- Nội dung -->
                  <StackPanel Spacing="0">
                    <TextBlock Classes="sq-label" Text="Nội dung" />
                    <TextBox Classes="sq-input"
                      Text="{Binding SoQuyPhieuNoiDung, Mode=TwoWay}"
                      Watermark="Nội dung thu/chi..."
                      AcceptsReturn="True"
                      TextWrapping="Wrap"
                      Height="96"
                      VerticalContentAlignment="Top"
                      Padding="12,10" />
                  </StackPanel>

                  <!-- Số tiền (định dạng tiền Việt Nam, chỉ nhận số) -->
                  <StackPanel Spacing="0">
                    <TextBlock Classes="sq-label" Text="Số tiền" />
                    <Border BorderBrush="{Binding SoQuyVienSoTien}"
                      BorderThickness="1.5"
                      CornerRadius="8">
                      <controls:MoneyTextBox Value="{Binding SoQuyPhieuSoTien, Mode=TwoWay}"
                        Height="34"
                        Margin="0" />
                    </Border>
                    <TextBlock Classes="sq-error-text"
                      Text="{Binding SoQuyLoiSoTienText}"
                      IsVisible="{Binding SoQuyHienLoiSoTien}" />
                  </StackPanel>

                  <!-- Ghi chú -->
                  <StackPanel Spacing="0">
                    <TextBlock Classes="sq-label" Text="Ghi chú" />
                    <TextBox Classes="sq-input"
                      Text="{Binding SoQuyPhieuGhiChu, Mode=TwoWay}"
                      Watermark="Ghi chú phiếu thu..."
                      AcceptsReturn="True"
                      TextWrapping="Wrap"
                      Height="96"
                      VerticalContentAlignment="Top"
                      Padding="12,10" />
                  </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="14" Margin="0,0,0,0">

                  <!-- Thời gian (tự động) -->
                  <StackPanel Spacing="0">
                    <TextBlock Classes="sq-label" Text="Thời gian" />
                    <TextBox Classes="sq-input"
                      Text="{Binding SoQuyPhieuThoiGianText, Mode=OneWay}"
                      IsReadOnly="True"
                      Focusable="False"
                      BorderBrush="{Binding SoQuyVienThoiGian}"
                      Watermark="dd/MM/yyyy HH:mm"
                      HorizontalAlignment="Stretch" />
                    <TextBlock Classes="sq-error-text"
                      Text="{Binding SoQuyLoiThoiGianText}"
                      IsVisible="{Binding SoQuyHienLoiThoiGian}" />
                  </StackPanel>

                  <!-- Người thu -->
                  <StackPanel Spacing="0">
                    <TextBlock Classes="sq-label" Text="Người thu" />
                    <TextBox Classes="sq-input"
                      Text="{Binding SoQuyPhieuNguoiThucHien, Mode=TwoWay}"
                      Watermark="Nhân viên thu tiền"
                      BorderBrush="{Binding SoQuyVienNguoiThucHien}"
                      HorizontalAlignment="Stretch" />
                    <TextBlock Classes="sq-error-text"
                      Text="{Binding SoQuyLoiNguoiThucHienHienThi}"
                      IsVisible="{Binding SoQuyHienLoiNguoiThucHien}" />
                  </StackPanel>

                  <!-- Tên người nộp -->
                  <StackPanel Spacing="0">
                    <TextBlock Classes="sq-label" Text="Tên người nộp" />
                    <TextBox Classes="sq-input"
                      Text="{Binding SoQuyPhieuTenNguoi, Mode=TwoWay}"
                      Watermark="Nhập tên người nộp tiền"
                      BorderBrush="{Binding SoQuyVienTenNguoi}"
                      HorizontalAlignment="Stretch" />
                    <TextBlock Classes="sq-error-text"
                      Text="{Binding SoQuyLoiTenNguoiHienThi}"
                      IsVisible="{Binding SoQuyHienLoiTenNguoi}" />
                  </StackPanel>
                </StackPanel>
              </Grid>
            </ScrollViewer>

            <!-- CHECKBOX HẠCH TOÁN + GIẢI THÍCH -->
            <Border Grid.Row="2"
              Background="#F7FAF9"
              BorderBrush="#E2ECE8"
              BorderThickness="0,1,0,0"
              CornerRadius="0,0,16,16"
              Padding="22,16">

              <StackPanel Spacing="10">

                <StackPanel Orientation="Horizontal" Spacing="8">
                  <CheckBox IsChecked="{Binding SoQuyPhieuHachToan, Mode=OneWay}"
                    IsEnabled="False"
                    Opacity="1"
                    Content="Hạch toán vào kết quả hoạt động kinh doanh"
                    FontSize="13"
                    Foreground="#344054"
                    VerticalAlignment="Center"
                    Margin="0" />

                  <Border Width="20"
                    Height="20"
                    CornerRadius="10"
                    Background="#EAF1FF"
                    VerticalAlignment="Center">
                    <TextBlock Text="i"
                      FontSize="11"
                      FontWeight="Bold"
                      Foreground="#1877F2"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
                  </Border>
                </StackPanel>

                <TextBlock Text="Phiếu thu sẽ được ghi nhận vào tổng thu của sổ quỹ và đồng thời tính vào kết quả hoạt động kinh doanh trong kỳ này."
                  FontSize="12"
                  Foreground="#667085"
                  TextWrapping="Wrap"
                  Margin="0,0,0,0" />

                <!-- FOOTER -->
                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10" Margin="0,4,0,0">

                  <Button Grid.Column="1"
                    Classes="sq-btn-secondary"
                    Content="Bỏ qua"
                    Command="{Binding DongSoQuyPhieuCommand}" />

                  <Button Grid.Column="2"
                    Classes="sq-btn-secondary"
                    Content="Lưu &amp; In"
                    IsEnabled="{Binding !IsSoQuyPhieuDangLuu}"
                    Command="{Binding LuuVaInSoQuyPhieuThuCommand}"
                    IsVisible="{Binding CanCreateReceipt}" />

                  <Button Grid.Column="3"
                    Classes="sq-btn-primary"
                    Content="Lưu"
                    IsEnabled="{Binding !IsSoQuyPhieuDangLuu}"
                    Command="{Binding LuuSoQuyPhieuThuCommand}"
                    IsVisible="{Binding CanCreateReceipt}" />
                </Grid>
              </StackPanel>
            </Border>
          </Grid>
        </Border>
      </Grid>

      <!-- MODAL TẠO PHIẾU CHI TIỀN MẶT (cùng bố cục với phiếu thu)        -->
      <Grid IsVisible="{Binding IsSoQuyPhieuChiVisible}"
        ZIndex="900"
        Background="#66101A2B">

        <Border Width="920"
          MaxHeight="780"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Background="White"
          BorderBrush="#E2ECE8"
          BorderThickness="1"
          CornerRadius="16"
          BoxShadow="0 18 50 #40000000">

          <Grid RowDefinitions="Auto,*,Auto">

            <!-- TIÊU ĐỀ -->
            <Border Grid.Row="0"
              Background="#F7FAF9"
              BorderBrush="#E2ECE8"
              BorderThickness="0,0,0,1"
              CornerRadius="16,16,0,0"
              Padding="22,16">

              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock Text="Tạo phiếu chi tiền mặt"
                  FontSize="19"
                  FontWeight="Bold"
                  Foreground="#163F38"
                  VerticalAlignment="Center" />

                <Button Grid.Column="1"
                  Classes="sq-icon"
                  Content="✕"
                  Width="32"
                  Height="32"
                  FontSize="13"
                  ToolTip.Tip="Đóng"
                  Command="{Binding DongSoQuyPhieuCommand}" />
              </Grid>
            </Border>

            <!-- FORM 2 CỘT -->
            <ScrollViewer Grid.Row="1"
              Padding="22,18"
              HorizontalScrollBarVisibility="Disabled">

              <Grid ColumnDefinitions="*,*" ColumnSpacing="22" RowSpacing="0">

                <StackPanel Grid.Column="0" Spacing="14" Margin="0,0,0,0">

                  <!-- Mã phiếu (tự sinh) -->
                  <StackPanel Spacing="0">
                    <TextBlock Classes="sq-label" Text="Mã phiếu" />
                    <TextBox Classes="sq-input"
                      Text="{Binding SoQuyPhieuMa, Mode=OneWay}"
                      IsReadOnly="True"
                      Focusable="False"
                      BorderBrush="{Binding SoQuyVienMaPhieu}"
                      Foreground="#087F6E"
                      FontWeight="Bold"
                      Watermark="Đang tạo mã..."
                      HorizontalAlignment="Stretch" />
                    <TextBlock Classes="sq-error-text"
                      Text="{Binding SoQuyLoiMaPhieuText}"
                      IsVisible="{Binding SoQuyHienLoiMaPhieu}" />
                  </StackPanel>

                  <!-- Loại chi -->
                  <StackPanel Spacing="0">
                    <TextBlock Classes="sq-label" Text="Loại chi" />
                    <ComboBox Classes="sq-input"
                      ItemsSource="{Binding SoQuyLoaiChiOptions}"
                      SelectedItem="{Binding SoQuyPhieuChiLoai, Mode=TwoWay}"
                      BorderBrush="{Binding SoQuyVienLoai}"
                      HorizontalAlignment="Stretch">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:SoQuyLuaChonItem">
                          <TextBlock Text="{Binding HienThi}" FontSize="13" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                      <ComboBox.SelectionBoxItemTemplate>
                        <DataTemplate x:DataType="models:SoQuyLuaChonItem">
                          <TextBlock Text="{Binding HienThi}" FontSize="13" />
                        </DataTemplate>
                      </ComboBox.SelectionBoxItemTemplate>
                    </ComboBox>
                    <TextBlock Classes="sq-error-text"
                      Text="{Binding SoQuyLoiLoaiText}"
                      IsVisible="{Binding SoQuyHienLoiLoai}" />
                  </StackPanel>

                  <!-- Quỹ: danh sách lấy từ phuong_thuc có trong phiếu -->
                  <StackPanel Spacing="0"
                    IsVisible="{Binding SoQuyPhieuCoQuy}">
                    <TextBlock Classes="sq-label" Text="Quỹ" />
                    <ComboBox Classes="sq-input"
                      ItemsSource="{Binding SoQuyPhieuQuyOptions}"
                      SelectedItem="{Binding SoQuyPhieuQuy, Mode=TwoWay}"
                      HorizontalAlignment="Stretch">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:SoQuyLuaChon">
                          <TextBlock Text="{Binding HienThi}" FontSize="13" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                      <ComboBox.SelectionBoxItemTemplate>
                        <DataTemplate x:DataType="models:SoQuyLuaChon">
                          <TextBlock Text="{Binding HienThi}" FontSize="13" />
                        </DataTemplate>
                      </ComboBox.SelectionBoxItemTemplate>
                    </ComboBox>
                  </StackPanel>

                  <!-- Nội dung -->
                  <StackPanel Spacing="0">
                    <TextBlock Classes="sq-label" Text="Nội dung" />
                    <TextBox Classes="sq-input"
                      Text="{Binding SoQuyPhieuNoiDung, Mode=TwoWay}"
                      Watermark="Nội dung thu/chi..."
                      AcceptsReturn="True"
                      TextWrapping="Wrap"
                      Height="96"
                      VerticalContentAlignment="Top"
                      Padding="12,10" />
                  </StackPanel>

                  <!-- Số tiền (định dạng tiền Việt Nam, chỉ nhận số) -->
                  <StackPanel Spacing="0">
                    <TextBlock Classes="sq-label" Text="Số tiền" />
                    <Border BorderBrush="{Binding SoQuyVienSoTien}"
                      BorderThickness="1.5"
                      CornerRadius="8">
                      <controls:MoneyTextBox Value="{Binding SoQuyPhieuSoTien, Mode=TwoWay}"
                        Height="34"
                        Margin="0" />
                    </Border>
                    <TextBlock Classes="sq-error-text"
                      Text="{Binding SoQuyLoiSoTienText}"
                      IsVisible="{Binding SoQuyHienLoiSoTien}" />
                  </StackPanel>

                  <!-- Ghi chú -->
                  <StackPanel Spacing="0">
                    <TextBlock Classes="sq-label" Text="Ghi chú" />
                    <TextBox Classes="sq-input"
                      Text="{Binding SoQuyPhieuGhiChu, Mode=TwoWay}"
                      Watermark="Ghi chú phiếu chi..."
                      AcceptsReturn="True"
                      TextWrapping="Wrap"
                      Height="96"
                      VerticalContentAlignment="Top"
                      Padding="12,10" />
                  </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="14" Margin="0,0,0,0">

                  <!-- Thời gian (tự động) -->
                  <StackPanel Spacing="0">
                    <TextBlock Classes="sq-label" Text="Thời gian" />
                    <TextBox Classes="sq-input"
                      Text="{Binding SoQuyPhieuThoiGianText, Mode=OneWay}"
                      IsReadOnly="True"
                      Focusable="False"
                      BorderBrush="{Binding SoQuyVienThoiGian}"
                      Watermark="dd/MM/yyyy HH:mm"
                      HorizontalAlignment="Stretch" />
                    <TextBlock Classes="sq-error-text"
                      Text="{Binding SoQuyLoiThoiGianText}"
                      IsVisible="{Binding SoQuyHienLoiThoiGian}" />
                  </StackPanel>

                  <!-- Người chi -->
                  <StackPanel Spacing="0">
                    <TextBlock Classes="sq-label" Text="Người chi" />
                    <TextBox Classes="sq-input"
                      Text="{Binding SoQuyPhieuNguoiThucHien, Mode=TwoWay}"
                      Watermark="Nhân viên chi tiền"
                      BorderBrush="{Binding SoQuyVienNguoiThucHien}"
                      HorizontalAlignment="Stretch" />
                    <TextBlock Classes="sq-error-text"
                      Text="{Binding SoQuyLoiNguoiThucHienHienThi}"
                      IsVisible="{Binding SoQuyHienLoiNguoiThucHien}" />
                  </StackPanel>

                  <!-- Tên người nhận -->
                  <StackPanel Spacing="0">
                    <TextBlock Classes="sq-label" Text="Tên người nhận" />
                    <TextBox Classes="sq-input"
                      Text="{Binding SoQuyPhieuTenNguoi, Mode=TwoWay}"
                      Watermark="Nhập tên người nhận tiền"
                      BorderBrush="{Binding SoQuyVienTenNguoi}"
                      HorizontalAlignment="Stretch" />
                    <TextBlock Classes="sq-error-text"
                      Text="{Binding SoQuyLoiTenNguoiHienThi}"
                      IsVisible="{Binding SoQuyHienLoiTenNguoi}" />
                  </StackPanel>
                </StackPanel>
              </Grid>
            </ScrollViewer>

            <!-- CHECKBOX HẠCH TOÁN + GIẢI THÍCH -->
            <Border Grid.Row="2"
              Background="#F7FAF9"
              BorderBrush="#E2ECE8"
              BorderThickness="0,1,0,0"
              CornerRadius="0,0,16,16"
              Padding="22,16">

              <StackPanel Spacing="10">

                <StackPanel Orientation="Horizontal" Spacing="8">
                  <CheckBox IsChecked="{Binding SoQuyPhieuHachToan, Mode=OneWay}"
                    IsEnabled="False"
                    Opacity="1"
                    Content="Hạch toán vào kết quả hoạt động kinh doanh"
                    FontSize="13"
                    Foreground="#344054"
                    VerticalAlignment="Center"
                    Margin="0" />

                  <Border Width="20"
                    Height="20"
                    CornerRadius="10"
                    Background="#FEF3F2"
                    VerticalAlignment="Center">
                    <TextBlock Text="i"
                      FontSize="11"
                      FontWeight="Bold"
                      Foreground="#D92D20"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
                  </Border>
                </StackPanel>

                <TextBlock Text="Phiếu chi sẽ được ghi nhận vào tổng chi của sổ quỹ và đồng thời tính vào kết quả hoạt động kinh doanh trong kỳ này."
                  FontSize="12"
                  Foreground="#667085"
                  TextWrapping="Wrap"
                  Margin="0,0,0,0" />

                <!-- FOOTER -->
                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10" Margin="0,4,0,0">

                  <Button Grid.Column="1"
                    Classes="sq-btn-secondary"
                    Content="Bỏ qua"
                    Command="{Binding DongSoQuyPhieuCommand}" />

                  <Button Grid.Column="2"
                    Classes="sq-btn-secondary"
                    Content="Lưu &amp; In"
                    IsEnabled="{Binding !IsSoQuyPhieuDangLuu}"
                    Command="{Binding LuuVaInSoQuyPhieuChiCommand}"
                    IsVisible="{Binding CanCreatePayment}" />

                  <Button Grid.Column="3"
                    Classes="sq-btn-primary"
                    Content="Lưu"
                    IsEnabled="{Binding !IsSoQuyPhieuDangLuu}"
                    Command="{Binding LuuSoQuyPhieuChiCommand}"
                    IsVisible="{Binding CanCreatePayment}" />
                </Grid>
              </StackPanel>
            </Border>
          </Grid>
        </Border>
      </Grid>

      <!-- MODAL CHI TIẾT PHIẾU                                            -->
      <!-- Mở khi bấm nút "Xem" ở một dòng trong bảng sổ quỹ.              -->
      <!-- Sửa / Hủy đều xuất phát từ đây nên bảng chỉ cần một nút.       -->
      <Grid IsVisible="{Binding IsSoQuyChiTietVisible}"
        ZIndex="950"
        Background="#66101A2B">

        <Border Width="720"
          MaxHeight="720"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Background="White"
          BorderBrush="#E2ECE8"
          BorderThickness="1"
          CornerRadius="16"
          BoxShadow="0 18 50 #40000000">

          <Grid RowDefinitions="Auto,*">

            <!-- TIÊU ĐỀ -->
            <Border Grid.Row="0"
              Background="#F7FAF9"
              BorderBrush="#E2ECE8"
              BorderThickness="0,0,0,1"
              CornerRadius="16,16,0,0"
              Padding="22,16">

              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">

                <StackPanel Grid.Column="0"
                  Orientation="Horizontal"
                  Spacing="10"
                  VerticalAlignment="Center">

                  <Border Background="{Binding SoQuyChiTietDangXem.MauNenLoai}"
                    CornerRadius="12"
                    Padding="10,5"
                    VerticalAlignment="Center">
                    <TextBlock Text="{Binding SoQuyChiTietDangXem.LoaiPhieu}"
                      FontSize="12"
                      FontWeight="Bold"
                      Foreground="{Binding SoQuyChiTietDangXem.MauLoai}" />
                  </Border>

                  <TextBlock Text="{Binding SoQuyChiTietDangXem.MaPhieu}"
                    FontSize="19"
                    FontWeight="Bold"
                    Foreground="#163F38"
                    VerticalAlignment="Center" />
                </StackPanel>

                <Button Grid.Column="1"
                  Classes="sq-icon"
                  Content="✕"
                  Width="32"
                  Height="32"
                  FontSize="13"
                  ToolTip.Tip="Đóng"
                  Command="{Binding DongChiTietPhieuCommand}" />
              </Grid>
            </Border>

            <!-- NỘI DUNG -->
            <Grid Grid.Row="1" RowDefinitions="*,Auto">

              <ScrollViewer Padding="22,18"
                HorizontalScrollBarVisibility="Disabled">

                <StackPanel Spacing="16">

                  <!-- SỐ TIỀN + TRẠNG THÁI -->
                  <Border Background="#F7FAF9"
                    BorderBrush="#E2ECE8"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16,14">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="4">

                      <TextBlock Grid.Row="0"
                        Text="SỐ TIỀN"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="#98A2B3" />

                      <TextBlock Grid.Row="1"
                        Text="{Binding SoQuyChiTietDangXem.SoTienHienThi}"
                        FontSize="26"
                        FontWeight="Bold"
                        Foreground="{Binding SoQuyChiTietDangXem.MauLoai}"
                        VerticalAlignment="Center" />

                      <Border Grid.Row="0"
                        Grid.RowSpan="2"
                        Grid.Column="1"
                        Background="{Binding SoQuyChiTietDangXem.MauNenTrangThai}"
                        CornerRadius="12"
                        Padding="10,5"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                        <TextBlock Text="{Binding SoQuyChiTietDangXem.TrangThaiHienThi}"
                          FontSize="12"
                          FontWeight="SemiBold"
                          Foreground="{Binding SoQuyChiTietDangXem.MauTrangThai}" />
                      </Border>
                    </Grid>
                  </Border>

                  <!-- CÁC Ô THÔNG TIN -->
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="22" RowSpacing="16">

                    <StackPanel Grid.Column="0" Spacing="14">
                      <StackPanel Spacing="3">
                        <TextBlock Classes="sq-label" Text="Thời gian" />
                        <TextBlock Text="{Binding SoQuyChiTietDangXem.ThoiGianHienThi}"
                          FontSize="13"
                          Foreground="#344054" />
                      </StackPanel>

                      <StackPanel Spacing="3">
                        <TextBlock Classes="sq-label" Text="Loại thu/chi" />
                        <TextBlock Text="{Binding SoQuyChiTietDangXem.TenLoai}"
                          FontSize="13"
                          Foreground="#344054"
                          TextWrapping="Wrap" />
                      </StackPanel>

                      <StackPanel Spacing="3">
                        <TextBlock Classes="sq-label" Text="Quỹ" />
                        <TextBlock Text="{Binding SoQuyChiTietDangXem.PhuongThucHienThi}"
                          FontSize="13"
                          Foreground="#344054" />
                      </StackPanel>

                      <StackPanel Spacing="3">
                        <TextBlock Classes="sq-label" Text="Người tạo" />
                        <TextBlock Text="{Binding SoQuyChiTietDangXem.NguoiTao}"
                          FontSize="13"
                          Foreground="#344054"
                          TextWrapping="Wrap" />
                      </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="14">
                      <StackPanel Spacing="3">
                        <TextBlock Classes="sq-label"
                          Text="{Binding SoQuyChiTietDangXem.NhanNguoiNopNhan}" />
                        <TextBlock Text="{Binding SoQuyChiTietDangXem.NguoiNopNhan}"
                          FontSize="13"
                          Foreground="#344054"
                          TextWrapping="Wrap" />
                      </StackPanel>

                      <StackPanel Spacing="3">
                        <TextBlock Classes="sq-label" Text="Nội dung" />
                        <TextBlock Text="{Binding SoQuyChiTietDangXem.NoiDung}"
                          FontSize="13"
                          Foreground="#344054"
                          TextWrapping="Wrap" />
                      </StackPanel>

                      <StackPanel Spacing="3">
                        <TextBlock Classes="sq-label" Text="Ghi chú" />
                        <TextBlock Text="{Binding SoQuyChiTietDangXem.GhiChu}"
                          FontSize="13"
                          Foreground="#344054"
                          TextWrapping="Wrap" />
                      </StackPanel>
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </ScrollViewer>

              <!-- FOOTER -->
              <Border Grid.Row="1"
                Background="#F7FAF9"
                BorderBrush="#E2ECE8"
                BorderThickness="0,1,0,0"
                CornerRadius="0,0,16,16"
                Padding="22,16">

                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">

                  <Button Grid.Column="1"
                    Classes="sq-btn-secondary"
                    Content="Đóng"
                    Command="{Binding DongChiTietPhieuCommand}" />

                  <Button Grid.Column="2"
                    Classes="sq-btn-primary"
                    Content="Hủy phiếu"
                    IsVisible="{Binding !SoQuyChiTietDangXem.DaHuy} and {Binding CanCancelCashBook}"
                    Command="{Binding HuyPhieuHienTaiCommand}" />
                </Grid>
              </Border>
            </Grid>
          </Grid>
        </Border>
      </Grid>

    </Grid>
  </Grid>
</Window>

<UserControl xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:ShopHoa.ViewModels"
  xmlns:models="using:ShopHoa.Models"
  xmlns:controls="using:ShopHoa.Controls"
  x:Class="ShopHoa.Views.ThemPhieuXuatTraView"
  x:Name="RootView"
  x:DataType="vm:MainWindowViewModel">

  <UserControl.Styles>
    <Style Selector="TextBox.formInput">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#CBD5E1" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="FontSize" Value="12.5" />
    </Style>

    <Style Selector="Button.btnPrimary">
      <Setter Property="Background" Value="#DC2626" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.btnPrimary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#B91C1C" />
      <Setter Property="TextElement.Foreground" Value="White" />
    </Style>

    <Style Selector="Button.btnOutline">
      <Setter Property="Background" Value="#FEF2F2" />
      <Setter Property="Foreground" Value="#B91C1C" />
      <Setter Property="BorderBrush" Value="#FECACA" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.btnOutline:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#FEE2E2" />
      <Setter Property="BorderBrush" Value="#FCA5A5" />
      <Setter Property="TextElement.Foreground" Value="#991B1B" />
    </Style>

    <Style Selector="Button.btnSubtle">
      <Setter Property="Background" Value="#F1F5F9" />
      <Setter Property="Foreground" Value="#475569" />
      <Setter Property="BorderBrush" Value="#E2E8F0" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.btnSubtle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#E2E8F0" />
      <Setter Property="TextElement.Foreground" Value="#1E293B" />
    </Style>

    <Style Selector="Button.btnDanger">
      <Setter Property="Background" Value="#FEE2E2" />
      <Setter Property="Foreground" Value="#B91C1C" />
      <Setter Property="BorderBrush" Value="#FECACA" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.btnSuccess">
      <Setter Property="Background" Value="#059669" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.btnSuccess:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#047857" />
      <Setter Property="TextElement.Foreground" Value="White" />
    </Style>
  </UserControl.Styles>

  <!-- MÀN HÌNH: THÊM PHIẾU XUẤT HÀNG TRẢ LẠI NCC -->
  <Grid RowDefinitions="Auto,*" RowSpacing="14">

    <!-- ============================================================ -->
    <!-- HEADER BAR: Tiêu đề, Mã phiếu, Trạng thái, và Nút thao tác nhanh -->
    <!-- ============================================================ -->
    <Border Grid.Row="0"
      Background="White"
      BorderBrush="#E2E8F0"
      BorderThickness="1"
      CornerRadius="12"
      Padding="16,12"
      BoxShadow="0 1 3 #0A000000">
      <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">

        <!-- Nút Quay lại -->
        <Button Classes="btnSubtle"
          Command="{Binding DongFormThemPhieuXuatTraCommand}"
          Margin="0,0,16,0"
          Padding="10,6"
          VerticalAlignment="Center"
          ToolTip.Tip="Quay lại danh sách phiếu xuất trả NCC">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <TextBlock Text="←" FontWeight="Bold" FontSize="15" Foreground="#475569" />
            <TextBlock Text="Quay lại" FontSize="13" FontWeight="SemiBold" Foreground="#475569" />
          </StackPanel>
        </Button>

        <!-- Tiêu đề + Badges -->
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <TextBlock Text="Thêm phiếu xuất hàng trả lại"
              FontSize="20"
              FontWeight="Bold"
              Foreground="#0F172A" />

            <!-- Badge Mã phiếu -->
            <Border Background="#FEE2E2"
              BorderBrush="#FECACA"
              BorderThickness="1"
              CornerRadius="6"
              Padding="8,2"
              VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="Mã:" FontSize="11.5" Foreground="#DC2626" />
                <TextBlock Text="{Binding PhieuXuatTraMa}"
                  Foreground="#B91C1C"
                  FontWeight="Bold"
                  FontSize="12" />
              </StackPanel>
            </Border>

            <!-- Badge Trạng thái -->
            <Border Background="#FEF3C7"
              BorderBrush="#FDE68A"
              BorderThickness="1"
              CornerRadius="6"
              Padding="8,2"
              VerticalAlignment="Center">
              <TextBlock Text="Chờ lưu"
                Foreground="#B45309"
                FontWeight="SemiBold"
                FontSize="11.5" />
            </Border>
          </StackPanel>

          <!-- Breadcrumb phụ -->
          <TextBlock Text="Nghiệp vụ → Xuất hàng trả lại → Thêm phiếu xuất trả Nhà cung cấp"
            FontSize="12"
            Foreground="#64748B" />
        </StackPanel>

        <!-- Nút thao tác góc phải -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Button Classes="btnOutline"
            Command="{Binding LamMoiFormThemPhieuXuatTraCommand}"
            Padding="14,8"
            ToolTip.Tip="Làm mới toàn bộ form lập phiếu">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="↻" FontSize="14" FontWeight="Bold" />
              <TextBlock Text="Làm mới" FontSize="13" />
            </StackPanel>
          </Button>

          <Button Classes="btnPrimary"
            Command="{Binding LuuPhieuXuatTraHangCommand}"
            IsEnabled="{Binding !IsSavingPhieuXuatTra}"
            Padding="18,8"
            ToolTip.Tip="Lưu phiếu xuất trả và cập nhật kho, công nợ">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="💾" FontSize="14" />
              <!-- Save Label -->
              <TextBlock Text="Lưu phiếu xuất trả"
                FontSize="13.5"
                FontWeight="Bold" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ============================================================ -->
    <!-- NỘI DUNG CHÍNH: 2 CỘT (Trái: Form + Hàng hóa | Phải: Tổng kết) -->
    <!-- ============================================================ -->
    <Grid Grid.Row="1" ColumnDefinitions="*,340" ColumnSpacing="14">

      <!-- CỘT TRÁI: THÔNG TIN PHIẾU + CHỌN HÀNG + BẢNG MẶT HÀNG -->
      <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="14" Margin="0,0,4,14">

          <!-- CARD 1: THÔNG TIN PHIẾU XUẤT TRẢ -->
          <Border Background="White"
            BorderBrush="#E2E8F0"
            BorderThickness="1"
            CornerRadius="12"
            Padding="18"
            BoxShadow="0 1 3 #0A000000">
            <StackPanel Spacing="14">
              <TextBlock Text="THÔNG TIN PHIẾU XUẤT TRẢ"
                FontSize="13.5"
                FontWeight="Bold"
                Foreground="#475569" />

              <!-- Hàng 1: Mã phiếu, Ngày xuất, Kho xuất -->
              <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                <!-- Mã phiếu -->
                <StackPanel Grid.Column="0" Spacing="6">
                  <TextBlock Text="Mã phiếu xuất trả" FontSize="12" FontWeight="SemiBold" Foreground="#334155" />
                  <TextBox Classes="formInput"
                    Text="{Binding PhieuXuatTraMa}"
                    IsReadOnly="True"
                    Background="#F8FAFC"
                    Foreground="#64748B"
                    FontWeight="SemiBold" />
                </StackPanel>

                <!-- Ngày xuất trả -->
                <StackPanel Grid.Column="1" Spacing="6">
                  <TextBlock Text="Thời gian xuất trả" FontSize="12" FontWeight="SemiBold" Foreground="#334155" />
                  <TextBox Classes="formInput"
                    Text="{Binding PhieuXuatTraNgayXuatText}"
                    IsReadOnly="True"
                    Background="#F8FAFC"
                    Foreground="#334155" />
                </StackPanel>

                <!-- Kho xuất -->
                <StackPanel Grid.Column="2" Spacing="6">
                  <TextBlock Text="Kho xuất hàng" FontSize="12" FontWeight="SemiBold" Foreground="#334155" />
                  <TextBox Classes="formInput"
                    Text="{Binding PhieuXuatTraKhoXuat}"
                    IsReadOnly="True"
                    Background="#F8FAFC"
                    Foreground="#334155" />
                </StackPanel>
              </Grid>

              <!-- Hàng 2: Nhà cung cấp & Phiếu nhập gốc -->
              <Grid ColumnDefinitions="*,*" ColumnSpacing="12">

                <!-- Nhà cung cấp -->
                <StackPanel Grid.Column="0" Spacing="6">
                  <TextBlock Text="Nhà cung cấp nhận hàng trả *" FontSize="12" FontWeight="SemiBold" Foreground="#334155" />

                  <!-- Nếu chưa chọn NCC: Tìm kiếm + Gợi ý -->
                  <Grid RowDefinitions="Auto,Auto" IsVisible="{Binding !HasSelectedPhieuXuatTraNcc}">
                    <TextBox Classes="formInput"
                      Text="{Binding PhieuXuatTraNccSearch, Mode=TwoWay}"
                      Watermark="Gõ tên, mã hoặc SĐT nhà cung cấp..."
                      FontSize="12.5">
                      <TextBox.InnerRightContent>
                        <Button Classes="btnSubtle"
                          Command="{Binding TimKiemNhaCungCapChoXuatTraCommand}"
                          CommandParameter="{Binding PhieuXuatTraNccSearch}"
                          Margin="2"
                          Padding="6,4">
                          <TextBlock Text="🔍" FontSize="12" />
                        </Button>
                      </TextBox.InnerRightContent>
                    </TextBox>

                    <!-- Danh sách gợi ý NCC -->
                    <Border Grid.Row="1"
                      Background="White"
                      BorderBrush="#CBD5E1"
                      BorderThickness="1"
                      CornerRadius="8"
                      Margin="0,4,0,0"
                      MaxHeight="180"
                      IsVisible="{Binding HasPhieuXuatTraSupplierSuggestions}"
                      BoxShadow="0 4 8 #15000000">
                      <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding PhieuXuatTraSupplierSuggestions}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="models:NhaCungCap">
                              <Button HorizontalAlignment="Stretch"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="10,6"
                                Cursor="Hand"
                                Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).ChonNhaCungCapChoXuatTraCommand}"
                                CommandParameter="{Binding}">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                  <TextBlock Text="{Binding MaNhaCungCap}" FontWeight="Bold" Foreground="#DC2626" FontSize="12" Margin="0,0,8,0" />
                                  <TextBlock Grid.Column="1" Text="{Binding TenNhaCungCap}" Foreground="#0F172A" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                  <TextBlock Grid.Column="2" Text="{Binding SoDienThoai}" Foreground="#64748B" FontSize="11.5" />
                                </Grid>
                              </Button>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </ScrollViewer>
                    </Border>
                  </Grid>

                  <!-- Đã chọn NCC: Thẻ thông tin -->
                  <Border Background="#FEE2E2"
                    BorderBrush="#FECACA"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10,7"
                    IsVisible="{Binding HasSelectedPhieuXuatTraNcc}">
                    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                      <StackPanel Spacing="2">
                        <TextBlock Text="{Binding SelectedPhieuXuatTraNcc.TenNhaCungCap}"
                          FontWeight="Bold"
                          FontSize="13"
                          Foreground="#991B1B" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                          <TextBlock Text="{Binding SelectedPhieuXuatTraNcc.MaNhaCungCap, StringFormat='Mã: {0}'}" FontSize="11.5" Foreground="#B91C1C" />
                          <TextBlock Text="{Binding SelectedPhieuXuatTraNcc.SoDienThoai, StringFormat='SĐT: {0}'}" FontSize="11.5" Foreground="#7F1D1D" />
                        </StackPanel>
                      </StackPanel>

                      <Button Grid.Column="1"
                        Classes="btnDanger"
                        Command="{Binding XoaNhaCungCapDaChonChoXuatTraCommand}"
                        Padding="6,3"
                        ToolTip.Tip="Bỏ chọn nhà cung cấp">
                        <TextBlock Text="✕" FontSize="11" FontWeight="Bold" />
                      </Button>
                    </Grid>
                  </Border>
                </StackPanel>

                <!-- Phiếu nhập gốc liên quan (Tùy chọn) -->
                <StackPanel Grid.Column="1" Spacing="6">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Phiếu nhập hàng gốc (tùy chọn)" FontSize="12" FontWeight="SemiBold" Foreground="#334155" />
                    <Button Grid.Column="1"
                      Classes="btnSubtle"
                      Command="{Binding NapHangTuPhieuNhapGocCommand}"
                      IsVisible="{Binding HasSelectedPhieuXuatTraPhieuNhapGoc}"
                      Padding="6,2"
                      Margin="0,-2,0,0">
                      <TextBlock Text="📥 Nạp hàng từ phiếu" FontSize="11" FontWeight="SemiBold" Foreground="#0284C7" />
                    </Button>
                  </Grid>

                  <!-- Nếu chưa chọn Phiếu gốc: Tìm kiếm + Gợi ý -->
                  <Grid RowDefinitions="Auto,Auto" IsVisible="{Binding !HasSelectedPhieuXuatTraPhieuNhapGoc}">
                    <TextBox Classes="formInput"
                      Text="{Binding PhieuXuatTraPhieuNhapGocSearch, Mode=TwoWay}"
                      Watermark="Gõ mã phiếu nhập PN... để tìm và nạp hàng"
                      FontSize="12.5">
                      <TextBox.InnerRightContent>
                        <Button Classes="btnSubtle"
                          Command="{Binding TimKiemPhieuNhapGocChoXuatTraCommand}"
                          CommandParameter="{Binding PhieuXuatTraPhieuNhapGocSearch}"
                          Margin="2"
                          Padding="6,4">
                          <TextBlock Text="🔍" FontSize="12" />
                        </Button>
                      </TextBox.InnerRightContent>
                    </TextBox>

                    <!-- Danh sách gợi ý Phiếu nhập -->
                    <Border Grid.Row="1"
                      Background="White"
                      BorderBrush="#CBD5E1"
                      BorderThickness="1"
                      CornerRadius="8"
                      Margin="0,4,0,0"
                      MaxHeight="180"
                      IsVisible="{Binding HasPhieuXuatTraPhieuNhapGocSuggestions}"
                      BoxShadow="0 4 8 #15000000">
                      <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding PhieuXuatTraPhieuNhapGocSuggestions}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="models:PhieuNhapGocGoiY">
                              <Button HorizontalAlignment="Stretch"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="10,6"
                                Cursor="Hand"
                                Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).ChonPhieuNhapGocChoXuatTraCommand}"
                                CommandParameter="{Binding}">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                  <TextBlock Text="{Binding MaPhieuNhap}" FontWeight="Bold" Foreground="#0284C7" FontSize="12" Margin="0,0,8,0" />
                                  <TextBlock Grid.Column="1" Text="{Binding TenNhaCungCap}" Foreground="#0F172A" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                  <TextBlock Grid.Column="2" Text="{Binding TongTienNhapText}" Foreground="#059669" FontWeight="SemiBold" FontSize="11.5" />
                                </Grid>
                              </Button>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </ScrollViewer>
                    </Border>
                  </Grid>

                  <!-- Đã chọn Phiếu gốc: Thẻ thông tin -->
                  <Border Background="#EFF6FF"
                    BorderBrush="#BFDBFE"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10,7"
                    IsVisible="{Binding HasSelectedPhieuXuatTraPhieuNhapGoc}">
                    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                      <StackPanel Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="{Binding SelectedPhieuXuatTraPhieuNhapGoc.MaPhieuNhap}"
                            FontWeight="Bold"
                            FontSize="13"
                            Foreground="#1D4ED8" />
                          <TextBlock Text="{Binding SelectedPhieuXuatTraPhieuNhapGoc.TongTienNhapText}"
                            FontWeight="SemiBold"
                            FontSize="12"
                            Foreground="#059669" />
                        </StackPanel>
                        <TextBlock Text="{Binding SelectedPhieuXuatTraPhieuNhapGoc.ThoiGianNhapText, StringFormat='Ngày nhập: {0}'}" FontSize="11.5" Foreground="#3B82F6" />
                      </StackPanel>

                      <Button Grid.Column="1"
                        Classes="btnDanger"
                        Command="{Binding XoaPhieuNhapGocDaChonChoXuatTraCommand}"
                        Padding="6,3"
                        ToolTip.Tip="Bỏ liên kết phiếu nhập gốc">
                        <TextBlock Text="✕" FontSize="11" FontWeight="Bold" />
                      </Button>
                    </Grid>
                  </Border>
                </StackPanel>
              </Grid>

              <!-- Hàng 3: Nhân viên & Ghi chú / lý do -->
              <Grid ColumnDefinitions="*,2*" ColumnSpacing="12">
                <StackPanel Grid.Column="0" Spacing="6">
                  <TextBlock Text="Nhân viên lập phiếu" FontSize="12" FontWeight="SemiBold" Foreground="#334155" />
                  <TextBox Classes="formInput"
                    Text="{Binding PhieuXuatTraNhanVien}"
                    IsReadOnly="True"
                    Background="#F8FAFC"
                    Foreground="#334155" />
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="6">
                  <TextBlock Text="Lý do xuất trả / Ghi chú chung" FontSize="12" FontWeight="SemiBold" Foreground="#334155" />
                  <TextBox Classes="formInput"
                    Text="{Binding PhieuXuatTraGhiChu, Mode=TwoWay}"
                    Watermark="Ví dụ: Hoa bị dập nát do vận chuyển, sai quy cách yêu cầu..." />
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>

          <!-- CARD 2: CHỌN HÀNG HÓA XUẤT TRẢ -->
          <Border Background="White"
            BorderBrush="#E2E8F0"
            BorderThickness="1"
            CornerRadius="12"
            Padding="18"
            BoxShadow="0 1 3 #0A000000">
            <StackPanel Spacing="12">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="TÌM KIẾM VÀ CHỌN HÀNG HÓA XUẤT TRẢ"
                  FontSize="13.5"
                  FontWeight="Bold"
                  Foreground="#475569" />

                <TextBlock Grid.Column="1"
                  Text="💡 Bạn có thể nạp nhanh toàn bộ hàng từ Phiếu nhập gốc"
                  FontSize="11.5"
                  Foreground="#64748B" />
              </Grid>

              <!-- Ô tìm kiếm sản phẩm -->
              <Grid RowDefinitions="Auto,Auto">
                <TextBox Classes="formInput"
                  Text="{Binding PhieuXuatTraProductSearch, Mode=TwoWay}"
                  Watermark="🔍 Tìm kiếm theo mã hoặc tên hàng hóa (gõ ký tự để gợi ý)..."
                  FontSize="13">
                  <TextBox.InnerRightContent>
                    <Button Classes="btnSubtle"
                      Command="{Binding TimKiemSanPhamChoXuatTraCommand}"
                      CommandParameter="{Binding PhieuXuatTraProductSearch}"
                      Margin="2"
                      Padding="8,5">
                      <TextBlock Text="Tìm hàng" FontSize="12" FontWeight="SemiBold" />
                    </Button>
                  </TextBox.InnerRightContent>
                </TextBox>

                <!-- Danh sách gợi ý sản phẩm -->
                <Border Grid.Row="1"
                  Background="White"
                  BorderBrush="#CBD5E1"
                  BorderThickness="1"
                  CornerRadius="8"
                  Margin="0,4,0,0"
                  MaxHeight="220"
                  IsVisible="{Binding HasPhieuXuatTraSuggestions}"
                  BoxShadow="0 4 10 #15000000">
                  <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding PhieuXuatTraProductSuggestions}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="models:SanPham">
                          <Button HorizontalAlignment="Stretch"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="12,8"
                            Cursor="Hand"
                            Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).ThemSanPhamVaoPhieuXuatTraCommand}"
                            CommandParameter="{Binding}">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                              <!-- Mã sản phẩm -->
                              <Border Background="#F1F5F9" CornerRadius="4" Padding="6,2" Margin="0,0,10,0">
                                <TextBlock Text="{Binding MaSanPham}" FontWeight="Bold" Foreground="#0284C7" FontSize="12" />
                              </Border>

                              <!-- Tên sản phẩm + ĐVT -->
                              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding TenSanPham}" FontWeight="SemiBold" Foreground="#0F172A" FontSize="13" />
                                <TextBlock Text="{Binding DonViTinh, StringFormat='ĐVT: {0}'}" FontSize="11.5" Foreground="#64748B" />
                              </StackPanel>

                              <!-- Tồn kho -->
                              <StackPanel Grid.Column="2" HorizontalAlignment="Right" Margin="0,0,14,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding TonKhoExcel, StringFormat='Tồn: {0:N0}'}" FontSize="12" Foreground="#475569" />
                              </StackPanel>

                              <!-- Đơn giá vốn/bán -->
                              <TextBlock Grid.Column="3"
                                Text="{Binding GiaVonHienThi, StringFormat='Giá vốn: {0}'}"
                                FontWeight="Bold"
                                Foreground="#DC2626"
                                FontSize="12.5"
                                VerticalAlignment="Center" />
                            </Grid>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </Border>
              </Grid>
            </StackPanel>
          </Border>

          <!-- CARD 3: BẢNG CHI TIẾT MẶT HÀNG XUẤT TRẢ (9 CỘT) -->
          <Border Background="White"
            BorderBrush="#E2E8F0"
            BorderThickness="1"
            CornerRadius="12"
            Padding="0"
            BoxShadow="0 1 3 #0A000000"
            ClipToBounds="True">
            <Grid RowDefinitions="Auto,*">

              <!-- Header bảng -->
              <Border Grid.Row="0"
                Background="#F8FAFC"
                BorderBrush="#E2E8F0"
                BorderThickness="0,0,0,1"
                Padding="16,10">
                <Grid ColumnDefinitions="45,95,*,65,65,130,110,120,130,45">
                  <TextBlock Grid.Column="0" Text="STT" FontWeight="Bold" FontSize="12" Foreground="#475569" HorizontalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="Mã hàng" FontWeight="Bold" FontSize="12" Foreground="#475569" />
                  <TextBlock Grid.Column="2" Text="Tên hàng hóa" FontWeight="Bold" FontSize="12" Foreground="#475569" Margin="6,0,0,0" />
                  <TextBlock Grid.Column="3" Text="ĐVT" FontWeight="Bold" FontSize="12" Foreground="#475569" HorizontalAlignment="Center" />
                  <TextBlock Grid.Column="4" Text="Tồn kho" FontWeight="Bold" FontSize="12" Foreground="#475569" HorizontalAlignment="Right" />
                  <TextBlock Grid.Column="5" Text="Số lượng trả" FontWeight="Bold" FontSize="12" Foreground="#475569" HorizontalAlignment="Center" />
                  <TextBlock Grid.Column="6" Text="Đơn giá" FontWeight="Bold" FontSize="12" Foreground="#475569" HorizontalAlignment="Right" />
                  <TextBlock Grid.Column="7" Text="Thành tiền" FontWeight="Bold" FontSize="12" Foreground="#475569" HorizontalAlignment="Right" />
                  <TextBlock Grid.Column="8" Text="Lý do xuất trả" FontWeight="Bold" FontSize="12" Foreground="#475569" Margin="8,0,0,0" />
                  <TextBlock Grid.Column="9" Text="Xóa" FontWeight="Bold" FontSize="12" Foreground="#475569" HorizontalAlignment="Center" />
                </Grid>
              </Border>

              <!-- Nội dung dòng hàng hoặc trạng thái trống -->
              <Grid Grid.Row="1" MinHeight="180">
                <!-- Khi chưa có dòng hàng nào -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" IsVisible="{Binding IsPhieuXuatTraEmpty}" Margin="20">
                  <TextBlock Text="📦" FontSize="36" HorizontalAlignment="Center" Foreground="#94A3B8" />
                  <TextBlock Text="Chưa có mặt hàng nào trong phiếu xuất trả NCC." FontSize="14" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Center" />
                  <TextBlock Text="Hãy tìm kiếm hàng hóa ở ô trên hoặc bấm 'Nạp hàng từ phiếu' để thêm vào phiếu." FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Danh sách các dòng hàng -->
                <ItemsControl ItemsSource="{Binding PhieuXuatTraChiTietItems}" IsVisible="{Binding HasPhieuXuatTraItems}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="models:ChiTietPhieuXuatTraHang">
                      <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="16,8">
                        <Grid ColumnDefinitions="45,95,*,65,65,130,110,120,130,45" VerticalAlignment="Center">

                          <!-- 1. STT -->
                          <TextBlock Grid.Column="0" Text="{Binding SoThuTu}" FontWeight="SemiBold" FontSize="12" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center" />

                          <!-- 2. Mã hàng -->
                          <TextBlock Grid.Column="1" Text="{Binding MaSanPham}" FontWeight="Bold" FontSize="12" Foreground="#0284C7" VerticalAlignment="Center" />

                          <!-- 3. Tên hàng -->
                          <StackPanel Grid.Column="2" Margin="6,0,8,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding TenSanPham}" FontWeight="SemiBold" FontSize="13" Foreground="#0F172A" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding SoLuongToiDa, StringFormat='Giới hạn theo phiếu nhập: tối đa {0:N0}'}"
                              FontSize="11"
                              Foreground="#D97706"
                              IsVisible="{Binding HasPhieuNhapGoc}" />
                          </StackPanel>

                          <!-- 4. ĐVT -->
                          <TextBlock Grid.Column="3" Text="{Binding DonViTinh}" FontSize="12" Foreground="#475569" HorizontalAlignment="Center" VerticalAlignment="Center" />

                          <!-- 5. Tồn kho -->
                          <TextBlock Grid.Column="4" Text="{Binding TonKhoText}" FontSize="12" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />

                          <!-- 6. Số lượng xuất trả: Stepper -->
                          <Border Grid.Column="5"
                            Background="#F8FAFC"
                            BorderBrush="#CBD5E1"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="2"
                            Margin="8,0"
                            VerticalAlignment="Center">
                            <Grid ColumnDefinitions="26,*,26">
                              <Button Grid.Column="0"
                                Classes="btnSubtle"
                                Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).GiamSoLuongXuatTraCommand}"
                                CommandParameter="{Binding}"
                                Padding="0"
                                Width="26"
                                Height="26"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center">
                                <TextBlock Text="-" FontSize="14" FontWeight="Bold" Foreground="#475569" />
                              </Button>

                              <NumericUpDown Grid.Column="1"
                                Value="{Binding SoLuong, Mode=TwoWay}"
                                Minimum="0"
                                Maximum="{Binding SoLuongToiDa}"
                                FormatString="N0"
                                ShowButtonSpinner="False"
                                BorderThickness="0"
                                Background="Transparent"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                FontSize="13"
                                FontWeight="Bold" />

                              <Button Grid.Column="2"
                                Classes="btnSubtle"
                                Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).TangSoLuongXuatTraCommand}"
                                CommandParameter="{Binding}"
                                Padding="0"
                                Width="26"
                                Height="26"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center">
                                <TextBlock Text="+" FontSize="14" FontWeight="Bold" Foreground="#475569" />
                              </Button>
                            </Grid>
                          </Border>

                          <!-- 7. Đơn giá -->
                          <NumericUpDown Grid.Column="6"
                            Value="{Binding DonGia, Mode=TwoWay}"
                            Minimum="0"
                            FormatString="N0"
                            ShowButtonSpinner="False"
                            Classes="formInput"
                            HorizontalContentAlignment="Right"
                            FontSize="12.5"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center"
                            Margin="4,0" />

                          <!-- 8. Thành tiền -->
                          <TextBlock Grid.Column="7"
                            Text="{Binding ThanhTienText}"
                            FontWeight="Bold"
                            FontSize="13"
                            Foreground="#DC2626"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,4,0" />

                          <!-- 9. Lý do xuất trả -->
                          <TextBox Grid.Column="8"
                            Classes="formInput"
                            Text="{Binding LyDoXuatTra, Mode=TwoWay}"
                            Watermark="Lý do xuất trả..."
                            FontSize="11.5"
                            VerticalAlignment="Center"
                            Margin="4,0" />

                          <!-- 10. Xóa dòng -->
                          <Button Grid.Column="9"
                            Classes="btnDanger"
                            Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).XoaDongPhieuXuatTraCommand}"
                            CommandParameter="{Binding}"
                            Padding="6,4"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            ToolTip.Tip="Xóa mặt hàng này khỏi phiếu">
                            <TextBlock Text="🗑" FontSize="12" />
                          </Button>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Grid>
            </Grid>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- CỘT PHẢI: TỔNG KẾT & THANH TOÁN HOÀN TRẢ -->
      <Border Grid.Column="1"
        Background="White"
        BorderBrush="#E2E8F0"
        BorderThickness="1"
        CornerRadius="12"
        Padding="18"
        BoxShadow="0 1 3 #0A000000"
        VerticalAlignment="Top">
        <StackPanel Spacing="16">
          <TextBlock Text="TỔNG KẾT &amp; HOÀN TIỀN NCC"
            FontSize="13.5"
            FontWeight="Bold"
            Foreground="#475569" />

          <!-- Số mặt hàng -->
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Số dòng mặt hàng:" FontSize="13" Foreground="#64748B" />
            <TextBlock Grid.Column="1"
              Text="{Binding PhieuXuatTraChiTietItems.Count, StringFormat='{}{0} mặt hàng'}"
              FontWeight="SemiBold"
              FontSize="13"
              Foreground="#334155" />
          </Grid>

          <!-- Tổng số lượng xuất trả -->
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Tổng số lượng xuất trả:" FontSize="13" Foreground="#64748B" />
            <TextBlock Grid.Column="1"
              Text="{Binding PhieuXuatTraTongSoLuongText}"
              FontWeight="Bold"
              FontSize="14"
              Foreground="#0F172A" />
          </Grid>

          <Separator Background="#E2E8F0" Height="1" />

          <!-- Tổng tiền hoàn trả từ NCC -->
          <StackPanel Spacing="4">
            <TextBlock Text="Tổng tiền hoàn trả từ NCC:" FontSize="13" Foreground="#64748B" />
            <TextBlock Text="{Binding PhieuXuatTraTongTienText}"
              FontSize="24"
              FontWeight="Bold"
              Foreground="#DC2626"
              HorizontalAlignment="Right" />
          </StackPanel>

          <Separator Background="#E2E8F0" Height="1" />

          <!-- Phương thức nhận hoàn tiền -->
          <StackPanel Spacing="8">
            <TextBlock Text="Phương thức nhận hoàn trả *" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155" />

            <ComboBox ItemsSource="{Binding PhuongThucHoanTienNccOptions}"
              SelectedItem="{Binding PhieuXuatTraPhuongThucHoanTien, Mode=TwoWay}"
              HorizontalAlignment="Stretch"
              FontSize="13"
              CornerRadius="6" />

            <!-- Lời giải thích phương thức -->
            <Border Background="#F8FAFC"
              BorderBrush="#E2E8F0"
              BorderThickness="1"
              CornerRadius="6"
              Padding="10,8">
              <TextBlock Text="{Binding PhieuXuatTraPhuongThucGiaiThich}"
                FontSize="11.5"
                Foreground="#475569"
                TextWrapping="Wrap" />
            </Border>
          </StackPanel>

          <!-- Nút Lưu & Hoàn tất -->
          <Button Classes="btnPrimary"
            Command="{Binding LuuPhieuXuatTraHangCommand}"
            IsEnabled="{Binding !IsSavingPhieuXuatTra}"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Center"
            Padding="0,12"
            Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
              <TextBlock Text="💾" FontSize="16" />
              <TextBlock Text="LƯU PHIẾU XUẤT TRẢ"
                FontSize="14"
                FontWeight="Bold" />
            </StackPanel>
          </Button>

          <!-- Nút Hủy bỏ -->
          <Button Classes="btnSubtle"
            Command="{Binding DongFormThemPhieuXuatTraCommand}"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Center"
            Padding="0,8">
            <TextBlock Text="Hủy bỏ &amp; Quay lại" FontSize="12.5" Foreground="#64748B" />
          </Button>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>

<Window xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ShopHoa.Controls"
    xmlns:models="using:ShopHoa.Models"
    x:Class="ShopHoa.Views.ThanhToanPhieuNhapWindow"
    Title="Thanh toán công nợ phiếu nhập"
    Icon="/Assets/logo.ico"
    Width="500"
    Height="690"
    MinWidth="440"
    MinHeight="620"
    CanResize="False"
    WindowStartupLocation="CenterOwner"
    RequestedThemeVariant="Light"
    Background="#F4F7F6">

    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="#263B35" />
        </Style>

        <Style Selector="TextBox">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#263B35" />
            <Setter Property="BorderBrush" Value="#D8E5E0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="TextBox:pointerover">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#8CCFC0" />
        </Style>
        <Style Selector="TextBox:focus">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#087F6E" />
            <Setter Property="BorderThickness" Value="1.5" />
        </Style>
        <Style Selector="TextBox /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D8E5E0" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#8CCFC0" />
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#087F6E" />
            <Setter Property="BorderThickness" Value="1.5" />
        </Style>
        <Style Selector="TextBox /template/ ScrollViewer#PART_ContentHost">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#263B35" />
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#263B35" />
            <Setter Property="BorderBrush" Value="#D8E5E0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="ComboBox:pointerover">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#8CCFC0" />
        </Style>
        <Style Selector="ComboBox:focus">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#087F6E" />
        </Style>
        <Style Selector="ComboBox /template/ Border#Background">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D8E5E0" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <Style Selector="Button.cancelButton">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#52645E" />
            <Setter Property="BorderBrush" Value="#D8E5E0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.cancelButton:pointerover">
            <Setter Property="Background" Value="#F4FAF8" />
            <Setter Property="BorderBrush" Value="#B2DDD0" />
            <Setter Property="Foreground" Value="#163F38" />
        </Style>

        <Style Selector="Button.actionButton">
            <Setter Property="Background" Value="#087F6E" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.actionButton:pointerover">
            <Setter Property="Background" Value="#0A9884" />
        </Style>
        <Style Selector="Button.actionButton:pressed">
            <Setter Property="Background" Value="#06695A" />
        </Style>
    </Window.Styles>

    <Border Background="#FFFFFF"
        CornerRadius="16"
        BorderBrush="#D8E5E0"
        BorderThickness="1"
        BoxShadow="0 8 28 #140A352E"
        Margin="14"
        Padding="24">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,*"
            RowSpacing="14">

            <!-- TIÊU ĐỀ -->
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Border Width="42" Height="42" CornerRadius="12" Background="#E6F5F1">
                    <TextBlock Text="🧾" FontSize="20"
                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="Thanh toán công nợ phiếu nhập" FontSize="18" FontWeight="Bold"
                        Foreground="#163F38" />
                    <TextBlock Text="Ghi nhận trả tiền cho nhà cung cấp theo phiếu nhập hàng"
                        FontSize="12" Foreground="#61736E" />
                </StackPanel>
            </StackPanel>

            <!-- TÓM TẮT PHIẾU NHẬP -->
            <Border Grid.Row="1"
                Background="#F7FAF9"
                BorderBrush="#E2ECE8"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16,13">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Mã phiếu nhập" Foreground="#61736E" FontSize="13" />
                        <TextBlock x:Name="TxtMaPhieuNhap" Grid.Column="1" FontWeight="SemiBold"
                            Foreground="#163F38" FontSize="13" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Nhà cung cấp" Foreground="#61736E" FontSize="13" />
                        <TextBlock x:Name="TxtNhaCungCap" Grid.Column="1" FontWeight="SemiBold"
                            Foreground="#163F38" FontSize="13" TextAlignment="Right" />
                    </Grid>
                    <Border Height="1" Background="#E8F0ED" Margin="0,2" />
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Tổng tiền nhập" Foreground="#61736E" FontSize="13" />
                        <TextBlock x:Name="TxtTongTien" Grid.Column="1" Foreground="#263B35"
                            FontSize="13" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Đã thanh toán" Foreground="#61736E" FontSize="13" />
                        <TextBlock x:Name="TxtDaThanhToan" Grid.Column="1" Foreground="#263B35"
                            FontSize="13" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Còn nợ" Foreground="#61736E" FontSize="13" />
                        <TextBlock x:Name="TxtConNo" Grid.Column="1" FontWeight="Bold"
                            Foreground="#D64545" FontSize="14" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- SỐ TIỀN THANH TOÁN -->
            <StackPanel Grid.Row="2" Spacing="6">
                <TextBlock Text="Số tiền thanh toán" FontWeight="SemiBold" Foreground="#163F38"
                    FontSize="13" />
                <controls:MoneyTextBox x:Name="TienThanhToanBox" />
            </StackPanel>

            <!-- PHƯƠNG THỨC -->
            <StackPanel Grid.Row="3" Spacing="6">
                <TextBlock Text="Phương thức thanh toán" FontWeight="SemiBold"
                    Foreground="#163F38" FontSize="13" />
                <ComboBox x:Name="CboPhuongThuc" HorizontalAlignment="Stretch" Height="38">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:PhuongThucOption">
                            <TextBlock Text="{Binding Ten}" VerticalAlignment="Center" FontSize="13" Foreground="#263B35" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <!-- NGÀY THANH TOÁN -->
            <StackPanel Grid.Row="4" Spacing="6">
                <TextBlock Text="Ngày thanh toán" FontWeight="SemiBold" Foreground="#163F38"
                    FontSize="13" />
                <DatePicker x:Name="NgayThanhToanBox" HorizontalAlignment="Stretch" />
            </StackPanel>

            <!-- GHI CHÚ -->
            <StackPanel Grid.Row="5" Spacing="6">
                <TextBlock Text="Ghi chú" FontWeight="SemiBold" Foreground="#163F38"
                    FontSize="13" />
                <TextBox x:Name="TxtGhiChu" AcceptsReturn="True" TextWrapping="Wrap"
                    MinHeight="60" MaxHeight="84" Padding="12,8"
                    Watermark="Ghi chú lần thanh toán (không bắt buộc)..." />
            </StackPanel>

            <!-- LỖI -->
            <TextBlock Grid.Row="6" x:Name="TxtLoi" Foreground="#D92D20" FontWeight="SemiBold"
                FontSize="12" TextWrapping="Wrap" IsVisible="False" Margin="2,0,0,0" />

            <!-- NÚT -->
            <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right"
                VerticalAlignment="Bottom" Spacing="10">
                <Button Content="Hủy" Classes="cancelButton" Width="100" Height="38"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    Click="OnCancelClick" />
                <Button Content="✓ Thanh toán" Classes="actionButton" Width="140" Height="38"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    Click="OnConfirmClick" />
            </StackPanel>
        </Grid>
    </Border>
</Window>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:ShopHoa.Views"
        xmlns:models="using:ShopHoa.Models"
        x:Class="ShopHoa.Views.ThietLapGiaDoiTacWindow"
        x:DataType="views:ThietLapGiaDoiTacWindow"
        Width="840"
        Height="560"
        MinWidth="760"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Title="Thiết lập giá cho đối tác"
        Background="#F0F5FA"
        RequestedThemeVariant="Light">

    <Window.Styles>
        <Style Selector="TextBlock.fieldLabel">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1C3A5E"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>

        <Style Selector="TextBox.classicInput">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1A2D42"/>
            <Setter Property="BorderBrush" Value="#8EB2D5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style Selector="TextBox.numberInput">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1A2D42"/>
            <Setter Property="BorderBrush" Value="#8EB2D5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style Selector="ComboBox.classicCombo">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1A2D42"/>
            <Setter Property="BorderBrush" Value="#8EB2D5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="Button.actionBtn">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="Button.saveBtn">
            <Setter Property="Background" Value="#E2F0D9"/>
            <Setter Property="Foreground" Value="#1E4620"/>
            <Setter Property="BorderBrush" Value="#70AD47"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Button.saveBtn:pointerover">
            <Setter Property="Background" Value="#C5E0B4"/>
        </Style>

        <Style Selector="Button.cancelBtn">
            <Setter Property="Background" Value="#FCE4D6"/>
            <Setter Property="Foreground" Value="#C00000"/>
            <Setter Property="BorderBrush" Value="#F4B084"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Button.cancelBtn:pointerover">
            <Setter Property="Background" Value="#F8CBAD"/>
        </Style>
    </Window.Styles>

    <Border BorderBrush="#6DA2D9" BorderThickness="2" Margin="6" Background="#F0F5FA" CornerRadius="4">
        <Grid RowDefinitions="Auto,Auto,*,Auto">

            <!-- 1. TIÊU ĐỀ BANNER -->
            <Border Grid.Row="0"
                    Background="#CBE8FA"
                    BorderBrush="#90C4E8"
                    BorderThickness="0,0,0,1"
                    Padding="12,7"
                    CornerRadius="3,3,0,0">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="CHI TIẾT GIÁ CHO ĐỐI TÁC:"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="#0B4B82"/>
                        <TextBlock Name="TieuDeDoiTacTextBlock"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="#C00000"
                                   Text="{Binding TenDoiTacHienThi}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               Name="MaDoiTacTextBlock"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#0B4B82"
                               VerticalAlignment="Center"
                               Text="{Binding MaDoiTacHienThi}"/>
                </Grid>
            </Border>

            <!-- 2. THANH CÔNG CỤ THÊM GIÁ MỚI -->
            <Border Grid.Row="1"
                    Background="#EBF3FB"
                    BorderBrush="#BAD4EB"
                    BorderThickness="0,0,0,1"
                    Padding="12,8">
                <Grid ColumnDefinitions="Auto,2*,Auto,*,Auto,85,Auto,110,Auto" ColumnSpacing="6">
                    <TextBlock Classes="fieldLabel" Text="Hàng hóa:"/>
                    <ComboBox Grid.Column="1"
                              Name="ChonSanPhamComboBox"
                              Classes="classicCombo"
                              HorizontalAlignment="Stretch"
                              SelectionChanged="ChonSanPhamComboBox_OnSelectionChanged"
                              PlaceholderText="-- Chọn mặt hàng --"/>

                    <TextBlock Grid.Column="2" Classes="fieldLabel" Text="ĐVT:"/>
                    <ComboBox Grid.Column="3"
                              Name="ChonDvtComboBox"
                              Classes="classicCombo"
                              HorizontalAlignment="Stretch"
                              PlaceholderText="ĐVT"/>

                    <TextBlock Grid.Column="4" Classes="fieldLabel" Text="C.Khấu (%):"/>
                    <TextBox Grid.Column="5"
                             Name="ChietKhauMoiBox"
                             Classes="numberInput"
                             Text="0"/>

                    <TextBlock Grid.Column="6" Classes="fieldLabel" Text="Đơn giá:"/>
                    <TextBox Grid.Column="7"
                             Name="DonGiaMoiBox"
                             Classes="numberInput"
                             Text="0"/>

                    <Button Grid.Column="8"
                            Classes="actionBtn saveBtn"
                            Content="➕ Thêm"
                            Click="ThemDongGia_OnClick"/>
                </Grid>
            </Border>

            <!-- 3. BẢNG DỮ LIỆU GIÁ THIẾT LẬP -->
            <Border Grid.Row="2" Margin="10,8" BorderBrush="#BAD4EB" BorderThickness="1" Background="White" CornerRadius="3">
                <DataGrid Name="GiaDataGrid"
                          ItemsSource="{Binding DanhSachGia}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          GridLinesVisibility="All"
                          HeadersVisibility="Column"
                          CanUserSortColumns="True"
                          RowBackground="White">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã hàng"
                                            Binding="{Binding MaHangHoa}"
                                            Width="120"/>

                        <DataGridTextColumn Header="Tên hàng hóa"
                                            Binding="{Binding TenHangHoa}"
                                            Width="*"/>

                        <DataGridTextColumn Header="ĐVT"
                                            Binding="{Binding DonViTinh}"
                                            Width="90"/>

                        <DataGridTextColumn Header="Chiết khấu (%)"
                                            Binding="{Binding ChietKhau, StringFormat={}{0:N2}%}"
                                            Width="120"/>

                        <DataGridTextColumn Header="Đơn giá"
                                            Binding="{Binding DonGia, StringFormat={}{0:N0} đ}"
                                            Width="140"/>

                        <DataGridTemplateColumn Header="Thao tác" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Classes="actionBtn cancelBtn"
                                            Height="24"
                                            Padding="8,0"
                                            FontSize="11"
                                            Content="❌ Xóa"
                                            Click="XoaDongGia_OnClick"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- 4. THANH NÚT BẤM DƯỚI CÙNG -->
            <Border Grid.Row="3"
                    Background="#E6EFF7"
                    BorderBrush="#BAD4EB"
                    BorderThickness="0,1,0,0"
                    Padding="14,10"
                    CornerRadius="0,0,3,3">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                    <TextBlock Name="ThongBaoTextBlock"
                               Foreground="#087F6E"
                               FontWeight="SemiBold"
                               FontSize="13"
                               VerticalAlignment="Center"/>

                    <Button Grid.Column="1"
                            Classes="actionBtn saveBtn"
                            Content="💾  Lưu thiết lập"
                            Click="LuuThietLap_OnClick"/>

                    <Button Grid.Column="2"
                            Classes="actionBtn cancelBtn"
                            Content="🚫  Đóng"
                            Click="Dong_OnClick"/>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ShopHoa.Views.ProductEditorWindow"
        Width="820"
        Height="720"
        MinWidth="820"
        MinHeight="640"
        Title="Thêm hàng hóa mới"
        WindowStartupLocation="CenterOwner"
        Background="#F0F5FA"
        RequestedThemeVariant="Light">

    <Window.Styles>
        <Style Selector="TextBlock.fieldLabel">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1C3A5E"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style Selector="TextBox.classicInput">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1A2D42"/>
            <Setter Property="BorderBrush" Value="#8EB2D5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style Selector="TextBox.classicInput:focus">
            <Setter Property="BorderBrush" Value="#2572B4"/>
            <Setter Property="BorderThickness" Value="1.5"/>
        </Style>

        <Style Selector="TextBox.numberInput">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1A2D42"/>
            <Setter Property="BorderBrush" Value="#8EB2D5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style Selector="ComboBox.classicCombo">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1A2D42"/>
            <Setter Property="BorderBrush" Value="#8EB2D5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="Button.actionBtn">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="Button.saveBtn">
            <Setter Property="Background" Value="#E2F0D9"/>
            <Setter Property="Foreground" Value="#1E4620"/>
            <Setter Property="BorderBrush" Value="#70AD47"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Button.saveBtn:pointerover">
            <Setter Property="Background" Value="#C5E0B4"/>
        </Style>

        <Style Selector="Button.cancelBtn">
            <Setter Property="Background" Value="#FCE4D6"/>
            <Setter Property="Foreground" Value="#C00000"/>
            <Setter Property="BorderBrush" Value="#F4B084"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Button.cancelBtn:pointerover">
            <Setter Property="Background" Value="#F8CBAD"/>
        </Style>
    </Window.Styles>

    <Border BorderBrush="#6DA2D9" BorderThickness="2" Margin="6" Background="#F0F5FA" CornerRadius="4">
        <Grid RowDefinitions="Auto,*,Auto">

            <!-- 1. TIÊU ĐỀ BANNER -->
            <Border Grid.Row="0"
                    Background="#CBE8FA"
                    BorderBrush="#90C4E8"
                    BorderThickness="0,0,0,1"
                    Padding="12,7"
                    CornerRadius="3,3,0,0">
                <TextBlock Text="THÔNG TIN CHI TIẾT HÀNG HÓA"
                           FontSize="15"
                           FontWeight="Bold"
                           Foreground="#0B4B82"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <!-- 2. NỘI DUNG FORM -->
            <ScrollViewer Grid.Row="1" Padding="14,10" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="7">

                    <!-- Hàng 1: Nhóm hàng -->
                    <Grid ColumnDefinitions="100,*" ColumnSpacing="10">
                        <TextBlock Classes="fieldLabel" Text="Nhóm hàng"/>
                        <ComboBox Grid.Column="1"
                                  Name="NhomSanPhamComboBox"
                                  Classes="classicCombo"
                                  Background="#FFFDEB"
                                  HorizontalAlignment="Stretch"
                                  PlaceholderText="-- Chọn nhóm hàng --"/>
                    </Grid>

                    <!-- Hàng 2: Mã hàng + Barcode -->
                    <Grid ColumnDefinitions="100,2*,80,2*,90" ColumnSpacing="10">
                        <TextBlock Classes="fieldLabel" Text="Mã hàng"/>
                        <TextBox Grid.Column="1"
                                 Name="MaSanPhamTextBox"
                                 Classes="classicInput"
                                 Watermark="Mã tự động hoặc tự nhập"/>

                        <TextBlock Grid.Column="2" Classes="fieldLabel" Text="Barcode" HorizontalAlignment="Right"/>
                        <TextBox Grid.Column="3"
                                 Name="BarcodeTextBox"
                                 Classes="classicInput"
                                 Watermark="Mã vạch sản phẩm"/>
                        <Button Grid.Column="4"
                                Name="GenerateBarcodeButton"
                                Classes="actionBtn"
                                Height="30"
                                Padding="10,0"
                                Content="Tạo mã"
                                Click="GenerateBarcodeButton_OnClick"/>
                    </Grid>

                    <!-- Hàng 3: Tên hàng -->
                    <Grid ColumnDefinitions="100,*" ColumnSpacing="10">
                        <TextBlock Classes="fieldLabel" Text="Tên hàng *"/>
                        <TextBox Grid.Column="1"
                                 Name="TenSanPhamTextBox"
                                 Classes="classicInput"
                                 Watermark="Nhập tên hoa hoặc sản phẩm"/>
                    </Grid>

                    <!-- BẢNG 3 CẤP ĐƠN VỊ TÍNH & GIÁ -->
                    <Border Background="#EBF3FB"
                            BorderBrush="#BAD4EB"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8,6"
                            Margin="0,4,0,4">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="6" MinWidth="760">

                                <!-- Cấp 1: Đơn vị gốc -->
                                <Grid ColumnDefinitions="90,150,70,80,70,110,70,110,70,110" ColumnSpacing="6">
                                    <TextBlock Classes="fieldLabel" Text="Đơn vị gốc"/>
                                    <ComboBox Grid.Column="1"
                                              Name="DonViTinhComboBox"
                                              Classes="classicCombo"
                                              MinWidth="150"
                                              HorizontalAlignment="Stretch"
                                              PlaceholderText="Chọn ĐVT"/>

                                    <TextBlock Grid.Column="2" Classes="fieldLabel" Text="Quy đổi" HorizontalAlignment="Right"/>
                                    <TextBox Grid.Column="3"
                                             Name="QuyDoiGocTextBox"
                                             Classes="numberInput"
                                             MinWidth="80"
                                             Text="1"
                                             IsReadOnly="True"
                                             Background="#E6EDF5"/>

                                    <TextBlock Grid.Column="4" Classes="fieldLabel" Text="Giá nhập" HorizontalAlignment="Right"/>
                                    <TextBox Grid.Column="5"
                                             Name="GiaVonTextBox"
                                             Classes="numberInput"
                                             MinWidth="110"
                                             Text="0"/>

                                    <TextBlock Grid.Column="6" Classes="fieldLabel" Text="Giá lẻ" HorizontalAlignment="Right"/>
                                    <TextBox Grid.Column="7"
                                             Name="GiaBanTextBox"
                                             Classes="numberInput"
                                             MinWidth="110"
                                             Text="0"/>

                                    <TextBlock Grid.Column="8" Classes="fieldLabel" Text="Giá sỉ" HorizontalAlignment="Right"/>
                                    <TextBox Grid.Column="9"
                                             Name="GiaSiTextBox"
                                             Classes="numberInput"
                                             MinWidth="110"
                                             Text="0"/>
                                </Grid>

                                <!-- Cấp 2: Đơn vị cấp 2 -->
                                <Grid Grid.Row="1" ColumnDefinitions="90,150,70,80,70,110,70,110,70,110" ColumnSpacing="6">
                                    <TextBlock Classes="fieldLabel" Text="Đơn vị cấp 2"/>
                                    <ComboBox Grid.Column="1"
                                              Name="DonViTinhCap2ComboBox"
                                              Classes="classicCombo"
                                              MinWidth="150"
                                              HorizontalAlignment="Stretch"
                                              PlaceholderText="Chọn ĐVT"/>

                                    <TextBlock Grid.Column="2" Classes="fieldLabel" Text="Quy đổi" HorizontalAlignment="Right"/>
                                    <TextBox Grid.Column="3"
                                             Name="QuyDoiCap2TextBox"
                                             Classes="numberInput"
                                             MinWidth="80"
                                             Text="0"/>

                                    <TextBlock Grid.Column="4" Classes="fieldLabel" Text="Giá nhập" HorizontalAlignment="Right"/>
                                    <TextBox Grid.Column="5"
                                             Name="GiaNhapCap2TextBox"
                                             Classes="numberInput"
                                             MinWidth="110"
                                             Text="0"/>

                                    <TextBlock Grid.Column="6" Classes="fieldLabel" Text="Giá lẻ" HorizontalAlignment="Right"/>
                                    <TextBox Grid.Column="7"
                                             Name="GiaLeCap2TextBox"
                                             Classes="numberInput"
                                             MinWidth="110"
                                             Text="0"/>

                                    <TextBlock Grid.Column="8" Classes="fieldLabel" Text="Giá sỉ" HorizontalAlignment="Right"/>
                                    <TextBox Grid.Column="9"
                                             Name="GiaSiCap2TextBox"
                                             Classes="numberInput"
                                             MinWidth="110"
                                             Text="0"/>
                                </Grid>

                                <!-- Cấp 3: Đơn vị cấp 3 -->
                                <Grid Grid.Row="2" ColumnDefinitions="90,150,70,80,70,110,70,110,70,110" ColumnSpacing="6">
                                    <TextBlock Classes="fieldLabel" Text="Đơn vị cấp 3"/>
                                    <ComboBox Grid.Column="1"
                                              Name="DonViTinhCap3ComboBox"
                                              Classes="classicCombo"
                                              MinWidth="150"
                                              HorizontalAlignment="Stretch"
                                              PlaceholderText="Chọn ĐVT"/>

                                    <TextBlock Grid.Column="2" Classes="fieldLabel" Text="Quy đổi" HorizontalAlignment="Right"/>
                                    <TextBox Grid.Column="3"
                                             Name="QuyDoiCap3TextBox"
                                             Classes="numberInput"
                                             MinWidth="80"
                                             Text="0"/>

                                    <TextBlock Grid.Column="4" Classes="fieldLabel" Text="Giá nhập" HorizontalAlignment="Right"/>
                                    <TextBox Grid.Column="5"
                                             Name="GiaNhapCap3TextBox"
                                             Classes="numberInput"
                                             MinWidth="110"
                                             Text="0"/>

                                    <TextBlock Grid.Column="6" Classes="fieldLabel" Text="Giá lẻ" HorizontalAlignment="Right"/>
                                    <TextBox Grid.Column="7"
                                             Name="GiaLeCap3TextBox"
                                             Classes="numberInput"
                                             MinWidth="110"
                                             Text="0"/>

                                    <TextBlock Grid.Column="8" Classes="fieldLabel" Text="Giá sỉ" HorizontalAlignment="Right"/>
                                    <TextBox Grid.Column="9"
                                             Name="GiaSiCap3TextBox"
                                             Classes="numberInput"
                                             MinWidth="110"
                                             Text="0"/>
                                </Grid>

                            </Grid>
                        </ScrollViewer>
                    </Border>

                    <!-- Hàng: Quy cách | Trọng lượng (Kg) -->
                    <Grid ColumnDefinitions="100,*,120,120" ColumnSpacing="10">
                        <TextBlock Classes="fieldLabel" Text="Quy cách"/>
                        <TextBox Grid.Column="1"
                                 Name="QuyCachTextBox"
                                 Classes="classicInput"
                                 Watermark="Ví dụ: Bó 10 bông, Cành dài 60cm..."/>

                        <TextBlock Grid.Column="2" Classes="fieldLabel" Text="Trọng lượng (Kg)" HorizontalAlignment="Right"/>
                        <TextBox Grid.Column="3"
                                 Name="TrongLuongTextBox"
                                 Classes="numberInput"
                                 Text="0"/>
                    </Grid>

                    <!-- Hàng: Dự trữ min | Dự trữ max -->
                    <Grid ColumnDefinitions="100,*,120,120" ColumnSpacing="10">
                        <TextBlock Classes="fieldLabel" Text="Dự trữ min"/>
                        <TextBox Grid.Column="1"
                                 Name="DuTruMinTextBox"
                                 Classes="numberInput"
                                 Text="0"/>

                        <TextBlock Grid.Column="2" Classes="fieldLabel" Text="Dự trữ max" HorizontalAlignment="Right"/>
                        <TextBox Grid.Column="3"
                                 Name="DuTruMaxTextBox"
                                 Classes="numberInput"
                                 Text="0"/>
                    </Grid>

                    <!-- Hàng: Ghi chú -->
                    <Grid ColumnDefinitions="100,*" ColumnSpacing="10">
                        <TextBlock Classes="fieldLabel" Text="Ghi chú" VerticalAlignment="Top" Margin="0,5,0,0"/>
                        <TextBox Grid.Column="1"
                                 Name="GhiChuTextBox"
                                 Classes="classicInput"
                                 Height="75"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalContentAlignment="Top"/>
                    </Grid>

                    <!-- Hàng Checkboxes + Dòng chú thích đỏ -->
                    <Grid ColumnDefinitions="Auto,Auto,*" Margin="110,4,0,0">
                        <CheckBox Name="InAnCheckBox"
                                  Content="In ấn"
                                  IsChecked="True"
                                  Margin="0,0,16,0"
                                  VerticalAlignment="Center"/>

                        <CheckBox Grid.Column="1"
                                  Name="ConSuDungCheckBox"
                                  Content="Còn sử dụng"
                                  IsChecked="True"
                                  Margin="0,0,16,0"
                                  VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="2"
                                   Text="(Ghi chú: Đơn vị gốc là đơn vị nhỏ nhất dùng để quy đổi)"
                                   Foreground="#C00000"
                                   FontStyle="Italic"
                                   FontSize="12"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Dòng hiển thị lỗi -->
                    <TextBlock Name="ErrorTextBlock"
                               Foreground="#C00000"
                               FontWeight="SemiBold"
                               FontSize="12"
                               Margin="110,4,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>

            <!-- 3. THANH NÚT BẤM -->
            <Border Grid.Row="2"
                    Background="#E6EFF7"
                    BorderBrush="#BAD4EB"
                    BorderThickness="0,1,0,0"
                    Padding="14,10"
                    CornerRadius="0,0,3,3">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16">
                    <Button Name="SaveButton"
                            Classes="actionBtn saveBtn"
                            Content="💾  Lưu"
                            Click="SaveButton_OnClick"/>

                    <Button Name="CancelButton"
                            Classes="actionBtn cancelBtn"
                            Content="🚫  Hủy bỏ"
                            Click="CancelButton_OnClick"/>
                </StackPanel>
            </Border>

        </Grid>
    </Border>
</Window>
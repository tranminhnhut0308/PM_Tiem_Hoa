<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ShopHoa.Views.SettingsPasswordWindow"

        Title="Xác thực cài đặt"

        Width="420"
        Height="290"

        MinWidth="420"
        MinHeight="290"

        CanResize="False"
        WindowStartupLocation="CenterOwner"

        Background="#F4F7FB">


    <Window.Styles>

        <!-- ===================================================== -->
        <!-- TEXTBOX MẬT KHẨU -->
        <!-- ===================================================== -->

        <Style Selector="TextBox.passwordInput">

            <Setter Property="Background"
                    Value="#FFFFFF"/>

            <Setter Property="Foreground"
                    Value="#263B35"/>

            <Setter Property="CaretBrush"
                    Value="#263B35"/>

            <Setter Property="BorderBrush"
                    Value="#D0D5DD"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="Padding"
                    Value="12"/>

            <Setter Property="MinHeight"
                    Value="46"/>

            <Setter Property="CornerRadius"
                    Value="8"/>

        </Style>


        <!-- FOCUS -->

        <Style Selector="TextBox.passwordInput:focus">

            <Setter Property="Background"
                    Value="#FFFFFF"/>

            <Setter Property="Foreground"
                    Value="#263B35"/>

            <Setter Property="CaretBrush"
                    Value="#263B35"/>

            <Setter Property="BorderBrush"
                    Value="#0878E8"/>

            <Setter Property="BorderThickness"
                    Value="2"/>

        </Style>


        <!-- HOVER -->

        <Style Selector="TextBox.passwordInput:pointerover">

            <Setter Property="Background"
                    Value="#FFFFFF"/>

            <Setter Property="Foreground"
                    Value="#263B35"/>

            <Setter Property="CaretBrush"
                    Value="#263B35"/>

        </Style>


        <!-- HOVER + FOCUS -->

        <Style Selector="TextBox.passwordInput:pointerover:focus">

            <Setter Property="Background"
                    Value="#FFFFFF"/>

            <Setter Property="Foreground"
                    Value="#263B35"/>

            <Setter Property="CaretBrush"
                    Value="#263B35"/>

            <Setter Property="BorderBrush"
                    Value="#0878E8"/>

            <Setter Property="BorderThickness"
                    Value="2"/>

        </Style>


        <!-- ===================================================== -->
        <!-- TEXTBOX TEMPLATE - KHÓA NỀN BÊN TRONG -->
        <!-- ===================================================== -->

        <Style Selector="TextBox.passwordInput /template/ Border#PART_BorderElement">

            <Setter Property="Background"
                    Value="#FFFFFF"/>

            <Setter Property="BorderBrush"
                    Value="#D0D5DD"/>

        </Style>


        <Style Selector="TextBox.passwordInput:focus /template/ Border#PART_BorderElement">

            <Setter Property="Background"
                    Value="#FFFFFF"/>

            <Setter Property="BorderBrush"
                    Value="#0878E8"/>

        </Style>


        <Style Selector="TextBox.passwordInput:pointerover /template/ Border#PART_BorderElement">

            <Setter Property="Background"
                    Value="#FFFFFF"/>

            <Setter Property="BorderBrush"
                    Value="#D0D5DD"/>

        </Style>


        <Style Selector="TextBox.passwordInput:pointerover:focus /template/ Border#PART_BorderElement">

            <Setter Property="Background"
                    Value="#FFFFFF"/>

            <Setter Property="BorderBrush"
                    Value="#0878E8"/>

        </Style>


        <!-- ===================================================== -->
        <!-- TEXT PRESENTATION BÊN TRONG TEXTBOX -->
        <!-- ===================================================== -->

        <Style Selector="TextBox.passwordInput /template/ ScrollViewer#PART_TextPresenter">

            <Setter Property="Background"
                    Value="#FFFFFF"/>

            <Setter Property="Foreground"
                    Value="#263B35"/>

        </Style>


        <Style Selector="TextBox.passwordInput:focus /template/ ScrollViewer#PART_TextPresenter">

            <Setter Property="Background"
                    Value="#FFFFFF"/>

            <Setter Property="Foreground"
                    Value="#263B35"/>

        </Style>


        <Style Selector="TextBox.passwordInput:pointerover /template/ ScrollViewer#PART_TextPresenter">

            <Setter Property="Background"
                    Value="#FFFFFF"/>

            <Setter Property="Foreground"
                    Value="#263B35"/>

        </Style>


        <!-- ===================================================== -->
        <!-- NÚT XÁC NHẬN -->
        <!-- ===================================================== -->

        <Style Selector="Button.primary">

            <Setter Property="Background"
                    Value="#0878E8"/>

            <Setter Property="Foreground"
                    Value="#FFFFFF"/>

            <Setter Property="BorderBrush"
                    Value="#0878E8"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="FontWeight"
                    Value="Bold"/>

            <Setter Property="MinHeight"
                    Value="44"/>

            <Setter Property="Padding"
                    Value="18,8"/>

            <Setter Property="CornerRadius"
                    Value="8"/>

        </Style>


        <!-- XÁC NHẬN - HOVER -->

        <Style Selector="Button.primary:pointerover">

            <Setter Property="Background"
                    Value="#0878E8"/>

            <Setter Property="Foreground"
                    Value="#FFFFFF"/>

            <Setter Property="BorderBrush"
                    Value="#0878E8"/>

        </Style>


        <!-- XÁC NHẬN - PRESSED -->

        <Style Selector="Button.primary:pressed">

            <Setter Property="Background"
                    Value="#0667C7"/>

            <Setter Property="Foreground"
                    Value="#FFFFFF"/>

            <Setter Property="BorderBrush"
                    Value="#0667C7"/>

        </Style>


        <!-- TEMPLATE NÚT XÁC NHẬN -->

        <Style Selector="Button.primary /template/ ContentPresenter#PART_ContentPresenter">

            <Setter Property="Background"
                    Value="#0878E8"/>

            <Setter Property="Foreground"
                    Value="#FFFFFF"/>

        </Style>


        <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">

            <Setter Property="Background"
                    Value="#0878E8"/>

            <Setter Property="Foreground"
                    Value="#FFFFFF"/>

        </Style>


        <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">

            <Setter Property="Background"
                    Value="#0667C7"/>

            <Setter Property="Foreground"
                    Value="#FFFFFF"/>

        </Style>


        <!-- ===================================================== -->
        <!-- NÚT HỦY -->
        <!-- ===================================================== -->

        <Style Selector="Button.secondary">

            <Setter Property="Background"
                    Value="#FFFFFF"/>

            <Setter Property="Foreground"
                    Value="#344054"/>

            <Setter Property="BorderBrush"
                    Value="#D0D5DD"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="MinHeight"
                    Value="44"/>

            <Setter Property="Padding"
                    Value="18,8"/>

            <Setter Property="CornerRadius"
                    Value="8"/>

        </Style>


        <!-- HỦY - HOVER -->

        <Style Selector="Button.secondary:pointerover">

            <Setter Property="Background"
                    Value="#FFFFFF"/>

            <Setter Property="Foreground"
                    Value="#344054"/>

            <Setter Property="BorderBrush"
                    Value="#D0D5DD"/>

        </Style>


        <!-- HỦY - PRESSED -->

        <Style Selector="Button.secondary:pressed">

            <Setter Property="Background"
                    Value="#F8FAFC"/>

            <Setter Property="Foreground"
                    Value="#344054"/>

            <Setter Property="BorderBrush"
                    Value="#D0D5DD"/>

        </Style>


        <!-- TEMPLATE NÚT HỦY -->

        <Style Selector="Button.secondary /template/ ContentPresenter#PART_ContentPresenter">

            <Setter Property="Background"
                    Value="#FFFFFF"/>

            <Setter Property="Foreground"
                    Value="#344054"/>

        </Style>


        <Style Selector="Button.secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">

            <Setter Property="Background"
                    Value="#FFFFFF"/>

            <Setter Property="Foreground"
                    Value="#344054"/>

        </Style>


        <Style Selector="Button.secondary:pressed /template/ ContentPresenter#PART_ContentPresenter">

            <Setter Property="Background"
                    Value="#F8FAFC"/>

            <Setter Property="Foreground"
                    Value="#344054"/>

        </Style>

    </Window.Styles>


    <!-- ===================================================== -->
    <!-- KHUNG -->
    <!-- ===================================================== -->

    <Border Margin="15"
            Background="#FFFFFF"
            CornerRadius="15"
            BoxShadow="0 8 30 0 #22000000">

        <Grid Margin="25"
              RowDefinitions="Auto,Auto,Auto,*">


            <!-- ================================================= -->
            <!-- HEADER -->
            <!-- ================================================= -->

            <StackPanel Grid.Row="0">

                <StackPanel Orientation="Horizontal">

                    <Border Width="44"
                            Height="44"
                            CornerRadius="11"
                            Background="#EAF4FF">

                        <TextBlock Text="🔐"
                                   FontSize="21"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                    </Border>


                    <StackPanel Margin="12,0,0,0"
                                VerticalAlignment="Center">

                        <TextBlock Text="Xác thực cài đặt"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#172033"/>

                        <TextBlock Text="Nhập mật khẩu để mở cấu hình"
                                   FontSize="12"
                                   Foreground="#667085"
                                   Margin="0,3,0,0"/>

                    </StackPanel>

                </StackPanel>

            </StackPanel>


            <!-- ================================================= -->
            <!-- MẬT KHẨU CÀI ĐẶT -->
            <!-- ================================================= -->

            <StackPanel Grid.Row="1"
                        Margin="0,22,0,0">

                <TextBlock Text="Mật khẩu"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#172033"
                           Margin="0,0,0,7"/>

                <TextBox x:Name="PasswordTextBox"
                         Classes="passwordInput"
                         PasswordChar="●"
                         Watermark="Nhập mật khẩu"
                         KeyDown="OnCredentialKeyDown"/>

            </StackPanel>


            <!-- ================================================= -->
            <!-- THÔNG BÁO -->
            <!-- ================================================= -->

            <TextBlock Grid.Row="2"
                       x:Name="ErrorText"
                       Text=""
                       Foreground="#D92D20"
                       FontSize="12"
                       Margin="0,9,0,0"
                       TextWrapping="Wrap"/>


            <!-- ================================================= -->
            <!-- BUTTON -->
            <!-- ================================================= -->

            <Grid Grid.Row="3"
                  Margin="0,20,0,0">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>


                <!-- HỦY -->

                <Button Grid.Column="0"
                        Classes="secondary"
                        Content="HỦY"
                        Click="OnCancelClick"
                        HorizontalAlignment="Left"/>


                <!-- XÁC NHẬN -->

                <Button Grid.Column="1"
                        x:Name="ConfirmButton"
                        Classes="primary"
                        Content="XÁC NHẬN"
                        Click="OnConfirmClick"/>

            </Grid>

        </Grid>

    </Border>

</Window>
<UserControl xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:models="using:ShopHoa.Models"
  xmlns:vm="using:ShopHoa.ViewModels"
  x:Class="ShopHoa.Views.BaoCaoTinhHinhNhapXuatView"
  x:Name="RootView"
  x:DataType="vm:BaoCaoTinhHinhNhapXuatViewModel">

  <UserControl.Styles>
    <Style Selector="Border.bcCard">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="BorderBrush" Value="#E4EDEA" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BoxShadow" Value="0 1 4 0 #0D000000" />
    </Style>

    <Style Selector="Border.bcMetric">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="BorderBrush" Value="#E4EDEA" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BoxShadow" Value="0 1 3 0 #0A000000" />
      <Setter Property="Padding" Value="14,12" />
    </Style>

    <Style Selector="Button.bcBtn">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#D5E3DF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#344B45" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.bcBtn:pointerover">
      <Setter Property="Background" Value="#EFF6F4" />
      <Setter Property="BorderBrush" Value="#B9D6CF" />
      <Setter Property="Foreground" Value="#0B5F52" />
    </Style>

    <Style Selector="Button.bcMode">
      <Setter Property="Background" Value="#F2F6F5" />
      <Setter Property="BorderBrush" Value="#D5E3DF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14,6" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#344B45" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.bcMode:pointerover">
      <Setter Property="Background" Value="#E4EFEA" />
      <Setter Property="Foreground" Value="#087F6E" />
    </Style>

    <Style Selector="Button.bcMode.active">
      <Setter Property="Background" Value="#087F6E" />
      <Setter Property="BorderBrush" Value="#087F6E" />
      <Setter Property="Foreground" Value="White" />
    </Style>

    <Style Selector="Button.bcPrimary">
      <Setter Property="Background" Value="#087F6E" />
      <Setter Property="BorderBrush" Value="#087F6E" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14,7" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.bcPrimary:pointerover">
      <Setter Property="Background" Value="#066E61" />
    </Style>

    <Style Selector="Button.bcAction">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#D5E3DF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#344B45" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.bcAction:pointerover">
      <Setter Property="Background" Value="#F2F7F5" />
      <Setter Property="BorderBrush" Value="#B9D6CF" />
    </Style>
  </UserControl.Styles>

  <Grid Margin="18,12,18,18" RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="12">

    <!-- 1. TIÊU ĐỀ + CHẾ ĐỘ XEM + NÚT THAO TÁC -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
      <StackPanel Spacing="3" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="Báo cáo tổng hợp tình hình nhập/xuất"
            FontSize="22"
            FontWeight="Bold"
            Foreground="#163F38" />
          <Border Background="#E6F4F1" CornerRadius="12" Padding="8,2" VerticalAlignment="Center">
            <TextBlock Text="{Binding Items.Count, StringFormat={}{0} bản ghi}"
              FontSize="11"
              FontWeight="SemiBold"
              Foreground="#087F6E" />
          </Border>
        </StackPanel>
        <TextBlock Text="Theo dõi và đối chiếu luồng hàng nhập, xuất vốn, doanh thu, chênh lệch lưu kho và tỷ lệ tiêu thụ"
          FontSize="12"
          Foreground="#61736E" />
      </StackPanel>

      <!-- CHẾ ĐỘ XEM (VIEW MODE TABS) -->
      <Border Grid.Column="1" Background="#EBF2EF" CornerRadius="9" Padding="3" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <Button Classes="bcMode" Classes.active="{Binding IsTheoHangHoa}" Content="Theo Hàng hóa"
            Command="{Binding ChonCheDoXemCommand}" CommandParameter="THEO_HANG_HOA" />
          <Button Classes="bcMode" Classes.active="{Binding IsTheoNhomHang}" Content="Theo Nhóm hàng"
            Command="{Binding ChonCheDoXemCommand}" CommandParameter="THEO_NHOM_HANG" />
          <Button Classes="bcMode" Classes.active="{Binding IsTheoNgay}" Content="Theo Ngày"
            Command="{Binding ChonCheDoXemCommand}" CommandParameter="THEO_NGAY" />
        </StackPanel>
      </Border>

      <Button Grid.Column="2"
        Classes="bcAction"
        Content="📤 Xuất Excel"
        Command="{Binding XuatExcelCommand}"
        VerticalAlignment="Center" />

      <Button Grid.Column="3"
        Classes="bcPrimary"
        Content="↻ Làm mới"
        Command="{Binding TaiLaiCommand}"
        VerticalAlignment="Center" />
    </Grid>

    <!-- 2. THẺ CHỈ TIÊU (KPI CARDS) -->
    <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*,*" ColumnSpacing="10">

      <!-- Card 1: Tổng giá trị nhập -->
      <Border Grid.Column="0" Classes="bcMetric">
        <StackPanel Spacing="4">
          <TextBlock Text="TỔNG GIÁ TRỊ NHẬP" FontSize="11" FontWeight="SemiBold" Foreground="#61736E" />
          <TextBlock Text="{Binding TongGiaTriNhapHienThi}"
            FontSize="20"
            FontWeight="Bold"
            Foreground="#163F38" />
          <TextBlock Text="{Binding TongSoLuongNhapHienThi, StringFormat={}Tổng SL nhập: {0}}"
            FontSize="11"
            Foreground="#087F6E"
            FontWeight="SemiBold" />
        </StackPanel>
      </Border>

      <!-- Card 2: Giá trị xuất vốn (COGS) -->
      <Border Grid.Column="1" Classes="bcMetric">
        <StackPanel Spacing="4">
          <TextBlock Text="GIÁ TRỊ XUẤT VỐN (COGS)" FontSize="11" FontWeight="SemiBold" Foreground="#61736E" />
          <TextBlock Text="{Binding TongGiaTriXuatVonHienThi}"
            FontSize="20"
            FontWeight="Bold"
            Foreground="#163F38" />
          <TextBlock Text="{Binding TongSoLuongXuatHienThi, StringFormat={}Tổng SL xuất: {0}}"
            FontSize="11"
            Foreground="#61736E"
            FontWeight="SemiBold" />
        </StackPanel>
      </Border>

      <!-- Card 3: Doanh thu bán xuất -->
      <Border Grid.Column="2" Classes="bcMetric">
        <StackPanel Spacing="4">
          <TextBlock Text="DOANH THU BÁN XUẤT" FontSize="11" FontWeight="SemiBold" Foreground="#61736E" />
          <TextBlock Text="{Binding TongDoanhThuXuatHienThi}"
            FontSize="20"
            FontWeight="Bold"
            Foreground="#087F6E" />
          <TextBlock Text="{Binding TongLoiNhuanGopHienThi, StringFormat={}Lợi nhuận gộp: {0}}"
            FontSize="11"
            Foreground="#137333"
            FontWeight="SemiBold" />
        </StackPanel>
      </Border>

      <!-- Card 4: Chênh lệch giá trị (Vốn lưu kho ròng) -->
      <Border Grid.Column="3" Classes="bcMetric" Background="#F8FAF9">
        <StackPanel Spacing="4">
          <TextBlock Text="CHÊNH LỆCH VỐN (NHẬP - XUẤT)" FontSize="11" FontWeight="SemiBold" Foreground="#61736E" />
          <TextBlock Text="{Binding ChenhLechGiaTriTongHienThi}"
            FontSize="20"
            FontWeight="Bold"
            Foreground="#163F38" />
          <TextBlock Text="Vốn lưu kho ròng tăng/giảm" FontSize="11" Foreground="#879691" />
        </StackPanel>
      </Border>

      <!-- Card 5: Tỷ lệ tiêu thụ trung bình -->
      <Border Grid.Column="4" Classes="bcMetric" Background="#F0FDF4" BorderBrush="#BBF7D0">
        <StackPanel Spacing="4">
          <TextBlock Text="TỶ LỆ TIÊU THỤ TRUNG BÌNH" FontSize="11" FontWeight="SemiBold" Foreground="#15803D" />
          <TextBlock Text="{Binding TyLeTieuThuTbHienThi}"
            FontSize="20"
            FontWeight="Bold"
            Foreground="#15803D" />
          <TextBlock Text="% SL Xuất / SL Nhập" FontSize="11" Foreground="#16A34A" />
        </StackPanel>
      </Border>
    </Grid>

    <!-- 3. THANH BỘ LỌC -->
    <Border Grid.Row="2" Classes="bcCard" Padding="14,10">
      <StackPanel Spacing="10">
        <WrapPanel VerticalAlignment="Center">
          <!-- Nhóm nút thời gian nhanh -->
          <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,16,0" VerticalAlignment="Center">
            <TextBlock Text="Thời gian:"
              FontSize="12"
              FontWeight="SemiBold"
              Foreground="#344B45"
              VerticalAlignment="Center"
              Margin="0,0,6,0" />

            <Button Classes="bcBtn" Content="Hôm nay"
              Command="{Binding ChonKhoangThoiGianCommand}" CommandParameter="Hôm nay" />
            <Button Classes="bcBtn" Content="7 ngày qua"
              Command="{Binding ChonKhoangThoiGianCommand}" CommandParameter="7 ngày qua" />
            <Button Classes="bcBtn" Content="Tuần này"
              Command="{Binding ChonKhoangThoiGianCommand}" CommandParameter="Tuần này" />
            <Button Classes="bcBtn" Content="Tháng này"
              Command="{Binding ChonKhoangThoiGianCommand}" CommandParameter="Tháng này" />
            <Button Classes="bcBtn" Content="Tháng trước"
              Command="{Binding ChonKhoangThoiGianCommand}" CommandParameter="Tháng trước" />
            <Button Classes="bcBtn" Content="Tùy chọn"
              Command="{Binding ChonKhoangThoiGianCommand}" CommandParameter="Tùy chọn" />
          </StackPanel>

          <!-- Lọc theo nhóm hàng (chỉ hiện khi xem Theo Hàng hóa) -->
          <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,16,0" VerticalAlignment="Center"
            IsVisible="{Binding IsTheoHangHoa}">
            <TextBlock Text="Nhóm hàng:" FontSize="12" FontWeight="SemiBold" Foreground="#344B45" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding NhomOptions}"
              SelectedItem="{Binding SelectedNhom, Mode=TwoWay}"
              Height="32" FontSize="12" MinWidth="170">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="models:BaoCaoNhapXuatNhomOption">
                  <TextBlock Text="{Binding TenHienThi}" FontSize="12" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>

          <!-- Ô tìm kiếm -->
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
            IsVisible="{Binding !IsTheoNgay}">
            <TextBox Width="230"
              Height="32"
              FontSize="12"
              VerticalContentAlignment="Center"
              Watermark="🔍 Tìm mã, tên mặt hàng..."
              Text="{Binding TimKiem, Mode=TwoWay}" />
          </StackPanel>
        </WrapPanel>

        <!-- Hàng ngày tùy chọn -->
        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding TuyChinh}">
          <TextBlock Text="Từ ngày:" FontSize="12" Foreground="#61736E" VerticalAlignment="Center" />
          <DatePicker SelectedDate="{Binding TuNgayChon, Mode=TwoWay}" Height="32" FontSize="12" />
          <TextBlock Text="Đến ngày:" FontSize="12" Foreground="#61736E" VerticalAlignment="Center" />
          <DatePicker SelectedDate="{Binding DenNgayChon, Mode=TwoWay}" Height="32" FontSize="12" />
          <Button Classes="bcPrimary" Content="Áp dụng" Command="{Binding ApDungTuyChinhCommand}" Height="32" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- THÔNG BÁO LỖI NẾU CÓ -->
    <Border Grid.Row="3"
      Background="#FDF2F2"
      BorderBrush="#F98080"
      BorderThickness="1"
      CornerRadius="8"
      Padding="12,8"
      IsVisible="{Binding CoLoi}">
      <TextBlock Text="{Binding ThongBaoLoi}" Foreground="#9B1C1C" FontSize="12" />
    </Border>

    <!-- 4. BẢNG DỮ LIỆU BÁO CÁO -->
    <Border Grid.Row="4" Classes="bcCard" Padding="0" ClipToBounds="True">
      <Grid>
        <!-- BẢNG DATA GRID -->
        <DataGrid ItemsSource="{Binding Items}"
          AutoGenerateColumns="False"
          IsReadOnly="True"
          CanUserReorderColumns="False"
          CanUserResizeColumns="True"
          CanUserSortColumns="True"
          GridLinesVisibility="Horizontal"
          HorizontalScrollBarVisibility="Auto"
          VerticalScrollBarVisibility="Auto"
          HeadersVisibility="Column"
          RowHeight="38"
          BorderThickness="0">

          <DataGrid.Columns>
            <!-- STT -->
            <DataGridTextColumn Header="STT"
              Binding="{Binding Stt}"
              Width="55" />

            <!-- Mã đối tượng -->
            <DataGridTemplateColumn Header="MÃ" Width="110">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="models:BaoCaoTinhHinhNhapXuatItem">
                  <TextBlock Text="{Binding MaDoiTuong}"
                    FontWeight="SemiBold"
                    Foreground="#087F6E"
                    VerticalAlignment="Center"
                    Padding="10,0" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <!-- Tên đối tượng -->
            <DataGridTemplateColumn Header="TÊN ĐỐI TƯỢNG" Width="*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="models:BaoCaoTinhHinhNhapXuatItem">
                  <TextBlock Text="{Binding TenDoiTuong}"
                    FontWeight="SemiBold"
                    Foreground="#163F38"
                    VerticalAlignment="Center"
                    Padding="10,0" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <!-- ĐVT / Phân loại -->
            <DataGridTextColumn Header="ĐVT / PHÂN LOẠI"
              Binding="{Binding DonViTinh}"
              Width="120" />

            <!-- SL Nhập -->
            <DataGridTemplateColumn Header="SL NHẬP" Width="95">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="models:BaoCaoTinhHinhNhapXuatItem">
                  <TextBlock Text="{Binding SoLuongNhapHienThi}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Padding="10,0" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <!-- Giá trị nhập -->
            <DataGridTemplateColumn Header="GIÁ TRỊ NHẬP" Width="135">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="models:BaoCaoTinhHinhNhapXuatItem">
                  <TextBlock Text="{Binding GiaTriNhapHienThi}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Foreground="#163F38"
                    Padding="10,0" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <!-- SL Xuất -->
            <DataGridTemplateColumn Header="SL XUẤT" Width="95">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="models:BaoCaoTinhHinhNhapXuatItem">
                  <TextBlock Text="{Binding SoLuongXuatHienThi}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Padding="10,0" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <!-- Giá trị xuất vốn -->
            <DataGridTemplateColumn Header="GIÁ TRỊ XUẤT VỐN" Width="140">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="models:BaoCaoTinhHinhNhapXuatItem">
                  <TextBlock Text="{Binding GiaTriXuatVonHienThi}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Foreground="#61736E"
                    Padding="10,0" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <!-- Doanh thu xuất -->
            <DataGridTemplateColumn Header="DOANH THU XUẤT" Width="140">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="models:BaoCaoTinhHinhNhapXuatItem">
                  <TextBlock Text="{Binding DoanhThuXuatHienThi}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Foreground="#087F6E"
                    Padding="10,0" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <!-- Chênh lệch SL -->
            <DataGridTemplateColumn Header="CHÊNH LỆCH SL" Width="115">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="models:BaoCaoTinhHinhNhapXuatItem">
                  <TextBlock Text="{Binding ChenhLechSoLuongHienThi}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Foreground="{Binding ChenhLechColor}"
                    Padding="10,0" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <!-- Chênh lệch Tiền -->
            <DataGridTemplateColumn Header="CHÊNH LỆCH TIỀN" Width="140">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="models:BaoCaoTinhHinhNhapXuatItem">
                  <TextBlock Text="{Binding ChenhLechGiaTriHienThi}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    FontWeight="Bold"
                    Foreground="{Binding ChenhLechColor}"
                    Padding="10,0" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <!-- Tỷ lệ tiêu thụ -->
            <DataGridTemplateColumn Header="TIÊU THỤ (%)" Width="115">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="models:BaoCaoTinhHinhNhapXuatItem">
                  <Border Background="{Binding TyLeBadgeBg}"
                    CornerRadius="12"
                    Padding="8,3"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <TextBlock Text="{Binding TyLeTieuThuHienThi}"
                      FontSize="11"
                      FontWeight="Bold"
                      Foreground="{Binding TyLeBadgeFg}" />
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <!-- Tồn hiện tại -->
            <DataGridTemplateColumn Header="TỒN KHO" Width="100">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="models:BaoCaoTinhHinhNhapXuatItem">
                  <TextBlock Text="{Binding TonHienTaiHienThi}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Padding="10,0" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>

        <!-- TRẠNG THÁI KHÔNG CÓ DỮ LIỆU -->
        <StackPanel IsVisible="{Binding KhongCoDuLieu}"
          VerticalAlignment="Center"
          HorizontalAlignment="Center"
          Spacing="8">
          <TextBlock Text="🔄" FontSize="36" HorizontalAlignment="Center" />
          <TextBlock Text="Không có giao dịch nhập xuất nào trong khoảng thời gian này"
            FontSize="15"
            FontWeight="SemiBold"
            Foreground="#61736E"
            HorizontalAlignment="Center" />
          <TextBlock Text="Thử mở rộng khoảng ngày lọc hoặc chọn nhóm hàng khác"
            FontSize="12"
            Foreground="#879691"
            HorizontalAlignment="Center" />
        </StackPanel>

        <!-- LOADING OVERLAY -->
        <Border Background="#66FFFFFF"
          IsVisible="{Binding DangTai}"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch">
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
            <ProgressBar IsIndeterminate="True" Width="200" Height="4" />
            <TextBlock Text="Đang tổng hợp tình hình nhập/xuất..." FontSize="12" Foreground="#087F6E" HorizontalAlignment="Center" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>
  </Grid>
</UserControl>

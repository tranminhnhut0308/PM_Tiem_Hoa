<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:ShopHoa.Views"
        xmlns:models="using:ShopHoa.Models"
        x:Class="ShopHoa.Views.KhachHangEditorWindow"
        x:DataType="views:KhachHangEditorWindow"
        Width="740"
        Height="630"
        MinWidth="700"
        MinHeight="580"
        WindowStartupLocation="CenterOwner"
        Title="Thông tin chi tiết khách hàng"
        Background="#F0F5FA"
        RequestedThemeVariant="Light">

    <Window.Styles>
        <Style Selector="TextBlock.fieldLabel">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1C3A5E"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style Selector="TextBox.classicInput">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1A2D42"/>
            <Setter Property="BorderBrush" Value="#8EB2D5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style Selector="TextBox.classicInput:focus">
            <Setter Property="BorderBrush" Value="#2572B4"/>
            <Setter Property="BorderThickness" Value="1.5"/>
        </Style>

        <Style Selector="TextBox.classicInput[IsReadOnly=True]">
            <Setter Property="Background" Value="#E6EDF5"/>
            <Setter Property="Foreground" Value="#556E8A"/>
        </Style>

        <Style Selector="TextBox.numberInput">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1A2D42"/>
            <Setter Property="BorderBrush" Value="#8EB2D5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style Selector="ComboBox.classicCombo">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1A2D42"/>
            <Setter Property="BorderBrush" Value="#8EB2D5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="Button.actionBtn">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="Button.saveBtn">
            <Setter Property="Background" Value="#E2F0D9"/>
            <Setter Property="Foreground" Value="#1E4620"/>
            <Setter Property="BorderBrush" Value="#70AD47"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Button.saveBtn:pointerover">
            <Setter Property="Background" Value="#C5E0B4"/>
        </Style>

        <Style Selector="Button.priceBtn">
            <Setter Property="Background" Value="#E8F4FD"/>
            <Setter Property="Foreground" Value="#0E5E9E"/>
            <Setter Property="BorderBrush" Value="#84BBE6"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Button.priceBtn:pointerover">
            <Setter Property="Background" Value="#D0E8FB"/>
        </Style>

        <Style Selector="Button.cancelBtn">
            <Setter Property="Background" Value="#FCE4D6"/>
            <Setter Property="Foreground" Value="#C00000"/>
            <Setter Property="BorderBrush" Value="#F4B084"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Button.cancelBtn:pointerover">
            <Setter Property="Background" Value="#F8CBAD"/>
        </Style>
    </Window.Styles>

    <Border BorderBrush="#6DA2D9" BorderThickness="2" Margin="6" Background="#F0F5FA" CornerRadius="4">
        <Grid RowDefinitions="Auto,*,Auto">

            <!-- 1. TIÊU ĐỀ BANNER -->
            <Border Grid.Row="0"
                    Background="#CBE8FA"
                    BorderBrush="#90C4E8"
                    BorderThickness="0,0,0,1"
                    Padding="12,7"
                    CornerRadius="3,3,0,0">
                <TextBlock Text="THÔNG TIN CHI TIẾT KHÁCH HÀNG"
                           FontSize="15"
                           FontWeight="Bold"
                           Foreground="#0B4B82"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <!-- 2. NỘI DUNG FORM -->
            <ScrollViewer Grid.Row="1" Padding="16,12" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="8">

                    <!-- Hàng 1: Nhóm KH + Mã KH -->
                    <Grid ColumnDefinitions="110,2*,80,2*" ColumnSpacing="10">
                        <TextBlock Classes="fieldLabel" Text="Nhóm KH"/>
                        <ComboBox Grid.Column="1"
                                  Name="NhomKhachHangBox"
                                  Classes="classicCombo"
                                  Background="#FFFDEB"
                                  HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding DanhSachNhom}"
                                  SelectedItem="{Binding NhomKhachHangDaChon, Mode=TwoWay}"
                                  PlaceholderText="-- Chọn nhóm KH --">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TenNhom}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Grid.Column="2" Classes="fieldLabel" Text="Mã KH" HorizontalAlignment="Right"/>
                        <TextBox Grid.Column="3"
                                 Classes="classicInput"
                                 Text="{Binding Customer.MaKhachHang, Mode=TwoWay}"
                                 Watermark="Mã tự động hoặc tự nhập"/>
                    </Grid>

                    <!-- Hàng 2: Tên KH -->
                    <Grid ColumnDefinitions="110,*" ColumnSpacing="10">
                        <TextBlock Classes="fieldLabel" Text="Tên KH *"/>
                        <TextBox Grid.Column="1"
                                 Name="TenKhachHangBox"
                                 Classes="classicInput"
                                 Text="{Binding Customer.TenKhachHang, Mode=TwoWay}"
                                 Watermark="Nhập họ tên khách hàng hoặc tên đơn vị"/>
                    </Grid>

                    <!-- Hàng 3: Địa chỉ -->
                    <Grid ColumnDefinitions="110,*" ColumnSpacing="10">
                        <TextBlock Classes="fieldLabel" Text="Địa chỉ"/>
                        <TextBox Grid.Column="1"
                                 Classes="classicInput"
                                 Text="{Binding Customer.DiaChi, Mode=TwoWay}"
                                 Watermark="Số nhà, đường, phường/xã, quận/huyện, tỉnh/thành..."/>
                    </Grid>

                    <!-- Hàng 4: ĐT liên hệ + Email -->
                    <Grid ColumnDefinitions="110,*,80,*" ColumnSpacing="10">
                        <TextBlock Classes="fieldLabel" Text="ĐT liên hệ"/>
                        <TextBox Grid.Column="1"
                                 Name="SoDienThoaiBox"
                                 Classes="classicInput"
                                 Text="{Binding Customer.SoDienThoai, Mode=TwoWay}"
                                 Watermark="Số điện thoại liên hệ"/>

                        <TextBlock Grid.Column="2" Classes="fieldLabel" Text="Email" HorizontalAlignment="Right"/>
                        <TextBox Grid.Column="3"
                                 Name="EmailBox"
                                 Classes="classicInput"
                                 Text="{Binding Customer.Email, Mode=TwoWay}"
                                 Watermark="Email khách hàng"/>
                    </Grid>

                    <!-- Hàng 5: Số tài khoản + Ngân hàng -->
                    <Grid ColumnDefinitions="110,*,80,*" ColumnSpacing="10">
                        <TextBlock Classes="fieldLabel" Text="Số tài khoản"/>
                        <TextBox Grid.Column="1"
                                 Classes="classicInput"
                                 Text="{Binding Customer.SoTaiKhoan, Mode=TwoWay}"
                                 Watermark="Số tài khoản ngân hàng"/>

                        <TextBlock Grid.Column="2" Classes="fieldLabel" Text="Ngân hàng" HorizontalAlignment="Right"/>
                        <TextBox Grid.Column="3"
                                 Classes="classicInput"
                                 Text="{Binding Customer.NganHang, Mode=TwoWay}"
                                 Watermark="Tên ngân hàng mở tài khoản"/>
                    </Grid>

                    <!-- Hàng 6: Mã số thuế + C.Nợ gối đầu -->
                    <Grid ColumnDefinitions="110,*,90,*" ColumnSpacing="10">
                        <TextBlock Classes="fieldLabel" Text="Mã số thuế"/>
                        <TextBox Grid.Column="1"
                                 Classes="classicInput"
                                 Text="{Binding Customer.MaSoThue, Mode=TwoWay}"
                                 Watermark="Mã số thuế doanh nghiệp / cá nhân"/>

                        <TextBlock Grid.Column="2" Classes="fieldLabel" Text="C.Nợ gối đầu" HorizontalAlignment="Right"/>
                        <TextBox Grid.Column="3"
                                 Name="CongNoGoiDauBox"
                                 Classes="numberInput"
                                 Text="{Binding Customer.CongNoGoiDau, Mode=TwoWay, StringFormat={}{0:N0}}"/>
                    </Grid>

                    <!-- Hàng 7: Nhãn hiệu + Chiết khấu -->
                    <Grid ColumnDefinitions="110,*,90,*" ColumnSpacing="10">
                        <TextBlock Classes="fieldLabel" Text="Nhãn hiệu"/>
                        <TextBox Grid.Column="1"
                                 Classes="classicInput"
                                 Text="{Binding Customer.NhanHieu, Mode=TwoWay}"
                                 Watermark="Nhãn hiệu / Thương hiệu"/>

                        <TextBlock Grid.Column="2" Classes="fieldLabel" Text="Chiết khấu (%)" HorizontalAlignment="Right"/>
                        <TextBox Grid.Column="3"
                                 Name="ChietKhauBox"
                                 Classes="numberInput"
                                 Text="{Binding Customer.ChietKhau, Mode=TwoWay, StringFormat={}{0:N2}}"/>
                    </Grid>

                    <!-- Hàng 8: Ghi chú -->
                    <Grid ColumnDefinitions="110,*" ColumnSpacing="10">
                        <TextBlock Classes="fieldLabel" Text="Ghi chú" VerticalAlignment="Top" Margin="0,5,0,0"/>
                        <TextBox Grid.Column="1"
                                 Classes="classicInput"
                                 Text="{Binding Customer.GhiChu, Mode=TwoWay}"
                                 Height="70"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalContentAlignment="Top"
                                 Watermark="Ghi chú thêm về khách hàng..."/>
                    </Grid>

                    <!-- Hàng 9: Checkbox Còn hợp tác -->
                    <Grid Margin="120,4,0,0">
                        <CheckBox Name="ConHopTacCheckBox"
                                  Content="Còn hợp tác"
                                  IsChecked="{Binding Customer.ConHopTac, Mode=TwoWay}"
                                  VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Dòng hiển thị lỗi -->
                    <TextBlock Name="LoiMessageTextBlock"
                               Foreground="#C00000"
                               FontWeight="SemiBold"
                               FontSize="12.5"
                               Margin="120,4,0,0"
                               TextWrapping="Wrap"/>

                </StackPanel>
            </ScrollViewer>

            <!-- 3. THANH NÚT BẤM -->
            <Border Grid.Row="2"
                    Background="#E6EFF7"
                    BorderBrush="#BAD4EB"
                    BorderThickness="0,1,0,0"
                    Padding="14,10"
                    CornerRadius="0,0,3,3">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16">
                    <Button Name="NutLuuButton"
                            Classes="actionBtn saveBtn"
                            Content="💾  Lưu"
                            Click="OnSaveClicked"/>

                    <Button Name="NutThietLapGiaButton"
                            Classes="actionBtn priceBtn"
                            Content="💲  Thiết lập giá"
                            Click="OnThietLapGiaClicked"/>

                    <Button Name="NutHuyButton"
                            Classes="actionBtn cancelBtn"
                            Content="🚫  Hủy bỏ"
                            Click="OnCancelClicked"/>
                </StackPanel>
            </Border>

        </Grid>
    </Border>
</Window>
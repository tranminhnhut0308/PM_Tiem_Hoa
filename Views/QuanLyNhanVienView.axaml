<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ShopHoa.ViewModels"
             xmlns:models="using:ShopHoa.Models"
             x:Class="ShopHoa.Views.QuanLyNhanVienView"
             x:DataType="vm:QuanLyNhanVienViewModel"
             Background="#F4F7F6">

    <UserControl.Styles>
        <Style Selector="TextBox.searchInput">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#1E293B" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="TextBox.searchInput:focus">
            <Setter Property="BorderBrush" Value="#0B4B82" />
            <Setter Property="BorderThickness" Value="1.5" />
        </Style>
        <Style Selector="ComboBox.filterCombo">
            <Setter Property="Height" Value="38" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#1E293B" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.btnPrimary">
            <Setter Property="Height" Value="38" />
            <Setter Property="Background" Value="#0B4B82" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.btnPrimary:pointerover">
            <Setter Property="Background" Value="#083863" />
        </Style>
        <Style Selector="Button.btnPrimary:disabled">
            <Setter Property="Opacity" Value="0.45" />
        </Style>
        <Style Selector="Button.btnAction">
            <Setter Property="Height" Value="38" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.btnAction:pointerover">
            <Setter Property="Background" Value="#F1F5F9" />
        </Style>
        <Style Selector="Button.rowBtn">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.pageBtn">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="32" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.pageBtn:pointerover">
            <Setter Property="Background" Value="#EFF6FF" />
            <Setter Property="BorderBrush" Value="#93C5FD" />
            <Setter Property="Foreground" Value="#1D4ED8" />
        </Style>
        <Style Selector="Button.pageBtn:disabled">
            <Setter Property="Opacity" Value="0.4" />
            <Setter Property="Cursor" Value="Arrow" />
        </Style>
        <Style Selector="DataGrid">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#F1F5F9" />
            <Setter Property="RowHeight" Value="48" />
        </Style>
        <Style Selector="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="12,12" />
            <Setter Property="SeparatorBrush" Value="#E2E8F0" />
        </Style>
        <Style Selector="DataGridRow:pointerover">
            <Setter Property="Background" Value="#F8FAFC" />
        </Style>
        <Style Selector="DataGridRow:selected">
            <Setter Property="Background" Value="#EFF6FF" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="16,12,16,12" RowSpacing="10">

        <!-- 1. HEADER -->
        <Border Grid.Row="0" Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="18,14">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="4" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="38" Height="38" CornerRadius="10" Background="#EFF6FF" VerticalAlignment="Center">
                            <TextBlock Text="👥" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Quản lý nhân viên" FontSize="20" FontWeight="Bold" Foreground="#0F172A" />
                                <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="12" Padding="8,2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TotalRecords, StringFormat='{}{0} hồ sơ'}" FontSize="11.5" FontWeight="Bold" Foreground="#1D4ED8" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Hồ sơ nhân sự: chức vụ, bộ phận, ngày vào làm. Tài khoản đăng nhập quản lý riêng tại màn “Quản lý tài khoản”."
                                       FontSize="12.5" Foreground="#64748B" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button Classes="btnAction" Command="{Binding LoadDataCommand}" ToolTip.Tip="Tải lại danh sách">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="🔄" FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Text="Làm mới" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Classes="btnAction"
                            Command="{Binding XuatExcelCommand}"
                            IsVisible="{Binding CanExport}"
                            ToolTip.Tip="Xuất danh sách nhân viên ra Excel">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="📊" FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Text="Xuất Excel" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Classes="btnPrimary"
                            Command="{Binding ThemNhanVienCommand}"
                            IsVisible="{Binding CanCreate}"
                            ToolTip.Tip="Thêm hồ sơ nhân viên mới">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="➕" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Text="Thêm nhân viên" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. BỘ LỌC -->
        <Border Grid.Row="1" Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14,12">
            <Grid ColumnDefinitions="320,170,170,190,Auto,*" ColumnSpacing="10">
                <TextBox Grid.Column="0" Classes="searchInput"
                         Text="{Binding SearchKeyword, Mode=TwoWay}"
                         Watermark="🔍 Tìm theo mã, họ tên, chức vụ, số điện thoại..." />

                <ComboBox Grid.Column="1" Classes="filterCombo"
                          HorizontalAlignment="Stretch"
                          ItemsSource="{Binding TrangThaiOptions}"
                          SelectedItem="{Binding SelectedTrangThai, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:TrangThaiNhanVienOption">
                            <TextBlock Text="{Binding HienThi}" FontSize="13" VerticalAlignment="Center" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <ComboBox Grid.Column="2" Classes="filterCombo"
                          HorizontalAlignment="Stretch"
                          ItemsSource="{Binding TaiKhoanOptions}"
                          SelectedItem="{Binding SelectedTaiKhoan, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:TaiKhoanNhanVienOption">
                            <TextBlock Text="{Binding HienThi}" FontSize="13" VerticalAlignment="Center" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <ComboBox Grid.Column="3" Classes="filterCombo"
                          HorizontalAlignment="Stretch"
                          ItemsSource="{Binding BoPhanOptions}"
                          SelectedItem="{Binding SelectedBoPhan, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:ProductOption">
                            <TextBlock Text="{Binding Name}" FontSize="13" VerticalAlignment="Center" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <Button Grid.Column="4" Classes="btnAction" Command="{Binding XoaBoLocCommand}" ToolTip.Tip="Đặt lại bộ lọc mặc định">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="✕" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" />
                        <TextBlock Text="Xóa lọc" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- 3. BẢNG DỮ LIỆU -->
        <Border Grid.Row="2" Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" ClipToBounds="True">
            <Grid>
                <DataGrid ItemsSource="{Binding NhanVienList}"
                          SelectedItem="{Binding SelectedNhanVien}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserResizeColumns="True"
                          BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="STT" Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:NhanVienItem">
                                    <TextBlock Text="{Binding Stt}" Foreground="#64748B" FontSize="12.5"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Mã NV" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:NhanVienItem">
                                    <TextBlock Text="{Binding MaNhanVien}" FontWeight="Bold" Foreground="#0B4B82"
                                               VerticalAlignment="Center" Margin="12,0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Họ và tên" Width="2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:NhanVienItem">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="12,0">
                                        <TextBlock Text="{Binding HoTen}" FontWeight="SemiBold" Foreground="#0F172A"
                                                   FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <Border Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="4" Padding="6,1"
                                                VerticalAlignment="Center" IsVisible="{Binding IsAdmin}">
                                            <TextBlock Text="Admin" Foreground="#B45309" FontSize="10.5" FontWeight="Bold" />
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Chức vụ" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:NhanVienItem">
                                    <Border Background="#F1F5F9" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left"
                                            VerticalAlignment="Center" Margin="12,0">
                                        <TextBlock Text="{Binding ChucVu}" Foreground="#334155" FontSize="12"
                                                   FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Bộ phận" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:NhanVienItem">
                                    <TextBlock Text="{Binding TenChiNhanh}" Foreground="#475569" FontSize="12.5"
                                               VerticalAlignment="Center" Margin="12,0" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Số điện thoại" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:NhanVienItem">
                                    <TextBlock Text="{Binding SoDienThoai}" Foreground="#334155" FontSize="12.5"
                                               VerticalAlignment="Center" Margin="12,0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Ngày vào làm" Width="115">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:NhanVienItem">
                                    <TextBlock Text="{Binding NgayVaoLam, StringFormat='dd/MM/yyyy'}" Foreground="#475569"
                                               FontSize="12.5" VerticalAlignment="Center" Margin="12,0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Tài khoản" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:NhanVienItem">
                                    <Panel VerticalAlignment="Center" Margin="12,0">
                                        <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="12"
                                                Padding="8,3" HorizontalAlignment="Left" IsVisible="{Binding CoTaiKhoan}">
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <Ellipse Width="6" Height="6" Fill="#10B981" />
                                                <TextBlock Text="Đã có" Foreground="#047857" FontSize="11.5" FontWeight="Medium" />
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12"
                                                Padding="8,3" HorizontalAlignment="Left" IsVisible="{Binding !CoTaiKhoan}">
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <Ellipse Width="6" Height="6" Fill="#94A3B8" />
                                                <TextBlock Text="Chưa có" Foreground="#64748B" FontSize="11.5" FontWeight="Medium" />
                                            </StackPanel>
                                        </Border>
                                    </Panel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Trạng thái" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:NhanVienItem">
                                    <Panel VerticalAlignment="Center" Margin="12,0">
                                        <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="12"
                                                Padding="8,3" HorizontalAlignment="Left" IsVisible="{Binding TrangThai}">
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <Ellipse Width="6" Height="6" Fill="#10B981" />
                                                <TextBlock Text="Đang làm việc" Foreground="#047857" FontSize="11.5" FontWeight="Medium" />
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="12"
                                                Padding="8,3" HorizontalAlignment="Left" IsVisible="{Binding !TrangThai}">
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <Ellipse Width="6" Height="6" Fill="#EF4444" />
                                                <TextBlock Text="Ngừng hoạt động" Foreground="#B91C1C" FontSize="11.5" FontWeight="Medium" />
                                            </StackPanel>
                                        </Border>
                                    </Panel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Thao tác" Width="250">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:NhanVienItem">
                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" Margin="8,0">
                                        <Button Classes="rowBtn" Content="✏️ Sửa"
                                                IsVisible="{Binding CanEdit}"
                                                Command="{Binding $parent[UserControl].((vm:QuanLyNhanVienViewModel)DataContext).SuaNhanVienCommand}"
                                                CommandParameter="{Binding}"
                                                Background="#EFF6FF" Foreground="#1D4ED8" BorderBrush="#BFDBFE" BorderThickness="1"
                                                ToolTip.Tip="Sửa hồ sơ nhân viên" />

                                        <Button Classes="rowBtn" Content="🔑 Tài khoản"
                                                IsVisible="{Binding !CoTaiKhoan}"
                                                Command="{Binding $parent[UserControl].((vm:QuanLyNhanVienViewModel)DataContext).CapTaiKhoanCommand}"
                                                CommandParameter="{Binding}"
                                                Background="#F5F3FF" Foreground="#6D28D9" BorderBrush="#DDD6FE" BorderThickness="1"
                                                ToolTip.Tip="Cấp tài khoản đăng nhập cho nhân viên" />

                                        <Button Classes="rowBtn" Content="🔄 Trạng thái"
                                                IsVisible="{Binding CanEdit}"
                                                Command="{Binding $parent[UserControl].((vm:QuanLyNhanVienViewModel)DataContext).DoiTrangThaiCommand}"
                                                CommandParameter="{Binding}"
                                                Background="#FFFBEB" Foreground="#B45309" BorderBrush="#FDE68A" BorderThickness="1"
                                                ToolTip.Tip="Đổi trạng thái làm việc" />

                                        <Button Classes="rowBtn" Content="🗑️"
                                                IsVisible="{Binding CanDelete}"
                                                Command="{Binding $parent[UserControl].((vm:QuanLyNhanVienViewModel)DataContext).XoaNhanVienCommand}"
                                                CommandParameter="{Binding}"
                                                Background="#FEF2F2" Foreground="#DC2626" BorderBrush="#FECACA" BorderThickness="1"
                                                ToolTip.Tip="Xóa hồ sơ nhân viên" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Background="White" IsVisible="{Binding IsEmpty}" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="40">
                    <StackPanel Spacing="10" HorizontalAlignment="Center">
                        <TextBlock Text="👥" FontSize="44" HorizontalAlignment="Center" Foreground="#94A3B8" />
                        <TextBlock Text="Không tìm thấy hồ sơ nhân viên nào" FontSize="16" FontWeight="SemiBold"
                                   Foreground="#334155" HorizontalAlignment="Center" />
                        <TextBlock Text="Thử tìm kiếm với từ khóa khác hoặc bấm nút Xóa lọc bên trên." FontSize="13"
                                   Foreground="#64748B" HorizontalAlignment="Center" />
                        <Button Classes="btnAction" Content="Xóa bộ lọc" Command="{Binding XoaBoLocCommand}"
                                HorizontalAlignment="Center" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <Border Background="#40FFFFFF" IsVisible="{Binding IsLoading}" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                        <ProgressBar IsIndeterminate="True" Width="200" Height="4" Foreground="#0B4B82" />
                        <TextBlock Text="Đang tải dữ liệu nhân viên..." FontSize="13" Foreground="#64748B" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 4. PHÂN TRANG -->
        <Border Grid.Row="3" Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16,10">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                <TextBlock Grid.Column="0" Text="{Binding PagingSummary}" Foreground="#64748B" FontSize="13" VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="20,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Hiển thị:" Foreground="#64748B" FontSize="12.5" VerticalAlignment="Center" />
                    <ComboBox ItemsSource="{Binding PageSizeOptions}"
                              SelectedItem="{Binding PageSize, Mode=TwoWay}"
                              Height="30" Padding="8,0" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock Text="dòng/trang" Foreground="#64748B" FontSize="12.5" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Classes="pageBtn" Command="{Binding TrangDauCommand}" IsEnabled="{Binding CanGoPrevious}" ToolTip.Tip="Trang đầu">
                        <TextBlock Text="⏮" FontSize="11" VerticalAlignment="Center" />
                    </Button>
                    <Button Classes="pageBtn" Command="{Binding TrangTruocCommand}" IsEnabled="{Binding CanGoPrevious}" ToolTip.Tip="Trang trước">
                        <TextBlock Text="◀" FontSize="10" VerticalAlignment="Center" />
                    </Button>
                    <Border Background="#F1F5F9" CornerRadius="6" Padding="12,4" VerticalAlignment="Center">
                        <TextBlock Text="{Binding PagingPagesText}" FontSize="12.5" FontWeight="SemiBold" Foreground="#1E293B" />
                    </Border>
                    <Button Classes="pageBtn" Command="{Binding TrangSauCommand}" IsEnabled="{Binding CanGoNext}" ToolTip.Tip="Trang sau">
                        <TextBlock Text="▶" FontSize="10" VerticalAlignment="Center" />
                    </Button>
                    <Button Classes="pageBtn" Command="{Binding TrangCuoiCommand}" IsEnabled="{Binding CanGoNext}" ToolTip.Tip="Trang cuối">
                        <TextBlock Text="⏭" FontSize="11" VerticalAlignment="Center" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

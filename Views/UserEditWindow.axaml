<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ShopHoa.ViewModels"
        xmlns:m="clr-namespace:ShopHoa.Models"
        x:Class="ShopHoa.Views.UserEditWindow"
        x:DataType="vm:UserEditViewModel"
        Title="{Binding Title}"
        Width="900" Height="820"
        WindowStartupLocation="CenterOwner"
        RequestedThemeVariant="Light">
  <Border Background="White">
    <Grid Margin="24" RowDefinitions="Auto,*,Auto">
      <StackPanel Spacing="6">
        <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold" />
        <TextBlock Text="Tạo tài khoản và gán quyền theo từng chức năng chi tiết" Foreground="#6B7280" />
      </StackPanel>

      <Grid Grid.Row="1" Margin="0,16,0,0" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" RowSpacing="10">
        <StackPanel Grid.Row="0" Spacing="4">
          <TextBlock Text="Tên đăng nhập *" />
          <TextBox Text="{Binding TenDangNhap}" IsEnabled="{Binding CanChangeUsername}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="4">
          <TextBlock Text="Họ và tên *" />
          <TextBox Text="{Binding HoTen}" />
        </StackPanel>

        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="12">
          <StackPanel Spacing="4">
            <TextBlock Text="Mật khẩu *" />
            <TextBox Text="{Binding MatKhau}" PasswordChar="*" Watermark="{Binding PasswordWatermark}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="4">
            <TextBlock Text="Xác nhận mật khẩu *" />
            <TextBox Text="{Binding NhapLaiMatKhau}" PasswordChar="*" />
          </StackPanel>
        </Grid>

        <StackPanel Grid.Row="3" Spacing="4">
          <TextBlock Text="Vai trò" />
          <ComboBox ItemsSource="{Binding Roles}"
                    SelectedItem="{Binding SelectedRole}"
                    HorizontalAlignment="Stretch">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="m:Role">
                <TextBlock Text="{Binding TenVaiTro}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <CheckBox Content="Đang hoạt động" IsChecked="{Binding IsActive}" Margin="0,6,0,0" />
        </StackPanel>

        <Border Grid.Row="4"
                BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="12" Background="#FAFAFA">
          <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="8">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBlock Text="QUYỀN TRUY CẬP" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                <Button Content="Mở tất cả" Command="{Binding MoTatCaNhomCommand}" Padding="10,4" />
                <Button Content="Thu gọn tất cả" Command="{Binding DongTatCaNhomCommand}" Padding="10,4" />
                <Button Content="Chọn tất cả" Command="{Binding ChonTatCaCommand}" Padding="10,4"
                        Background="#0F766E" Foreground="White" />
                <Button Content="Bỏ chọn tất cả" Command="{Binding BoChonTatCaCommand}" Padding="10,4" />
              </StackPanel>
            </Grid>

            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBlock Text="{Binding PermissionHint}" Foreground="#6B7280" TextWrapping="Wrap" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding SelectedSummary}" Foreground="#0F766E" FontWeight="SemiBold" VerticalAlignment="Center" />
            </Grid>

            <ScrollViewer Grid.Row="2" MaxHeight="380" VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding PermissionGroups}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="m:PermissionGroup">
                    <Border Margin="0,4" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="6" Background="White">
                      <StackPanel>
                        <Border Background="#F3F4F6" CornerRadius="5,5,0,0">
                          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Margin="8,6">
                          <CheckBox Grid.Column="0"
                                    IsThreeState="True"
                                    IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                    IsEnabled="{Binding CanEditPermissions}"
                                    VerticalAlignment="Center"
                                    ToolTip.Tip="Chọn / bỏ chọn toàn bộ nhóm" />
                          <ToggleButton Grid.Column="1"
                                        Content="{Binding TenNhom}"
                                        IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="0"
                                        FontWeight="SemiBold"
                                        HorizontalAlignment="Left" />
                          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{Binding TrangThaiNhom}" Foreground="#6B7280" FontSize="12" VerticalAlignment="Center" />
                            <Button Content="Chọn" Padding="8,2" FontSize="12"
                                    Command="{Binding ChonTatCaCommand}"
                                    IsEnabled="{Binding CanEditPermissions}" />
                            <Button Content="Bỏ chọn" Padding="8,2" FontSize="12"
                                    Command="{Binding BoChonTatCaCommand}"
                                    IsEnabled="{Binding CanEditPermissions}" />
                          </StackPanel>
                          </Grid>
                        </Border>

                        <ItemsControl ItemsSource="{Binding Permissions}" IsVisible="{Binding IsExpanded}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="m:PermissionItem">
                              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="24,3,8,3">
                                <CheckBox Grid.Column="0"
                                          IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                          IsEnabled="{Binding IsSelectable}" />
                                <StackPanel Grid.Column="1">
                                  <TextBlock Text="{Binding TenQuyen}" />
                                  <TextBlock Text="{Binding MaQuyen}" FontSize="11" Foreground="#9CA3AF" />
                                </StackPanel>
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>

            <TextBlock Grid.Row="3" Text="Chỉ những quyền được tick mới được cấp. Bỏ tick một quyền nghĩa là nhân viên sẽ không thấy và không thực hiện được chức năng đó."
                       Foreground="#9CA3AF" FontSize="12" TextWrapping="Wrap" />
          </Grid>
        </Border>

        <Grid Grid.Row="5" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,16,0,0">
          <Button Grid.Column="1" Content="Hủy" Command="{Binding CancelCommand}" CommandParameter="{Binding $parent[Window]}" />
          <Button Grid.Column="2" Content="{Binding SaveButtonText}" Command="{Binding SaveCommand}" CommandParameter="{Binding $parent[Window]}" Background="#0F766E" Foreground="White" />
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>

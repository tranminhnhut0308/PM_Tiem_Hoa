<UserControl xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:ShopHoa.ViewModels"
  xmlns:models="using:ShopHoa.Models"
  xmlns:controls="using:ShopHoa.Controls"
  x:Class="ShopHoa.Views.ThemPhieuChiView"
  x:Name="RootView"
  x:DataType="vm:MainWindowViewModel">

  <!--
    Toàn bộ ô của form dùng chung state với form phiếu của Sổ quỹ
    (SoQuyPhieuMa / SoQuyPhieuChiLoai / SoQuyPhieuSoTien / ...) và nút Lưu gọi
    lại LuuSoQuyPhieuAsync(false) nên validation + cách ghi database giống hệt
    modal "Tạo phiếu chi tiền mặt" đang có sẵn.
    Các lớp sq-* khai trong Styles của MainWindow nên view này chỉ dùng lại.
  -->

  <Grid RowDefinitions="Auto,*,Auto" Margin="0">

    <!-- ============================================================ -->
    <!-- HEADER                                                       -->
    <!-- ============================================================ -->
    <Border Grid.Row="0"
      Background="White"
      BorderBrush="#E2ECE8"
      BorderThickness="0,0,0,1"
      Padding="22,14">

      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <StackPanel Orientation="Horizontal"
          Spacing="10"
          VerticalAlignment="Center">

          <Border Background="#FEF3F2"
            CornerRadius="6"
            Padding="6,2"
            VerticalAlignment="Center">
            <TextBlock Text="💸 THÊM PHIẾU CHI"
              FontSize="11"
              FontWeight="Bold"
              Foreground="#B42318" />
          </Border>

          <TextBlock Text="Thêm phiếu chi"
            FontSize="20"
            FontWeight="Bold"
            Foreground="#0F172A"
            VerticalAlignment="Center" />
        </StackPanel>

        <Button Grid.Column="1"
          Classes="sq-icon"
          Content="✕"
          Width="36"
          Height="36"
          FontSize="14"
          ToolTip.Tip="Quay lại danh sách"
          Command="{Binding DongFormThemPhieuChiCommand}" />
      </Grid>
    </Border>

    <!-- ============================================================ -->
    <!-- FORM 2 CỘT                                                   -->
    <!-- ============================================================ -->
    <ScrollViewer Grid.Row="1"
      Padding="22,18"
      HorizontalScrollBarVisibility="Disabled">

      <Border MaxWidth="980"
        HorizontalAlignment="Center"
        Background="White"
        BorderBrush="#E2ECE8"
        BorderThickness="1"
        CornerRadius="16"
        Padding="24,20"
        BoxShadow="0 6 24 #14000000">

        <StackPanel Spacing="16">

          <Grid ColumnDefinitions="*,*" ColumnSpacing="24">

            <StackPanel Grid.Column="0" Spacing="14">

              <!-- Mã phiếu (tự sinh) -->
              <StackPanel Spacing="0">
                <TextBlock Classes="sq-label" Text="Mã phiếu" />
                <TextBox Classes="sq-input"
                  Text="{Binding SoQuyPhieuMa, Mode=OneWay}"
                  IsReadOnly="True"
                  Focusable="False"
                  BorderBrush="{Binding SoQuyVienMaPhieu}"
                  Foreground="#087F6E"
                  FontWeight="Bold"
                  Watermark="Đang tạo mã..."
                  HorizontalAlignment="Stretch" />
                <TextBlock Classes="sq-error-text"
                  Text="{Binding SoQuyLoiMaPhieuText}"
                  IsVisible="{Binding SoQuyHienLoiMaPhieu}" />
              </StackPanel>

              <!-- Loại chi -->
              <StackPanel Spacing="0">
                <TextBlock Classes="sq-label" Text="Loại chi" />
                <ComboBox Classes="sq-input"
                  ItemsSource="{Binding SoQuyLoaiChiOptions}"
                  SelectedItem="{Binding SoQuyPhieuChiLoai, Mode=TwoWay}"
                  BorderBrush="{Binding SoQuyVienLoai}"
                  HorizontalAlignment="Stretch">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="models:SoQuyLuaChonItem">
                      <TextBlock Text="{Binding HienThi}" FontSize="13" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                  <ComboBox.SelectionBoxItemTemplate>
                    <DataTemplate x:DataType="models:SoQuyLuaChonItem">
                      <TextBlock Text="{Binding HienThi}" FontSize="13" />
                    </DataTemplate>
                  </ComboBox.SelectionBoxItemTemplate>
                </ComboBox>
                <TextBlock Classes="sq-error-text"
                  Text="{Binding SoQuyLoiLoaiText}"
                  IsVisible="{Binding SoQuyHienLoiLoai}" />
              </StackPanel>

              <!-- Quỹ: danh sách lấy từ phuong_thuc có trong phiếu -->
              <StackPanel Spacing="0"
                IsVisible="{Binding SoQuyPhieuCoQuy}">
                <TextBlock Classes="sq-label" Text="Quỹ" />
                <ComboBox Classes="sq-input"
                  ItemsSource="{Binding SoQuyPhieuQuyOptions}"
                  SelectedItem="{Binding SoQuyPhieuQuy, Mode=TwoWay}"
                  HorizontalAlignment="Stretch">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="models:SoQuyLuaChon">
                      <TextBlock Text="{Binding HienThi}" FontSize="13" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                  <ComboBox.SelectionBoxItemTemplate>
                    <DataTemplate x:DataType="models:SoQuyLuaChon">
                      <TextBlock Text="{Binding HienThi}" FontSize="13" />
                    </DataTemplate>
                  </ComboBox.SelectionBoxItemTemplate>
                </ComboBox>
              </StackPanel>

              <!-- Nội dung -->
              <StackPanel Spacing="0">
                <TextBlock Classes="sq-label" Text="Nội dung" />
                <TextBox Classes="sq-input"
                  Text="{Binding SoQuyPhieuNoiDung, Mode=TwoWay}"
                  Watermark="Nội dung chi tiền..."
                  AcceptsReturn="True"
                  TextWrapping="Wrap"
                  Height="96"
                  VerticalContentAlignment="Top"
                  Padding="12,10" />
              </StackPanel>

              <!-- Số tiền (định dạng tiền Việt Nam, chỉ nhận số) -->
              <StackPanel Spacing="0">
                <TextBlock Classes="sq-label" Text="Số tiền" />
                <Border BorderBrush="{Binding SoQuyVienSoTien}"
                  BorderThickness="1.5"
                  CornerRadius="8">
                  <controls:MoneyTextBox Value="{Binding SoQuyPhieuSoTien, Mode=TwoWay}"
                    Height="34"
                    Margin="0" />
                </Border>
                <TextBlock Classes="sq-error-text"
                  Text="{Binding SoQuyLoiSoTienText}"
                  IsVisible="{Binding SoQuyHienLoiSoTien}" />
              </StackPanel>

              <!-- Ghi chú -->
              <StackPanel Spacing="0">
                <TextBlock Classes="sq-label" Text="Ghi chú" />
                <TextBox Classes="sq-input"
                  Text="{Binding SoQuyPhieuGhiChu, Mode=TwoWay}"
                  Watermark="Ghi chú phiếu chi..."
                  AcceptsReturn="True"
                  TextWrapping="Wrap"
                  Height="96"
                  VerticalContentAlignment="Top"
                  Padding="12,10" />
              </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="14">

              <!-- Thời gian (tự động) -->
              <StackPanel Spacing="0">
                <TextBlock Classes="sq-label" Text="Thời gian" />
                <TextBox Classes="sq-input"
                  Text="{Binding SoQuyPhieuThoiGianText, Mode=OneWay}"
                  IsReadOnly="True"
                  Focusable="False"
                  BorderBrush="{Binding SoQuyVienThoiGian}"
                  Watermark="dd/MM/yyyy HH:mm"
                  HorizontalAlignment="Stretch" />
                <TextBlock Classes="sq-error-text"
                  Text="{Binding SoQuyLoiThoiGianText}"
                  IsVisible="{Binding SoQuyHienLoiThoiGian}" />
              </StackPanel>

              <!-- Người chi -->
              <StackPanel Spacing="0">
                <TextBlock Classes="sq-label" Text="Người chi" />
                <TextBox Classes="sq-input"
                  Text="{Binding SoQuyPhieuNguoiThucHien, Mode=TwoWay}"
                  Watermark="Nhân viên chi tiền"
                  BorderBrush="{Binding SoQuyVienNguoiThucHien}"
                  HorizontalAlignment="Stretch" />
                <TextBlock Classes="sq-error-text"
                  Text="{Binding SoQuyLoiNguoiThucHienHienThi}"
                  IsVisible="{Binding SoQuyHienLoiNguoiThucHien}" />
              </StackPanel>

              <!-- Tên người nhận -->
              <StackPanel Spacing="0">
                <TextBlock Classes="sq-label" Text="Tên người nhận" />
                <TextBox Classes="sq-input"
                  Text="{Binding SoQuyPhieuTenNguoi, Mode=TwoWay}"
                  Watermark="Nhập tên người nhận tiền"
                  BorderBrush="{Binding SoQuyVienTenNguoi}"
                  HorizontalAlignment="Stretch" />
                <TextBlock Classes="sq-error-text"
                  Text="{Binding SoQuyLoiTenNguoiHienThi}"
                  IsVisible="{Binding SoQuyHienLoiTenNguoi}" />
              </StackPanel>

              <!-- Trạng thái hạch toán + giải thích (giống modal Sổ quỹ) -->
              <Border Background="#FFF9ED"
                BorderBrush="#F0E0BB"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,10">
                <StackPanel Spacing="6">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <CheckBox IsChecked="{Binding SoQuyPhieuHachToan, Mode=OneWay}"
                      IsEnabled="False"
                      Content="Hạch toán vào kết quả hoạt động kinh doanh"
                      FontSize="13"
                      Foreground="#344054"
                      VerticalAlignment="Center"
                      Margin="0" />

                    <Border Width="20"
                      Height="20"
                      CornerRadius="10"
                      Background="#FEF3F2"
                      VerticalAlignment="Center">
                      <TextBlock Text="i"
                        FontSize="11"
                        FontWeight="Bold"
                        Foreground="#D92D20"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                    </Border>
                  </StackPanel>

                  <TextBlock Text="Phiếu chi sẽ được ghi nhận vào tổng chi của sổ quỹ và đồng thời tính vào kết quả hoạt động kinh doanh trong kỳ này."
                    FontSize="12"
                    Foreground="#667085"
                    TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>
    </ScrollViewer>

    <!-- ============================================================ -->
    <!-- FOOTER                                                       -->
    <!-- ============================================================ -->
    <Border Grid.Row="2"
      Background="#F7FAF9"
      BorderBrush="#E2ECE8"
      BorderThickness="0,1,0,0"
      Padding="22,14">

      <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="10">

        <TextBlock Grid.Column="0"
          Text="{Binding StatusMessage}"
          FontSize="12.5"
          Foreground="#667085"
          VerticalAlignment="Center"
          TextTrimming="CharacterEllipsis" />

        <Button Grid.Column="1"
          Classes="sq-btn-secondary"
          Content="Quay lại"
          Command="{Binding DongFormThemPhieuChiCommand}" />

        <Button Grid.Column="2"
          Classes="sq-btn-secondary"
          Content="Làm mới"
          IsEnabled="{Binding !IsSoQuyPhieuDangLuu}"
          Command="{Binding LamMoiFormThemPhieuChiCommand}" />

        <Button Grid.Column="3"
          Classes="sq-btn-secondary"
          Content="Lưu &amp; In"
          IsEnabled="{Binding !IsSoQuyPhieuDangLuu}"
          IsVisible="{Binding CanCreatePayment}"
          Command="{Binding LuuVaInThemPhieuChiCommand}" />

        <Button Grid.Column="4"
          Classes="sq-btn-primary"
          Content="Lưu phiếu chi"
          IsEnabled="{Binding !IsSoQuyPhieuDangLuu}"
          IsVisible="{Binding CanCreatePayment}"
          Command="{Binding LuuThemPhieuChiCommand}" />
      </Grid>
    </Border>
  </Grid>
</UserControl>

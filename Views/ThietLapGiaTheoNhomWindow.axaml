<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ShopHoa.ViewModels"
        xmlns:models="using:ShopHoa.Models"
        x:Class="ShopHoa.Views.ThietLapGiaTheoNhomWindow"
        x:DataType="vm:ThietLapGiaTheoNhomViewModel"
        Width="1200"
        Height="780"
        MinWidth="1050"
        MinHeight="650"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        Title="Thiết lập giá theo nhóm / nhiều khách hàng"
        Background="#F4F7F6"
        RequestedThemeVariant="Light">

    <Window.Styles>
        <Style Selector="TextBox.inputBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1A2D42"/>
            <Setter Property="BorderBrush" Value="#D8E5E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style Selector="TextBox.inputBox:focus">
            <Setter Property="BorderBrush" Value="#087F6E"/>
            <Setter Property="BorderThickness" Value="1.5"/>
        </Style>

        <Style Selector="ComboBox.combo">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1A2D42"/>
            <Setter Property="BorderBrush" Value="#D8E5E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="Button.btnPrimary">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="#087F6E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.btnPrimary:pointerover">
            <Setter Property="Background" Value="#066356"/>
        </Style>

        <Style Selector="Button.btnAction">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#263B35"/>
            <Setter Property="BorderBrush" Value="#D8E5E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.btnAction:pointerover">
            <Setter Property="Background" Value="#EDF3F1"/>
        </Style>

        <Style Selector="Button.btnQuickCalc">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="#E3F2ED"/>
            <Setter Property="Foreground" Value="#087F6E"/>
            <Setter Property="BorderBrush" Value="#A2D7CB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.btnQuickCalc:pointerover">
            <Setter Property="Background" Value="#C9E8DF"/>
        </Style>

        <Style Selector="Button.btnDeleteMini">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Background" Value="#FEE2E2"/>
            <Setter Property="Foreground" Value="#DC2626"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="Button.btnDeleteMini:pointerover">
            <Setter Property="Background" Value="#FCA5A5"/>
        </Style>

        <!-- DATA GRID STYLES -->
        <Style Selector="DataGridColumnHeader">
            <Setter Property="Background" Value="#EBF3F0"/>
            <Setter Property="Foreground" Value="#164B40"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="SeparatorBrush" Value="#D8E5E0"/>
        </Style>
        <Style Selector="DataGridRow:pointerover">
            <Setter Property="Background" Value="#F8FCFA"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- 1. HEADER -->
        <Border Grid.Row="0" Background="White" BorderBrush="#D8E5E0" BorderThickness="0,0,0,1" Padding="24,14">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                    <Border Width="44" Height="44" CornerRadius="22" Background="#087F6E" VerticalAlignment="Center">
                        <TextBlock Text="🏷️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Thiết lập giá theo nhóm / nhiều khách hàng" FontSize="18" FontWeight="Bold" Foreground="#163F38"/>
                        <TextBlock Text="Áp dụng chính sách giá bán đặc quyền đồng thời cho danh sách nhiều khách hàng và nhóm hàng" FontSize="12.5" Foreground="#667A74"/>
                    </StackPanel>
                </StackPanel>

                <!-- Quick Stats Badges -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Background="#F4F8F6" BorderBrush="#D8E5E0" BorderThickness="1" CornerRadius="8" Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="👥" FontSize="13"/>
                            <TextBlock Text="{Binding TongSoKhachHangText}" FontSize="13" FontWeight="Bold" Foreground="#163F38"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#E8F5E9" BorderBrush="#A5D6A7" BorderThickness="1" CornerRadius="8" Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="📦" FontSize="13"/>
                            <TextBlock Text="{Binding TongSoSanPhamText}" FontSize="13" FontWeight="Bold" Foreground="#2E7D32"/>
                        </StackPanel>
                    </Border>
                    <!-- Warning badge if selling below cost -->
                    <Border Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="8" Padding="12,6"
                            IsVisible="{Binding CoCanhBaoGiaVon}">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CanhBaoGiaVonText}" FontSize="12.5" FontWeight="Bold" Foreground="#DC2626"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. NỘI DUNG CHÍNH (2 CỘT) -->
        <Grid Grid.Row="1" ColumnDefinitions="380,*" Margin="20,16" ColumnSpacing="16">

            <!-- ========================================================= -->
            <!-- CỘT TRÁI: CHỌN KHÁCH HÀNG ÁP DỤNG -->
            <!-- ========================================================= -->
            <Border Grid.Column="0" Background="White" CornerRadius="10" BorderBrush="#D8E5E0" BorderThickness="1" Padding="16">
                <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="12">

                    <!-- Tiêu đề cột -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="👥" FontSize="14"/>
                            <TextBlock Text="1. KHÁCH HÀNG ÁP DỤNG" FontSize="13.5" FontWeight="Bold" Foreground="#163F38"/>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="btnAction" Content="Xóa tất cả"
                                Command="{Binding XoaTatCaKhachHangCommand}"
                                Height="26" Padding="8,0" FontSize="11.5"
                                IsVisible="{Binding DanhSachKhachHang.Count}"/>
                    </Grid>

                    <!-- Thêm theo nhóm khách hàng -->
                    <Border Grid.Row="1" Background="#F8FAFA" BorderBrush="#E2ECE8" BorderThickness="1" CornerRadius="8" Padding="12,10">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Thêm nhanh theo nhóm:" FontSize="12" FontWeight="SemiBold" Foreground="#344B45"/>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <ComboBox Grid.Column="0" Classes="combo" HorizontalAlignment="Stretch"
                                          ItemsSource="{Binding NhomKhachHangOptions}"
                                          SelectedItem="{Binding SelectedNhomKhachHang, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:NhomKhachHang">
                                            <TextBlock Text="{Binding TenNhom}" FontSize="13" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Grid.Column="1" Classes="btnPrimary" Content="＋ Cả nhóm"
                                        Command="{Binding ThemNhomKhachHangCommand}" ToolTip.Tip="Thêm tất cả khách hàng trong nhóm này vào danh sách"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Tìm & thêm từng khách hàng -->
                    <StackPanel Grid.Row="2" Spacing="6">
                        <TextBlock Text="Hoặc tìm thêm từng khách:" FontSize="12" FontWeight="SemiBold" Foreground="#344B45"/>
                        <TextBox Classes="inputBox" Watermark="🔍 Gõ mã, tên hoặc SĐT khách..."
                                 Text="{Binding CustomerSearch, Mode=TwoWay}"/>

                        <!-- Gợi ý tìm kiếm khách hàng -->
                        <Border Background="White" BorderBrush="#087F6E" BorderThickness="1" CornerRadius="6"
                                MaxHeight="180" Margin="0,-2,0,0" BoxShadow="0 4 12 #20000000"
                                IsVisible="{Binding HasCustomerSuggestions}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding CustomerSuggestions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:KhachHang">
                                            <Button Classes="btnAction" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                    Height="36" BorderThickness="0,0,0,1" BorderBrush="#F0F4F2"
                                                    Command="{Binding $parent[Window].((vm:ThietLapGiaTheoNhomViewModel)DataContext).ChonKhachHangGoiYCommand}"
                                                    CommandParameter="{Binding}">
                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                                    <TextBlock Grid.Column="0" Text="{Binding MaKhachHang}" FontWeight="Bold" Foreground="#087F6E" FontSize="12"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding TenKhachHang}" FontWeight="SemiBold" Foreground="#163F38" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding SoDienThoai}" Foreground="#667A74" FontSize="11.5"/>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>

                    <!-- Danh sách khách hàng đã chọn -->
                    <Border Grid.Row="3" Background="#F8FAFA" BorderBrush="#E2ECE8" BorderThickness="1" CornerRadius="8" Padding="8">
                        <Grid>
                            <!-- Empty state -->
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8"
                                        IsVisible="{Binding !DanhSachKhachHang.Count}">
                                <TextBlock Text="👥" FontSize="28" HorizontalAlignment="Center"/>
                                <TextBlock Text="Chưa chọn khách hàng nào" FontWeight="Bold" Foreground="#667A74" HorizontalAlignment="Center"/>
                                <TextBlock Text="Hãy chọn nhóm ở trên hoặc tìm kiếm để thêm khách vào danh sách."
                                           FontSize="12" Foreground="#9CA3AF" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="260"/>
                            </StackPanel>

                            <!-- List -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto" IsVisible="{Binding DanhSachKhachHang.Count}">
                                <ItemsControl ItemsSource="{Binding DanhSachKhachHang}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:KhachHang">
                                            <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6"
                                                    Padding="10,8" Margin="0,0,0,6">
                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                                    <Border Width="32" Height="32" CornerRadius="16" Background="#E3F2ED" VerticalAlignment="Center">
                                                        <TextBlock Text="👤" Foreground="#087F6E" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                        <TextBlock Text="{Binding TenKhachHang}" FontWeight="SemiBold" FontSize="12.5" Foreground="#163F38" TextTrimming="CharacterEllipsis"/>
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <TextBlock Text="{Binding MaKhachHang}" FontSize="11" Foreground="#087F6E" FontWeight="Bold"/>
                                                            <TextBlock Text="•" FontSize="10" Foreground="#D1D5DB"/>
                                                            <TextBlock Text="{Binding SoDienThoai}" FontSize="11" Foreground="#6B7280"/>
                                                            <TextBlock Text="{Binding NhomKhachHang, StringFormat='({0})'}" FontSize="11" Foreground="#059669"
                                                                       IsVisible="{Binding NhomKhachHang, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <Button Grid.Column="2" Classes="btnDeleteMini" Content="✕" ToolTip.Tip="Bỏ khách hàng này"
                                                            Command="{Binding $parent[Window].((vm:ThietLapGiaTheoNhomViewModel)DataContext).XoaKhachHangCommand}"
                                                            CommandParameter="{Binding}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- Tóm tắt số khách hàng -->
                    <Border Grid.Row="4" Background="#E3F2ED" CornerRadius="6" Padding="10,6">
                        <TextBlock Text="{Binding TongSoKhachHang, StringFormat='Đã chọn: {0} khách hàng'}"
                                   FontWeight="Bold" Foreground="#087F6E" HorizontalAlignment="Center" FontSize="12.5"/>
                    </Border>
                </Grid>
            </Border>

            <!-- ========================================================= -->
            <!-- CỘT PHẢI: CHỌN SẢN PHẨM & BẢNG GIÁ RIÊNG -->
            <!-- ========================================================= -->
            <Border Grid.Column="1" Background="White" CornerRadius="10" BorderBrush="#D8E5E0" BorderThickness="1" Padding="16">
                <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">

                    <!-- Tiêu đề cột & Tìm kiếm sản phẩm -->
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="10">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="📦" FontSize="14"/>
                            <TextBlock Text="2. SẢN PHẨM &amp; GIÁ RIÊNG" FontSize="13.5" FontWeight="Bold" Foreground="#163F38"/>
                        </StackPanel>

                        <!-- Ô tìm kiếm sản phẩm -->
                        <TextBox Grid.Column="1" Classes="inputBox" Watermark="🔍 Gõ mã hoặc tên sản phẩm..."
                                 Text="{Binding ProductSearch, Mode=TwoWay}"/>

                        <!-- Lọc theo nhóm sản phẩm -->
                        <ComboBox Grid.Column="2" Classes="combo" Width="180"
                                  ItemsSource="{Binding NhomSanPhamOptions}"
                                  SelectedItem="{Binding SelectedNhomSanPham, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:ProductOption">
                                    <TextBlock Text="{Binding Name}" FontSize="12.5" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- Nút Thêm cả nhóm hàng -->
                        <Button Grid.Column="3" Classes="btnAction" Content="＋ Thêm cả nhóm"
                                Command="{Binding ThemTatCaSanPhamNhomCommand}"
                                ToolTip.Tip="Thêm toàn bộ sản phẩm trong nhóm hàng đã chọn vào bảng"/>

                        <!-- Xóa tất cả sản phẩm -->
                        <Button Grid.Column="4" Classes="btnAction" Content="Xóa tất cả"
                                Command="{Binding XoaTatCaSanPhamCommand}"
                                IsVisible="{Binding DanhSachSanPham.Count}"/>
                    </Grid>

                    <!-- Gợi ý tìm kiếm sản phẩm (Floating panel) -->
                    <Border Grid.Row="0" Margin="0,40,0,0" Background="White" BorderBrush="#087F6E" BorderThickness="1" CornerRadius="6"
                            MaxHeight="200" BoxShadow="0 4 12 #20000000" ZIndex="20"
                            IsVisible="{Binding HasProductSuggestions}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ProductSuggestions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:SanPham">
                                        <Button Classes="btnAction" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                Height="38" BorderThickness="0,0,0,1" BorderBrush="#F0F4F2"
                                                Command="{Binding $parent[Window].((vm:ThietLapGiaTheoNhomViewModel)DataContext).ChonSanPhamGoiYCommand}"
                                                CommandParameter="{Binding}">
                                            <Grid ColumnDefinitions="110,*,Auto,Auto" ColumnSpacing="10">
                                                <TextBlock Grid.Column="0" Text="{Binding MaSanPham}" FontWeight="Bold" Foreground="#087F6E" FontSize="12"/>
                                                <TextBlock Grid.Column="1" Text="{Binding TenSanPham}" FontWeight="SemiBold" Foreground="#163F38" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="2" Text="{Binding DonViTinh, StringFormat='ĐVT: {0}'}" Foreground="#667A74" FontSize="11.5"/>
                                                <TextBlock Grid.Column="3" Text="{Binding GiaBan, StringFormat='{}{0:N0} đ'}" FontWeight="Bold" Foreground="#163F38" FontSize="12.5"/>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <!-- THANH CÔNG CỤ TÍNH GIÁ NHANH HÀNG LOẠT -->
                    <Border Grid.Row="1" Background="#F8FAFA" BorderBrush="#D8E5E0" BorderThickness="1" CornerRadius="8" Padding="12,8">
                        <Grid ColumnDefinitions="Auto,70,Auto,Auto,Auto,*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="⚡" FontSize="13"/>
                                <TextBlock Text="Tính giá nhanh:" FontSize="12.5" FontWeight="Bold" Foreground="#163F38" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Ô nhập giá trị tính (vd: 10% hoặc 5000đ) -->
                            <TextBox Grid.Column="1" Classes="inputBox" Height="30" TextAlignment="Center"
                                     FontWeight="Bold" Foreground="#087F6E"
                                     Text="{Binding BatchCalcValue, Mode=TwoWay}"/>

                            <Button Grid.Column="2" Classes="btnQuickCalc" Content="Giảm %"
                                    Command="{Binding ApDungGiamPhanTramCommand}"
                                    ToolTip.Tip="Tính Giá riêng = Giá niêm yết - X% cho tất cả sản phẩm trong bảng"/>

                            <Button Grid.Column="3" Classes="btnQuickCalc" Content="Giảm số tiền"
                                    Command="{Binding ApDungGiamSoTienCommand}"
                                    ToolTip.Tip="Tính Giá riêng = Giá niêm yết - X đ cho tất cả sản phẩm trong bảng"/>

                            <Button Grid.Column="4" Classes="btnQuickCalc" Content="Giá vốn + %"
                                    Command="{Binding ApDungGiaVonCongLaiCommand}"
                                    ToolTip.Tip="Tính Giá riêng = Giá vốn + X% cho tất cả sản phẩm trong bảng"/>

                            <Button Grid.Column="6" Classes="btnAction" Height="28" Padding="10,0" FontSize="12"
                                    Content="Khôi phục giá niêm yết"
                                    Command="{Binding KhoiPhucGiaNiemYetCommand}"
                                    ToolTip.Tip="Đặt lại giá riêng bằng đúng giá niêm yết chung"/>
                        </Grid>
                    </Border>

                    <!-- BẢNG DANH SÁCH SẢN PHẨM & GIÁ RIÊNG -->
                    <Grid Grid.Row="2">
                        <!-- Empty state -->
                        <Border Background="#F9FAFB" CornerRadius="8" BorderBrush="#E5E7EB" BorderThickness="1"
                                IsVisible="{Binding !DanhSachSanPham.Count}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                                <TextBlock Text="📦" FontSize="36" HorizontalAlignment="Center"/>
                                <TextBlock Text="Chưa có mặt hàng nào trong bảng giá" FontWeight="Bold" Foreground="#667A74" HorizontalAlignment="Center"/>
                                <TextBlock Text="Hãy tìm kiếm sản phẩm hoặc bấm “＋ Thêm cả nhóm” ở trên để thêm mặt hàng cần thiết lập giá."
                                           FontSize="12.5" Foreground="#9CA3AF" TextAlignment="Center" MaxWidth="380"/>
                            </StackPanel>
                        </Border>

                        <!-- DataGrid -->
                        <Border Background="White" CornerRadius="8" BorderBrush="#D8E5E0" BorderThickness="1" ClipToBounds="True"
                                IsVisible="{Binding DanhSachSanPham.Count}">
                            <DataGrid ItemsSource="{Binding DanhSachSanPham}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="False"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto"
                                      RowHeight="44">
                                <DataGrid.Columns>

                                    <!-- STT -->
                                    <DataGridTextColumn Header="STT" Binding="{Binding Stt}" IsReadOnly="True" Width="45"/>

                                    <!-- MÃ HÀNG -->
                                    <DataGridTemplateColumn Header="MÃ HÀNG" Width="100" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate x:DataType="vm:SanPhamGiaRiengItem">
                                                <TextBlock Text="{Binding MaSanPham}" FontWeight="Bold" Foreground="#087F6E"
                                                           FontSize="12" VerticalAlignment="Center" Margin="8,0"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- TÊN HÀNG HÓA -->
                                    <DataGridTemplateColumn Header="TÊN HÀNG HÓA" Width="*" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate x:DataType="vm:SanPhamGiaRiengItem">
                                                <StackPanel VerticalAlignment="Center" Margin="8,0">
                                                    <TextBlock Text="{Binding TenSanPham}" FontWeight="SemiBold" Foreground="#163F38"
                                                               FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                                                    <!-- Warning line if selling below cost -->
                                                    <TextBlock Text="{Binding ChenhLechGiaVonText}" FontSize="11" FontWeight="Bold" Foreground="#DC2626"
                                                               IsVisible="{Binding IsThapHonGiaVon}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- ĐVT -->
                                    <DataGridTextColumn Header="ĐVT" Binding="{Binding DonViTinh}" IsReadOnly="True" Width="60"/>

                                    <!-- GIÁ NIÊM YẾT (GỐC) -->
                                    <DataGridTemplateColumn Header="GIÁ NIÊM YẾT" Width="110" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate x:DataType="vm:SanPhamGiaRiengItem">
                                                <TextBlock Text="{Binding GiaBanText}" Foreground="#667A74" FontSize="12"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- GIÁ VỐN -->
                                    <DataGridTemplateColumn Header="GIÁ VỐN" Width="100" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate x:DataType="vm:SanPhamGiaRiengItem">
                                                <TextBlock Text="{Binding GiaVonText}" Foreground="#9CA3AF" FontSize="11.5"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- GIÁ BÁN RIÊNG (EDITABLE) -->
                                    <DataGridTemplateColumn Header="GIÁ BÁN RIÊNG (đ)" Width="140">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate x:DataType="vm:SanPhamGiaRiengItem">
                                                <Border Background="#E8F5E9" BorderBrush="#A5D6A7" BorderThickness="1" CornerRadius="6"
                                                        Padding="4,2" Margin="4" VerticalAlignment="Center">
                                                    <TextBox Text="{Binding GiaRieng, Mode=TwoWay, StringFormat='{}{0:N0}'}"
                                                             FontWeight="Bold" Foreground="#087F6E" FontSize="13"
                                                             TextAlignment="Right" BorderThickness="0" Background="Transparent"
                                                             VerticalAlignment="Center"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- CHÊNH LỆCH -->
                                    <DataGridTemplateColumn Header="CHÊNH LỆCH" Width="130" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate x:DataType="vm:SanPhamGiaRiengItem">
                                                <TextBlock Text="{Binding ChenhLechText}" Foreground="{Binding ChenhLechColor}"
                                                           FontWeight="SemiBold" FontSize="12"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- GHI CHÚ -->
                                    <DataGridTemplateColumn Header="GHI CHÚ" Width="110">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate x:DataType="vm:SanPhamGiaRiengItem">
                                                <TextBox Text="{Binding GhiChu, Mode=TwoWay}" FontSize="11.5"
                                                         Watermark="Ghi chú..." BorderThickness="0" Background="Transparent"
                                                         VerticalAlignment="Center" Margin="4,0"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- NÚT XÓA -->
                                    <DataGridTemplateColumn Header="" Width="45" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate x:DataType="vm:SanPhamGiaRiengItem">
                                                <Button Classes="btnDeleteMini" Content="✕" ToolTip.Tip="Bỏ mặt hàng này"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        Command="{Binding $parent[Window].((vm:ThietLapGiaTheoNhomViewModel)DataContext).XoaSanPhamCommand}"
                                                        CommandParameter="{Binding}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>

                    <!-- Thông báo trạng thái / Tiến trình -->
                    <Border Grid.Row="3" Background="#F4F8F6" CornerRadius="6" Padding="12,8">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding StatusMessage}" FontSize="12.5" Foreground="#163F38" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding TongSoSanPham, StringFormat='Tổng: {0} mặt hàng'}"
                                       FontWeight="Bold" Foreground="#087F6E" FontSize="12.5"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- 3. FOOTER ACTION BAR -->
        <Border Grid.Row="2" Background="White" BorderBrush="#D8E5E0" BorderThickness="0,1,0,0" Padding="24,14">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="16" VerticalAlignment="Center">

                <!-- Ngày áp dụng & Ghi chú chung -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="📅 Ngày áp dụng:" FontSize="13" FontWeight="SemiBold" Foreground="#344B45" VerticalAlignment="Center"/>
                        <DatePicker SelectedDate="{Binding NgayApDung, Mode=TwoWay}" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- Tóm tắt số lượng -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock FontSize="13" Foreground="#163F38">
                        <Run Text="Áp dụng "/>
                        <Run Text="{Binding TongSoSanPham}" FontWeight="Bold" Foreground="#087F6E"/>
                        <Run Text=" sản phẩm có giá riêng cho "/>
                        <Run Text="{Binding TongSoKhachHang}" FontWeight="Bold" Foreground="#087F6E"/>
                        <Run Text=" khách hàng đã chọn."/>
                    </TextBlock>
                </StackPanel>

                <!-- Nút Lưu & Áp dụng -->
                <Button Grid.Column="2" Classes="btnPrimary" Height="38" Padding="22,0" FontSize="13.5"
                        Content="💾 Áp dụng cho tất cả khách hàng"
                        Command="{Binding LuuThietLapGiaCommand}"
                        ToolTip.Tip="Lưu bảng giá riêng cho tất cả khách hàng đã chọn"/>

                <!-- Nút Đóng -->
                <Button Grid.Column="3" Classes="btnAction" Height="38" Padding="18,0" Content="✕ Đóng"
                        Click="OnCloseClick"/>
            </Grid>
        </Border>

    </Grid>
</Window>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ShopHoa.Views.NhapGiaBanWindow"
        Width="480"
        Height="300"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Title="Nhập giá bán"
        Background="#F4F7F6">

    <Window.Styles>

        <!-- ========================= -->
        <!-- Ô NHẬP GIÁ -->
        <!-- ========================= -->

        <Style Selector="TextBox.giaBanInput">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#263B35"/>
            <Setter Property="BorderBrush" Value="#D8E5E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="CaretBrush" Value="#087F6E"/>
        </Style>

        <Style Selector="TextBox.giaBanInput:pointerover">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#263B35"/>
            <Setter Property="BorderBrush" Value="#087F6E"/>
        </Style>

        <Style Selector="TextBox.giaBanInput:focus">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#263B35"/>
            <Setter Property="BorderBrush" Value="#087F6E"/>
            <Setter Property="BorderThickness" Value="1.5"/>
        </Style>

        <Style Selector="TextBox.giaBanInput /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#D8E5E0"/>
        </Style>

        <Style Selector="TextBox.giaBanInput:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#087F6E"/>
        </Style>

        <Style Selector="TextBox.giaBanInput:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#087F6E"/>
        </Style>

        <!-- ========================= -->
        <!-- NÚT HỦY -->
        <!-- ========================= -->

        <Style Selector="Button.cancelButton">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#52645E"/>
            <Setter Property="BorderBrush" Value="#D8E5E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
        </Style>

        <Style Selector="Button.cancelButton:pointerover">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#52645E"/>
            <Setter Property="BorderBrush" Value="#D8E5E0"/>
        </Style>

        <Style Selector="Button.cancelButton:pressed">
            <Setter Property="Background" Value="#F4F7F6"/>
            <Setter Property="Foreground" Value="#52645E"/>
            <Setter Property="BorderBrush" Value="#D8E5E0"/>
        </Style>

        <!-- ========================= -->
        <!-- NÚT LƯU -->
        <!-- ========================= -->

        <Style Selector="Button.savePriceButton">
            <Setter Property="Background" Value="#087F6E"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#087F6E"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="Button.savePriceButton:pointerover">
            <Setter Property="Background" Value="#087F6E"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#087F6E"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>

        <Style Selector="Button.savePriceButton:focus">
            <Setter Property="Background" Value="#087F6E"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#087F6E"/>
        </Style>

        <Style Selector="Button.savePriceButton:pressed">
            <Setter Property="Background" Value="#087F6E"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#087F6E"/>
        </Style>

        <!-- ÉP KIỂU CHỮ TRONG NÚT -->
        <Style Selector="Button.savePriceButton /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="TextElement.Foreground" Value="#FFFFFF"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

    </Window.Styles>

    <Border Background="#FFFFFF"
            CornerRadius="16"
            BorderBrush="#D8E5E0"
            BorderThickness="1"
            Padding="28"
            Margin="10">

        <Grid RowDefinitions="Auto,Auto,Auto,Auto"
              RowSpacing="14">

            <!-- TIÊU ĐỀ -->
            <TextBlock Text="Sản phẩm chưa có giá bán"
                       FontSize="21"
                       FontWeight="Bold"
                       Foreground="#163F38"/>

            <!-- MÔ TẢ -->
            <TextBlock Grid.Row="1"
                       Text="Vui lòng nhập giá bán trước khi thêm sản phẩm vào giỏ hàng."
                       FontSize="14"
                       Foreground="#61736E"
                       TextWrapping="Wrap"/>

            <!-- Ô GIÁ -->
            <TextBox Grid.Row="2"
                     x:Name="GiaBanTextBox"
                     Classes="giaBanInput"
                     Watermark="Nhập giá bán..."
                     Height="44"
                     HorizontalContentAlignment="Left"
                     VerticalContentAlignment="Center"/>

            <!-- NÚT -->
            <Grid Grid.Row="3"
                  ColumnDefinitions="*,Auto"
                  ColumnSpacing="10">

               <Button Content="Hủy"
        Classes="cancelButton"
        Width="90"
        Height="40"
        HorizontalAlignment="Stretch"
        HorizontalContentAlignment="Center"
        VerticalContentAlignment="Center"
        Click="HuyClicked"/>

                <Button Grid.Column="1"
                        Content="Lưu giá bán"
                        Classes="savePriceButton"
                        Width="125"
                        Height="40"
                        HorizontalAlignment="Right"
                        Click="LuuClicked"/>

            </Grid>

        </Grid>

    </Border>

</Window>
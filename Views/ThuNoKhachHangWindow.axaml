<Window xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ShopHoa.Controls"
    x:Class="ShopHoa.Views.ThuNoKhachHangWindow"
    Title="Thu công nợ khách hàng"
    Width="500"
    Height="560"
    MinWidth="440"
    MinHeight="500"
    CanResize="False"
    WindowStartupLocation="CenterOwner"
    Background="#F4F7F6">

    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="#263B35" />
        </Style>
        <Style Selector="Button.cancelButton">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#52645E" />
            <Setter Property="BorderBrush" Value="#D8E5E0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,8" />
        </Style>
        <Style Selector="Button.actionButton">
            <Setter Property="Background" Value="#087F6E" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,8" />
        </Style>
    </Window.Styles>

    <Border Background="#FFFFFF"
        CornerRadius="16"
        BorderBrush="#D8E5E0"
        BorderThickness="1"
        Margin="12"
        Padding="24">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*"
            RowSpacing="12">

            <!-- TIÊU ĐỀ -->
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Border Width="42" Height="42" CornerRadius="10" Background="#E6F5F1">
                    <TextBlock Text="💰" FontSize="20"
                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Thanh toán công nợ" FontSize="18" FontWeight="Bold"
                        Foreground="#163F38" />
                    <TextBlock Text="Trừ dần vào các hóa đơn còn nợ (cũ nhất trước)"
                        FontSize="12" Foreground="#61736E" />
                </StackPanel>
            </StackPanel>

            <!-- TÓM TẮT KHÁCH HÀNG -->
            <Border Grid.Row="1"
                Background="#F7FAF9"
                BorderBrush="#E2ECE8"
                BorderThickness="1"
                CornerRadius="12"
                Padding="14,12">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Khách hàng" Foreground="#61736E" FontSize="13" />
                        <TextBlock x:Name="TxtKhachHang" Grid.Column="1" FontWeight="SemiBold"
                            Foreground="#163F38" FontSize="13" />
                    </Grid>
                    <Border Height="1" Background="#E8F0ED" />
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Công nợ hiện tại" Foreground="#61736E" FontSize="13" />
                        <TextBlock x:Name="TxtConNo" Grid.Column="1" FontWeight="Bold"
                            Foreground="#D64545" FontSize="14" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- SỐ TIỀN THU -->
            <StackPanel Grid.Row="2" Spacing="4">
                <TextBlock Text="Số tiền khách trả" FontWeight="SemiBold" Foreground="#163F38"
                    FontSize="13" />
                <controls:MoneyTextBox x:Name="TienThuBox" />
            </StackPanel>

            <!-- PHƯƠNG THỨC -->
            <StackPanel Grid.Row="3" Spacing="4">
                <TextBlock Text="Phương thức thanh toán" FontWeight="SemiBold"
                    Foreground="#163F38" FontSize="13" />
                <ComboBox x:Name="CboPhuongThuc" HorizontalAlignment="Stretch" Height="38" />
            </StackPanel>

            <!-- GHI CHÚ -->
            <StackPanel Grid.Row="4" Spacing="4">
                <TextBlock Text="Ghi chú" FontWeight="SemiBold" Foreground="#163F38"
                    FontSize="13" />
                <TextBox x:Name="TxtGhiChu" AcceptsReturn="True" TextWrapping="Wrap"
                    MinHeight="60" MaxHeight="90" Watermark="Ghi chú lần thu nợ (không bắt buộc)..." />
            </StackPanel>

            <!-- LỖI -->
            <TextBlock Grid.Row="5" x:Name="TxtLoi" Foreground="#D92D20" FontWeight="SemiBold"
                FontSize="12" TextWrapping="Wrap" IsVisible="False" />

            <!-- NÚT -->
            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right"
                VerticalAlignment="Bottom" Spacing="10">
                <Button Content="Hủy" Classes="cancelButton" Width="100" Height="40"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    Click="OnCancelClick" />
                <Button Content="✓ Thanh toán" Classes="actionButton" Width="140" Height="40"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    Click="OnConfirmClick" />
            </StackPanel>
        </Grid>
    </Border>
</Window>

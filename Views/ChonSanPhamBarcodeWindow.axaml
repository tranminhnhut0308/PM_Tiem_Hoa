<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:ShopHoa.Models"
        x:Class="ShopHoa.Views.ChonSanPhamBarcodeWindow"
        Width="620"
        Height="480"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Title="Chọn sản phẩm theo mã vạch"
        Background="#F4F7F6">

    <Window.Styles>
        <Style Selector="TextBlock.tieuDe">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#163F38"/>
        </Style>

        <Style Selector="TextBlock.nho">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#61736E"/>
        </Style>

        <Style Selector="Button.cancelButton">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#52645E"/>
            <Setter Property="BorderBrush" Value="#D8E5E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="Button.cancelButton:pointerover">
            <Setter Property="Background" Value="#F4F7F6"/>
            <Setter Property="Foreground" Value="#52645E"/>
        </Style>

        <Style Selector="Button.saveButton">
            <Setter Property="Background" Value="#087F6E"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="Button.saveButton:pointerover">
            <Setter Property="Background" Value="#06695B"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
    </Window.Styles>

    <Border Background="#FFFFFF"
            CornerRadius="16"
            BorderBrush="#D8E5E0"
            BorderThickness="1"
            Padding="24"
            Margin="10">

        <StackPanel Spacing="14">

            <StackPanel Spacing="4">
                <TextBlock Text="Mã vạch trỏ tới nhiều sản phẩm"
                           Classes="tieuDe"/>
                <TextBlock x:Name="MaVachText"
                           Text="Mã vạch: "
                           Classes="nho"/>
            </StackPanel>

            <ListBox x:Name="DanhSachListBox"
                     Height="300"
                     Background="#F9FBFA"
                     BorderBrush="#E5ECE9"
                     BorderThickness="1"
                     SelectionMode="Single"
                     DoubleTapped="DanhSachListBox_OnDoubleTapped">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:SanPham">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12" Margin="4,6">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{Binding TenSanPham}"
                                           FontWeight="SemiBold"
                                           FontSize="14"
                                           Foreground="#163F38"/>
                                <TextBlock FontSize="12" Foreground="#61736E">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="Mã SP: {0}">
                                            <Binding Path="MaSanPham" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>

                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="#61736E"
                                       Text="{Binding DonViTinh}"/>

                            <TextBlock Grid.Column="2"
                                       VerticalAlignment="Center"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="#087F6E"
                                       Text="{Binding TonKho, StringFormat='Tồn: {0:N0}'}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Text="Bấm đúp vào sản phẩm hoặc chọn rồi nhấn Thêm vào giỏ."
                       Classes="nho"/>

            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" Margin="0,4,0,0">
                <Button Grid.Column="1"
                        Content="Huỷ"
                        Classes="cancelButton"
                        Width="90"
                        HorizontalContentAlignment="Center"
                        Click="HuyClicked"/>

                <Button Grid.Column="2"
                        Content="✓ Thêm vào giỏ"
                        Classes="saveButton"
                        MinWidth="150"
                        HorizontalContentAlignment="Center"
                        Click="ChonClicked"/>
            </Grid>

        </StackPanel>

    </Border>

</Window>

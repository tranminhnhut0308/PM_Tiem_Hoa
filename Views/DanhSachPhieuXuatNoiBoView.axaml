<UserControl xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:ShopHoa.ViewModels"
  xmlns:models="using:ShopHoa.Models"
  x:Class="ShopHoa.Views.DanhSachPhieuXuatNoiBoView"
  x:Name="RootView"
  x:DataType="vm:MainWindowViewModel">

  <UserControl.Styles>
    <Style Selector="TextBox.filterInput">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#CBD5E1" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="FontSize" Value="12.5" />
    </Style>

    <Style Selector="Button.btnPrimary">
      <Setter Property="Background" Value="#2563EB" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.btnPrimary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#1D4ED8" />
      <Setter Property="TextElement.Foreground" Value="White" />
    </Style>

    <Style Selector="Button.btnOutline">
      <Setter Property="Background" Value="#EFF6FF" />
      <Setter Property="Foreground" Value="#1D4ED8" />
      <Setter Property="BorderBrush" Value="#BFDBFE" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.btnOutline:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#DBEAFE" />
      <Setter Property="BorderBrush" Value="#93C5FD" />
      <Setter Property="TextElement.Foreground" Value="#1E40AF" />
    </Style>

    <Style Selector="Button.btnSubtle">
      <Setter Property="Background" Value="#F1F5F9" />
      <Setter Property="Foreground" Value="#475569" />
      <Setter Property="BorderBrush" Value="#E2E8F0" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.btnSubtle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#E2E8F0" />
      <Setter Property="TextElement.Foreground" Value="#1E293B" />
    </Style>

    <Style Selector="Button.btnTableAction">
      <Setter Property="Background" Value="#F8FAFC" />
      <Setter Property="Foreground" Value="#334155" />
      <Setter Property="BorderBrush" Value="#CBD5E1" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.btnTableAction:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#EFF6FF" />
      <Setter Property="BorderBrush" Value="#93C5FD" />
      <Setter Property="TextElement.Foreground" Value="#1D4ED8" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="12" Margin="0">

    <!-- ============================================================ -->
    <!-- SECTION A: HEADER & CÁC NÚT THAO TÁC                         -->
    <!-- ============================================================ -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="16" VerticalAlignment="Center">
      <StackPanel Spacing="3">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Border Background="#DBEAFE" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
            <TextBlock Text="🏢 XUẤT NỘI BỘ" FontSize="11" FontWeight="Bold" Foreground="#1E40AF" />
          </Border>
          <TextBlock Text="Danh sách phiếu xuất hàng nội bộ" FontSize="20" FontWeight="Bold" Foreground="#0F172A" />
        </StackPanel>
        <TextBlock Text="Quản lý các loại phiếu xuất chuyển kho, xuất cấp phát, xuất sử dụng và xuất hủy hỏng nội bộ"
                   FontSize="12.5" Foreground="#64748B" />
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button Classes="btnPrimary"
                Content="＋ Thêm phiếu xuất nội bộ"
                Height="36"
                Padding="14,0"
                Command="{Binding TaoPhieuXuatNoiBoMoiCommand}" />

        <Button Classes="btnOutline"
                Content="↻ Làm mới"
                Height="36"
                Padding="12,0"
                Command="{Binding LamMoiDsPhieuXuatNoiBoCommand}" />

        <Button Classes="btnSubtle"
                Content="📤 Xuất Excel"
                Height="36"
                Padding="12,0"
                Command="{Binding XuatExcelDsPhieuXuatNoiBoCommand}" />
      </StackPanel>
    </Grid>

    <!-- ============================================================ -->
    <!-- SECTION B: THẺ THỐNG KÊ TỔNG QUAN                            -->
    <!-- ============================================================ -->
    <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="12">

      <!-- Thẻ 1: Tổng số phiếu -->
      <Border Grid.Column="0"
              Background="White"
              BorderBrush="#E2E8F0"
              BorderThickness="1"
              CornerRadius="10"
              Padding="14,10"
              BoxShadow="0 1 3 #0A000000">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalAlignment="Center">
          <Border Width="38" Height="38" CornerRadius="8" Background="#EFF6FF" VerticalAlignment="Center">
            <TextBlock Text="🏢" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" Spacing="1">
            <TextBlock Text="TỔNG PHIẾU XUẤT NỘI BỘ" FontSize="11" FontWeight="Bold" Foreground="#64748B" />
            <TextBlock Text="{Binding ThongKeTongPhieuXuatNoiBoText}" FontSize="18" FontWeight="Bold" Foreground="#1E40AF" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- Thẻ 2: Tổng giá trị xuất -->
      <Border Grid.Column="1"
              Background="White"
              BorderBrush="#E2E8F0"
              BorderThickness="1"
              CornerRadius="10"
              Padding="14,10"
              BoxShadow="0 1 3 #0A000000">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalAlignment="Center">
          <Border Width="38" Height="38" CornerRadius="8" Background="#ECFDF5" VerticalAlignment="Center">
            <TextBlock Text="💰" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" Spacing="1">
            <TextBlock Text="TỔNG GIÁ TRỊ XUẤT NỘI BỘ" FontSize="11" FontWeight="Bold" Foreground="#64748B" />
            <TextBlock Text="{Binding ThongKeTongGiaTriXuatNoiBoText}" FontSize="18" FontWeight="Bold" Foreground="#047857" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- Thẻ 3: Tổng số lượng SP xuất -->
      <Border Grid.Column="2"
              Background="White"
              BorderBrush="#E2E8F0"
              BorderThickness="1"
              CornerRadius="10"
              Padding="14,10"
              BoxShadow="0 1 3 #0A000000">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalAlignment="Center">
          <Border Width="38" Height="38" CornerRadius="8" Background="#FEF3C7" VerticalAlignment="Center">
            <TextBlock Text="📦" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" Spacing="1">
            <TextBlock Text="TỔNG SỐ LƯỢNG SP XUẤT" FontSize="11" FontWeight="Bold" Foreground="#64748B" />
            <TextBlock Text="{Binding ThongKeTongSoLuongXuatNoiBoText}" FontSize="18" FontWeight="Bold" Foreground="#B45309" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <!-- ============================================================ -->
    <!-- SECTION C: THANH BỘ LỌC TÌM KIẾM                             -->
    <!-- ============================================================ -->
    <Border Grid.Row="2"
            Background="White"
            BorderBrush="#E2E8F0"
            BorderThickness="1"
            CornerRadius="10"
            Padding="12,10"
            BoxShadow="0 1 3 #0A000000">
      <Grid ColumnDefinitions="*,170,150,140,140,Auto,Auto" ColumnSpacing="10" VerticalAlignment="Center">

        <!-- Ô tìm kiếm -->
        <TextBox Grid.Column="0"
                 Classes="filterInput"
                 Text="{Binding DsPhieuXuatNoiBoSearch, Mode=TwoWay}"
                 Watermark="🔍 Mã phiếu, bộ phận nhận, người lập, ghi chú..." />

        <!-- Lọc Loại xuất -->
        <ComboBox Grid.Column="1"
                  ItemsSource="{Binding DsPhieuXuatNoiBoLoaiOptions}"
                  SelectedItem="{Binding SelectedPhieuXuatNoiBoLoaiHienThi, Mode=TwoWay}"
                  HorizontalAlignment="Stretch"
                  Height="36"
                  FontSize="12"
                  Background="White"
                  BorderBrush="#CBD5E1"
                  CornerRadius="8" />

        <!-- Lọc Trạng thái -->
        <ComboBox Grid.Column="2"
                  ItemsSource="{Binding DsPhieuXuatNoiBoTrangThaiOptions}"
                  SelectedItem="{Binding SelectedPhieuXuatNoiBoTrangThaiHienThi, Mode=TwoWay}"
                  HorizontalAlignment="Stretch"
                  Height="36"
                  FontSize="12"
                  Background="White"
                  BorderBrush="#CBD5E1"
                  CornerRadius="8" />

        <!-- Từ ngày -->
        <DatePicker Grid.Column="3"
                    SelectedDate="{Binding DsPhieuXuatNoiBoTuNgay, Mode=TwoWay}"
                    HorizontalAlignment="Stretch"
                    Height="36"
                    FontSize="12" />

        <!-- Đến ngày -->
        <DatePicker Grid.Column="4"
                    SelectedDate="{Binding DsPhieuXuatNoiBoDenNgay, Mode=TwoWay}"
                    HorizontalAlignment="Stretch"
                    Height="36"
                    FontSize="12" />

        <!-- Nút Tìm kiếm -->
        <Button Grid.Column="5"
                Classes="btnPrimary"
                Content="Tìm kiếm"
                Height="36"
                Padding="14,0"
                Command="{Binding TimKiemDsPhieuXuatNoiBoCommand}" />

        <!-- Nút Xóa lọc -->
        <Button Grid.Column="6"
                Classes="btnSubtle"
                Content="↺ Xóa lọc"
                Height="36"
                Padding="12,0"
                Command="{Binding LamMoiDsPhieuXuatNoiBoCommand}" />
      </Grid>
    </Border>

    <!-- ============================================================ -->
    <!-- SECTION D: BẢNG DỮ LIỆU PHIẾU XUẤT NỘI BỘ (10 CỘT CHUẨN)      -->
    <!-- ============================================================ -->
    <Border Grid.Row="3"
            Background="White"
            BorderBrush="#E2E8F0"
            BorderThickness="1"
            CornerRadius="10"
            Padding="0"
            BoxShadow="0 1 3 #0A000000"
            ClipToBounds="True">
      <Grid RowDefinitions="Auto,*">

        <!-- Header Bảng -->
        <Border Grid.Row="0"
                Background="#F8FAFC"
                BorderBrush="#E2E8F0"
                BorderThickness="0,0,0,1"
                Padding="12,10">
          <Grid ColumnDefinitions="45,115,125,120,150,*,80,115,100,130">
            <TextBlock Grid.Column="0" Text="STT" FontWeight="Bold" FontSize="12" Foreground="#475569" HorizontalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="Mã phiếu xuất" FontWeight="Bold" FontSize="12" Foreground="#475569" />
            <TextBlock Grid.Column="2" Text="Thời gian xuất" FontWeight="Bold" FontSize="12" Foreground="#475569" />
            <TextBlock Grid.Column="3" Text="Loại xuất" FontWeight="Bold" FontSize="12" Foreground="#475569" HorizontalAlignment="Center" />
            <TextBlock Grid.Column="4" Text="Kho xuất" FontWeight="Bold" FontSize="12" Foreground="#475569" />
            <TextBlock Grid.Column="5" Text="Kho nhận / Bộ phận nhận" FontWeight="Bold" FontSize="12" Foreground="#475569" Margin="6,0,0,0" />
            <TextBlock Grid.Column="6" Text="Tổng SL" FontWeight="Bold" FontSize="12" Foreground="#475569" HorizontalAlignment="Right" />
            <TextBlock Grid.Column="7" Text="Tổng giá trị" FontWeight="Bold" FontSize="12" Foreground="#475569" HorizontalAlignment="Right" />
            <TextBlock Grid.Column="8" Text="Trạng thái" FontWeight="Bold" FontSize="12" Foreground="#475569" HorizontalAlignment="Center" />
            <TextBlock Grid.Column="9" Text="Thao tác" FontWeight="Bold" FontSize="12" Foreground="#475569" HorizontalAlignment="Center" />
          </Grid>
        </Border>

        <!-- Danh sách dòng phiếu -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <Grid>
            <!-- Khi danh sách rỗng -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6" Margin="0,40"
                        IsVisible="{Binding !DsPhieuXuatNoiBoItems.Count}">
              <TextBlock Text="🏢" FontSize="36" HorizontalAlignment="Center" Foreground="#94A3B8" />
              <TextBlock Text="Không có phiếu xuất nội bộ nào phù hợp với bộ lọc."
                         FontSize="13.5" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Center" />
              <TextBlock Text="Thử thay đổi từ khóa tìm kiếm hoặc bấm 'Làm mới'."
                         FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Có dữ liệu -->
            <ItemsControl ItemsSource="{Binding DsPhieuXuatNoiBoItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="models:PhieuXuatNoiBo">
                  <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="12,9">
                    <Grid ColumnDefinitions="45,115,125,120,150,*,80,115,100,130" VerticalAlignment="Center">

                      <!-- 1. STT -->
                      <TextBlock Grid.Column="0" Text="{Binding SoThuTu}" FontSize="12" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center" />

                      <!-- 2. Mã phiếu -->
                      <TextBlock Grid.Column="1" Text="{Binding MaPhieuXuatNoiBo}" FontWeight="Bold" FontSize="12.5" Foreground="#2563EB" VerticalAlignment="Center" />

                      <!-- 3. Thời gian -->
                      <TextBlock Grid.Column="2" Text="{Binding ThoiGianXuatText}" FontSize="12" Foreground="#334155" VerticalAlignment="Center" />

                      <!-- 4. Loại xuất (Badge) -->
                      <Border Grid.Column="3"
                              Background="{Binding LoaiXuatBadgeBackground}"
                              CornerRadius="4"
                              Padding="6,2"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center">
                        <TextBlock Text="{Binding LoaiXuatNoiBoText}"
                                   FontWeight="SemiBold"
                                   FontSize="11"
                                   Foreground="{Binding LoaiXuatBadgeForeground}" />
                      </Border>

                      <!-- 5. Kho xuất -->
                      <TextBlock Grid.Column="4" Text="{Binding KhoXuat}" FontSize="12" Foreground="#334155" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                      <!-- 6. Kho nhận / Bộ phận nhận -->
                      <StackPanel Grid.Column="5" Margin="6,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding BoPhanNhanHienThi}" FontWeight="SemiBold" FontSize="12.5" Foreground="#0F172A" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding GhiChu}" FontSize="11" Foreground="#64748B" TextTrimming="CharacterEllipsis" IsVisible="{Binding GhiChu, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      </StackPanel>

                      <!-- 7. Tổng số lượng -->
                      <TextBlock Grid.Column="6" Text="{Binding TongSoLuongText}" FontWeight="SemiBold" FontSize="12.5" Foreground="#334155" HorizontalAlignment="Right" VerticalAlignment="Center" />

                      <!-- 8. Tổng giá trị -->
                      <TextBlock Grid.Column="7" Text="{Binding TongGiaTriText}" FontWeight="Bold" FontSize="12.5" Foreground="#0F172A" HorizontalAlignment="Right" VerticalAlignment="Center" />

                      <!-- 9. Trạng thái (Badge) -->
                      <Border Grid.Column="8"
                              Background="{Binding TrangThaiBadgeBackground}"
                              CornerRadius="4"
                              Padding="6,2"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center">
                        <TextBlock Text="{Binding TrangThaiText}"
                                   FontWeight="SemiBold"
                                   FontSize="11"
                                   Foreground="{Binding TrangThaiBadgeForeground}" />
                      </Border>

                      <!-- 10. Thao tác -->
                      <StackPanel Grid.Column="9" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button Classes="btnTableAction"
                                Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).XemChiTietPhieuXuatNoiBoCommand}"
                                CommandParameter="{Binding}"
                                ToolTip.Tip="Xem chi tiết các mặt hàng trong phiếu">
                          <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="👁" FontSize="11" />
                            <TextBlock Text="Xem" FontSize="11" />
                          </StackPanel>
                        </Button>

                        <Button Classes="btnTableAction"
                                Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).InPhieuXuatNoiBoCommand}"
                                CommandParameter="{Binding}"
                                ToolTip.Tip="In phiếu xuất nội bộ">
                          <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="🖨" FontSize="11" />
                            <TextBlock Text="In" FontSize="11" />
                          </StackPanel>
                        </Button>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
        </ScrollViewer>
      </Grid>
    </Border>

    <!-- ============================================================ -->
    <!-- SECTION E: THANH PHÂN TRANG                                  -->
    <!-- ============================================================ -->
    <Grid Grid.Row="4" ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center" Margin="2,0">
      <TextBlock Grid.Column="0"
                 Text="{Binding DsPhieuXuatNoiBoRangeText}"
                 FontSize="12.5"
                 Foreground="#64748B"
                 VerticalAlignment="Center" />

      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <Button Classes="btnSubtle"
                Command="{Binding DsPhieuXuatNoiBoTrangTruocCommand}"
                IsEnabled="{Binding CanDsPhieuXuatNoiBoTrangTruoc}"
                Height="32"
                Padding="10,0">
          <TextBlock Text="‹ Trang trước" FontSize="12" />
        </Button>

        <Border Background="#EFF6FF" CornerRadius="6" Padding="10,6" VerticalAlignment="Center">
          <TextBlock Text="{Binding DsPhieuXuatNoiBoPage, StringFormat='Trang {0}'}"
                     FontSize="12"
                     FontWeight="Bold"
                     Foreground="#1D4ED8" />
        </Border>

        <Button Classes="btnSubtle"
                Command="{Binding DsPhieuXuatNoiBoTrangSauCommand}"
                IsEnabled="{Binding CanDsPhieuXuatNoiBoTrangSau}"
                Height="32"
                Padding="10,0">
          <TextBlock Text="Trang sau ›" FontSize="12" />
        </Button>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>

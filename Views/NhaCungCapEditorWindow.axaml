<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:ShopHoa.Views"
        xmlns:models="using:ShopHoa.Models"
        x:Class="ShopHoa.Views.NhaCungCapEditorWindow"
        x:DataType="views:NhaCungCapEditorWindow"
        Width="860"
        Height="720"
        MinWidth="800"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Title="{Binding TieuDe}"
        Background="#F4F7F6"
        CanResize="True"
        RequestedThemeVariant="Light">

    <Window.Styles>
        <!-- Breadcrumb style -->
        <Style Selector="TextBlock.breadcrumb">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="#5E7A74"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Card group style -->
        <Style Selector="Border.cardGroup">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D9EAE4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="BoxShadow" Value="0 2 6 0 #0D000000"/>
        </Style>

        <!-- Group header -->
        <Style Selector="TextBlock.groupHeader">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#163F38"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- Input label -->
        <Style Selector="TextBlock.inputLabel">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#2D433E"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- Modern input -->
        <Style Selector="TextBox.modernInput">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#163F38"/>
            <Setter Property="BorderBrush" Value="#CBDED8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>
        <Style Selector="TextBox.modernInput:focus">
            <Setter Property="BorderBrush" Value="#087F6E"/>
            <Setter Property="BorderThickness" Value="1.5"/>
        </Style>
        <Style Selector="TextBox.modernInput[IsReadOnly=True]">
            <Setter Property="Background" Value="#F2F7F5"/>
            <Setter Property="Foreground" Value="#4B6660"/>
        </Style>

        <!-- Number input -->
        <Style Selector="TextBox.numberInput">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#163F38"/>
            <Setter Property="BorderBrush" Value="#CBDED8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>
        <Style Selector="TextBox.numberInput:focus">
            <Setter Property="BorderBrush" Value="#087F6E"/>
            <Setter Property="BorderThickness" Value="1.5"/>
        </Style>

        <!-- Modern ComboBox -->
        <Style Selector="ComboBox.modernCombo">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#163F38"/>
            <Setter Property="BorderBrush" Value="#CBDED8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="ComboBox.modernCombo:focus">
            <Setter Property="BorderBrush" Value="#087F6E"/>
            <Setter Property="BorderThickness" Value="1.5"/>
        </Style>

        <!-- Action buttons -->
        <Style Selector="Button.btnAction">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="Button.btnPrimary">
            <Setter Property="Background" Value="#087F6E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.btnPrimary:pointerover">
            <Setter Property="Background" Value="#066658"/>
        </Style>

        <Style Selector="Button.btnOutline">
            <Setter Property="Background" Value="#E8F4FD"/>
            <Setter Property="Foreground" Value="#0E5E9E"/>
            <Setter Property="BorderBrush" Value="#84BBE6"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Button.btnOutline:pointerover">
            <Setter Property="Background" Value="#D0E9FA"/>
        </Style>

        <Style Selector="Button.btnSecondary">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#2D433E"/>
            <Setter Property="BorderBrush" Value="#CBDED8"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Button.btnSecondary:pointerover">
            <Setter Property="Background" Value="#E8F4F0"/>
            <Setter Property="BorderBrush" Value="#087F6E"/>
        </Style>

        <Style Selector="Button.btnSmall">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Background" Value="#EAF1EE"/>
            <Setter Property="Foreground" Value="#163F38"/>
            <Setter Property="BorderBrush" Value="#CBDED8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.btnSmall:pointerover">
            <Setter Property="Background" Value="#D5E6E0"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ======================================================== -->
        <!-- 1. BREADCRUMB & HEADER                                  -->
        <!-- ======================================================== -->
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#D9EAE4"
                BorderThickness="0,0,0,1"
                Padding="20,12">
            <StackPanel Spacing="3">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Classes="breadcrumb" Text="Danh mục"/>
                    <TextBlock Classes="breadcrumb" Text="/"/>
                    <TextBlock Classes="breadcrumb" Text="Đối tác"/>
                    <TextBlock Classes="breadcrumb" Text="/"/>
                    <TextBlock Classes="breadcrumb"
                               Text="{Binding BreadcrumbCurrentText}"
                               Foreground="#087F6E"
                               FontWeight="Bold"/>
                </StackPanel>

                <Grid ColumnDefinitions="*,Auto" Margin="0,3,0,0">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{Binding HeaderText}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#163F38"/>
                        <TextBlock Text="Quản lý chi tiết hồ sơ nhà cung cấp, thông tin đối tác phân phối hoa, phụ liệu và điều khoản thanh toán."
                                   FontSize="12"
                                   Foreground="#5E7A74"/>
                    </StackPanel>

                    <!-- Huy hiệu trạng thái -->
                    <Border Grid.Column="1"
                            Background="{Binding StatusBadgeBackground}"
                            CornerRadius="14"
                            Padding="12,5"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusBadgeText}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{Binding StatusBadgeForeground}"/>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ======================================================== -->
        <!-- 2. NỘI DUNG FORM (SCROLLVIEWER)                          -->
        <!-- ======================================================== -->
        <ScrollViewer Grid.Row="1" Padding="20,14" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="14">

                <!-- CARD A: THÔNG TIN CƠ BẢN -->
                <Border Classes="cardGroup">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="groupHeader" Text="🏢  THÔNG TIN CƠ BẢN"/>

                        <!-- Hàng 1: Mã NCC & Tên NCC -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                            <!-- Mã NCC -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Classes="inputLabel" Text="Mã nhà cung cấp"/>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                    <TextBox Name="MaNhaCungCapBox"
                                             Classes="modernInput"
                                             Text="{Binding Supplier.MaNhaCungCap, Mode=TwoWay}"
                                             Watermark="Mã tự động hoặc tự nhập (VD: NCC0001)"/>
                                    <Button Grid.Column="1"
                                            Classes="btnSmall"
                                            Content="🔄 Sinh mã"
                                            ToolTip.Tip="Tự động phát sinh mã NCC mới nhất từ hệ thống"
                                            Click="OnSinhMaClicked"/>
                                </Grid>
                            </StackPanel>

                            <!-- Tên NCC -->
                            <StackPanel Grid.Column="1">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Classes="inputLabel" Text="Tên nhà cung cấp"/>
                                    <TextBlock Text="*" Foreground="#C00000" FontWeight="Bold"/>
                                </StackPanel>
                                <TextBox Name="TenNhaCungCapBox"
                                         Classes="modernInput"
                                         Text="{Binding Supplier.TenNhaCungCap, Mode=TwoWay}"
                                         Watermark="Nhập tên nhà vườn, vựa hoa hoặc đại lý (bắt buộc)"/>
                            </StackPanel>
                        </Grid>

                        <!-- Hàng 2: Tên công ty & Nhóm NCC -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                            <!-- Tên công ty -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Classes="inputLabel" Text="Tên công ty / Doanh nghiệp đại diện"/>
                                <TextBox Classes="modernInput"
                                         Text="{Binding Supplier.TenCongTy, Mode=TwoWay}"
                                         Watermark="Tên pháp nhân công ty (nếu có)"/>
                            </StackPanel>

                            <!-- Nhóm NCC -->
                            <StackPanel Grid.Column="1">
                                <TextBlock Classes="inputLabel" Text="Nhóm nhà cung cấp"/>
                                <AutoCompleteBox Name="NhomNhaCungCapBox"
                                                 Height="32"
                                                 Padding="8,4"
                                                 FontSize="12.5"
                                                 BorderBrush="#CBDED8"
                                                 CornerRadius="4"
                                                 Text="{Binding Supplier.NhomNhaCungCapTen, Mode=TwoWay}"
                                                 ItemsSource="{Binding DanhSachNhomNCC}"
                                                 Watermark="Chọn hoặc gõ nhóm (VD: Vườn Đà Lạt, Hoa nhập...)"/>
                            </StackPanel>
                        </Grid>

                        <!-- Hàng 3: Người liên hệ & Mã số thuế -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                            <!-- Người liên hệ -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Classes="inputLabel" Text="Người liên hệ đại diện"/>
                                <TextBox Classes="modernInput"
                                         Text="{Binding Supplier.NguoiLienHe, Mode=TwoWay}"
                                         Watermark="Họ tên người giao dịch, chủ vườn"/>
                            </StackPanel>

                            <!-- Mã số thuế -->
                            <StackPanel Grid.Column="1">
                                <TextBlock Classes="inputLabel" Text="Mã số thuế"/>
                                <TextBox Classes="modernInput"
                                         Text="{Binding Supplier.MaSoThue, Mode=TwoWay}"
                                         Watermark="Mã số thuế doanh nghiệp / hộ kinh doanh"/>
                            </StackPanel>
                        </Grid>

                        <!-- Hàng 4: Số điện thoại & Email -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                            <!-- SĐT -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Classes="inputLabel" Text="Số điện thoại liên hệ"/>
                                <TextBox Name="SoDienThoaiBox"
                                         Classes="modernInput"
                                         Text="{Binding Supplier.SoDienThoai, Mode=TwoWay}"
                                         Watermark="Số điện thoại di động / bàn"/>
                            </StackPanel>

                            <!-- Email -->
                            <StackPanel Grid.Column="1">
                                <TextBlock Classes="inputLabel" Text="Địa chỉ Email"/>
                                <TextBox Name="EmailBox"
                                         Classes="modernInput"
                                         Text="{Binding Supplier.Email, Mode=TwoWay}"
                                         Watermark="Email trao đổi thông tin (VD: contact@nhavuon.vn)"/>
                            </StackPanel>
                        </Grid>

                    </StackPanel>
                </Border>

                <!-- CARD B: THÔNG TIN ĐỊA CHỈ & LIÊN HỆ -->
                <Border Classes="cardGroup">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="groupHeader" Text="📍  THÔNG TIN ĐỊA CHỈ"/>

                        <!-- Hàng 1: Địa chỉ chi tiết & Phường/Xã -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                            <!-- Địa chỉ chi tiết -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Classes="inputLabel" Text="Địa chỉ chi tiết (Số nhà, đường, thôn xóm)"/>
                                <TextBox Name="DiaChiChiTietBox"
                                         Classes="modernInput"
                                         Text="{Binding Supplier.DiaChi, Mode=TwoWay}"
                                         KeyUp="OnDiaChiComponentChanged"
                                         LostFocus="OnDiaChiComponentLostFocus"
                                         Watermark="Ví dụ: 123 Đường Mai Anh Đào"/>
                            </StackPanel>

                            <!-- Phường/Xã -->
                            <StackPanel Grid.Column="1">
                                <TextBlock Classes="inputLabel" Text="Phường / Xã"/>
                                <TextBox Name="PhuongXaBox"
                                         Classes="modernInput"
                                         Text="{Binding Supplier.PhuongXa, Mode=TwoWay}"
                                         KeyUp="OnDiaChiComponentChanged"
                                         LostFocus="OnDiaChiComponentLostFocus"
                                         Watermark="Ví dụ: Phường 8"/>
                            </StackPanel>
                        </Grid>

                        <!-- Hàng 2: Quận/Huyện & Tỉnh/Thành -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                            <!-- Quận/Huyện -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Classes="inputLabel" Text="Quận / Huyện / Thị xã"/>
                                <TextBox Name="QuanHuyenBox"
                                         Classes="modernInput"
                                         Text="{Binding Supplier.QuanHuyen, Mode=TwoWay}"
                                         KeyUp="OnDiaChiComponentChanged"
                                         LostFocus="OnDiaChiComponentLostFocus"
                                         Watermark="Ví dụ: TP. Đà Lạt"/>
                            </StackPanel>

                            <!-- Tỉnh/Thành -->
                            <StackPanel Grid.Column="1">
                                <TextBlock Classes="inputLabel" Text="Tỉnh / Thành phố"/>
                                <TextBox Name="TinhThanhBox"
                                         Classes="modernInput"
                                         Text="{Binding Supplier.TinhThanh, Mode=TwoWay}"
                                         KeyUp="OnDiaChiComponentChanged"
                                         LostFocus="OnDiaChiComponentLostFocus"
                                         Watermark="Ví dụ: Lâm Đồng"/>
                            </StackPanel>
                        </Grid>

                        <!-- Hàng 3: Hiển thị địa chỉ đầy đủ (Preview) -->
                        <Border Background="#F0FDF4"
                                BorderBrush="#DCFCE7"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,8">
                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Text="📌  Địa chỉ đầy đủ: "
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#166534"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Name="DiaChiDayDuTextBlock"
                                           Text="{Binding DiaChiDayDuPreview}"
                                           FontSize="12.5"
                                           FontWeight="Medium"
                                           Foreground="#14532D"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                    </StackPanel>
                </Border>

                <!-- CARD C: THÔNG TIN THANH TOÁN & BỔ SUNG -->
                <Border Classes="cardGroup">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="groupHeader" Text="💳  THANH TOÁN &amp; HỢP TÁC"/>

                        <!-- Hàng 1: Số tài khoản & Ngân hàng -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                            <StackPanel Grid.Column="0">
                                <TextBlock Classes="inputLabel" Text="Số tài khoản ngân hàng"/>
                                <TextBox Classes="modernInput"
                                         Text="{Binding Supplier.SoTaiKhoan, Mode=TwoWay}"
                                         Watermark="Số tài khoản nhận thanh toán"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Classes="inputLabel" Text="Ngân hàng mở tài khoản"/>
                                <TextBox Classes="modernInput"
                                         Text="{Binding Supplier.NganHang, Mode=TwoWay}"
                                         Watermark="Tên ngân hàng (VD: Vietcombank, BIDV, Agribank...)"/>
                            </StackPanel>
                        </Grid>

                        <!-- Hàng 2: Hạn mức nợ & Chiết khấu % -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                            <StackPanel Grid.Column="0">
                                <TextBlock Classes="inputLabel" Text="Công nợ gối đầu / Hạn mức nợ (đ)"/>
                                <TextBox Name="CongNoGoiDauBox"
                                         Classes="numberInput"
                                         Text="{Binding Supplier.CongNoGoiDau, Mode=TwoWay, StringFormat={}{0:N0}}"
                                         Watermark="0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Classes="inputLabel" Text="Chiết khấu mặc định (%)"/>
                                <TextBox Name="ChietKhauBox"
                                         Classes="numberInput"
                                         Text="{Binding Supplier.ChietKhau, Mode=TwoWay, StringFormat={}{0:N2}}"
                                         Watermark="0.00"/>
                            </StackPanel>
                        </Grid>

                        <!-- Hàng 3: Nhãn hiệu & Trạng thái -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                            <StackPanel Grid.Column="0">
                                <TextBlock Classes="inputLabel" Text="Nhãn hiệu / Thương hiệu"/>
                                <TextBox Classes="modernInput"
                                         Text="{Binding Supplier.NhanHieu, Mode=TwoWay}"
                                         Watermark="Nhãn hiệu hoặc vựa hoa đại diện"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,18,0,0">
                                <CheckBox Name="ConHopTacCheckBox"
                                          IsChecked="{Binding Supplier.ConHopTac, Mode=TwoWay}"
                                          Content="Đang hợp tác (cho phép lập phiếu nhập và giao dịch)"
                                          FontSize="12.5"
                                          FontWeight="SemiBold"
                                          Foreground="#163F38"/>
                            </StackPanel>
                        </Grid>

                        <!-- Hàng 4: Ghi chú -->
                        <StackPanel>
                            <TextBlock Classes="inputLabel" Text="Ghi chú thêm về nhà cung cấp"/>
                            <TextBox Classes="modernInput"
                                     Text="{Binding Supplier.GhiChu, Mode=TwoWay}"
                                     Height="65"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalContentAlignment="Top"
                                     Watermark="Nhập ghi chú đặc điểm giao hàng, chất lượng hoa, điều khoản đối soát công nợ..."/>
                        </StackPanel>

                    </StackPanel>
                </Border>

                <!-- KHU VỰC THÔNG BÁO LỖI -->
                <Border Name="LoiMessageBorder"
                        Background="#FDE8E8"
                        BorderBrush="#F8B4B4"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,10"
                        IsVisible="{Binding CoLoi}">
                    <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Text="⚠️  "
                                   FontSize="14"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Name="LoiMessageTextBlock"
                                   Text="{Binding LoiMessage}"
                                   Foreground="#9B1C1C"
                                   FontWeight="SemiBold"
                                   FontSize="12.5"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ======================================================== -->
        <!-- 3. THANH NÚT BẤM DƯỚI CÙNG                              -->
        <!-- ======================================================== -->
        <Border Grid.Row="2"
                Background="#EAF1EE"
                BorderBrush="#D9EAE4"
                BorderThickness="0,1,0,0"
                Padding="20,12">
            <Grid ColumnDefinitions="*,Auto">
                <!-- Ghi chú bắt buộc bên trái -->
                <TextBlock Text="* Các trường có dấu sao là thông tin bắt buộc"
                           FontSize="11.5"
                           FontStyle="Italic"
                           Foreground="#5E7A74"
                           VerticalAlignment="Center"/>

                <!-- Nhóm nút bên phải -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                    <!-- Nút Thiết lập giá (chỉ hiện khi sửa NCC đã có ID) -->
                    <Button Name="NutThietLapGiaButton"
                            Classes="btnAction btnOutline"
                            Content="💲  Thiết lập giá đối tác"
                            IsVisible="{Binding CoTheThietLapGia}"
                            ToolTip.Tip="Mở bảng thiết lập chiết khấu và đơn giá riêng cho nhà cung cấp này"
                            Click="OnThietLapGiaClicked"/>

                    <!-- Nút Hủy bỏ -->
                    <Button Name="NutHuyButton"
                            Classes="btnAction btnSecondary"
                            Content="✕  Hủy bỏ"
                            Click="OnCancelClicked"/>

                    <!-- Nút Lưu -->
                    <Button Name="NutLuuButton"
                            Classes="btnAction btnPrimary"
                            Content="💾  Lưu thông tin"
                            Click="OnSaveClicked"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>